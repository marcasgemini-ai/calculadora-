{%- comment -%}
  PÁGINA INTEGRAL METABOMEN · LIQUID 05b · INGREDIENTES + CAJA "LO QUE VAS A ENCONTRAR EN LA ETIQUETA"
  Necesita el 01 arriba. Separá con | (mismo orden).
  i_dosis: completá con la dosis real de la etiqueta (dejá '' si no la querés mostrar).
  etiqueta: verificá cada punto antes de publicar (RNPA, lote y vencimiento iguales en caja y frasco, etc.).
{%- endcomment -%}

{%- assign eyebrow = 'La fórmula' -%}
{%- assign titulo = 'Qué hay en <em>cada cápsula</em>' -%}
{%- assign bajada = '14 activos elegidos para el sueño, la panza, la energía, las ganas y el envejecimiento del hombre de +40.' -%}

{%- assign i_icono = 'grape|citrus|hex|drop|bulb|dumbbell|leaf|berry' | split: '|' -%}
{%- assign i_nombre = 'Resveratrol + semilla de uva|Vitamina C|Zinc|Magnesio|Ginkgo biloba|L-Arginina|Té verde|Naranja amarga + cetona de frambuesa' | split: '|' -%}
{%- assign i_dosis = '[X] mg|[X] mg|[X] mg|[X] mg|[X] mg|[X] mg|[X] mg|[X] mg' | split: '|' -%}
{%- assign i_texto = 'Los antioxidantes de la uva, los mismos que se estudian en el mundo de la longevidad.|Contribuye a proteger las células frente al estrés oxidativo y a disminuir el cansancio.|Contribuye a mantener niveles normales de testosterona, que bajan con los años.|Contribuye a disminuir el cansancio y la fatiga.|Extracto de hoja usado hace siglos.|Aminoácido elegido por hombres activos.|Extracto vegetal clásico de las fórmulas de apoyo metabólico.|Extractos vegetales usados en fórmulas para el control de peso.' | split: '|' -%}

{%- assign etiqueta_titulo = 'Lo que vas a encontrar en la etiqueta' -%}
{%- assign etiqueta = 'RNPA vigente ([número])|Lote y vencimiento iguales en caja y frasco|Laboratorio habilitado ([nombre])|Sin gluten|Lista completa de ingredientes y dosis|Contraindicaciones claras' | split: '|' -%}

<style>
  .dt-ing { background: #fff; border: 1px solid var(--dt-line); border-radius: 16px; padding: 18px; height: 100%; }
  .dt-ing__i { width: 46px; height: 46px; border-radius: 50%; background: var(--dt-ink, #141517); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 12px; }
  .dt-ing__i .dt-ic { width: 24px; height: 24px; }
  .dt-ing h3 { font-size: 18px; margin-bottom: 2px; }
  .dt-ing small { display: block; font-size: 12px; font-weight: 800; color: var(--dt-red); margin-bottom: 8px; }
  .dt-ing p { font-size: 14px; color: var(--dt-muted); margin: 0 !important; line-height: 1.45; }
  .dt-etq { background: var(--dt-black); color: #fff; border-radius: 18px; padding: 22px; margin-top: 22px; }
  .dt-etq p { font-family: var(--dt-head); font-size: 18px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 14px !important; text-align: center; }
  .dt-etq ul.dt-chk { grid-template-columns: 1fr 1fr; gap: 10px 20px; }
  .dt-etq li { font-size: 14.5px; }
  .dt-etq li::before { background: #6BD39A !important; }
  @media (max-width: 749px) { .dt-etq ul.dt-chk { grid-template-columns: 1fr; } }
</style>

<div class="dt-band">
  <div class="dt dt-sec">
    <div class="dt-head">
      <span class="dt-eyebrow">{{ eyebrow }}</span>
      <h2 class="dt-h2">{{ titulo }}</h2>
      <p class="dt-lead">{{ bajada }}</p>
    </div>
    <div class="dt-scroll">
      {%- for n in i_nombre -%}
        {%- assign k = forloop.index0 -%}
        <div class="dt-ing">
          <div class="dt-ing__i"><svg class="dt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{%- case i_icono[k] -%}{%- when 'bolt' -%}<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>{%- when 'leaf' -%}<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>{%- when 'grape' -%}<circle cx="9" cy="9.5" r="2.5"/><circle cx="15" cy="9.5" r="2.5"/><circle cx="12" cy="14" r="2.5"/><circle cx="9" cy="18.5" r="2.5"/><circle cx="15" cy="18.5" r="2.5"/><path d="M12 7V3.5l3-1.5"/>{%- when 'pulse' -%}<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>{%- when 'pin' -%}<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>{%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>{%- when 'trophy' -%}<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>{%- when 'camera' -%}<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>{%- when 'flame' -%}<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>{%- when 'book' -%}<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>{%- when 'utensils' -%}<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>{%- when 'plane' -%}<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>{%- when 'gift' -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/>{%- when 'lock' -%}<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>{%- when 'truck' -%}<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62L18.3 9.38a1 1 0 0 0-.78-.38H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>{%- when 'card' -%}<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/>{%- when 'chat' -%}<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>{%- when 'badge' -%}<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>{%- when 'clock' -%}<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>{%- when 'hourglass' -%}<path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.17a2 2 0 0 0-.59-1.42L12 12l-4.41 4.41A2 2 0 0 0 7 17.83V22"/><path d="M7 2v4.17a2 2 0 0 0 .59 1.42L12 12l4.41-4.41A2 2 0 0 0 17 6.17V2"/>{%- when 'flask' -%}<path d="M9 3h6"/><path d="M10 3v6L4.5 18.5A2 2 0 0 0 6.2 21.5h11.6a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7 15h10"/>{%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>{%- when 'heart' -%}<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>{%- when 'calendar' -%}<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>{%- when 'bulb' -%}<path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>{%- when 'dumbbell' -%}<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>{%- when 'citrus' -%}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><path d="M12 6.5v11M6.5 12h11M8.1 8.1l7.8 7.8M15.9 8.1l-7.8 7.8"/>{%- when 'hex' -%}<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M9 9.5h6l-6 5h6"/>{%- when 'drop' -%}<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>{%- when 'berry' -%}<circle cx="12" cy="14" r="7"/><path d="M12 7V3M9 4.5 12 7l3-2.5"/><path d="M9.5 12h.01M14.5 12h.01M12 15h.01M9.5 17h.01M14.5 17h.01"/>{%- when 'arrowdown' -%}<path d="M12 5v14M19 12l-7 7-7-7"/>{%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>{%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>{%- endcase -%}</svg></div>
          <h3>{{ n }}</h3>
          {%- if i_dosis[k] != blank -%}<small>{{ i_dosis[k] }} por cápsula</small>{%- endif -%}
          <p>{{ i_texto[k] }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="dt-etq">
      <p>{{ etiqueta_titulo }}</p>
      <ul class="dt-chk">{%- for e in etiqueta -%}<li>{{ e }}</li>{%- endfor -%}</ul>
    </div>
  </div>
</div>
