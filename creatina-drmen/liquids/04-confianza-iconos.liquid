{%- comment -%}
  04 · FILA DE CONFIANZA (debajo del botón "Agregar al carrito")
  EDITAR: cuotas, días de garantía.
{%- endcomment -%}
{%- assign cuotas = '3 cuotas sin interés' -%}
{%- assign garantia_dias = '60' -%}
<div class="drm drm--light drm-trust">
  <div class="drm-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/></svg><span>Envío gratis</span></div>
  <div class="drm-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg><span>Garantía {{ garantia_dias }} días</span></div>
  <div class="drm-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg><span>{{ cuotas }}</span></div>
  <div class="drm-trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 19c8 0 14-6 14-14-8 0-14 6-14 14z"/><path d="M5 19l7-7"/></svg><span>Sin gluten</span></div>
</div>
<style>
  .drm-trust{background:transparent;color:inherit;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:14px 0;border-top:1px solid rgba(0,0,0,.08);border-bottom:1px solid rgba(0,0,0,.08);margin:8px 0}
  .drm-trust__item{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;font-size:12px;font-weight:600;line-height:1.2}
  .drm-trust__item svg{width:26px;height:26px;color:var(--gold)}
</style>
