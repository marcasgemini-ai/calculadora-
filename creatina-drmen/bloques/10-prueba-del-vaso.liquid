{%- comment -%}
  10 · LA PRUEBA DEL VASO (demo visual, el "wow" de Gains)
  IMPORTANTE: hacer la prueba real antes de publicar (5 g en 500 ml de agua a temperatura ambiente,
  revolver 30 s) contra una creatina común sin micronizar. Si tienen video, cargarlo en video_demo
  y reemplaza los vasos dibujados.
{%- endcomment -%}
<style>.drm{--bg:#0B0B0C;--card:#161618;--card-2:#1E1E21;--ink:#F4F2EE;--muted:#A9A49B;--gold:#C9A45C;--gold-2:#E2C489;--red:#D9443A;--green:#3DB57E;--paper:#F4F1EC;--paper-ink:#141414;--line:rgba(255,255,255,.10);font-family:var(--font-body-family,inherit);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.5;width:100%;overflow-x:clip}.drm *,.drm *::before,.drm *::after{box-sizing:border-box}.drm img,.drm video{max-width:100%;display:block}.drm--light{background:var(--paper);color:var(--paper-ink);--muted:#5E5A54;--line:rgba(0,0,0,.10);--card:#FFFFFF;--card-2:#EFEBE4}.drm-wrap{max-width:1120px;margin:0 auto;padding:64px 16px}.drm-h{font-family:var(--font-heading-family,inherit);font-style:var(--font-heading-style,normal);letter-spacing:-.01em;line-height:1.12;font-weight:var(--font-heading-weight,700);margin:0 0 16px;color:inherit}.drm-h2{font-size:clamp(28px,4.6vw,46px)}.drm-h3{font-size:clamp(20px,2.6vw,24px)}.drm-eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:700;margin:0 0 12px}.drm-lead{font-size:17px;line-height:1.6;color:var(--muted);max-width:660px;margin:0 0 36px}.drm-center{text-align:center}.drm-center .drm-lead{margin-left:auto;margin-right:auto}.drm-accent{color:var(--gold)}.drm-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:16px 32px;border:0;border-radius:999px;background:var(--gold);color:#111;font:700 16px/1 var(--font-body-family,inherit);text-transform:uppercase;letter-spacing:.06em;text-decoration:none;cursor:pointer;transition:transform .15s ease,background .15s ease;box-shadow:0 10px 30px rgba(201,164,92,.25)}.drm-btn:hover{background:var(--gold-2);transform:translateY(-1px)}.drm-btn--block{width:100%}.drm-ph{display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;min-height:100%;width:100%;background:repeating-linear-gradient(45deg,var(--card),var(--card) 12px,var(--card-2) 12px,var(--card-2) 24px);color:var(--muted);font-size:13px;font-weight:600;border:1px dashed var(--line)}.drm-stars{display:inline-flex;gap:2px;color:var(--gold)}.drm-stars svg{width:16px;height:16px}@media (max-width:749px){.drm-wrap{padding:48px 16px}}</style>
{%- assign video_demo = '' -%}
<section class="drm drm--light drm-glass">
  <div class="drm-wrap drm-center">
    <p class="drm-eyebrow">Hacé la prueba en tu casa</p>
    <h2 class="drm-h drm-h2">La prueba del vaso</h2>
    <p class="drm-lead">5 g en 500 ml de agua a temperatura ambiente. Revolvé 30 segundos. Mirá el fondo.</p>
    {%- if video_demo != blank -%}
      <div class="drm-glass__video"><video src="{{ video_demo | file_url }}" playsinline muted loop autoplay controls preload="metadata"></video></div>
    {%- else -%}
    <div class="drm-glass__row">
      <figure class="drm-glass__fig">
        <div class="drm-glass__cup drm-glass__cup--bad"><i></i><b></b></div>
        <figcaption><strong>Creatina común</strong><span class="drm-glass__x">✕</span> Turbia · arenilla en el fondo</figcaption>
      </figure>
      <div class="drm-glass__vs">VS</div>
      <figure class="drm-glass__fig">
        <div class="drm-glass__cup drm-glass__cup--good"><i></i></div>
        <figcaption><strong>PURE Activator®</strong><span class="drm-glass__ok">✓</span> Hiperfiltrada · se disuelve por completo</figcaption>
      </figure>
    </div>
    {%- endif -%}
  </div>
</section>
<style>.drm-glass__row{display:flex;align-items:center;justify-content:center;gap:40px}.drm-glass__fig{margin:0;display:flex;flex-direction:column;align-items:center;gap:18px}.drm-glass__cup{position:relative;width:150px;height:210px;border:4px solid rgba(0,0,0,.18);border-top:0;border-radius:0 0 28px 28px;clip-path:polygon(0 0,100% 0,90% 100%,10% 100%);overflow:hidden;background:rgba(255,255,255,.6)}.drm-glass__cup i{position:absolute;left:0;right:0;bottom:0;height:78%;background:linear-gradient(180deg,rgba(170,210,235,.55),rgba(150,195,225,.75))}.drm-glass__cup--bad i{background:linear-gradient(180deg,rgba(215,215,210,.75),rgba(200,198,190,.9))}.drm-glass__cup--bad b{position:absolute;left:10%;right:10%;bottom:0;height:16%;background:radial-gradient(circle at 20% 40%,#fff 2px,transparent 3px) 0 0/9px 8px,#E9E6DE;border-radius:40% 40% 0 0}.drm-glass__fig figcaption{font-size:14px;color:var(--muted);max-width:200px}.drm-glass__fig strong{display:block;font:700 20px/1.2 var(--font-heading-family,inherit);color:var(--paper-ink);margin-bottom:4px}.drm-glass__x,.drm-glass__ok{display:inline-grid;place-items:center;width:18px;height:18px;border-radius:50%;color:#fff;font-size:11px;margin-right:6px;vertical-align:-3px}.drm-glass__x{background:var(--red)}.drm-glass__ok{background:var(--green)}.drm-glass__vs{font:700 28px/1 var(--font-heading-family,inherit);color:var(--gold)}.drm-glass__video{max-width:420px;margin:0 auto;border-radius:20px;overflow:hidden}@media (max-width:749px){.drm-glass__row{gap:14px}.drm-glass__cup{width:110px;height:160px}.drm-glass__vs{font-size:20px}}</style>
