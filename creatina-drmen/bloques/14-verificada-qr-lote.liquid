{%- comment -%}
  14 · VERIFICACIÓN POR LOTE (reemplaza el bloque "Informed Sport · Clean gains. Zero guesswork.")
  ES EL CORAZÓN DE LA CATEGORÍA. EDITAR: laboratorio, RNPA, RNE y link a la página de lotes.
  Crear en Shopify una página /pages/lotes con el PDF del análisis de cada lote.
{%- endcomment -%}
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>.drm{--bg:#0B0B0C;--card:#161618;--card-2:#1E1E21;--ink:#F4F2EE;--muted:#A9A49B;--gold:#C9A45C;--gold-2:#E2C489;--red:#D9443A;--green:#3DB57E;--paper:#F4F1EC;--paper-ink:#141414;--line:rgba(255,255,255,.10);font-family:Inter,system-ui,-apple-system,sans-serif;color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.5;width:100%;overflow-x:clip}.drm *,.drm *::before,.drm *::after{box-sizing:border-box}.drm img,.drm video{max-width:100%;display:block}.drm--light{background:var(--paper);color:var(--paper-ink);--muted:#5E5A54;--line:rgba(0,0,0,.10);--card:#FFFFFF;--card-2:#EFEBE4}.drm-wrap{max-width:1120px;margin:0 auto;padding:64px 16px}.drm-h{font-family:Oswald,Impact,sans-serif;text-transform:uppercase;letter-spacing:.01em;line-height:1.05;font-weight:700;margin:0 0 16px;color:inherit}.drm-h2{font-size:clamp(30px,5.2vw,52px)}.drm-h3{font-size:clamp(20px,2.6vw,24px)}.drm-eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:700;margin:0 0 12px}.drm-lead{font-size:17px;line-height:1.6;color:var(--muted);max-width:660px;margin:0 0 36px}.drm-center{text-align:center}.drm-center .drm-lead{margin-left:auto;margin-right:auto}.drm-accent{color:var(--gold)}.drm-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:16px 32px;border:0;border-radius:999px;background:var(--gold);color:#111;font:700 16px/1 Inter,sans-serif;text-transform:uppercase;letter-spacing:.06em;text-decoration:none;cursor:pointer;transition:transform .15s ease,background .15s ease;box-shadow:0 10px 30px rgba(201,164,92,.25)}.drm-btn:hover{background:var(--gold-2);transform:translateY(-1px)}.drm-btn--block{width:100%}.drm-ph{display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;min-height:100%;width:100%;background:repeating-linear-gradient(45deg,var(--card),var(--card) 12px,var(--card-2) 12px,var(--card-2) 24px);color:var(--muted);font-size:13px;font-weight:600;border:1px dashed var(--line)}.drm-stars{display:inline-flex;gap:2px;color:var(--gold)}.drm-stars svg{width:16px;height:16px}@media (max-width:749px){.drm-wrap{padding:48px 16px}}</style>
{%- assign laboratorio = '[Nombre del laboratorio independiente]' -%}
{%- assign rnpa = '[N° RNPA]' -%}
{%- assign rne = '[N° RNE]' -%}
{%- assign url_lotes = '/pages/lotes' -%}
{%- assign img_lab = '' -%}
<section class="drm drm--light drm-lab">
  <div class="drm-wrap drm-lab__grid">
    <div class="drm-lab__media">
      {%- if img_lab != blank -%}<img src="{{ img_lab | file_url }}" alt="Análisis de laboratorio de creatina DR.MEN" loading="lazy">{%- else -%}<div class="drm-ph">Foto: mano escaneando el QR<br>del frasco con el celular</div>{%- endif -%}
    </div>
    <div>
      <div class="drm-lab__badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>Creatina Verificada</div>
      <h2 class="drm-h drm-h2">Escaneá. Mirá tu lote.<br>Decidí vos.</h2>
      <p class="drm-lead">Cero confianza a ciegas. Cada lote de PURE Activator® se analiza en {{ laboratorio }} y el resultado queda publicado para que lo veas.</p>
      <ol class="drm-lab__steps">
        <li><b>Buscá el número de lote</b> en la base del frasco.</li>
        <li><b>Escaneá el QR</b> de la etiqueta con tu celular.</li>
        <li><b>Mirá el análisis:</b> pureza, contenido por porción y control de contaminantes.</li>
      </ol>
      <div class="drm-lab__reg"><span>RNPA {{ rnpa }}</span><span>RNE {{ rne }}</span></div>
      <a class="drm-lab__link" href="{{ url_lotes }}">Ver análisis de todos los lotes →</a>
    </div>
  </div>
</section>
<style>.drm-lab__grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center}.drm-lab__media{aspect-ratio:4/5;border-radius:20px;overflow:hidden}.drm-lab__media img{width:100%;height:100%;object-fit:cover}.drm-lab__badge{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:#111;color:var(--gold);font:700 12px/1 Inter,sans-serif;text-transform:uppercase;letter-spacing:.1em;margin-bottom:18px}.drm-lab__badge svg{width:18px;height:18px}.drm-lab__steps{margin:0 0 24px;padding:0;list-style:none;counter-reset:s;display:grid;gap:12px}.drm-lab__steps li{counter-increment:s;position:relative;padding-left:44px;font-size:15px;line-height:1.5}.drm-lab__steps li::before{content:counter(s);position:absolute;left:0;top:-2px;width:30px;height:30px;border-radius:50%;background:var(--gold);color:#111;display:grid;place-items:center;font:700 14px/1 Oswald,sans-serif}.drm-lab__reg{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}.drm-lab__reg span{padding:6px 12px;border-radius:8px;background:var(--card-2);font-size:13px;font-weight:600}.drm-lab__link{color:var(--paper-ink);font-weight:700;text-decoration:underline;text-underline-offset:4px}@media (max-width:749px){.drm-lab__grid{grid-template-columns:1fr;gap:32px}.drm-lab__media{aspect-ratio:4/3}}</style>
