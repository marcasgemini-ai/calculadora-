{%- comment -%}
  01 · BARRA DE PROMO (arriba de todo, como el "$10 Off + 4 Free Gifts" de Gains)
  EDITAR: textos de abajo.
{%- endcomment -%}
<style>.drm{--bg:#0B0B0C;--card:#161618;--card-2:#1E1E21;--ink:#F4F2EE;--muted:#A9A49B;--gold:#C9A45C;--gold-2:#E2C489;--red:#D9443A;--green:#3DB57E;--paper:#F4F1EC;--paper-ink:#141414;--line:rgba(255,255,255,.10);font-family:var(--font-body-family,inherit);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.5;width:100%;overflow-x:clip}.drm *,.drm *::before,.drm *::after{box-sizing:border-box}.drm img,.drm video{max-width:100%;display:block}.drm--light{background:var(--paper);color:var(--paper-ink);--muted:#5E5A54;--line:rgba(0,0,0,.10);--card:#FFFFFF;--card-2:#EFEBE4}.drm-wrap{max-width:1120px;margin:0 auto;padding:64px 16px}.drm-h{font-family:var(--font-heading-family,inherit);font-style:var(--font-heading-style,normal);letter-spacing:-.01em;line-height:1.12;font-weight:var(--font-heading-weight,700);margin:0 0 16px;color:inherit}.drm-h2{font-size:clamp(28px,4.6vw,46px)}.drm-h3{font-size:clamp(20px,2.6vw,24px)}.drm-eyebrow{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:700;margin:0 0 12px}.drm-lead{font-size:17px;line-height:1.6;color:var(--muted);max-width:660px;margin:0 0 36px}.drm-center{text-align:center}.drm-center .drm-lead{margin-left:auto;margin-right:auto}.drm-accent{color:var(--gold)}.drm-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:16px 32px;border:0;border-radius:999px;background:var(--gold);color:#111;font:700 16px/1 var(--font-body-family,inherit);text-transform:uppercase;letter-spacing:.06em;text-decoration:none;cursor:pointer;transition:transform .15s ease,background .15s ease;box-shadow:0 10px 30px rgba(201,164,92,.25)}.drm-btn:hover{background:var(--gold-2);transform:translateY(-1px)}.drm-btn--block{width:100%}.drm-ph{display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;min-height:100%;width:100%;background:repeating-linear-gradient(45deg,var(--card),var(--card) 12px,var(--card-2) 12px,var(--card-2) 24px);color:var(--muted);font-size:13px;font-weight:600;border:1px dashed var(--line)}.drm-stars{display:inline-flex;gap:2px;color:var(--gold)}.drm-stars svg{width:16px;height:16px}@media (max-width:749px){.drm-wrap{padding:48px 16px}}</style>
{%- assign promo_1 = 'Hasta 25% OFF + 4 regalos en tu Kit de Inicio' -%}
{%- assign promo_2 = 'Envío gratis a todo el país' -%}
{%- assign promo_3 = 'Garantía de 60 días' -%}
<div class="drm drm-promo">
  <div class="drm-promo__track">
    {%- for i in (1..2) -%}
      <span>{{ promo_1 }}</span><i>◆</i><span>{{ promo_2 }}</span><i>◆</i><span>{{ promo_3 }}</span><i>◆</i>
    {%- endfor -%}
  </div>
</div>
<style>.drm-promo{background:var(--gold);color:#111;overflow:hidden;white-space:nowrap}.drm-promo__track{display:inline-flex;gap:24px;align-items:center;padding:11px 0;font:700 13px/1 var(--font-body-family,inherit);text-transform:uppercase;letter-spacing:.08em;animation:drmPromo 28s linear infinite}.drm-promo__track i{font-style:normal;font-size:9px;opacity:.6}@keyframes drmPromo{from{transform:translateX(0)}to{transform:translateX(-50%)}}@media (prefers-reduced-motion:reduce){.drm-promo__track{animation:none}}</style>
