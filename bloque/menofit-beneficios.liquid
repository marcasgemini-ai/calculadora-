{%- comment -%}
BENEFICIOS MENOFIT · Pegá TODO en un bloque "Liquid personalizado".
Para editar: cambiá los textos de abajo. <b>...</b> = negrita.
{%- endcomment -%}
{%- liquid
assign b1 = '<b>Energía para todo el día</b>, sin cafeína'
assign b2 = '<b>Pensado para mujeres 40+</b>, no es un multivitamínico genérico'
assign b3 = '<b>1 comprimido al día</b>, sin complicarte'
assign b4 = '<b>Acompaña esta etapa</b> de forma natural'
assign b5 = '<b>Registrado en ANMAT</b>, sin gluten'
assign c_main = '#6922A5'
assign c_soft = '#F3EAFB'
assign c_ink = '#2A0E45'
-%}
<ul class="mf-ben" style="--mf-main: {{ c_main }}; --mf-soft: {{ c_soft }}; --mf-ink: {{ c_ink }};">
<li><span class="mf-ben__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2.5L5 13.5h6l-1 8 8-11h-6z"/></svg></span><span class="mf-ben__tx">{{ b1 }}</span></li>
<li><span class="mf-ben__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4.5"/><path d="M12 12.5v9M8.5 18h7"/></svg></span><span class="mf-ben__tx">{{ b2 }}</span></li>
<li><span class="mf-ben__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-35 12 12)"/><path d="M9.6 8.6l4.8 6.8"/></svg></span><span class="mf-ben__tx">{{ b3 }}</span></li>
<li><span class="mf-ben__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19C5 10.5 10.5 5 19.5 4.5 19.5 13.5 14 19 5 19z"/><path d="M5 19l8.5-8.5"/></svg></span><span class="mf-ben__tx">{{ b4 }}</span></li>
<li><span class="mf-ben__ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"/><path d="M8.5 12l2.5 2.5 4.5-4.5"/></svg></span><span class="mf-ben__tx">{{ b5 }}</span></li>
</ul>
<style>
.mf-ben{list-style:none;margin:16px 0;padding:0;display:grid;gap:10px;color:var(--mf-ink)}
.mf-ben li{display:flex;align-items:center;gap:12px;margin:0;padding:0}
.mf-ben li::before,.mf-ben li::marker{content:none}
.mf-ben__ic{flex:none;width:36px;height:36px;border-radius:50%;background:var(--mf-soft);display:flex;align-items:center;justify-content:center}
.mf-ben__ic svg{width:19px;height:19px;fill:none;stroke:var(--mf-main);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.mf-ben__tx{font-size:15.5px;line-height:1.35;letter-spacing:0}
.mf-ben__tx b{font-weight:700;color:var(--mf-ink)}
@media (max-width:420px){.mf-ben__tx{font-size:15px}.mf-ben__ic{width:34px;height:34px}}
</style>
