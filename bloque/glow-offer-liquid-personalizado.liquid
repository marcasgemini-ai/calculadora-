{%- comment -%}
  OFERTA GLOW · bloque "Liquid personalizado". Pegá TODO este archivo.
  Solo se edita la parte CONFIGURACIÓN (hasta "FIN CONFIGURACIÓN").

  IMPORTANTE: el producto necesita las variantes (opción "Pack"), en este orden:
    1 = 1 frasco ($53.990) · 2 = 2 frascos ($75.800) · 3 = 3 frascos ($93.300) · 4 = 6 frascos ($113.700)
  El precio que se muestra y el que se cobra sale de cada variante.

  - Handle = lo que va después de /products/ en la URL del producto.
  - Packs y regalos: valores separados por |, en el orden en que se muestran. Guion (-) = vacío.
  - Badges: separados por coma. El primero va destacado.
  - Regalos: g_min = desde cuántos frascos se desbloquea. g_handle = producto $0 que se agrega
    al carrito (guion si no hay producto, ej. envío gratis o sorteo).
  - Imágenes de los regalos (g_image): subilas en Contenido → Archivos, tocá "Copiar enlace"
    y pegá cada link en su lugar, separados por |. Guion (-) = sin imagen: usa la foto del
    producto regalo y, si no hay, un ícono de línea (g_icon: truck, book, leaf, sun, gift).
    Tip: imágenes cuadradas, fondo claro o transparente, mínimo 300×300 px.
{%- endcomment -%}

{%- liquid
  assign bump_handle = 'celufit'

  assign heading = 'Elegí tu protocolo'
  assign cta_label = 'Agregar al carrito'
  assign cta_sub = 'Quiero mi tono dorado'
  assign redirect = 'cart'

  assign t_pos      = '4|3|2|1' | split: '|'
  assign t_bottles  = '6|3|2|1' | split: '|'
  assign t_title    = 'Glow 12 meses|Protocolo Verano Completo|Protocolo 120 días|Protocolo 60 días' | split: '|'
  assign t_meta     = '6 frascos|3 frascos · 180 días|2 frascos|1 frasco' | split: '|'
  assign t_badges   = 'Pagás 3 llevás 6, Mejor precio, Envío gratis|Más comprado, Recomendado, Pagás 2 llevás 3|60% OFF segunda unidad, Envío gratis, 3 cuotas sin interés|Envío gratis, 3 cuotas sin interés' | split: '|'
  assign t_subtitle = 'Un año entero con tu tono dorado: llegás al verano y lo mantenés todo el año.|Empezás ahora y llegás con el tono desde octubre hasta el último día de marzo.|-|-' | split: '|'
  assign preselected = 2

  assign bump_price = 23990
  assign bump_free_min = 6
  assign bump_line = 'Para lucir tus piernas este verano'

  assign g_title  = 'Envío gratis|Guía Rutina Glow|Guía Alimentación|Viaje al Caribe' | split: '|'
  assign g_value  = '-|$25.000|$20.000|-' | split: '|'
  assign g_tag    = 'GRATIS|GRATIS|GRATIS|SORTEO' | split: '|'
  assign g_min    = '1|2|3|3' | split: '|'
  assign g_icon   = 'truck|book|leaf|sun' | split: '|'
  assign g_image  = '-|-|-|-' | split: '|'
  assign g_handle = '-|guia-rutina-glow|guia-alimentacion-para-un-tono-dorado|-' | split: '|'

  assign c_accent = '#F2B47F'
  assign c_soft = '#FEF5EC'
  assign c_text = '#9A4F1C'
  assign c_ink = '#3B1F14'
  assign c_line = '#D9A677'
-%}
{%- comment -%} ===================== FIN CONFIGURACIÓN ===================== {%- endcomment -%}

{%- liquid
  assign bump_product = all_products[bump_handle]
  assign bump_variant = bump_product.selected_or_first_available_variant
  assign max_pos = 0
  for t in t_pos
    assign p = t | plus: 0
    if p > max_pos
      assign max_pos = p
    endif
  endfor
  assign missing_gifts = ''
  for h in g_handle
    assign hh = h | strip
    if hh != '-' and hh != blank and all_products[hh] == blank
      assign missing_gifts = missing_gifts | append: ' "' | append: hh | append: '"'
    endif
  endfor
-%}

{%- if request.design_mode -%}
  {%- if product.variants.size < max_pos -%}
    <p style="margin:0 0 8px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: el producto tiene {{ product.variants.size }} variante(s) y la oferta necesita {{ max_pos }} (1, 2, 3 y 6 frascos). La oferta no se muestra hasta que las crees (dejá Kaching visible mientras tanto).</p>
  {%- endif -%}
  {%- if bump_variant == blank -%}
    <p style="margin:0 0 8px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: no se encontró el producto con handle "{{ bump_handle }}" (CELUFIT). Corregí bump_handle.</p>
  {%- endif -%}
  {%- if missing_gifts != blank -%}
    <p style="margin:0 0 8px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: no se encontraron estos regalos:{{ missing_gifts }}. Se muestran, pero no se agregan al carrito.</p>
  {%- endif -%}
{%- endif -%}

{%- if product.variants.size >= max_pos -%}
<div
  id="glow-offer"
  class="glow"
  lang="es"
  data-redirect="{{ redirect }}"
  data-bump-id="{{ bump_variant.id }}"
  data-bump-free-min="{{ bump_free_min }}"
  data-bump-price="{{ bump_price | times: 100 }}"
  data-bump-compare="{{ bump_variant.price }}"
  style="--g-accent: {{ c_accent }}; --g-soft: {{ c_soft }}; --g-text: {{ c_text }}; --g-ink: {{ c_ink }}; --g-line: {{ c_line }};"
>
  <div class="glow__heading"><span></span><p>{{ heading }}</p><span></span></div>

  {%- comment -%} ---------- PACKS ---------- {%- endcomment -%}
  <div class="glow__tiers" role="radiogroup" aria-label="{{ heading | escape }}">
    {%- for t in t_pos -%}
      {%- liquid
        assign ti = forloop.index0
        assign v_index = t | plus: 0 | minus: 1
        assign variant = product.variants[v_index]
        assign bottles = t_bottles[ti] | plus: 0
        assign title = t_title[ti]
        assign subtitle = t_subtitle[ti] | strip
        assign compare = variant.compare_at_price | default: variant.price
        assign savings = compare | minus: variant.price
      -%}
      {%- if variant != blank -%}
      <div
        class="gt{% if forloop.index == preselected %} is-active{% endif %}"
        data-variant-id="{{ variant.id }}"
        data-bottles="{{ bottles }}"
        data-price="{{ variant.price }}"
        data-compare="{{ compare }}"
        data-name="{{ title | escape }}"
      >
        <input type="radio" class="gt__radio" name="glow-tier" value="{{ variant.id }}"
          aria-label="{{ title | escape }} · {{ variant.price | money_without_trailing_zeros }}"
          {% if forloop.index == preselected %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
        <div class="gt__head">
          <span class="gt__dot" aria-hidden="true"></span>
          <div class="gt__name">
            <strong>{{ title }}</strong>
            <span>{{ t_meta[ti] }}</span>
          </div>
          <div class="gt__price">
            <strong>{{ variant.price | money_without_trailing_zeros }}</strong>
            {%- if savings > 0 -%}<s>{{ compare | money_without_trailing_zeros }}</s>{%- endif -%}
          </div>
        </div>
        <div class="gt__badges">
          {%- assign badges = t_badges[ti] | split: ',' -%}
          {%- for badge in badges -%}
            <span{% if forloop.first %} class="is-key"{% endif %}>{{ badge | strip }}</span>
          {%- endfor -%}
        </div>
        {%- if subtitle != '-' and subtitle != blank -%}
          <p class="gt__sub">"{{ subtitle }}"</p>
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} ---------- UPSELL CELUFIT ---------- {%- endcomment -%}
  {%- if bump_variant != blank -%}
    {%- liquid
      assign bump_cents = bump_price | times: 100
      assign bump_off = bump_variant.price | minus: bump_cents | times: 100 | divided_by: bump_variant.price | floor
    -%}
    <input type="checkbox" class="gb__input" id="glow-bump">
    <label class="gb" for="glow-bump">
      <span class="gb__box" aria-hidden="true"></span>
      <span class="gb__img">
        {%- if bump_product.featured_image -%}
          {{ bump_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: bump_product.title }}
        {%- endif -%}
      </span>
      <span class="gb__info">
        <strong>{{ bump_product.title }}</strong>
        <span class="gb__line">{{ bump_line }}</span>
        <span class="gb__prices">
          <s>{{ bump_variant.price | money_without_trailing_zeros }}</s>
          <b data-bump-now>{{ bump_cents | money_without_trailing_zeros }}</b>
          <em data-bump-pill data-off="-{{ bump_off }}%">-{{ bump_off }}%</em>
        </span>
      </span>
    </label>
  {%- endif -%}

  {%- comment -%} ---------- REGALOS ---------- {%- endcomment -%}
  <div class="gg__title"><span></span><p data-gifts-title></p><span></span></div>
  <div class="gg" style="--cols: {{ g_title.size }}">
    {%- for gt in g_title -%}
      {%- liquid
        assign gi = forloop.index0
        assign gval = g_value[gi] | strip
        assign gh = g_handle[gi] | strip
        assign gp = nil
        if gh != '-' and gh != blank
          assign gp = all_products[gh]
        endif
      -%}
      <div class="gg__tile" data-min="{{ g_min[gi] | plus: 0 }}"{% if gp != blank %} data-variant-id="{{ gp.selected_or_first_available_variant.id }}"{% endif %}>
        <span class="gg__check" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 8.4l2.6 2.6L12 5.6"/></svg></span>
        <span class="gg__media">
          {%- liquid
            assign gimg = g_image[gi] | strip
            assign has_img = false
            if gimg != '-' and gimg != ''
              assign has_img = true
              if gimg contains '?'
                assign gimg = gimg | append: '&width=300'
              else
                assign gimg = gimg | append: '?width=300'
              endif
            endif
            assign gicon = g_icon[gi] | strip
          -%}
          {%- if has_img -%}
            <img src="{{ gimg }}" alt="{{ gt | escape }}" loading="lazy" width="150" height="150">
          {%- elsif gp != blank and gp.featured_image -%}
            {{ gp.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: gt }}
          {%- else -%}
            <svg class="gg__icon" viewBox="0 0 24 24" aria-hidden="true">
              {%- case gicon -%}
                {%- when 'truck' -%}<path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
                {%- when 'book' -%}<path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5z"/><path d="M12 6.5v13"/>
                {%- when 'leaf' -%}<path d="M5 19C5 10.5 10.5 5 19.5 4.5 19.5 13.5 14 19 5 19z"/><path d="M5 19l8.5-8.5"/>
                {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>
                {%- else -%}<path d="M3.5 9.5h17v4h-17z"/><path d="M5 13.5v7h14v-7"/><path d="M12 9.5v11"/><path d="M12 9.5C10 9.5 7.5 8.5 8 6.5s3.5-.5 4 3c.5-3.5 3.5-5 4-3s-2 3-4 3z"/>
              {%- endcase -%}
            </svg>
          {%- endif -%}
          <span class="gg__lock" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg></span>
        </span>
        <span class="gg__txt">
          <span class="gg__name">{{ gt }}</span>
          <span class="gg__meta">
            <span class="gg__tag">{{ g_tag[gi] }}</span>
            <span class="gg__locked">Con {{ g_min[gi] | plus: 0 }} frascos</span>
            {%- if gval != '-' and gval != blank -%}<s class="gg__val">{{ gval }}</s>{%- endif -%}
          </span>
        </span>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} ---------- TOTAL Y BOTÓN ---------- {%- endcomment -%}
  <div class="glow__total">
    <span>Total</span>
    <strong data-glow-total></strong>
    <s data-glow-compare></s>
    <em data-glow-savings></em>
  </div>

  <button type="button" class="glow__cta" data-glow-cta>
    <span class="glow__cta-idle">
      <span class="glow__cta-main">{{ cta_label }}</span>
      {%- if cta_sub != blank -%}<span class="glow__cta-sub">{{ cta_sub }}</span>{%- endif -%}
    </span>
    <span class="glow__cta-busy" aria-hidden="true"><span class="glow__spin"></span><span data-glow-busy-text>Agregando…</span></span>
  </button>
  <p class="glow__error" data-glow-error hidden></p>
</div>

<style>
  #glow-offer { color: var(--g-ink); font-size: 16px; line-height: 1.35; margin: 10px 0 18px; }
  #glow-offer * { box-sizing: border-box; }
  #glow-offer s { opacity: .55; font-weight: 400; }
  #glow-offer p { margin: 0; }

  .glow__heading { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .glow__heading span { flex: 1; height: 1px; background: currentColor; opacity: .18; }
  .glow__heading p { font-size: 14px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }

  /* Packs */
  .glow__tiers { display: grid; gap: 10px; }
  .gt { position: relative; padding: 14px; border: 2px solid #EADFD6; border-radius: 8px; background: #fff; cursor: pointer; transition: border-color .15s, background .15s, box-shadow .15s; }
  .gt:hover { border-color: var(--g-accent); }
  .gt.is-active { border-color: var(--g-accent); background: var(--g-soft); box-shadow: 0 6px 18px -10px rgba(154,79,28,.45); }
  .gt__radio { position: absolute; opacity: 0; pointer-events: none; }
  .gt__radio:focus-visible + .gt__head .gt__dot { outline: 2px solid var(--g-ink); outline-offset: 2px; }
  .gt__head { display: grid; grid-template-columns: 22px 1fr auto; gap: 12px; align-items: center; }
  .gt__dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #CBBFB5; background: #fff; display: grid; place-items: center; }
  .is-active .gt__dot { border-color: var(--g-ink); }
  .is-active .gt__dot::after { content: ""; width: 11px; height: 11px; border-radius: 50%; background: var(--g-ink); }
  .gt__name strong { display: block; font-size: 17px; line-height: 1.2; }
  .gt__name span { display: block; margin-top: 2px; font-size: 14px; opacity: .75; }
  .gt__price { text-align: right; white-space: nowrap; }
  .gt__price strong { display: block; font-size: 20px; line-height: 1.15; }
  .gt__price s { font-size: 14px; }
  .gt__badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0 34px; }
  .gt__badges span { padding: 4px 10px; border-radius: 6px; background: #F4EDE7; font-size: 13px; font-weight: 600; }
  .gt__badges span.is-key { background: var(--g-accent); color: var(--g-ink); font-weight: 700; }
  .gt__sub { display: none; margin: 10px 0 0 34px !important; font-size: 15px; font-style: italic; }
  .gt.is-active .gt__sub { display: block; }

  /* Upsell */
  .gb__input { position: absolute; opacity: 0; pointer-events: none; }
  .gb { display: grid; grid-template-columns: 24px 64px 1fr; gap: 14px; align-items: center; margin-top: 14px; padding: 12px 14px; border: 2px solid #EADFD6; border-radius: 8px; background: #fff; cursor: pointer; transition: border-color .15s, background .15s; }
  .gb:hover { border-color: var(--g-accent); }
  .gb__input:checked + .gb { border-color: var(--g-accent); background: var(--g-soft); }
  .gb__input:focus-visible + .gb { outline: 2px solid var(--g-ink); outline-offset: 2px; }
  .gb__box { width: 24px; height: 24px; border-radius: 5px; border: 2px solid #9C8F86; background: #fff; display: grid; place-items: center; }
  .gb__input:checked + .gb .gb__box { background: var(--g-ink); border-color: var(--g-ink); }
  .gb__input:checked + .gb .gb__box::after { content: ""; width: 6px; height: 11px; margin-top: -2px; border: solid #fff; border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
  .gb__img { width: 64px; height: 64px; border-radius: 6px; overflow: hidden; background: var(--g-soft); }
  .gb__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gb__info { display: grid; gap: 2px; min-width: 0; }
  .gb__info strong { font-size: 17px; line-height: 1.2; }
  .gb__line { font-size: 13.5px; opacity: .75; }
  .gb__prices { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .gb__prices s { font-size: 15px; }
  .gb__prices b { font-size: 19px; color: var(--g-text); }
  .gb__prices em { padding: 2px 7px; border-radius: 4px; background: #C62828; color: #fff; font-style: normal; font-size: 13px; font-weight: 700; }
  .gb__prices em.is-free { background: #1E7B3A; }

  /* Regalos */
  .gg__title { display: flex; align-items: center; gap: 12px; margin: 20px 0 12px; }
  .gg__title span { flex: 1; height: 1px; background: currentColor; opacity: .18; }
  .gg__title p { font-size: 14px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; text-align: center; }
  .gg { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 8px; }
  .gg__tile { position: relative; display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 10px 6px 9px; border: 2px solid var(--g-line); border-radius: 8px; background: var(--g-soft); text-align: center; transition: opacity .2s, border-color .2s, background .2s; }
  .gg__check { z-index: 2; position: absolute; top: 5px; right: 5px; width: 20px; height: 20px; border-radius: 5px; background: #34A853; display: flex; align-items: center; justify-content: center; }
  .gg__check svg { display: block; width: 14px; height: 14px; fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .gg__media { position: relative; flex: none; width: 100%; aspect-ratio: 1; max-width: 64px; border-radius: 6px; overflow: hidden; background: #fff; border: 1px solid #F1E6DC; display: grid; place-items: center; }
  .gg__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gg__icon { width: 55%; height: 55%; fill: none; stroke: var(--g-text); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .gg__lock { position: absolute; inset: 0; display: none; place-items: center; background: #FBF9F7; }
  .gg__lock svg { width: 42%; height: 42%; fill: none; stroke: #9C8F86; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .gg__txt { display: flex; flex-direction: column; align-items: center; gap: 5px; width: 100%; min-width: 0; }
  #glow-offer .gg__name { font-size: 13px; font-weight: 700; line-height: 1.25; letter-spacing: 0; text-transform: none; overflow-wrap: break-word; hyphens: auto; }
  .gg__meta { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  #glow-offer .gg__tag { letter-spacing: .03em; }
  .gg__tag { padding: 2px 8px; border-radius: 4px; background: #E6F4EA; color: #1E7B3A; font-size: 12px; font-weight: 800; letter-spacing: .04em; }
  .gg__locked { display: none; font-size: 11.5px; font-weight: 700; letter-spacing: .03em; text-transform: uppercase; color: #9C8F86; }
  .gg__val { font-size: 12.5px; }
  .gg__tile.is-locked { border-color: #EFE8E2; background: #FBF9F7; cursor: pointer; }
  .gg__tile.is-locked .gg__check, .gg__tile.is-locked .gg__tag { display: none; }
  .gg__tile.is-locked .gg__lock { display: grid; }
  .gg__tile.is-locked .gg__locked { display: block; }
  .gg__tile.is-locked .gg__name, .gg__tile.is-locked .gg__val { opacity: .45; }

  /* Total y botón */
  .glow__total { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; margin: 18px 2px 10px; }
  .glow__total span { font-size: 15px; opacity: .75; }
  .glow__total strong { font-size: 24px; }
  .glow__total s { font-size: 16px; }
  .glow__total em { margin-left: auto; font-style: normal; font-size: 15px; font-weight: 700; color: var(--g-text); }
  .glow__cta { position: relative; width: 100%; min-height: 60px; padding: 10px 16px; border: 0; border-radius: 8px; background: var(--g-ink); color: #fff; cursor: pointer; display: grid; place-items: center; box-shadow: 0 10px 22px -12px rgba(59,31,20,.8); transition: transform .15s, background .2s; }
  .glow__cta:hover { transform: translateY(-1px); background: #2A150D; }
  .glow__cta-idle, .glow__cta-busy { grid-area: 1 / 1; display: flex; flex-direction: column; align-items: center; gap: 2px; transition: opacity .2s; }
  .glow__cta-main { font-size: 18px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .glow__cta-sub { font-size: 13.5px; font-weight: 500; color: var(--g-accent); }
  .glow__cta-busy { flex-direction: row; gap: 10px; opacity: 0; font-size: 16px; font-weight: 700; }
  .glow__cta.is-loading, .glow__cta.is-done { pointer-events: none; }
  .glow__cta.is-loading .glow__cta-idle, .glow__cta.is-done .glow__cta-idle { opacity: 0; }
  .glow__cta.is-loading .glow__cta-busy, .glow__cta.is-done .glow__cta-busy { opacity: 1; }
  .glow__cta.is-done .glow__spin { display: none; }
  .glow__spin { width: 20px; height: 20px; border-radius: 50%; border: 3px solid rgba(255,255,255,.3); border-top-color: var(--g-accent); animation: glow-spin .7s linear infinite; }
  @keyframes glow-spin { to { transform: rotate(360deg); } }
  .glow__error { margin-top: 8px !important; color: #b42318; font-size: 14px; text-align: center; }

  @media (max-width: 520px) {
    .gg { grid-template-columns: 1fr 1fr; }
    .gg__tile { flex-direction: row; align-items: center; gap: 9px; padding: 8px 10px 8px 8px; text-align: left; }
    .gg__media { width: 46px; max-width: 46px; }
    .gg__txt, .gg__meta { align-items: flex-start; }
    .gg__meta { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 3px 6px; }
    #glow-offer .gg__name { font-size: 13.5px; }
    .gg__check { top: 4px; left: 4px; right: auto; width: 18px; height: 18px; }
    .gg__check svg { width: 12px; height: 12px; }
    .gg__locked { font-size: 11px; }
  }
  @media (max-width: 420px) {
    .gt { padding: 13px 12px; }
    .gt__badges, .gt__sub { margin-left: 0 !important; }
    .gg { gap: 6px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('glow-offer');
    if (!root) return;
    var tiers = Array.prototype.slice.call(root.querySelectorAll('.gt'));
    if (!tiers.length) return;
    var tiles = Array.prototype.slice.call(root.querySelectorAll('.gg__tile'));
    var giftsTitle = root.querySelector('[data-gifts-title]');
    var bumpBox = root.querySelector('.gb__input');
    var bumpNow = root.querySelector('[data-bump-now]');
    var bumpPill = root.querySelector('[data-bump-pill]');
    var bumpId = Number(root.dataset.bumpId) || null;
    var bumpFreeMin = Number(root.dataset.bumpFreeMin);
    var bumpPrice = Number(root.dataset.bumpPrice);
    var bumpCompare = Number(root.dataset.bumpCompare);
    var cta = root.querySelector('[data-glow-cta]');
    var errorEl = root.querySelector('[data-glow-error]');
    var wasFree = false;

    function money(cents) { return '$' + Math.round(cents / 100).toLocaleString('es-AR'); }
    function active() { return root.querySelector('.gt.is-active') || tiers[0]; }
    function bottlesOf(tier) { return Number(tier.dataset.bottles); }
    function bumpOn() { return !!(bumpBox && bumpBox.checked && bumpId); }

    function render() {
      var tier = active();
      var bottles = bottlesOf(tier);
      var free = bottles >= bumpFreeMin;

      if (bumpBox) {
        if (free && !wasFree) bumpBox.checked = true;
        wasFree = free;
        bumpNow.textContent = free ? 'GRATIS' : money(bumpPrice);
        bumpPill.textContent = free ? '-100%' : bumpPill.dataset.off;
        bumpPill.classList.toggle('is-free', free);
      }

      var nextMin = null;
      tiles.forEach(function (tile) {
        var min = Number(tile.dataset.min);
        var locked = bottles < min;
        tile.classList.toggle('is-locked', locked);
        if (locked && (nextMin === null || min < nextMin)) nextMin = min;
      });
      giftsTitle.textContent = nextMin === null
        ? 'Regalos incluidos'
        : 'Desbloqueá con ' + nextMin + ' frascos o más';

      var price = Number(tier.dataset.price);
      var compare = Number(tier.dataset.compare);
      if (bumpOn()) {
        price += free ? 0 : bumpPrice;
        compare += bumpCompare;
      }
      root.querySelector('[data-glow-total]').textContent = money(price);
      root.querySelector('[data-glow-compare]').textContent = compare > price ? money(compare) : '';
      root.querySelector('[data-glow-savings]').textContent = compare > price ? 'Ahorrás ' + money(compare - price) : '';
    }

    function select(tier) {
      tiers.forEach(function (t) {
        var on = t === tier;
        t.classList.toggle('is-active', on);
        t.querySelector('.gt__radio').checked = on;
      });
      render();
    }

    tiers.forEach(function (tier) {
      var radio = tier.querySelector('.gt__radio');
      radio.addEventListener('change', function () { select(tier); });
      tier.addEventListener('click', function () {
        if (!radio.disabled && !tier.classList.contains('is-active')) select(tier);
      });
    });
    if (bumpBox) bumpBox.addEventListener('change', render);

    // Tocar un regalo bloqueado elige el pack más chico que lo desbloquea
    tiles.forEach(function (tile) {
      tile.addEventListener('click', function () {
        if (!tile.classList.contains('is-locked')) return;
        var min = Number(tile.dataset.min);
        var target = tiers
          .filter(function (t) { return bottlesOf(t) >= min && !t.querySelector('.gt__radio').disabled; })
          .sort(function (a, b) { return bottlesOf(a) - bottlesOf(b); })[0];
        if (target) select(target);
      });
    });

    cta.addEventListener('click', function () {
      var tier = active();
      var bottles = bottlesOf(tier);
      var offer = tier.dataset.name;
      var items = [{ id: Number(tier.dataset.variantId), quantity: 1, properties: { _oferta: offer } }];
      if (bumpOn()) items.push({ id: bumpId, quantity: 1, properties: { _oferta: offer + ' · upsell' } });
      tiles.forEach(function (tile) {
        var id = Number(tile.dataset.variantId);
        if (id && bottles >= Number(tile.dataset.min)) items.push({ id: id, quantity: 1, properties: { _regalo: offer } });
      });

      var busyText = cta.querySelector('[data-glow-busy-text]');
      busyText.textContent = 'Agregando…';
      cta.classList.add('is-loading');
      cta.setAttribute('aria-busy', 'true');
      errorEl.hidden = true;
      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) { return res.json().then(function (d) { if (!res.ok) throw d; return d; }); })
        .then(function () {
          cta.classList.remove('is-loading');
          cta.classList.add('is-done');
          busyText.textContent = '✓ ¡Agregado!';
          return new Promise(function (r) { setTimeout(r, 450); });
        })
        .then(function () {
          window.location.href = root.dataset.redirect === 'checkout' ? '/checkout' : '{{ routes.cart_url }}';
        })
        .catch(function (err) {
          cta.classList.remove('is-loading');
          cta.removeAttribute('aria-busy');
          errorEl.textContent = (err && (err.description || err.message)) || 'No pudimos agregar el pack. Probá de nuevo.';
          errorEl.hidden = false;
        });
    });

    select(active());
  })();
</script>
{%- endif -%}
