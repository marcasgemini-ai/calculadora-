{%- comment -%}
  OFERTA GLOW · bloque "Liquid personalizado". Pegá TODO este archivo.
  Solo se edita la parte CONFIGURACIÓN.

  IMPORTANTE: el producto necesita las variantes (opción "Pack"), en este orden:
    1 = 1 frasco ($53.990) · 2 = 2 frascos ($75.800) · 3 = 3 frascos ($93.300) · 4 = 6 frascos ($113.700)
  El precio que se muestra y el que se cobra sale de cada variante.

  - Handle = lo que va después de /products/ en la URL del producto.
  - Packs: separados por |, en el orden en que se muestran. Guion (-) = vacío.
  - Badges: separados por coma. El primero va destacado.
  - Regalos: "min" = desde cuántos frascos se desbloquea.
{%- endcomment -%}

{%- liquid
  assign bump_handle = 'celufit'
  assign gift_1_handle = 'guia-rutina-glow'
  assign gift_2_handle = 'guia-alimentacion-para-un-tono-dorado'

  assign heading = 'Elegí tu protocolo'
  assign cta_label = 'Quiero mi tono dorado'
  assign redirect = 'cart'

  assign t_pos      = '4|3|2|1' | split: '|'
  assign t_bottles  = '6|3|2|1' | split: '|'
  assign t_title    = 'Glow 12 meses|Protocolo Verano Completo|Protocolo 120 días|Protocolo 60 días' | split: '|'
  assign t_meta     = '6 frascos|3 frascos · 180 días|2 frascos|1 frasco' | split: '|'
  assign t_badges   = 'Pagás 3 llevás 6, Mejor precio, Envío gratis|Más comprado, Recomendado, Pagás 2 llevás 3|60% OFF segunda unidad, Envío gratis, 3 cuotas sin interés|Envío gratis, 3 cuotas sin interés' | split: '|'
  assign t_subtitle = 'Un año entero con tu tono dorado: llegás al verano y lo mantenés todo el año.|Empezás ahora y llegás con el tono desde octubre hasta el último día de marzo.|-|-' | split: '|'
  assign preselected = 2

  assign bump_price = 23990
  assign bump_free_min = 6
  assign bump_text = 'Tenés 50% OFF en CELUFIT para lucir tus piernas este verano'
  assign bump_text_free = 'CELUFIT para lucir tus piernas este verano'

  assign g_title = 'Guía "Rutina Glow"|Guía "Alimentación para un tono dorado"|Viaje al Caribe para Enero' | split: '|'
  assign g_value = '$25.000|$20.000|-' | split: '|'
  assign g_tag   = 'GRATIS|GRATIS|SORTEO' | split: '|'
  assign g_min   = '2|3|3' | split: '|'

  assign c_accent = '#E07A5F'
  assign c_soft = '#FDF1EC'
  assign c_ink = '#3B1F14'

  assign bump_product = all_products[bump_handle]
  assign bump_variant = bump_product.selected_or_first_available_variant
  assign gift_1_product = all_products[gift_1_handle]
  assign gift_2_product = all_products[gift_2_handle]
  assign gift_count = g_title.size
  assign first_gift_min = g_min[0] | plus: 0
  assign max_pos = 0
  for t in t_pos
    assign p = t | plus: 0
    if p > max_pos
      assign max_pos = p
    endif
  endfor
-%}

{%- if request.design_mode -%}
  {%- if product.variants.size < max_pos -%}
    <p style="margin:0 0 8px;padding:8px 10px;border-radius:8px;background:#fff4e5;color:#8a4b00;font-size:12.5px;">⚠️ Solo el editor ve esto: el producto tiene {{ product.variants.size }} variante(s) y la oferta necesita {{ max_pos }} (1, 2, 3 y 6 frascos). La oferta no se muestra hasta que las crees (dejá Kaching visible mientras tanto).</p>
  {%- endif -%}
  {%- if bump_variant == blank -%}
    <p style="margin:0 0 8px;padding:8px 10px;border-radius:8px;background:#fff4e5;color:#8a4b00;font-size:12.5px;">⚠️ Solo el editor ve esto: no se encontró el producto con handle "{{ bump_handle }}" (CELUFIT). Corregí bump_handle.</p>
  {%- endif -%}
  {%- if gift_1_product == blank or gift_2_product == blank -%}
    <p style="margin:0 0 8px;padding:8px 10px;border-radius:8px;background:#fff4e5;color:#8a4b00;font-size:12.5px;">⚠️ Solo el editor ve esto: no se encontró alguna guía ("{{ gift_1_handle }}" / "{{ gift_2_handle }}"). Se muestran, pero no se agregan al carrito.</p>
  {%- endif -%}
{%- endif -%}

{%- if product.variants.size >= max_pos -%}
<div
  id="glow-offer"
  class="glow"
  data-redirect="{{ redirect }}"
  data-bump-id="{{ bump_variant.id }}"
  data-bump-free-min="{{ bump_free_min }}"
  data-bump-price="{{ bump_price | times: 100 }}"
  data-bump-compare="{{ bump_variant.price }}"
  style="--g-accent: {{ c_accent }}; --g-soft: {{ c_soft }}; --g-ink: {{ c_ink }};"
>
  <div class="glow__heading"><span></span><p>{{ heading }}</p><span></span></div>

  <div class="glow__tiers" role="radiogroup" aria-label="{{ heading | escape }}">
    {%- for t in t_pos -%}
      {%- liquid
        assign ti = forloop.index0
        assign v_index = t | plus: 0 | minus: 1
        assign variant = product.variants[v_index]
        assign bottles = t_bottles[ti] | plus: 0
        assign title = t_title[ti]
        assign subtitle = t_subtitle[ti] | strip
        assign is_active = false
        if forloop.index == preselected
          assign is_active = true
        endif
      -%}
      {%- if variant != blank -%}
      {%- liquid
        assign compare = variant.compare_at_price | default: variant.price
        assign savings = compare | minus: variant.price
        assign unlocked = 0
        for m in g_min
          assign mm = m | plus: 0
          if bottles >= mm
            assign unlocked = unlocked | plus: 1
          endif
        endfor
        assign bump_free = false
        if bottles >= bump_free_min
          assign bump_free = true
        endif
      -%}
      <div
        class="gt{% if is_active %} is-active{% endif %}"
        data-variant-id="{{ variant.id }}"
        data-bottles="{{ bottles }}"
        data-price="{{ variant.price }}"
        data-compare="{{ compare }}"
        data-name="{{ title | escape }}"
      >
        <input type="radio" class="gt__radio" name="glow-tier" value="{{ variant.id }}"
          aria-label="{{ title | escape }} · {{ variant.price | money_without_trailing_zeros }}"
          {% if is_active %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>

        <div class="gt__head">
          <span class="gt__dot" aria-hidden="true"></span>
          <div class="gt__name">
            <strong>{{ title }}</strong>
            <span>{{ t_meta[ti] }}</span>
          </div>
          <div class="gt__price">
            <strong>{{ variant.price | money_without_trailing_zeros }}</strong>
            {%- if savings > 0 -%}<s>{{ compare | money_without_trailing_zeros }}</s>{%- endif -%}
          </div>
        </div>

        <div class="gt__badges">
          {%- assign badges = t_badges[ti] | split: ',' -%}
          {%- for badge in badges -%}
            <span{% if forloop.first %} class="is-key"{% endif %}>{{ badge | strip }}</span>
          {%- endfor -%}
        </div>

        <div class="gt__body">
          {%- if subtitle != '-' and subtitle != blank -%}
            <p class="gt__sub">"{{ subtitle }}"</p>
          {%- endif -%}

          {%- if bump_variant != blank -%}
            <input type="checkbox" class="gb__input" id="glow-bump-{{ ti }}" {% if bump_free %}checked{% endif %}>
            <label class="gb" for="glow-bump-{{ ti }}">
              <span class="gb__box" aria-hidden="true"></span>
              <span class="gb__text">{% if bump_free %}{{ bump_text_free }}{% else %}{{ bump_text }}{% endif %}</span>
              <span class="gb__price">
                <strong>{% if bump_free %}GRATIS{% else %}{{ bump_price | times: 100 | money_without_trailing_zeros }}{% endif %}</strong>
                <s>{{ bump_variant.price | money_without_trailing_zeros }}</s>
              </span>
            </label>
          {%- endif -%}

          <div class="gg">
            <p class="gg__title">
              {%- if unlocked > 0 -%}🎁 {{ unlocked }}/{{ gift_count }} regalos incluidos{%- else -%}🎁 Regalos desde {{ first_gift_min }} frascos{%- endif -%}
            </p>
            <ul>
              {%- for gt in g_title -%}
                {%- assign gi = forloop.index0 -%}
                {%- assign gmin = g_min[gi] | plus: 0 -%}
                {%- assign gval = g_value[gi] | strip -%}
                {%- if bottles >= gmin -%}
                  <li><span>✓ {{ gt }}</span><span class="gg__v"><b>{{ g_tag[gi] }}</b>{% if gval != '-' and gval != blank %} <s>{{ gval }}</s>{% endif %}</span></li>
                {%- else -%}
                  <li class="is-locked"><span>🔒 con {{ gmin }} frascos</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="glow__total">
    <span>Total</span>
    <strong data-glow-total></strong>
    <s data-glow-compare></s>
    <em data-glow-savings></em>
  </div>

  <button type="button" class="glow__cta" data-glow-cta>{{ cta_label }}</button>
  <p class="glow__error" data-glow-error hidden></p>

  <script type="application/json" data-glow-gifts>
    [
      { "min": {{ g_min[0] | plus: 0 }}, "variantId": {% if gift_1_product != blank %}{{ gift_1_product.selected_or_first_available_variant.id }}{% else %}null{% endif %} },
      { "min": {{ g_min[1] | plus: 0 }}, "variantId": {% if gift_2_product != blank %}{{ gift_2_product.selected_or_first_available_variant.id }}{% else %}null{% endif %} }
    ]
  </script>
</div>

<style>
  #glow-offer { color: var(--g-ink); font-size: 14px; line-height: 1.3; margin: 8px 0 16px; }
  #glow-offer * { box-sizing: border-box; }
  #glow-offer s { opacity: .5; font-weight: 400; }
  #glow-offer p { margin: 0; }

  .glow__heading { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .glow__heading span { flex: 1; height: 1px; background: currentColor; opacity: .15; }
  .glow__heading p { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .glow__tiers { display: grid; gap: 8px; }

  .gt { position: relative; padding: 10px 12px; border: 1.5px solid rgba(0,0,0,.12); border-radius: 12px; background: #fff; cursor: pointer; transition: border-color .15s, background .15s; }
  .gt:hover { border-color: var(--g-accent); }
  .gt.is-active { border-color: var(--g-accent); background: var(--g-soft); }
  .gt__radio { position: absolute; opacity: 0; pointer-events: none; }
  .gt__radio:focus-visible + .gt__head .gt__dot { outline: 2px solid var(--g-accent); outline-offset: 2px; }

  .gt__head { display: grid; grid-template-columns: 18px 1fr auto; gap: 10px; align-items: center; }
  .gt__dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(0,0,0,.25); display: grid; place-items: center; }
  .is-active .gt__dot { border-color: var(--g-accent); }
  .is-active .gt__dot::after { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--g-accent); }
  .gt__name strong { display: block; font-size: 14.5px; }
  .gt__name span { font-size: 12px; opacity: .65; }
  .gt__price { text-align: right; white-space: nowrap; }
  .gt__price strong { display: block; font-size: 16px; }
  .gt__price s { font-size: 12px; }

  .gt__badges { display: flex; flex-wrap: wrap; gap: 4px; margin: 6px 0 0 28px; }
  .gt__badges span { padding: 2px 7px; border-radius: 999px; background: rgba(0,0,0,.05); font-size: 10.5px; font-weight: 600; }
  .gt__badges span.is-key { background: var(--g-accent); color: #fff; }

  .gt__body { display: none; margin: 8px 0 0 28px; }
  .gt.is-active .gt__body { display: grid; gap: 8px; }
  .gt__sub { font-size: 12.5px; font-style: italic; opacity: .85; }

  .gb__input { position: absolute; opacity: 0; pointer-events: none; }
  .gb { display: grid; grid-template-columns: 16px 1fr auto; gap: 8px; align-items: center; padding: 7px 9px; border: 1.5px dashed var(--g-accent); border-radius: 8px; background: #fff; cursor: pointer; }
  .gb__box { width: 16px; height: 16px; border-radius: 4px; border: 2px solid var(--g-accent); display: grid; place-items: center; }
  .gb__input:checked + .gb .gb__box { background: var(--g-accent); }
  .gb__input:checked + .gb .gb__box::after { content: "✓"; color: #fff; font-size: 10px; font-weight: 700; }
  .gb__input:focus-visible + .gb { outline: 2px solid var(--g-accent); outline-offset: 2px; }
  .gb__text { font-size: 12px; font-weight: 600; }
  .gb__price { text-align: right; font-size: 12px; white-space: nowrap; }
  .gb__price strong { display: block; color: var(--g-accent); }

  .gg { padding: 7px 9px; border-radius: 8px; background: rgba(255,255,255,.75); }
  .gg__title { font-size: 12px; font-weight: 700; margin-bottom: 3px !important; }
  .gg ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .gg li { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; }
  .gg li.is-locked { opacity: .45; }
  .gg__v { white-space: nowrap; }
  .gg__v b { color: var(--g-accent); font-size: 11px; }

  .glow__total { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 8px; margin: 12px 2px 8px; }
  .glow__total span { font-size: 13px; opacity: .7; }
  .glow__total strong { font-size: 20px; }
  .glow__total em { margin-left: auto; font-style: normal; font-size: 12.5px; font-weight: 700; color: var(--g-accent); }

  .glow__cta { width: 100%; min-height: 52px; border: 0; border-radius: 999px; background: var(--g-ink); color: #fff; font-size: 15px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; cursor: pointer; }
  .glow__cta[aria-busy="true"] { opacity: .6; pointer-events: none; }
  .glow__error { margin-top: 6px !important; color: #b42318; font-size: 12.5px; text-align: center; }
</style>

<script>
  (function () {
    var root = document.getElementById('glow-offer');
    if (!root) return;
    var tiers = Array.prototype.slice.call(root.querySelectorAll('.gt'));
    if (!tiers.length) return;
    var gifts = JSON.parse(root.querySelector('[data-glow-gifts]').textContent);
    var bumpId = Number(root.dataset.bumpId) || null;
    var bumpFreeMin = Number(root.dataset.bumpFreeMin);
    var bumpPrice = Number(root.dataset.bumpPrice);
    var bumpCompare = Number(root.dataset.bumpCompare);
    var cta = root.querySelector('[data-glow-cta]');
    var errorEl = root.querySelector('[data-glow-error]');

    function money(cents) { return '$' + Math.round(cents / 100).toLocaleString('es-AR'); }
    function active() { return root.querySelector('.gt.is-active') || tiers[0]; }
    function bumpOn(tier) {
      var box = tier.querySelector('.gb__input');
      return !!(box && box.checked && bumpId);
    }
    function render() {
      var tier = active();
      var bottles = Number(tier.dataset.bottles);
      var price = Number(tier.dataset.price);
      var compare = Number(tier.dataset.compare);
      if (bumpOn(tier)) {
        price += bottles >= bumpFreeMin ? 0 : bumpPrice;
        compare += bumpCompare;
      }
      root.querySelector('[data-glow-total]').textContent = money(price);
      root.querySelector('[data-glow-compare]').textContent = compare > price ? money(compare) : '';
      root.querySelector('[data-glow-savings]').textContent = compare > price ? 'Ahorrás ' + money(compare - price) : '';
    }
    function select(tier) {
      tiers.forEach(function (t) {
        var on = t === tier;
        t.classList.toggle('is-active', on);
        t.querySelector('.gt__radio').checked = on;
      });
      render();
    }

    tiers.forEach(function (tier) {
      var radio = tier.querySelector('.gt__radio');
      radio.addEventListener('change', function () { select(tier); });
      tier.addEventListener('click', function () {
        if (!radio.disabled && !tier.classList.contains('is-active')) select(tier);
      });
      var box = tier.querySelector('.gb__input');
      if (box) box.addEventListener('change', render);
    });

    cta.addEventListener('click', function () {
      var tier = active();
      var bottles = Number(tier.dataset.bottles);
      var offer = tier.dataset.name;
      var items = [{ id: Number(tier.dataset.variantId), quantity: 1, properties: { _oferta: offer } }];
      if (bumpOn(tier)) items.push({ id: bumpId, quantity: 1, properties: { _oferta: offer + ' · bump' } });
      gifts.forEach(function (g) {
        if (g.variantId && bottles >= g.min) items.push({ id: g.variantId, quantity: 1, properties: { _regalo: offer } });
      });

      cta.setAttribute('aria-busy', 'true');
      errorEl.hidden = true;
      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) { return res.json().then(function (d) { if (!res.ok) throw d; return d; }); })
        .then(function () {
          window.location.href = root.dataset.redirect === 'checkout' ? '/checkout' : '{{ routes.cart_url }}';
        })
        .catch(function (err) {
          cta.removeAttribute('aria-busy');
          errorEl.textContent = (err && (err.description || err.message)) || 'No pudimos agregar el pack. Probá de nuevo.';
          errorEl.hidden = false;
        });
    });

    select(active());
  })();
</script>
{%- endif -%}
