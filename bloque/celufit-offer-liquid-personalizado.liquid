{%- comment -%}
OFERTA CELUFIT. Pegá TODO. Editá solo CONFIGURACIÓN. Guion (-) = vacío. Valores separados por |.
Variantes del producto (opción Pack) en orden: 1 frasco, 2, 3, 6.
pack_mode: 'discount' = agrega N unidades del frasco y el precio del pack lo pone un descuento automático (t_price) · 'variant' = cada pack es una variante.
proof: badges de arriba (separados por |) · trust: líneas debajo del botón (separadas por |). Vacío = no se muestra.
redirect: 'drawer' carrito lateral · 'cart' página del carrito · 'checkout'.
{%- endcomment -%}
{%- liquid
assign product_handle = 'drenaje-linfatico-y-celulitis'
assign bump_handle = 'slimfit-tratamiento-metabolico-para-mujeres-copia'
assign bump_title = 'SLIMFIT'
assign heading = 'Elegí tu tratamiento'
assign tip_title = ''
assign tip_text = ''
assign proof = '🏆 Más comprado en Mercado Libre|📸 Viral en Instagram|🔥 Viral en TikTok'
assign trust = '🥇 Top 1 en Mercado Libre|🚚 Envío gratis con seguimiento y fecha estimada'
assign cta_label = 'Agregar al carrito'
assign cta_sub = ''
assign redirect = 'drawer'
assign t_pos      = '4|3|2|1' | split: '|'
assign t_bottles  = '6|3|2|1' | split: '|'
assign t_title = 'Piernas 6 meses|Protocolo Verano Completo|Protocolo 60 días|Protocolo 30 días' | split: '|'
assign t_meta = '6 frascos · 6 meses|3 frascos · 90 días|2 frascos|1 frasco' | split: '|'
assign t_badges = 'Envío gratis, ⭐ Mejor precio, Pagás 3 llevás 6|🔥 Más comprado, Recomendado, Pagás 2 llevás 3|Envío gratis, 3 cuotas sin interés, 60% OFF 2da unidad|Envío gratis, 3 cuotas sin interés' | split: '|'
assign t_subtitle = 'Seis meses de tratamiento: llegás al verano y mantenés las piernas livianas hasta el otoño.|Empezás ahora y llegás a enero con piernas más firmes y sin pesadez.|-|-' | split: '|'
assign preselected = 2
assign pack_mode = 'discount'
assign t_price = '104900|85900|69900|49900' | split: '|'
assign bump_price = 29850
assign bump_free_min = 6
assign bump_text = 'Tenés <b>50% OFF</b> en SLIMFIT para bajar kilos este verano'
assign bump_text_free = '🎁 <b>SLIMFIT de regalo</b> para bajar kilos este verano'
assign g_title = 'Guía Protocolo Piel Firme 30+|Guía Alimentación antirretención|Viaje al Caribe para Enero' | split: '|'
assign g_value  = '$25.000|$20.000|-' | split: '|'
assign g_tag    = 'GRATIS|GRATIS|SORTEO' | split: '|'
assign g_min    = '2|3|3' | split: '|'
assign g_icon = 'book|leaf|sun' | split: '|'
assign g_handle = 'guia-protocolo-piel-firme-30|guia-alimentacion-antirretencion|-' | split: '|'
assign g_image = '-|-|-' | split: '|'
assign guarantee_title = '60 días para probarlo.'
assign guarantee_text = 'Si no sentís tus piernas más livianas, te devolvemos el dinero.'
assign c_accent = '#FEDBE9'
assign c_soft = '#FFF6FA'
assign c_text = '#CA3C74'
assign c_ink = '#601C37'
-%}
{%- comment -%} ===================== FIN CONFIGURACIÓN ===================== {%- endcomment -%}
{%- if product_handle != '' and all_products[product_handle] != blank -%}{%- assign product = all_products[product_handle] -%}{%- endif -%}
{%- liquid
assign bump_product = all_products[bump_handle]
assign bump_variant = bump_product.selected_or_first_available_variant
if bump_title == blank
assign bump_title = bump_product.title
endif
assign max_pos = 0
for t in t_pos
assign p = t | plus: 0
if p > max_pos
assign max_pos = p
endif
endfor
if pack_mode == 'discount'
assign max_pos = 1
endif
assign gift_count = g_title.size
assign first_gift_min = g_min[0] | plus: 0
assign missing_gifts = ''
for h in g_handle
assign hh = h | strip
if hh != '-' and hh != ''
assign gpx = all_products[hh]
if gpx == blank
assign missing_gifts = missing_gifts | append: ' "' | append: hh | append: '" (no existe)'
elsif gpx.selected_or_first_available_variant.available != true
assign missing_gifts = missing_gifts | append: ' "' | append: hh | append: '" (sin stock o en borrador)'
endif
endif
endfor
-%}
{%- capture gift_media -%}
{%- for gt in g_title -%}
{%- liquid
assign gi = forloop.index0
assign gh = g_handle[gi] | strip
assign has_gp_img = false
if gh != '-' and gh != ''
assign gp = all_products[gh]
if gp.featured_image
assign has_gp_img = true
endif
endif
assign gimg = g_image[gi] | strip
assign has_img = false
if gimg != '-' and gimg != ''
assign has_img = true
if gimg contains '?'
assign gimg = gimg | append: '&width=160'
else
assign gimg = gimg | append: '?width=160'
endif
endif
assign gicon = g_icon[gi] | strip
-%}
{%- if has_img -%}
<img src="{{ gimg }}" alt="" loading="lazy" width="80" height="80">
{%- elsif has_gp_img -%}
{{ gp.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
{%- else -%}
<svg class="go-icon" viewBox="0 0 24 24" aria-hidden="true">
{%- case gicon -%}
{%- when 'truck' -%}<path d="M2.5 6.5h11v9h-11z"/><path d="M13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
{%- when 'book' -%}<path d="M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5z"/><path d="M12 6.5v13"/>
{%- when 'leaf' -%}<path d="M5 19C5 10.5 10.5 5 19.5 4.5 19.5 13.5 14 19 5 19z"/><path d="M5 19l8.5-8.5"/>
{%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>
{%- else -%}<path d="M3.5 9.5h17v4h-17z"/><path d="M5 13.5v7h14v-7"/><path d="M12 9.5v11"/><path d="M12 9.5C10 9.5 7.5 8.5 8 6.5s3.5-.5 4 3c.5-3.5 3.5-5 4-3s-2 3-4 3z"/>
{%- endcase -%}
</svg>
{%- endif -%}
{%- unless forloop.last -%}@@@{%- endunless -%}
{%- endfor -%}
{%- endcapture -%}
{%- assign gift_media = gift_media | split: '@@@' -%}
{%- if request.design_mode -%}
{%- if product.variants.size < max_pos -%}
<p style="margin:0 0 8px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: el producto tiene {{ product.variants.size }} variante(s) y la oferta necesita {{ max_pos }} (1, 2, 3 y 6 frascos). La oferta no se muestra hasta que las crees (dejá Kaching visible mientras tanto).</p>
{%- endif -%}
{%- if bump_variant == blank -%}
<p style="margin:0 0 8px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: no se encontró el producto con handle "{{ bump_handle }}" ({{ bump_title }}). Corregí bump_handle.</p>
{%- endif -%}
{%- if missing_gifts != '' -%}
<p style="margin:0 0 8px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: estos regalos no se pueden agregar al carrito:{{ missing_gifts }}. Revisá que el handle sea exacto, que esté Activo, en Tienda online y sin seguimiento de stock.</p>
{%- endif -%}
{%- endif -%}
{%- if product.variants.size >= max_pos -%}
<div
id="celufit-offer"
class="go"
lang="es"
data-redirect="{{ redirect }}"
data-bump-id="{{ bump_variant.id }}"
data-bump-free-min="{{ bump_free_min }}"
style="--g-accent: {{ c_accent }}; --g-soft: {{ c_soft }}; --g-text: {{ c_text }}; --g-ink: {{ c_ink }}; --g-cta: #FC4B91;"
>
{%- if proof != '' -%}<div class="go__proof">{%- assign pr = proof | split: '|' -%}{%- for x in pr -%}<span>{{ x | strip }}</span>{%- endfor -%}</div>{%- endif -%}
<div class="go__heading"><span></span><p>{{ heading }}</p><span></span></div>
{%- if tip_title != '' -%}<div class="go__tip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg><p>{{ tip_title }}{% if tip_text != '' %}<span>{{ tip_text }}</span>{% endif %}</p></div>{%- endif -%}
<div class="go__tiers" role="radiogroup" aria-label="{{ heading | escape }}">
{%- for t in t_pos -%}
{%- liquid
assign ti = forloop.index0
assign bottles = t_bottles[ti] | plus: 0
if pack_mode == 'discount'
assign variant = product.variants[0]
assign qty = bottles
assign tier_price = t_price[ti] | plus: 0 | times: 100
assign compare = variant.price | times: bottles
else
assign v_index = t | plus: 0 | minus: 1
assign variant = product.variants[v_index]
assign qty = 1
assign tier_price = variant.price
assign compare = variant.compare_at_price | default: variant.price
endif
assign title = t_title[ti]
assign subtitle = t_subtitle[ti] | strip
assign savings = compare | minus: tier_price
assign unlocked = 0
for m in g_min
assign mm = m | plus: 0
if bottles >= mm
assign unlocked = unlocked | plus: 1
endif
endfor
assign bump_free = false
if bottles >= bump_free_min
assign bump_free = true
endif
-%}
{%- if variant != blank -%}
<div
class="gt{% if forloop.index == preselected %} is-active{% endif %}"
data-variant-id="{{ variant.id }}"
data-qty="{{ qty }}"
data-bottles="{{ bottles }}"
data-name="{{ title | escape }}"
>
<div class="gt__badges">
{%- assign badges = t_badges[ti] | split: ',' -%}
{%- for badge in badges -%}
<span{% if forloop.first %} class="is-dark"{% endif %}>{{ badge | strip }}</span>
{%- endfor -%}
</div>
<label class="gt__main">
<input type="radio" class="gt__radio" name="celufit-tier" value="{{ variant.id }}"
{% if forloop.index == preselected %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
<span class="gt__dot" aria-hidden="true"></span>
<span class="gt__name">
<strong>{{ title }}</strong>
<span class="gt__meta">{{ t_meta[ti] }}</span>
{%- if subtitle != '-' and subtitle != '' -%}<span class="gt__sub">{{ subtitle }}</span>{%- endif -%}
</span>
<span class="gt__price">
{%- if savings > 0 -%}<s>{{ compare | money_without_trailing_zeros }}</s>{%- endif -%}
<strong>{{ tier_price | money_without_trailing_zeros }}</strong>
</span>
</label>
{%- if bump_variant != blank -%}
<div class="gb" role="checkbox" tabindex="-1" aria-checked="false" data-bump-row>
<span class="gb__box" aria-hidden="true"></span>
<span class="gb__img">
{%- if bump_product.featured_image -%}
{{ bump_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: bump_title }}
{%- endif -%}
</span>
<span class="gb__text">{% if bump_free %}{{ bump_text_free }}{% else %}{{ bump_text }}{% endif %}</span>
<span class="gb__price">
<strong>{% if bump_free %}GRATIS{% else %}{{ bump_price | times: 100 | money_without_trailing_zeros }}{% endif %}</strong>
<s>{{ bump_variant.price | money_without_trailing_zeros }}</s>
</span>
</div>
{%- endif -%}
<div class="gg">
<div class="gg__sum">
<span class="gg__gift" aria-hidden="true">🎁</span>
<span class="gg__count">
{%- if unlocked > 0 -%}{{ unlocked }}/{{ gift_count }} regalos incluidos{%- else -%}Regalos desde {{ first_gift_min }} frascos{%- endif -%}
</span>
<span class="gg__thumbs">
{%- for gt in g_title -%}
{%- assign gmin = g_min[forloop.index0] | plus: 0 -%}
<span class="gg__thumb{% if bottles < gmin %} is-locked{% endif %}">{{ gift_media[forloop.index0] }}</span>
{%- endfor -%}
</span>
</div>
<ul class="gg__list">
{%- for gt in g_title -%}
{%- liquid
assign gi = forloop.index0
assign gmin = g_min[gi] | plus: 0
assign gval = g_value[gi] | strip
assign gtag = g_tag[gi] | strip
-%}
<li class="{% if bottles < gmin %}is-locked{% endif %}">
<span class="gg__thumb">{{ gift_media[gi] }}</span>
<span class="gg__name">+ {{ gt }}</span>
{%- if bottles >= gmin -%}
<span class="gg__val">
<em class="{% if gtag == 'SORTEO' %}is-dark{% endif %}">{{ gtag }}</em>
{%- if gtag != 'SORTEO' -%}<b>$0</b>{%- endif -%}
{%- if gval != '-' and gval != '' -%}<s>{{ gval }}</s>{%- endif -%}
</span>
{%- else -%}
<span class="gg__val gg__need">
<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
Con {{ gmin }} frascos
</span>
{%- endif -%}
</li>
{%- endfor -%}
</ul>
</div>
</div>
{%- endif -%}
{%- endfor -%}
</div>
<button type="button" class="go__cta" data-glow-cta>
<span class="go__cta-idle">
<span class="go__cta-main">{{ cta_label }}</span>
{%- if cta_sub != '' -%}<span class="go__cta-sub">{{ cta_sub }}</span>{%- endif -%}
</span>
<span class="go__cta-busy" aria-hidden="true"><span class="go__spin"></span><span data-glow-busy-text>Agregando…</span></span>
</button>
<p class="go__error" data-glow-error hidden></p>
{%- if guarantee_title != '' -%}
<div class="go__guarantee">
<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"/><path d="M8.5 12l2.5 2.5 4.5-4.5"/></svg>
<p><b>{{ guarantee_title }}</b> {{ guarantee_text }}</p>
</div>
{%- endif -%}
{%- if trust != '' -%}<ul class="go__trust">{%- assign tr = trust | split: '|' -%}{%- for x in tr -%}<li>{{ x | strip }}</li>{%- endfor -%}</ul>{%- endif -%}
<script type="application/json" data-glow-gifts>
[
{%- for gt in g_title -%}
{%- liquid
assign gh = g_handle[forloop.index0] | strip
assign gid = ''
if gh != '-' and gh != ''
assign gv = all_products[gh].selected_or_first_available_variant
if gv.available
assign gid = gv.id | append: ''
endif
endif
-%}
{ "min": {{ g_min[forloop.index0] | plus: 0 }}, "variantId": {% if gid != '' %}{{ gid }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
</script>
</div>
<style>

#celufit-offer{color:var(--g-ink);font-size:16px;line-height:1.35;margin:18px 0}#celufit-offer *{box-sizing:border-box}#celufit-offer s{color:#8E737D;font-weight:500}#celufit-offer p{margin:0}#celufit-offer .go-icon{width:60%;height:60%;fill:none;stroke:var(--g-text);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.go__heading{display:flex;align-items:center;gap:12px;margin-bottom:8px}.go__heading span{flex:1;height:1.5px;background:#DDB6C5}.go__heading p{font-size:14px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}.go__tip{display:flex;align-items:center;justify-content:center;gap:7px;margin:2px 0 10px;padding:6px 12px;border-radius:999px;background:var(--g-soft);border:1px solid #FED2E4}.go__tip svg{width:17px;height:17px;flex:none;fill:none;stroke:var(--g-text);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.go__tip p{font-size:13.5px;line-height:1.3;color:#724657;text-align:center}.go__tip b{color:var(--g-ink);font-weight:800}.go__tip span{display:block;font-size:12.5px}.go__tiers{display:grid;gap:22px;padding-top:10px}.gt{position:relative;border:2px solid #DDB6C5;border-radius:10px;background:#fff;cursor:pointer;transition:border-color .15s,box-shadow .15s}.gt:hover{border-color:#FC4B91}.gt.is-active{border:3px solid #FC4B91;box-shadow:0 12px 28px -12px rgba(252,75,145,.45)}.gt__badges{display:flex;flex-wrap:wrap;gap:4px;margin:-11px 0 0 12px;position:relative;z-index:1}.gt__badges span{padding:3px 10px;border-radius:999px;background:var(--g-accent);color:var(--g-ink);font-size:11.5px;font-weight:700;line-height:1.3;white-space:nowrap}.gt__badges span.is-dark{background:var(--g-ink);color:#fff}.gt__main{display:grid;grid-template-columns:22px 1fr auto;gap:12px;align-items:center;padding:12px 14px 14px;cursor:pointer;margin:0}.gt.is-active .gt__main{background:var(--g-soft)}.gt__radio{position:absolute;opacity:0;pointer-events:none}.gt__radio:focus-visible + .gt__dot{outline:2px solid var(--g-ink);outli