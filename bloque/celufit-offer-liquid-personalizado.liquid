orm:translateY(-1px);background:#D6407B}.go__cta-idle,.go__cta-busy{grid-area:1 / 1;display:flex;flex-direction:column;align-items:center;gap:2px;transition:opacity .2s}.go__cta-main{font-size:18px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.go__cta-sub{font-size:13.5px;font-weight:500;color:var(--g-accent)}.go__cta-busy{flex-direction:row;gap:10px;opacity:0;font-size:16px;font-weight:700}.go__cta.is-loading,.go__cta.is-done{pointer-events:none}.go__cta.is-loading .go__cta-idle,.go__cta.is-done .go__cta-idle{opacity:0}.go__cta.is-loading .go__cta-busy,.go__cta.is-done .go__cta-busy{opacity:1}.go__cta.is-done .go__spin{display:none}.go__spin{width:20px;height:20px;border-radius:50%;border:3px solid rgba(255,255,255,.3);border-top-color:var(--g-accent);animation:go-spin .7s linear infinite}@keyframes go-spin{to{transform:rotate(360deg)}}.go__error{margin-top:8px !important;color:#b42318;font-size:14px;text-align:center}.go__guarantee{display:flex;align-items:center;gap:12px;margin-top:12px;padding:12px 14px;border:1.5px solid var(--g-accent);border-radius:10px}.go__guarantee svg{width:34px;height:34px;flex:none;fill:none;stroke:var(--g-text);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.go__guarantee p{font-size:14px;line-height:1.4}@media (max-width:420px){.gt__main{padding:12px 12px 13px;gap:10px}.gt__badges{gap:3px;margin-left:8px}.gt__badges span{padding:2px 7px;font-size:10.5px}.gt__name strong{font-size:17px}.gb,.gt.is-active .gb{padding:9px 12px;gap:8px}.gt.is-active .gb{grid-template-columns:20px 40px 1fr auto}.gb{grid-template-columns:40px 1fr auto}.gb__img{width:40px;height:40px}.gb__text{font-size:13.5px}.gg__sum,.gg__list{padding-left:12px;padding-right:12px}.gg__name{font-size:14px}}
.go__proof{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin:0 0 14px}.go__proof span{padding:5px 11px;border-radius:999px;background:#fff;border:1px solid #E6CDD7;box-shadow:0 2px 8px rgba(0,0,0,.06);font-size:12.5px;font-weight:700;line-height:1.3;white-space:nowrap}.go__trust{list-style:none;margin:12px 0 0 !important;padding:0 !important;display:flex;flex-wrap:wrap;justify-content:center;gap:4px 16px}.go__trust li{margin:0;padding:0;font-size:13px;font-weight:600;color:#724657}.go__trust li::before,.go__trust li::marker{content:none}@media (max-width:420px){.go__proof span{font-size:11.5px;padding:4px 9px}}
</style>
<script>
(function () {
var root = document.getElementById('celufit-offer');
if (!root) return;
var tiers = Array.prototype.slice.call(root.querySelectorAll('.gt'));
if (!tiers.length) return;
var gifts = JSON.parse(root.querySelector('[data-glow-gifts]').textContent);
var bumpId = Number(root.dataset.bumpId) || null;
var bumpFreeMin = Number(root.dataset.bumpFreeMin);
var cta = root.querySelector('[data-glow-cta]');
var errorEl = root.querySelector('[data-glow-error]');
var bumpOn = false;
var wasFree = false;
function active() { return root.querySelector('.gt.is-active') || tiers[0]; }
function bottlesOf(tier) { return Number(tier.dataset.bottles); }
function render() {
var tier = active();
var free = bottlesOf(tier) >= bumpFreeMin;
if (free && !wasFree) bumpOn = true;
wasFree = free;
root.classList.toggle('bump-on', bumpOn && !!bumpId);
tiers.forEach(function (t) {
var row = t.querySelector('[data-bump-row]');
if (!row) return;
var on = t === tier;
row.setAttribute('tabindex', on ? '0' : '-1');
row.setAttribute('aria-checked', on && bumpOn ? 'true' : 'false');
});
}
function select(tier) {
tiers.forEach(function (t) {
var on = t === tier;
t.classList.toggle('is-active', on);
t.querySelector('.gt__radio').checked = on;
});
render();
}
tiers.forEach(function (tier) {
var radio = tier.querySelector('.gt__radio');
radio.addEventListener('change', function () { select(tier); });
tier.addEventListener('click', function (e) {
var row = e.target.closest('[data-bump-row]');
if (row && tier.classList.contains('is-active')) {
bumpOn = !bumpOn;
render();
return;
}
if (!radio.disabled && !tier.classList.contains('is-active')) select(tier);
});
var row = tier.querySelector('[data-bump-row]');
if (row) row.addEventListener('keydown', function (e) {
if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); row.click(); }
});
});
function resetCta() {
setTimeout(function () {
cta.classList.remove('is-done');
cta.removeAttribute('aria-busy');
}, 600);
}
function openThemeCart() {
['cart:refresh', 'cart:updated', 'cart:build'].forEach(function (name) {
document.dispatchEvent(new CustomEvent(name, { bubbles: true }));
});
var toggle = document.querySelector('[data-cart-drawer-toggle], [data-drawer-toggle="cart"], .js-drawer-open-cart, [aria-controls="CartDrawer"], [aria-controls="cart-drawer"]');
if (toggle) { toggle.click(); return true; }
return false;
}
cta.addEventListener('click', function () {
var tier = active();
var bottles = bottlesOf(tier);
var offer = tier.dataset.name;
var items = [{ id: Number(tier.dataset.variantId), quantity: Number(tier.dataset.qty) || 1, properties: { _oferta: offer } }];
if (bumpOn && bumpId) items.push({ id: bumpId, quantity: 1, properties: { _oferta: offer + ' · upsell' } });
var giftItems = [];
gifts.forEach(function (g) {
if (g.variantId && bottles >= g.min) giftItems.push({ id: g.variantId, quantity: 1, properties: { _regalo: offer } });
});
var busyText = cta.querySelector('[data-glow-busy-text]');
busyText.textContent = 'Agregando…';
cta.classList.add('is-loading');
cta.setAttribute('aria-busy', 'true');
errorEl.hidden = true;
var drawer = document.querySelector('cart-drawer');
var useDrawer = root.dataset.redirect === 'drawer' && drawer && typeof drawer.renderContents === 'function';
var payload = { items: items };
if (useDrawer) {
payload.sections = ['cart-drawer', 'cart-icon-bubble'];
payload.sections_url = window.location.pathname;
}
var cartData;
var addUrl = '{{ routes.cart_add_url }}.js';
var giftReq = giftItems.length ? fetch(addUrl, {
method: 'POST',
headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
body: JSON.stringify({ items: giftItems })
}).catch(function () {}) : Promise.resolve();
giftReq.then(function () { return fetch(addUrl, {
method: 'POST',
headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
body: JSON.stringify(payload)
}); })
.then(function (res) { return res.json().then(function (d) { if (!res.ok) throw d; return d; }); })
.then(function (d) {
cartData = d;
cta.classList.remove('is-loading');
cta.classList.add('is-done');
busyText.textContent = '✓ ¡Agregado!';
return new Promise(function (r) { setTimeout(r, useDrawer ? 350 : 450); });
})
.then(function () {
var mode = root.dataset.redirect;
if (mode === 'checkout') { window.location.href = '/checkout'; return; }
if (mode === 'drawer') {
if (useDrawer && cartData && cartData.sections) {
try {
var inner = drawer.querySelector('.drawer__inner');
if (inner) inner.classList.remove('is-empty');
drawer.classList.remove('is-empty');
drawer.renderContents(cartData);
resetCta();
return;
} catch (e) { /* si el tema no responde, vamos a la página del carrito */ }
}
if (openThemeCart()) { resetCta(); return; }
}
window.location.href = '{{ routes.cart_url }}';
})
.catch(function (err) {
cta.classList.remove('is-loading');
cta.removeAttribute('aria-busy');
errorEl.textContent = (err && (err.description || err.message)) || 'No pudimos agregar el pack. Probá de nuevo.';
errorEl.hidden = false;
});
});
select(active());
})();
</script>
{%- endif -%}
