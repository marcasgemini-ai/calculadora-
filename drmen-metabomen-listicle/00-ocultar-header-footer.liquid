{%- comment -%}
  LISTICLE METABOMEN +40 · LIQUID 00 · OCULTAR HEADER Y FOOTER (solo en esta página)
  Pegalo como PRIMERA sección "Liquid personalizado" del template del listicle.
  Como va adentro de ese template, solo afecta a esta página: el resto de la tienda queda igual.
  Hecho para el theme Shrine (base Dawn): header-group (ticker + header) y footer-group.

  ocultar_en_editor = true  -> también se ocultan dentro del editor de Shopify (así ves cómo queda).
  ocultar_popup     = true  -> oculta el popup promocional, el botón "volver arriba" y el reproductor de música.
  mostrar_barra     = true  -> barra mínima arriba con el texto o el logo, sin menú ni links.
{%- endcomment -%}

{%- assign ocultar_en_editor = true -%}
{%- assign ocultar_popup = true -%}
{%- assign mostrar_barra = true -%}
{%- assign barra_texto = 'DR.MEN · Salud masculina' -%}
{%- assign logo_url = '' -%}

{%- if ocultar_en_editor or request.design_mode == false -%}
<style>
  /* Shrine / Dawn: grupo del header (ticker + barra de anuncios + header) y grupo del footer */
  body > .shopify-section-group-header-group,
  body > .shopify-section-group-footer-group,
  .shopify-section-group-header-group,
  .shopify-section-group-footer-group,
  .section-header,
  sticky-header,
  .header-wrapper,
  .announcement-bar-section,
  .footer { display: none !important; }

  {%- if ocultar_popup %}
  #shopify-section-promo-popup,
  #shopify-section-scroll-to-top-btn,
  #shopify-section-global-music-player { display: none !important; }
  {%- endif %}

  /* el body de Shrine es una grilla de 4 filas: la acomodamos para que no quede espacio vacío */
  body { grid-template-rows: auto 1fr !important; }
  #MainContent { padding-top: 0 !important; margin-top: 0 !important; }
</style>

<script>
  /* respaldo: oculta cualquier sección del header o footer que el theme agregue con otro nombre */
  (function () {
    function run() {
      var main = document.getElementById('MainContent');
      if (!main) return;
      document.querySelectorAll('body > .shopify-section').forEach(function (s) {
        var id = s.id || '';
        var keep = {% if ocultar_popup %}false{% else %}/promo-popup|scroll-to-top|music-player/.test(id){% endif %};
        if (!keep && !main.contains(s)) s.style.setProperty('display', 'none', 'important');
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  })();
</script>
{%- endif -%}

{%- if mostrar_barra -%}
  <style>
    .mlx-top { background: #0E0F11; color: #fff; text-align: center; padding: 10px 16px; font-family: var(--font-body-family, inherit); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .mlx-top img { display: inline-block; height: 26px; width: auto; vertical-align: middle; }
  </style>
  <div class="mlx-top">
    {%- if logo_url != blank -%}<img src="{{ logo_url }}" alt="DR.MEN" width="120" height="26">{%- else -%}{{ barra_texto }}{%- endif -%}
  </div>
{%- endif -%}
