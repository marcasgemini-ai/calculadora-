{%- comment -%}
  LISTICLE METABOMEN +40 · LIQUID 01 de 10 · ESTILOS + HERO
  IMPORTANTE: este bloque va PRIMERO. Tiene los estilos que usan los bloques 02 a 08 y el 10.
  (El 09 · Oferta trae sus propios estilos y funciona solo.)
  Las imágenes vacías ('') muestran un recuadro punteado con lo que hay que poner.
{%- endcomment -%}

{%- assign img_hero = '' -%}
{%- assign cta_url = '#oferta' -%}
{%- assign rating = '4,8' -%}
{%- assign cant_clientes = '+[X].000' -%}
{%- assign fecha_nota = 'Actualizado octubre 2026' -%}

<style>
  .ml, .ml-band {
    --ml-red: #E1261C;
    --ml-red-dark: #A9170F;
    --ml-black: #0E0F11;
    --ml-ink: #15171A;
    --ml-soft: #F4F5F7;
    --ml-line: #E3E6EA;
    --ml-muted: #6B7178;
    --ml-good: #2F8A5B;
  }
  .ml { max-width: 1080px; margin: 0 auto; padding: 0 16px; color: var(--ml-ink); font-family: var(--font-body-family, inherit); font-size: 16px; line-height: 1.6; letter-spacing: 0; -webkit-text-size-adjust: 100%; }
  .ml *, .ml *::before, .ml *::after { box-sizing: border-box; }
  .ml :where(p, li, span, b, strong, small, a, div, td, th, summary, em) { letter-spacing: 0; }
  .ml :where(p, li, td, th, summary) { font-size: inherit; line-height: inherit; }
  .ml h1, .ml h2, .ml h3 { font-family: var(--font-heading-family, inherit); color: inherit; letter-spacing: 0; margin: 0; overflow-wrap: break-word; }
  .ml p { margin: 0 0 14px; }
  .ml img { display: block; width: 100%; height: auto; border-radius: 12px; }

  /* bandas a todo el ancho */
  .ml-band.is-dark { background: radial-gradient(ellipse at 75% 35%, rgba(225,38,28,.30), transparent 60%), var(--ml-black); color: #fff; }
  .ml-band.is-dark .ml { color: #fff; }
  .ml-band.is-soft { background: var(--ml-soft); }

  /* placeholder de imagen */
  .ml-ph { width: 100%; aspect-ratio: 1 / 1; border: 2px dashed #C9CED4; border-radius: 12px; background: var(--ml-soft); color: #4D5560; display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; font-size: 13px; font-weight: 600; line-height: 1.35; }
  .ml-ph.is-wide { aspect-ratio: 4 / 3; }
  .ml-ph.is-tall { aspect-ratio: 4 / 5; }
  .is-dark .ml-ph { background: #1B1E22; border-color: #3A4148; color: #A7B0B8; }

  /* HERO */
  .ml-hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: center; padding: 34px 16px 40px; }
  .ml-pill { display: inline-block; background: var(--ml-red); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; margin-bottom: 14px; }
  .ml-title { font-size: clamp(28px, 5.2vw, 46px); line-height: 1.08; font-weight: 900; text-transform: uppercase; margin-bottom: 14px !important; }
  .ml-title span { color: var(--ml-red); }
  .ml-sub { font-size: 17px; color: #C9CED4; }
  .ml-sub b { color: #fff; }
  .ml-byline { font-size: 12.5px; color: #8E969E; margin: 0 0 18px; }
  .ml-trust { font-size: 13px; color: #A7AEB5; margin-top: 12px; }
  .ml-stars { color: #E9A23B; letter-spacing: 2px; }

  /* RAZONES */
  .ml-reason { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; padding: 48px 0; border-top: 1px solid var(--ml-line); }
  .ml-reason.is-first { border-top: 0; }
  .ml-reason.is-rev .ml-media { order: 2; }
  .ml-kicker { display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ml-red); margin-bottom: 10px; }
  .ml-kicker b { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: var(--ml-red); color: #fff; font-size: 14px; letter-spacing: 0; }
  .ml-kicker::after { content: ''; flex: 1; height: 1px; background: var(--ml-line); }
  .ml-reason h2 { font-size: clamp(23px, 3.4vw, 32px); line-height: 1.15; font-weight: 900; margin-bottom: 14px; }
  .ml-reason h2 span { color: var(--ml-red); }
  .ml-reason p { font-size: 16px; }
  .ml-media { position: relative; }
  .ml-tag { position: absolute; top: 12px; left: 12px; background: #fff; color: var(--ml-ink); font-size: 12px; font-weight: 800; padding: 5px 10px; border-radius: 999px; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
  .ml-tag.is-red { background: var(--ml-red); color: #fff; }

  /* datos */
  .ml-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin: 18px 0; }
  .ml-stat { border: 1px solid var(--ml-line); border-radius: 12px; padding: 12px 14px; background: #fff; line-height: 1.25; }
  .ml-stat b { display: block; font-size: 30px; font-weight: 900; color: var(--ml-red); line-height: 1.05; }
  .ml-stat span { font-size: 13px; color: var(--ml-muted); }
  .ml .ml-src { font-size: 12px; color: var(--ml-muted); border-left: 3px solid var(--ml-red); padding-left: 10px; margin: 6px 0 0 !important; line-height: 1.4; }
  .ml-bridge { background: var(--ml-soft); border-left: 4px solid var(--ml-red); border-radius: 10px; padding: 14px 16px; margin-top: 16px; font-size: 15px; }
  .ml-bridge b { color: var(--ml-ink); }

  /* gráfico de barras */
  .ml-chart { border: 1px solid var(--ml-line); border-radius: 14px; padding: 18px; background: #fff; }
  .ml-chart__t { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; margin: 0 0 14px !important; }
  .ml-bar { margin-bottom: 14px; }
  .ml-bar__l { display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; margin-bottom: 5px; }
  .ml-bar__track { height: 26px; background: var(--ml-soft); border-radius: 6px; overflow: hidden; }
  .ml-bar__fill { height: 100%; background: var(--ml-ink); border-radius: 6px; }
  .ml-bar__fill.is-red { background: var(--ml-red); }

  /* activos */
  .ml-ings { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 18px 0; }
  .ml-ing { border: 1px solid var(--ml-line); border-radius: 12px; padding: 12px; background: #fff; line-height: 1.3; }
  .ml-ing b { display: block; font-size: 14.5px; }
  .ml-ing span { font-size: 12.5px; color: var(--ml-muted); }

  /* testimonios antes / después */
  .ml-h2 { font-size: clamp(26px, 4.2vw, 40px); line-height: 1.1; font-weight: 900; text-transform: uppercase; margin-bottom: 10px !important; }
  .ml-h2 span { color: var(--ml-red); }
  .ml-lead { font-size: 17px; color: var(--ml-muted); max-width: 720px; }
  .ml-center { text-align: center; }
  .ml-center .ml-lead { margin-left: auto; margin-right: auto; }
  .ml-big { display: flex; align-items: center; justify-content: center; gap: 14px; background: var(--ml-black); color: #fff; border-radius: 14px; padding: 18px; margin: 22px 0; text-align: left; }
  .ml-big b { font-size: 48px; font-weight: 900; color: var(--ml-red); line-height: 1; }
  .ml-big span { font-size: 16px; font-weight: 700; text-transform: uppercase; line-height: 1.25; }
  .ml-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .ml-card { border: 1px solid var(--ml-line); border-radius: 14px; background: #fff; padding: 12px; }
  .ml-ba { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 12px; }
  .ml-ba > div { position: relative; }
  .ml-ba img, .ml-ba .ml-ph { aspect-ratio: 3 / 4; border-radius: 8px; object-fit: cover; }
  .ml-ba .ml-ph { font-size: 11px; padding: 8px; }
  .ml-ba__l { position: absolute; bottom: 6px; left: 6px; background: rgba(14,15,17,.85); color: #fff; font-size: 10px; font-weight: 800; text-transform: uppercase; padding: 3px 7px; border-radius: 999px; }
  .ml-ba__l.is-after { background: var(--ml-red); }
  .ml-card__q { font-size: 14.5px; margin: 6px 0 10px !important; }
  .ml-card__n { font-size: 13px; font-weight: 800; }
  .ml-card__v { font-size: 11.5px; color: var(--ml-good); font-weight: 700; }
  .ml-card__w { display: inline-block; font-size: 11px; font-weight: 800; background: var(--ml-soft); padding: 3px 8px; border-radius: 999px; margin-bottom: 4px; }

  /* comparativa */
  .ml-table { width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid var(--ml-line); border-radius: 14px; overflow: hidden; background: #fff; font-size: 14.5px; }
  .ml-table th, .ml-table td { padding: 12px 10px; text-align: center; border-bottom: 1px solid var(--ml-line); }
  .ml-table th:first-child, .ml-table td:first-child { text-align: left; }
  .ml-table tr:last-child td { border-bottom: 0; }
  .ml-table th { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; background: var(--ml-soft); }
  .ml-table th.is-us { background: var(--ml-black); color: #fff; }
  .ml-table td.is-us { background: #FFF5F4; font-weight: 800; }
  .ml-yes { color: var(--ml-good); font-weight: 900; }
  .ml-no { color: #B5BCC3; font-weight: 900; }
  .ml-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 26px; }
  .ml-step { border: 1px solid var(--ml-line); border-radius: 14px; padding: 16px; background: #fff; }
  .ml-step b { display: block; font-size: 13px; color: var(--ml-red); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px; }
  .ml-step h3 { font-size: 17px; font-weight: 900; margin-bottom: 6px; }
  .ml-step p { font-size: 14px; color: var(--ml-muted); margin: 0 !important; }

  /* FAQ */
  .ml-faq { max-width: 760px; margin: 22px auto 0; }
  .ml-faq details { border: 1px solid var(--ml-line); border-radius: 12px; background: #fff; margin-bottom: 8px; }
  .ml-faq summary { cursor: pointer; list-style: none; padding: 14px 44px 14px 16px; font-weight: 800; position: relative; }
  .ml-faq summary::-webkit-details-marker { display: none; }
  .ml-faq summary::after { content: '+'; position: absolute; right: 16px; top: 50%; transform: translateY(-50%); font-size: 22px; color: var(--ml-red); }
  .ml-faq details[open] summary::after { content: '–'; }
  .ml-faq details > div { padding: 0 16px 14px; color: var(--ml-muted); font-size: 15px; }
  .ml-legal { font-size: 11.5px; color: var(--ml-muted); line-height: 1.5; margin-top: 26px; }

  /* botones */
  .ml-btn { display: inline-block; text-align: center; background: var(--ml-red); color: #fff !important; text-decoration: none !important; font-weight: 900; font-size: 16px; letter-spacing: .05em; text-transform: uppercase; padding: 17px 32px; border-radius: 10px; box-shadow: 0 5px 0 var(--ml-red-dark); transition: transform .1s ease, background .15s ease; border: 0; cursor: pointer; }
  .ml-btn:hover { background: var(--ml-red-dark); transform: translateY(2px); }
  .ml-btn.is-full { display: block; width: 100%; max-width: 460px; margin: 0 auto; }
  .ml-under { font-size: 12.5px; color: var(--ml-muted); margin-top: 10px; }
  .is-dark .ml-under { color: #A7AEB5; }

  /* CTA intermedio */
  .ml-mid { display: grid; grid-template-columns: 160px 1fr; gap: 20px; align-items: center; background: var(--ml-black); color: #fff; border-radius: 16px; padding: 18px; margin: 8px 0 40px; }
  .ml-mid h3 { font-size: 20px; font-weight: 900; margin-bottom: 6px !important; }
  .ml-mid p { color: #C9CED4; font-size: 14.5px; }

  /* barra fija mobile */
  .ml-sticky { display: none; }

  @media (max-width: 749px) {
    .ml-hero { grid-template-columns: 1fr; gap: 20px; padding: 22px 16px 30px; }
    .ml-hero__media { order: -1; }
    .ml-reason { grid-template-columns: 1fr; gap: 18px; padding: 34px 0; }
    .ml-reason.is-rev .ml-media { order: 0; }
    .ml-cards, .ml-steps { grid-template-columns: 1fr; }
    .ml-mid { grid-template-columns: 1fr; text-align: center; }
    .ml-mid .ml-ph, .ml-mid img { max-width: 160px; margin: 0 auto; }
    .ml-btn { display: block; width: 100%; }
    .ml-big b { font-size: 40px; }
    .ml-table { font-size: 13px; }
    .ml-table th, .ml-table td { padding: 10px 6px; }
    .ml-sticky { display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; gap: 10px; align-items: center; background: var(--ml-black); padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); box-shadow: 0 -4px 16px rgba(0,0,0,.25); transition: transform .2s ease; }
    .ml-sticky.is-hidden { transform: translateY(110%); }
    .ml-sticky span { flex: 1; color: #fff; font-size: 12.5px; line-height: 1.25; }
    .ml-sticky span b { display: block; font-size: 14px; }
    .ml-sticky .ml-btn { width: auto; padding: 12px 16px; font-size: 13px; box-shadow: none; }
  }
</style>

<div class="ml-band is-dark">
  <div class="ml ml-hero">
    <div class="ml-hero__text">
      <span class="ml-pill">Salud masculina · +40</span>
      <h1 class="ml-title">5 razones por las que los hombres de +40 <span>no bajan la panza</span> (aunque coman bien)</h1>
      <p class="ml-byline">Por el equipo editorial de DR.MEN · {{ fecha_nota }} · Lectura de 2 minutos</p>
      <p class="ml-sub">Dejaste las harinas, cenás liviano, vas al gimnasio cuando podés… y la panza sigue ahí. <b>No es lo que comés. Es lo que pasa en tu cuerpo cuando dormís 5 o 6 horas.</b> Esto es lo que descubrieron en la Universidad de Chicago.</p>
      <a class="ml-btn" href="{{ cta_url }}">Ver la oferta de hoy ↓</a>
      <div class="ml-trust"><span class="ml-stars">★★★★★</span> {{ rating }}/5 · {{ cant_clientes }} hombres ya lo usan</div>
    </div>
    <div class="ml-hero__media">
      {%- if img_hero != blank -%}<img src="{{ img_hero }}" alt="Hombre de más de 40 con Metabomen de DR.MEN" width="1080" height="1080">{%- else -%}<div class="ml-ph">IMAGEN HERO · Hombre de 45 años, de noche, sentado en la cama mirando el celular (3:12 AM en pantalla). Frasco Metabomen en la mesa de luz.</div>{%- endif -%}
    </div>
  </div>
</div>
