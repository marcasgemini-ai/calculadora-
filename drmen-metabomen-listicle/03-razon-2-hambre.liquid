{%- assign img = '' -%}

<div class="ml">
  <div class="ml-reason is-rev">
    <div class="ml-media">
      {%- if img != blank -%}<img src="{{ img }}" alt="Hombre abriendo la heladera de noche" loading="lazy" width="1080" height="1080">{%- else -%}<div class="ml-ph">IMAGEN 3 · Hombre de 40+ abriendo la heladera a las 23:40, la luz de la heladera le ilumina la cara. Pan y galletitas a la vista.</div>{%- endif -%}
      <span class="ml-tag">23:40 h</span>
