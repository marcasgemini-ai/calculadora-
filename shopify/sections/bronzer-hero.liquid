{%- comment -%}
  Bronzer · Hero (editorial / aspiracional)
  Imagen o video a pantalla completa, tipografía display y contenido en bloques.
  Todo se edita desde Tienda online > Personalizar: los bloques se agregan, quitan y reordenan arrastrando.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign main_image = s.image | default: s.image_mobile
  assign overlay_opacity = s.overlay_opacity | divided_by: 100.0
  assign animate = s.animate
  if request.design_mode
    assign animate = false
  endif
-%}

<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}
  #bz-hero-{{ section.id }} {
    --bz-text: {{ s.color_text }};
    --bz-accent: {{ s.color_accent }};
    --bz-overlay: {{ s.color_overlay }};
    --bz-overlay-opacity: {{ overlay_opacity }};
    --bz-btn-bg: {{ s.color_button_bg }};
    --bz-btn-text: {{ s.color_button_text }};
    --bz-display-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    --bz-display-weight: {{ s.heading_font.weight }};
    --bz-display-style: {{ s.heading_font.style }};
  }
</style>

<section
  id="bz-hero-{{ section.id }}"
  class="bz-hero bz-hero--h-{{ s.height }} bz-hero--pos-{{ s.content_position }}{% if animate %} bz-hero--animate{% endif %}"
>
  <div class="bz-hero__media" aria-hidden="true">
    {%- if s.video != blank -%}
      {{
        s.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          image_size: '1500x',
          class: 'bz-hero__asset'
      }}
    {%- elsif main_image != blank -%}
      <picture>
        {%- if s.image_mobile != blank and s.image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ s.image_mobile | image_url: width: 500 }} 500w,
              {{ s.image_mobile | image_url: width: 750 }} 750w,
              {{ s.image_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
            width="{{ s.image_mobile.width }}"
            height="{{ s.image_mobile.height }}"
          >
        {%- endif -%}
        {{
          main_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1920, 2400',
            class: 'bz-hero__asset',
            alt: ''
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'bz-hero__asset bz-hero__placeholder' }}
    {%- endif -%}
    <span class="bz-hero__overlay"></span>
  </div>

  <div class="bz-hero__inner">
    <div class="bz-hero__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'subtitulo' -%}
            <p class="bz-hero__eyebrow" {{ block.shopify_attributes }}>
              <span class="bz-hero__eyebrow-line" aria-hidden="true"></span>
              {{- block.settings.text | escape -}}
            </p>

          {%- when 'titulo' -%}
            <{{ block.settings.tag }} class="bz-hero__title bz-hero__title--{{ block.settings.size }}" {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
            </{{ block.settings.tag }}>

          {%- when 'texto' -%}
            <div class="bz-hero__text" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </div>

          {%- when 'beneficios' -%}
            <ul class="bz-hero__benefits" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- capture key -%}item_{{ i }}{%- endcapture -%}
                {%- if block.settings[key] != blank -%}
                  <li>{{ block.settings[key] | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'destacado' -%}
            <div class="bz-hero__highlight" {{ block.shopify_attributes }}>
              <span class="bz-hero__highlight-number">{{ block.settings.number | escape }}</span>
              <span class="bz-hero__highlight-copy">
                <strong>{{ block.settings.label | escape }}</strong>
                {%- if block.settings.caption != blank -%}
                  <span>{{ block.settings.caption | escape }}</span>
                {%- endif -%}
              </span>
            </div>

          {%- when 'botones' -%}
            <div class="bz-hero__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.label_1 != blank -%}
                <a
                  {% if block.settings.link_1 != blank %}href="{{ block.settings.link_1 }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="bz-hero__button bz-hero__button--primary"
                >
                  <span>{{ block.settings.label_1 | escape }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.label_2 != blank -%}
                <a
                  {% if block.settings.link_2 != blank %}href="{{ block.settings.link_2 }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="bz-hero__button bz-hero__button--ghost"
                >
                  {{- block.settings.label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
            {%- if block.settings.note != blank -%}
              <p class="bz-hero__note">{{ block.settings.note | escape }}</p>
            {%- endif -%}

          {%- when 'testimonio' -%}
            <figure class="bz-hero__quote" {{ block.shopify_attributes }}>
              <span class="bz-hero__stars" aria-label="{{ block.settings.stars }} de 5 estrellas">
                {%- for i in (1..block.settings.stars) -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.4 6.6L12 17.2l-5.9 3.3 1.4-6.6-5-4.5 6.6-.7z"/></svg>
                {%- endfor -%}
              </span>
              <blockquote>{{ block.settings.quote | escape }}</blockquote>
              {%- if block.settings.author != blank -%}
                <figcaption>{{ block.settings.author | escape }}</figcaption>
              {%- endif -%}
            </figure>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if s.show_scroll -%}
    <span class="bz-hero__scroll" aria-hidden="true"><span></span></span>
  {%- endif -%}
</section>

{% stylesheet %}
  .bz-hero {
    position: relative;
    display: flex;
    overflow: hidden;
    color: var(--bz-text);
    background: #1e140f;
    isolation: isolate;
  }
  .bz-hero--h-medium { min-height: 70vh; }
  .bz-hero--h-large  { min-height: 88vh; }
  .bz-hero--h-full   { min-height: 100vh; min-height: 100svh; }

  /* Fondo */
  .bz-hero__media { position: absolute; inset: 0; z-index: -1; }
  .bz-hero__media picture { display: block; width: 100%; height: 100%; }
  .bz-hero__asset { display: block; width: 100%; height: 100%; object-fit: cover; }
  .bz-hero__placeholder { background: #8a6a52; fill: rgba(255, 255, 255, 0.25); }
  .bz-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--bz-overlay);
    opacity: var(--bz-overlay-opacity);
  }
  .bz-hero--pos-bottom-left .bz-hero__overlay,
  .bz-hero--pos-center-left .bz-hero__overlay {
    background: linear-gradient(100deg, var(--bz-overlay) 0%, transparent 72%);
    opacity: calc(var(--bz-overlay-opacity) + 0.15);
  }
  .bz-hero--pos-bottom-center .bz-hero__overlay {
    background: linear-gradient(0deg, var(--bz-overlay) 0%, transparent 70%);
    opacity: calc(var(--bz-overlay-opacity) + 0.15);
  }

  /* Layout del contenido */
  .bz-hero__inner {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 120px 48px 96px;
    display: flex;
  }
  .bz-hero__content {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 620px;
  }
  .bz-hero__content > * { margin: 0; }
  .bz-hero--pos-bottom-left .bz-hero__inner   { align-items: flex-end; }
  .bz-hero--pos-center-left .bz-hero__inner   { align-items: center; }
  .bz-hero--pos-center .bz-hero__inner,
  .bz-hero--pos-bottom-center .bz-hero__inner { justify-content: center; text-align: center; }
  .bz-hero--pos-center .bz-hero__inner        { align-items: center; }
  .bz-hero--pos-bottom-center .bz-hero__inner { align-items: flex-end; }
  .bz-hero--pos-center .bz-hero__content,
  .bz-hero--pos-bottom-center .bz-hero__content { align-items: center; max-width: 760px; }

  /* Subtítulo */
  .bz-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--bz-accent);
  }
  .bz-hero__eyebrow-line { width: 40px; height: 1px; background: currentColor; }

  /* Título display */
  .bz-hero__title {
    font-family: var(--bz-display-font);
    font-weight: var(--bz-display-weight);
    font-style: var(--bz-display-style);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--bz-text);
    text-wrap: balance;
  }
  .bz-hero__title em { font-style: italic; color: var(--bz-accent); }
  .bz-hero__title--medium { font-size: clamp(40px, 6vw, 72px); }
  .bz-hero__title--large  { font-size: clamp(46px, 7.5vw, 96px); }
  .bz-hero__title--xlarge { font-size: clamp(52px, 9vw, 124px); }

  .bz-hero__text {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.65;
    max-width: 46ch;
    opacity: 0.9;
  }
  .bz-hero__text p { margin: 0; }
  .bz-hero__text p + p { margin-top: 0.7em; }

  /* Beneficios en línea */
  .bz-hero__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 0;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bz-hero--pos-center .bz-hero__benefits,
  .bz-hero--pos-bottom-center .bz-hero__benefits { justify-content: center; }
  .bz-hero__benefits li { display: inline-flex; align-items: center; opacity: 0.85; }
  .bz-hero__benefits li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    margin: 0 16px;
    border-radius: 50%;
    background: var(--bz-accent);
  }

  /* Destacado 18 días (vidrio) */
  .bz-hero__highlight {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 14px 26px 14px 18px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    text-align: left;
  }
  .bz-hero__highlight-number {
    font-family: var(--bz-display-font);
    font-style: italic;
    font-size: 56px;
    line-height: 1;
    color: var(--bz-accent);
  }
  .bz-hero__highlight-copy { display: flex; flex-direction: column; gap: 4px; }
  .bz-hero__highlight-copy strong { font-size: 15px; font-weight: 500; letter-spacing: 0.02em; }
  .bz-hero__highlight-copy span { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.7; }

  /* Botones */
  .bz-hero__buttons { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 10px; }
  .bz-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 58px;
    padding: 0 40px;
    border-radius: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.35s ease, color 0.35s ease, gap 0.35s ease;
  }
  .bz-hero__button svg { width: 18px; height: 18px; }
  .bz-hero__button--primary { background: var(--bz-btn-bg); color: var(--bz-btn-text); }
  .bz-hero__button--primary:hover { gap: 22px; }
  .bz-hero__button--ghost { color: var(--bz-text); border: 1px solid currentColor; background: transparent; }
  .bz-hero__button--ghost:hover { background: var(--bz-text); color: #1e140f; }
  .bz-hero__button[aria-disabled="true"] { cursor: default; }
  .bz-hero__note { font-size: 12px; letter-spacing: 0.08em; opacity: 0.7; }

  /* Testimonio */
  .bz-hero__quote {
    margin: 12px 0 0;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    max-width: 420px;
  }
  .bz-hero__stars { display: inline-flex; gap: 3px; margin-bottom: 10px; }
  .bz-hero__stars svg { width: 13px; height: 13px; fill: var(--bz-accent); }
  .bz-hero__quote blockquote {
    margin: 0;
    font-family: var(--bz-display-font);
    font-style: italic;
    font-size: 20px;
    line-height: 1.4;
  }
  .bz-hero__quote figcaption { margin-top: 8px; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0.7; }

  /* Indicador de scroll */
  .bz-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    width: 1px;
    height: 56px;
    background: rgba(255, 255, 255, 0.25);
    overflow: hidden;
  }
  .bz-hero__scroll span {
    position: absolute;
    left: 0;
    top: -50%;
    width: 100%;
    height: 50%;
    background: var(--bz-text);
    animation: bz-hero-scroll 2.2s ease-in-out infinite;
  }

  /* Animación de entrada */
  .bz-hero--animate .bz-hero__asset { animation: bz-hero-zoom 9s ease-out both; }
  .bz-hero--animate .bz-hero__content > * { animation: bz-hero-up 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .bz-hero--animate .bz-hero__content > *:nth-child(2) { animation-delay: 0.12s; }
  .bz-hero--animate .bz-hero__content > *:nth-child(3) { animation-delay: 0.24s; }
  .bz-hero--animate .bz-hero__content > *:nth-child(4) { animation-delay: 0.36s; }
  .bz-hero--animate .bz-hero__content > *:nth-child(5) { animation-delay: 0.48s; }
  .bz-hero--animate .bz-hero__content > *:nth-child(n+6) { animation-delay: 0.6s; }

  @keyframes bz-hero-up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes bz-hero-zoom { from { transform: scale(1.08); } to { transform: scale(1); } }
  @keyframes bz-hero-scroll { 0% { top: -50%; } 100% { top: 100%; } }

  @media (prefers-reduced-motion: reduce) {
    .bz-hero--animate .bz-hero__asset,
    .bz-hero--animate .bz-hero__content > *,
    .bz-hero__scroll span { animation: none; }
  }

  /* Celular */
  @media screen and (max-width: 749px) {
    .bz-hero__inner { padding: 96px 22px 72px; align-items: flex-end !important; }
    .bz-hero__content { gap: 18px; }
    .bz-hero--pos-bottom-left .bz-hero__overlay,
    .bz-hero--pos-center-left .bz-hero__overlay {
      background: linear-gradient(0deg, var(--bz-overlay) 0%, transparent 75%);
    }
    .bz-hero__text { font-size: 16px; }
    .bz-hero__benefits { font-size: 10px; letter-spacing: 0.14em; }
    .bz-hero__benefits li + li::before { margin: 0 10px; }
    .bz-hero__highlight-number { font-size: 44px; }
    .bz-hero__buttons { width: 100%; flex-direction: column; }
    .bz-hero__button { width: 100%; }
    .bz-hero__scroll { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bronzer · Hero",
  "tag": "div",
  "class": "section-bronzer-hero",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Fondo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (escritorio)",
      "info": "Foto lifestyle horizontal. Recomendado: 2400 x 1400 px."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen (celular)",
      "info": "Opcional. Foto vertical, recomendado 1100 x 1600 px."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video de fondo",
      "info": "Opcional. Si cargás un video, reemplaza a la imagen. Sin sonido y en loop."
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "Color de la capa sobre la imagen",
      "default": "#1E140F"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Intensidad de la capa",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "medium", "label": "Mediana" },
        { "value": "large", "label": "Grande" },
        { "value": "full", "label": "Pantalla completa" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Posición del contenido",
      "options": [
        { "value": "bottom-left", "label": "Abajo a la izquierda" },
        { "value": "center-left", "label": "Centro a la izquierda" },
        { "value": "center", "label": "Centrado" },
        { "value": "bottom-center", "label": "Abajo al centro" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Tipografía del título",
      "info": "Recomendado: una serif elegante (Playfair Display, Cormorant, Bodoni).",
      "default": "playfair_display_n4"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animación de entrada",
      "info": "Zoom suave de la imagen y aparición del texto. Se ve en la tienda, no en el editor.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Mostrar indicador de scroll",
      "default": true
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texto",
      "default": "#FBF4EC"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Acento dorado",
      "info": "Subtítulo, palabras en cursiva del título, número destacado y estrellas.",
      "default": "#E3B57A"
    },
    {
      "type": "color",
      "id": "color_button_bg",
      "label": "Fondo del botón",
      "default": "#FBF4EC"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Texto del botón",
      "default": "#1E140F"
    }
  ],
  "blocks": [
    {
      "type": "subtitulo",
      "name": "Subtítulo",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Fórmula Beta-Caroteno"
        }
      ]
    },
    {
      "type": "titulo",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Título",
          "info": "Poné una palabra en cursiva para resaltarla en dorado.",
          "default": "El dorado que nace <em>de adentro.</em>"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tamaño",
          "options": [
            { "value": "medium", "label": "Mediano" },
            { "value": "large", "label": "Grande" },
            { "value": "xlarge", "label": "Extra grande" }
          ],
          "default": "large"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Etiqueta SEO",
          "info": "Usá H1 solo una vez por página.",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "texto",
      "name": "Texto",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto",
          "default": "<p>Un bronceado luminoso en 18 días. Sin sol, sin camas solares, sin autobronceantes. Solo tu piel, en su versión más radiante.</p>"
        }
      ]
    },
    {
      "type": "beneficios",
      "name": "Beneficios en línea",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Frases cortas, se muestran en una línea separadas por un punto dorado."
        },
        {
          "type": "text",
          "id": "item_1",
          "label": "Beneficio 1",
          "default": "Sin sol"
        },
        {
          "type": "text",
          "id": "item_2",
          "label": "Beneficio 2",
          "default": "Sin camas solares"
        },
        {
          "type": "text",
          "id": "item_3",
          "label": "Beneficio 3",
          "default": "Sin manchas"
        },
        {
          "type": "text",
          "id": "item_4",
          "label": "Beneficio 4",
          "default": "Sin quemaduras"
        }
      ]
    },
    {
      "type": "destacado",
      "name": "Destacado (18 días)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Número",
          "default": "18"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto principal",
          "default": "días para tu glow natural"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Texto secundario",
          "default": "Desde adentro, todo el año"
        }
      ]
    },
    {
      "type": "botones",
      "name": "Botones",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label_1",
          "label": "Botón principal · Texto",
          "default": "Descubrí tu glow"
        },
        {
