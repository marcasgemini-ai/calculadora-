{%- comment -%}
  Bronzer · Hero
  Celular: foto arriba (se ve completa) que se funde con el fondo y el texto debajo.
  Escritorio: dos columnas, texto de un lado y foto a toda altura del otro.
  Todo se edita desde Tienda online > Personalizar: los bloques se agregan, quitan y reordenan arrastrando.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = '#bz-hero-' | append: section.id
  assign desktop_image = s.image | default: s.image_mobile
  assign mobile_image = s.image_mobile | default: s.image
  assign animate = s.animate
  if request.design_mode
    assign animate = false
  endif
-%}

<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}

  {{ sid }} {
    --bz-bg: {{ s.color_bg | default: '#140D09' }};
    --bz-text: {{ s.color_text | default: '#FFFFFF' }};
    --bz-text-soft: {{ s.color_text | default: '#FFFFFF' | color_modify: 'alpha', 0.8 }};
    --bz-accent: {{ s.color_accent | default: '#F2B544' }};
    --bz-btn-bg: {{ s.color_button_bg | default: '#B46F34' }};
    --bz-btn-text: {{ s.color_button_text | default: '#FFFFFF' }};
    --bz-btn-radius: {{ s.button_radius }}px;
    --bz-overlap: {{ s.mobile_overlap }}px;
    --bz-display-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    --bz-display-weight: {{ s.heading_font.weight }};
  }

  {{ sid }}, {{ sid }} *, {{ sid }} *::before, {{ sid }} *::after { box-sizing: border-box; }
  {{ sid }} p, {{ sid }} li, {{ sid }} span { color: inherit; }

  {{ sid }} {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bz-bg);
    color: var(--bz-text);
  }

  /* ---------- Imagen (celular primero) ---------- */
  {{ sid }} .bz-hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  {{ sid }}.bz-hero--m-tall .bz-hero__media { aspect-ratio: 3 / 4; }
  {{ sid }}.bz-hero--m-square .bz-hero__media { aspect-ratio: 1 / 1; }
  {{ sid }} .bz-hero__asset {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center 20%;
  }
  {{ sid }} .bz-hero__asset--desktop { display: none; }
  {{ sid }} .bz-hero__placeholder { background: #5a4334; fill: rgba(255, 255, 255, 0.18); }
  {{ sid }} .bz-hero__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 48%;
    background: linear-gradient(180deg, transparent 0%, var(--bz-bg) 92%);
    pointer-events: none;
  }

  /* Prueba social con efecto vidrio */
  {{ sid }} .bz-hero__top {
    position: absolute;
    top: 16px;
    left: 14px;
    right: 14px;
    z-index: 2;
  }
  {{ sid }} .bz-hero__proof {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    padding: 8px 18px 8px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(20, 13, 9, 0.35);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    backdrop-filter: blur(12px) saturate(140%);
    color: #fff;
    text-align: left;
  }
  {{ sid }} .bz-hero__avatars { display: inline-flex; flex: 0 0 auto; }
  {{ sid }} .bz-hero__avatar {
    width: 38px;
    height: 38px;
    max-width: none;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
  }
  {{ sid }} .bz-hero__avatar + .bz-hero__avatar { margin-left: -10px; }
  {{ sid }} .bz-hero__proof-copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  {{ sid }} .bz-hero__stars { display: inline-flex; gap: 2px; }
  {{ sid }} .bz-hero__stars svg { width: 15px; height: 15px; fill: var(--bz-accent); }
  {{ sid }} .bz-hero__proof-text { font-size: 13px; font-weight: 600; line-height: 1.3; }

  /* ---------- Contenido ---------- */
  {{ sid }} .bz-hero__body {
    position: relative;
    z-index: 2;
    margin-top: calc(var(--bz-overlap) * -1);
    padding: 0 20px 44px;
  }
  {{ sid }} .bz-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  {{ sid }} .bz-hero__content > * { margin: 0; }

  {{ sid }} .bz-hero__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--bz-accent);
  }
  {{ sid }} .bz-hero__title {
    margin: 0;
    font-family: var(--bz-display-font);
    font-weight: var(--bz-display-weight);
    font-size: clamp(34px, 9.5vw, 46px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    color: var(--bz-text);
    text-wrap: balance;
  }
  {{ sid }} .bz-hero__title em { color: var(--bz-accent); font-style: normal; }
  {{ sid }}.bz-hero--hl-italic .bz-hero__title em { font-style: italic; }
  {{ sid }} .bz-hero__text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--bz-text-soft);
    text-wrap: pretty;
  }
  {{ sid }} .bz-hero__text p { margin: 0; }
  {{ sid }} .bz-hero__text p + p { margin-top: 0.6em; }

  {{ sid }} .bz-hero__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 0;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bz-text-soft);
  }
  {{ sid }} .bz-hero__benefits li { display: inline-flex; align-items: center; }
  {{ sid }} .bz-hero__benefits li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    margin: 0 10px;
    border-radius: 50%;
    background: var(--bz-accent);
  }

  {{ sid }} .bz-hero__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    margin-top: 8px;
  }
  {{ sid }} .bz-hero__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 60px;
    padding: 0 18px;
    border-radius: var(--bz-btn-radius);
    background: var(--bz-btn-bg);
    color: var(--bz-btn-text);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 16px 32px -16px var(--bz-btn-bg);
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  {{ sid }} .bz-hero__button:hover { transform: translateY(-2px); filter: brightness(1.08); color: var(--bz-btn-text); }
  {{ sid }} .bz-hero__button[aria-disabled="true"] { cursor: default; }
  {{ sid }} .bz-hero__guarantee {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--bz-text-soft);
  }
  {{ sid }} .bz-hero__guarantee svg { flex: 0 0 16px; width: 16px; height: 16px; color: var(--bz-accent); }

  /* ---------- Tablet: foto más apaisada ---------- */
  @media screen and (min-width: 600px) and (max-width: 989px) {
    {{ sid }} .bz-hero__media,
    {{ sid }}.bz-hero--m-tall .bz-hero__media,
    {{ sid }}.bz-hero--m-square .bz-hero__media { aspect-ratio: 5 / 4; }
    {{ sid }} .bz-hero__title { font-size: 52px; }
    {{ sid }} .bz-hero__text { font-size: 18px; }
    {{ sid }} .bz-hero__body { padding-bottom: 64px; }
  }

  /* ---------- Escritorio: dos columnas ---------- */
  @media screen and (min-width: 990px) {
    {{ sid }} {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      min-height: 640px;
    }
    {{ sid }}.bz-hero--h-large { min-height: 85vh; }
    {{ sid }}.bz-hero--h-full { min-height: 100vh; min-height: 100svh; }

    {{ sid }} .bz-hero__media {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: auto;
      height: 100%;
      min-height: 100%;
    }
    {{ sid }} .bz-hero__asset--mobile { display: none; }
    {{ sid }} .bz-hero__asset--desktop { display: block; object-position: center 25%; }
    {{ sid }} .bz-hero__fade {
      top: 0;
      bottom: 0;
      left: -1px;
      right: auto;
      width: 30%;
      height: auto;
      background: linear-gradient(90deg, var(--bz-bg) 0%, transparent 100%);
    }

    {{ sid }}.bz-hero--img-left { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    {{ sid }}.bz-hero--img-left .bz-hero__media { grid-column: 1; }
    {{ sid }}.bz-hero--img-left .bz-hero__body { grid-column: 2; }
    {{ sid }}.bz-hero--img-left .bz-hero__fade {
      left: auto;
      right: -1px;
      background: linear-gradient(270deg, var(--bz-bg) 0%, transparent 100%);
    }

    {{ sid }} .bz-hero__top { top: 28px; left: auto; right: 28px; text-align: right; }
    {{ sid }}.bz-hero--img-left .bz-hero__top { right: auto; left: 28px; text-align: left; }
    {{ sid }} .bz-hero__proof { gap: 14px; padding: 10px 24px 10px 10px; }
    {{ sid }} .bz-hero__avatar { width: 44px; height: 44px; }
    {{ sid }} .bz-hero__avatar + .bz-hero__avatar { margin-left: -12px; }
    {{ sid }} .bz-hero__stars svg { width: 17px; height: 17px; }
    {{ sid }} .bz-hero__proof-text { font-size: 15px; white-space: nowrap; }

    {{ sid }} .bz-hero__body {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      margin: 0;
      padding: 72px 56px 72px 40px;
    }
    {{ sid }}.bz-hero--img-left .bz-hero__body { justify-content: flex-start; padding: 72px 40px 72px 56px; }
    {{ sid }} .bz-hero__content { gap: 20px; max-width: 580px; margin: 0; width: 100%; }
    {{ sid }}.bz-hero--align-left .bz-hero__content { align-items: flex-start; text-align: left; }
    {{ sid }}.bz-hero--align-left .bz-hero__benefits { justify-content: flex-start; }
    {{ sid }}.bz-hero--align-left .bz-hero__cta { align-items: flex-start; }

    {{ sid }} .bz-hero__eyebrow { font-size: 12px; }
    {{ sid }} .bz-hero__title { font-size: clamp(40px, 4.6vw, 72px); }
    {{ sid }} .bz-hero__text { font-size: 18px; max-width: 46ch; }
    {{ sid }} .bz-hero__benefits { font-size: 12px; }
    {{ sid }} .bz-hero__benefits li + li::before { margin: 0 14px; }
    {{ sid }} .bz-hero__cta { margin-top: 12px; gap: 18px; }
    {{ sid }} .bz-hero__button { max-width: 480px; min-height: 64px; font-size: 16px; padding: 0 32px; }
    {{ sid }} .bz-hero__guarantee { font-size: 12px; }
  }

  @media screen and (min-width: 1400px) {
    {{ sid }} .bz-hero__body { padding-left: calc((100vw - 1320px) / 2 + 40px); }
    {{ sid }}.bz-hero--img-left .bz-hero__body { padding-left: 56px; padding-right: calc((100vw - 1320px) / 2 + 40px); }
  }

  /* ---------- Animación de entrada ---------- */
  {{ sid }}.bz-hero--animate .bz-hero__asset { animation: bz-hero-zoom 8s ease-out both; }
  {{ sid }}.bz-hero--animate .bz-hero__top { animation: bz-hero-fade 0.9s 0.3s ease both; }
  {{ sid }}.bz-hero--animate .bz-hero__content > * { animation: bz-hero-up 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  {{ sid }}.bz-hero--animate .bz-hero__content > *:nth-child(2) { animation-delay: 0.1s; }
  {{ sid }}.bz-hero--animate .bz-hero__content > *:nth-child(3) { animation-delay: 0.2s; }
  {{ sid }}.bz-hero--animate .bz-hero__content > *:nth-child(4) { animation-delay: 0.3s; }
  {{ sid }}.bz-hero--animate .bz-hero__content > *:nth-child(n+5) { animation-delay: 0.4s; }

  @keyframes bz-hero-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  @keyframes bz-hero-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes bz-hero-zoom { from { transform: scale(1.06); } to { transform: scale(1); } }

  @media (prefers-reduced-motion: reduce) {
    {{ sid }}.bz-hero--animate .bz-hero__asset,
    {{ sid }}.bz-hero--animate .bz-hero__top,
    {{ sid }}.bz-hero--animate .bz-hero__content > * { animation: none; }
  }
</style>

{%- capture social_proof -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'prueba_social' -%}
      <div class="bz-hero__proof" {{ block.shopify_attributes }}>
        {%- if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank -%}
          <span class="bz-hero__avatars" aria-hidden="true">
            {%- for i in (1..3) -%}
              {%- capture key -%}avatar_{{ i }}{%- endcapture -%}
              {%- if block.settings[key] != blank -%}
                {{
                  block.settings[key]
                  | image_url: width: 120, height: 120, crop: 'center'
                  | image_tag: width: 44, height: 44, loading: 'eager', alt: '', class: 'bz-hero__avatar'
                }}
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
        <span class="bz-hero__proof-copy">
          <span class="bz-hero__stars" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas">
            {%- for i in (1..block.settings.stars) -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.4 6.6L12 17.2l-5.9 3.3 1.4-6.6-5-4.5 6.6-.7z"/></svg>
            {%- endfor -%}
          </span>
          {%- if block.settings.text != blank -%}
            <span class="bz-hero__proof-text">{{ block.settings.text }}</span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  id="bz-hero-{{ section.id }}"
  class="bz-hero bz-hero--img-{{ s.image_position }} bz-hero--h-{{ s.height }} bz-hero--m-{{ s.mobile_ratio }} bz-hero--align-{{ s.content_align }} bz-hero--hl-{{ s.highlight_style }}{% if animate %} bz-hero--animate{% endif %}"
>
  <div class="bz-hero__media">
    {%- if s.video != blank -%}
      {{
        s.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          image_size: '1500x',
          class: 'bz-hero__asset'
      }}
    {%- elsif desktop_image != blank -%}
      {{
        mobile_image
        | image_url: width: 1200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '500, 750, 1000, 1200',
          class: 'bz-hero__asset bz-hero__asset--mobile',
          alt: mobile_image.alt
      }}
      {{
        desktop_image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          sizes: '(min-width: 990px) 55vw, 1px',
          widths: '750, 1000, 1400, 2000',
          class: 'bz-hero__asset bz-hero__asset--desktop',
          alt: desktop_image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'bz-hero__asset bz-hero__placeholder' }}
    {%- endif -%}
    <span class="bz-hero__fade" aria-hidden="true"></span>

    {%- if social_proof != blank and s.proof_position == 'top' -%}
      <div class="bz-hero__top">{{ social_proof }}</div>
    {%- endif -%}
  </div>

  <div class="bz-hero__body">
    <div class="bz-hero__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'prueba_social' -%}
            {%- if s.proof_position == 'inline' -%}
              {{ social_proof }}
            {%- endif -%}

          {%- when 'subtitulo' -%}
            <p class="bz-hero__eyebrow" {{ block.shopify_attributes }}>
              {{- block.settings.text | escape -}}
            </p>

          {%- when 'titulo' -%}
            <{{ block.settings.tag }} class="bz-hero__title" {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
            </{{ block.settings.tag }}>

          {%- when 'texto' -%}
            <div class="bz-hero__text" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </div>

          {%- when 'beneficios' -%}
            <ul class="bz-hero__benefits" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- capture key -%}item_{{ i }}{%- endcapture -%}
                {%- if block.settings[key] != blank -%}
                  <li>{{ block.settings[key] | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'boton' -%}
            <div class="bz-hero__cta" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <a
                  href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#oferta{% endif %}"
                  class="bz-hero__button"
                >
                  {{- block.settings.label | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.guarantee != blank -%}
                <p class="bz-hero__guarantee">
                  {%- if block.settings.show_icon -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                  {%- endif -%}
                  <span>{{ block.settings.guarantee | escape }}</span>
                </p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bronzer · Hero",
  "tag": "div",
  "class": "section-bronzer-hero",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (escritorio)",
      "info": "Foto vertical o cuadrada de la modelo. Recomendado: 1600 x 1800 px."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen (celular)",
      "info": "Opcional. Foto vertical 4:5 (1200 x 1500 px). Si la dejás vacía se usa la de escritorio."
    },
    {
      "type": "paragraph",
      "content": "Para que la cara nunca se corte: en Contenido > Archivos, abrí la imagen y marcá el punto focal sobre la cara."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (opcional)",
      "info": "Reemplaza a la imagen. Sin sonido y en loop."
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Formato de la imagen en celular",
      "options": [
        {
          "value": "portrait",
          "label": "Vertical 4:5"
        },
        {
          "value": "tall",
          "label": "Vertical 3:4"
        },
        {
          "value": "square",
          "label": "Cuadrada 1:1"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "mobile_overlap",
      "label": "Texto sobre la imagen (celular)",
      "info": "Cuánto sube el título sobre el fundido de la foto.",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Escritorio"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen",
      "options": [
        {
          "value": "right",
          "label": "Derecha"
        },
        {
          "value": "left",
          "label": "Izquierda"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        {
          "value": "medium",
          "label": "Mediana"
        },
        {
          "value": "large",
          "label": "Grande"
        },
        {
          "value": "full",
          "label": "Pantalla completa"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centrado"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "select",
      "id": "proof_position",
      "label": "Prueba social",
      "options": [
        {
          "value": "top",
          "label": "Flotando sobre la imagen"
        },
        {
          "value": "inline",
          "label": "Junto al texto"
        }
      ],
      "default": "top"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Tipografía del título",
      "default": "playfair_display_n7"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Palabra resaltada",
      "info": "Para resaltar, poné la palabra en cursiva en el título.",
      "options": [
        {
          "value": "color",
          "label": "Solo color"
        },
        {
          "value": "italic",
          "label": "Color + cursiva"
        }
      ],
      "default": "color"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animación de entrada",
      "info": "Se ve en la tienda, no en el editor.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colores"
