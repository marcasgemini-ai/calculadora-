{%- comment -%}
  Bronzer · Hero
  Foto a pantalla completa, prueba social con efecto vidrio, título display con palabra resaltada,
  botón de compra y garantía. Todo se edita desde Tienda online > Personalizar:
  los bloques se agregan, quitan y reordenan arrastrando.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign main_image = s.image | default: s.image_mobile
  assign overlay_opacity = s.overlay_opacity | divided_by: 100.0
  assign animate = s.animate
  if request.design_mode
    assign animate = false
  endif
-%}

<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}
  #bz-hero-{{ section.id }} {
    --bz-text: {{ s.color_text }};
    --bz-text-soft: {{ s.color_text | color_modify: 'alpha', 0.82 }};
    --bz-accent: {{ s.color_accent }};
    --bz-overlay: {{ s.color_overlay }};
    --bz-overlay-opacity: {{ overlay_opacity }};
    --bz-btn-bg: {{ s.color_button_bg }};
    --bz-btn-text: {{ s.color_button_text }};
    --bz-btn-radius: {{ s.button_radius }}px;
    --bz-display-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    --bz-display-weight: {{ s.heading_font.weight }};
  }
</style>

{%- capture social_proof -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'prueba_social' -%}
      <div class="bz-hero__proof" {{ block.shopify_attributes }}>
        {%- if block.settings.avatar_1 != blank or block.settings.avatar_2 != blank or block.settings.avatar_3 != blank -%}
          <span class="bz-hero__avatars" aria-hidden="true">
            {%- for i in (1..3) -%}
              {%- capture key -%}avatar_{{ i }}{%- endcapture -%}
              {%- if block.settings[key] != blank -%}
                {{
                  block.settings[key]
                  | image_url: width: 120, height: 120, crop: 'center'
                  | image_tag: width: 44, height: 44, loading: 'eager', alt: '', class: 'bz-hero__avatar'
                }}
              {%- endif -%}
            {%- endfor -%}
          </span>
        {%- endif -%}
        <span class="bz-hero__proof-copy">
          <span class="bz-hero__stars" role="img" aria-label="{{ block.settings.stars }} de 5 estrellas">
            {%- for i in (1..block.settings.stars) -%}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.4 6.6L12 17.2l-5.9 3.3 1.4-6.6-5-4.5 6.6-.7z"/></svg>
            {%- endfor -%}
          </span>
          {%- if block.settings.text != blank -%}
            <span class="bz-hero__proof-text">{{ block.settings.text }}</span>
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  id="bz-hero-{{ section.id }}"
  class="bz-hero bz-hero--h-{{ s.height }} bz-hero--pos-{{ s.content_position }} bz-hero--hl-{{ s.highlight_style }}{% if animate %} bz-hero--animate{% endif %}"
>
  <div class="bz-hero__media" aria-hidden="true">
    {%- if s.video != blank -%}
      {{
        s.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          image_size: '1500x',
          class: 'bz-hero__asset'
      }}
    {%- elsif main_image != blank -%}
      <picture>
        {%- if s.image_mobile != blank and s.image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ s.image_mobile | image_url: width: 500 }} 500w,
              {{ s.image_mobile | image_url: width: 750 }} 750w,
              {{ s.image_mobile | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
            width="{{ s.image_mobile.width }}"
            height="{{ s.image_mobile.height }}"
          >
        {%- endif -%}
        {{
          main_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1920, 2400',
            class: 'bz-hero__asset',
            alt: ''
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'bz-hero__asset bz-hero__placeholder' }}
    {%- endif -%}
    <span class="bz-hero__overlay"></span>
  </div>

  {%- if social_proof != blank and s.proof_position == 'top' -%}
    <div class="bz-hero__top">{{ social_proof }}</div>
  {%- endif -%}

  <div class="bz-hero__inner">
    <div class="bz-hero__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'prueba_social' -%}
            {%- if s.proof_position == 'inline' -%}
              {{ social_proof }}
            {%- endif -%}

          {%- when 'subtitulo' -%}
            <p class="bz-hero__eyebrow" {{ block.shopify_attributes }}>
              {{- block.settings.text | escape -}}
            </p>

          {%- when 'titulo' -%}
            <{{ block.settings.tag }} class="bz-hero__title bz-hero__title--{{ block.settings.size }}" {{ block.shopify_attributes }}>
              {{- block.settings.heading -}}
            </{{ block.settings.tag }}>

          {%- when 'texto' -%}
            <div class="bz-hero__text" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </div>

          {%- when 'beneficios' -%}
            <ul class="bz-hero__benefits" role="list" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- capture key -%}item_{{ i }}{%- endcapture -%}
                {%- if block.settings[key] != blank -%}
                  <li>{{ block.settings[key] | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'boton' -%}
            <div class="bz-hero__cta" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}
                <a
                  {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                  class="bz-hero__button"
                >
                  {{- block.settings.label | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.guarantee != blank -%}
                <p class="bz-hero__guarantee">
                  {%- if block.settings.show_icon -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                  {%- endif -%}
                  <span>{{ block.settings.guarantee | escape }}</span>
                </p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .bz-hero,
  .bz-hero *,
  .bz-hero *::before,
  .bz-hero *::after { box-sizing: border-box; }

  .bz-hero {
    position: relative;
    display: flex;
    overflow: hidden;
    color: var(--bz-text);
    background: #140d09;
    isolation: isolate;
  }
  .bz-hero--h-medium { min-height: 75vh; }
  .bz-hero--h-large  { min-height: 90vh; }
  .bz-hero--h-full   { min-height: 100vh; min-height: 100svh; }

  /* Fondo */
  .bz-hero__media { position: absolute; inset: 0; z-index: -1; }
  .bz-hero__media picture { display: block; width: 100%; height: 100%; }
  .bz-hero__asset { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .bz-hero__placeholder { background: #6b4f3c; fill: rgba(255, 255, 255, 0.2); }
  .bz-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--bz-overlay) 0%, var(--bz-overlay) 18%, transparent 68%);
    opacity: var(--bz-overlay-opacity);
  }
  .bz-hero--pos-center-left .bz-hero__overlay {
    background: linear-gradient(95deg, var(--bz-overlay) 0%, var(--bz-overlay) 20%, transparent 70%);
  }
  .bz-hero--pos-center .bz-hero__overlay { background: var(--bz-overlay); opacity: calc(var(--bz-overlay-opacity) * 0.6); }

  /* Prueba social (vidrio) */
  .bz-hero__top {
    position: absolute;
    top: 28px;
    left: 0;
    right: 0;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
    z-index: 2;
  }
  .bz-hero__proof {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 10px 26px 10px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(30, 20, 14, 0.38);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    color: #fff;
    text-align: left;
  }
  .bz-hero__avatars { display: inline-flex; }
  .bz-hero__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
  }
  .bz-hero__avatar + .bz-hero__avatar { margin-left: -12px; }
  .bz-hero__proof-copy { display: flex; flex-direction: column; gap: 3px; }
  .bz-hero__stars { display: inline-flex; gap: 2px; }
  .bz-hero__stars svg { width: 17px; height: 17px; fill: var(--bz-accent); }
  .bz-hero__proof-text { font-size: 15px; font-weight: 600; letter-spacing: 0.01em; white-space: nowrap; }
  .bz-hero__proof-text p { margin: 0; }

  /* Layout del contenido */
  .bz-hero__inner {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 140px 40px 64px;
    display: flex;
  }
  .bz-hero__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    max-width: 640px;
  }
  .bz-hero__content > * { margin: 0; }
  .bz-hero--pos-bottom-center .bz-hero__inner { align-items: flex-end; justify-content: center; text-align: center; }
  .bz-hero--pos-center .bz-hero__inner        { align-items: center; justify-content: center; text-align: center; }
  .bz-hero--pos-center-left .bz-hero__inner   { align-items: center; }
  .bz-hero--pos-bottom-center .bz-hero__content,
  .bz-hero--pos-center .bz-hero__content { align-items: center; max-width: 820px; }

  .bz-hero__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bz-accent);
  }

  /* Título */
  .bz-hero__title {
    font-family: var(--bz-display-font);
    font-weight: var(--bz-display-weight);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--bz-text);
    text-wrap: balance;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
  }
  .bz-hero__title em { color: var(--bz-accent); font-style: normal; }
  .bz-hero--hl-italic .bz-hero__title em { font-style: italic; }
  .bz-hero__title--medium { font-size: clamp(36px, 5vw, 64px); }
  .bz-hero__title--large  { font-size: clamp(40px, 6vw, 80px); }
  .bz-hero__title--xlarge { font-size: clamp(46px, 7.5vw, 104px); }

  .bz-hero__text {
    font-size: 19px;
    line-height: 1.5;
    color: var(--bz-text-soft);
    max-width: 48ch;
  }
  .bz-hero__text p { margin: 0; }
  .bz-hero__text p + p { margin-top: 0.6em; }

  /* Beneficios */
  .bz-hero__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bz-text-soft);
  }
  .bz-hero--pos-bottom-center .bz-hero__benefits,
  .bz-hero--pos-center .bz-hero__benefits { justify-content: center; }
  .bz-hero__benefits li { display: inline-flex; align-items: center; }
  .bz-hero__benefits li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    margin: 0 14px;
    border-radius: 50%;
    background: var(--bz-accent);
  }

  /* Botón + garantía */
  .bz-hero__cta {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    gap: 22px;
    width: 100%;
    max-width: 560px;
    margin-top: 14px;
  }
  .bz-hero__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 68px;
    padding: 0 28px;
    border-radius: var(--bz-btn-radius);
    background: var(--bz-btn-bg);
    color: var(--bz-btn-text);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 14px 34px -14px var(--bz-btn-bg);
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  .bz-hero__button:hover { transform: translateY(-2px); filter: brightness(1.07); }
  .bz-hero__button[aria-disabled="true"] { cursor: default; }
  .bz-hero__guarantee {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bz-text-soft);
  }
  .bz-hero__guarantee svg { flex: 0 0 18px; width: 18px; height: 18px; color: var(--bz-accent); }

  /* Animación de entrada */
  .bz-hero--animate .bz-hero__asset { animation: bz-hero-zoom 9s ease-out both; }
  .bz-hero--animate .bz-hero__top { animation: bz-hero-down 1s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .bz-hero--animate .bz-hero__content > * { animation: bz-hero-up 1s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .bz-hero--animate .bz-hero__content > *:nth-child(2) { animation-delay: 0.1s; }
  .bz-hero--animate .bz-hero__content > *:nth-child(3) { animation-delay: 0.2s; }
  .bz-hero--animate .bz-hero__content > *:nth-child(4) { animation-delay: 0.3s; }
  .bz-hero--animate .bz-hero__content > *:nth-child(n+5) { animation-delay: 0.4s; }

  @keyframes bz-hero-up   { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes bz-hero-down { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
  @keyframes bz-hero-zoom { from { transform: scale(1.07); } to { transform: scale(1); } }

  @media (prefers-reduced-motion: reduce) {
    .bz-hero--animate .bz-hero__asset,
    .bz-hero--animate .bz-hero__top,
    .bz-hero--animate .bz-hero__content > * { animation: none; }
  }

  /* Celular */
  @media screen and (max-width: 749px) {
    .bz-hero__top { top: 16px; padding: 0 14px; }
    .bz-hero__proof { gap: 10px; padding: 8px 18px 8px 8px; }
    .bz-hero__avatar { width: 38px; height: 38px; }
    .bz-hero__avatar + .bz-hero__avatar { margin-left: -10px; }
    .bz-hero__stars svg { width: 15px; height: 15px; }
    .bz-hero__proof-text { font-size: 13px; }

    .bz-hero__inner { padding: 120px 18px 36px; align-items: flex-end !important; justify-content: center; text-align: center; }
    .bz-hero__content { align-items: center; gap: 14px; }
    .bz-hero--pos-center-left .bz-hero__overlay,
    .bz-hero--pos-center .bz-hero__overlay {
      background: linear-gradient(0deg, var(--bz-overlay) 0%, var(--bz-overlay) 18%, transparent 68%);
      opacity: var(--bz-overlay-opacity);
    }
    .bz-hero__text { font-size: 17px; }
    .bz-hero__benefits { justify-content: center; font-size: 10px; letter-spacing: 0.12em; }
    .bz-hero__benefits li + li::before { margin: 0 9px; }
    .bz-hero__cta { gap: 18px; margin-top: 10px; }
    .bz-hero__button { min-height: 62px; font-size: 16px; padding: 0 18px; }
    .bz-hero__guarantee { font-size: 11px; letter-spacing: 0.06em; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bronzer · Hero",
  "tag": "div",
  "class": "section-bronzer-hero",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Fondo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (escritorio)",
      "info": "Foto horizontal. Recomendado: 2400 x 1400 px."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen (celular)",
      "info": "Foto vertical, con la cara en la mitad de arriba. Recomendado: 1100 x 1900 px."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video de fondo",
      "info": "Opcional. Reemplaza a la imagen. Se reproduce sin sonido y en loop."
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "Color del degradado",
      "info": "Oscurece la parte de abajo para que se lea el texto.",
      "default": "#140D09"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Intensidad del degradado",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Altura",
      "options": [
        { "value": "medium", "label": "Mediana" },
        { "value": "large", "label": "Grande" },
        { "value": "full", "label": "Pantalla completa" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Posición del contenido (escritorio)",
      "info": "En celular siempre va abajo y centrado.",
      "options": [
        { "value": "bottom-center", "label": "Abajo al centro" },
        { "value": "center", "label": "Centrado" },
        { "value": "center-left", "label": "Centro a la izquierda" }
      ],
      "default": "bottom-center"
    },
    {
      "type": "select",
      "id": "proof_position",
      "label": "Posición de la prueba social",
      "options": [
        { "value": "top", "label": "Flotando arriba de la imagen" },
        { "value": "inline", "label": "Junto al texto" }
      ],
      "default": "top"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Tipografía del título",
      "default": "playfair_display_n7"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Estilo de la palabra resaltada",
      "info": "Para resaltar, poné la palabra en cursiva en el título.",
      "options": [
        { "value": "color", "label": "Solo color" },
        { "value": "italic", "label": "Color + cursiva" }
      ],
      "default": "color"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animación de entrada",
      "info": "Se ve en la tienda, no en el editor.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Texto",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Acento dorado",
      "info": "Palabra resaltada, estrellas e ícono de garantía.",
      "default": "#F2B544"
    },
    {
      "type": "color",
      "id": "color_button_bg",
      "label": "Fondo del botón",
      "default": "#B46F34"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Texto del botón",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Redondeo del botón",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "prueba_social",
      "name": "Prueba social",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar_1",
          "label": "Foto clienta 1"
        },
        {
          "type": "image_picker",
          "id": "avatar_2",
          "label": "Foto clienta 2"
        },
        {
          "type": "image_picker",
          "id": "avatar_3",
          "label": "Foto clienta 3"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Estrellas",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "+3mil reseñas · +10mil vendidos"
        }
      ]
    },
    {
      "type": "subtitulo",
      "name": "Subtítulo",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Fórmula Beta-Caroteno"
        }
      ]
    },
    {
      "type": "titulo",
      "name": "Título",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Título",
          "info": "La palabra en cursiva se pinta con el color de acento.",
          "default": "Bronceado dorado en 18 días, <em>sin tomar sol</em>"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tamaño",
          "options": [
            { "value": "medium", "label": "Mediano" },
            { "value": "large", "label": "Grande" },
            { "value": "xlarge", "label": "Extra grande" }
          ],
          "default": "large"
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Etiqueta SEO",
          "info": "Usá H1 solo una vez por página.",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" }
          ],
          "default": "h1"
        }
      ]
    },
    {
