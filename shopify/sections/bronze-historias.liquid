        this.panels = Array.from(this.querySelectorAll('.bz-hist__historia'));
        if (this.panels.length < 2) return;
        this.active = 0;

        this.tabs.forEach((tab, i) => tab.addEventListener('click', () => this.show(i, true)));
        this.querySelectorAll('.bz-hist__flecha').forEach((btn) =>
          btn.addEventListener('click', () => this.show(this.active + Number(btn.dataset.dir), true))
        );
        this.querySelector('.bz-hist__avatares').addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            this.show(this.active + (e.key === 'ArrowRight' ? 1 : -1), true, true);
          }
        });

        // Deslizar con el dedo en celular
        const track = this.querySelector('.bz-hist__track');
        let x0 = null, y0 = 0;
        track.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
        track.addEventListener('touchend', (e) => {
          if (x0 === null) return;
          const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
          x0 = null;
          if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.3) this.show(this.active + (dx < 0 ? 1 : -1), true);
        }, { passive: true });

        // Editor de temas: al seleccionar un bloque se muestra esa historia
        this.onBlockSelect = (e) => {
          const i = this.panels.indexOf(e.target);
          if (i > -1) this.show(i, true);
        };
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        const secs = Number(this.dataset.autoplay) || 0;
        if (secs > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          this.timer = setInterval(() => {
            if (!document.hidden) this.show(this.active + 1);
          }, secs * 1000);
        }
      }

      initReels() {
        this.reels = Array.from(this.querySelectorAll('.bz-hist__reel'));
        this.modal = this.querySelector('.bz-hist__modal');
        if (!this.reels.length || !this.modal) return;
        this.modalVideo = this.modal.querySelector('.bz-hist__modal-video');
        this.reels.forEach((reel, i) => {
          const v = reel.querySelector('video');
          const bar = reel.querySelector('.bz-hist__reel-bar i');
          if (v) {
            v.muted = true;
            if (bar) v.addEventListener('timeupdate', () => {
              if (v.duration) bar.style.transform = 'scaleX(' + (v.currentTime / v.duration) + ')';
            });
          }
          reel.querySelector('.bz-hist__reel-open').addEventListener('click', () => this.openReel(i));
          reel.querySelector('.bz-hist__reel-sound').addEventListener('click', (e) => { e.stopPropagation(); this.toggleSound(i); });
        });
        this.modal.querySelector('.bz-hist__modal-close').addEventListener('click', () => this.closeReel());
        this.modal.querySelectorAll('.bz-hist__modal-nav').forEach((b) =>
          b.addEventListener('click', () => this.openReel(this.reelIndex + Number(b.dataset.dir)))
        );
        const cta = this.modal.querySelector('[data-scroll-compra]');
        if (cta) cta.addEventListener('click', (e) => {
          const target = document.querySelector('.dw-offer, [id^="bz-of-"], product-form, form[action*="/cart/add"]');
          e.preventDefault();
          this.closeReel();
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
        this.modal.addEventListener('click', (e) => { if (e.target === this.modal) this.closeReel(); });
        this.modal.addEventListener('close', () => { this.modalVideo.pause(); this.observeReels(); });
        if (this.reels.length < 2) this.modal.querySelectorAll('.bz-hist__modal-nav').forEach((b) => (b.hidden = true));

        // Los videos se reproducen solos (sin sonido) mientras se ven en pantalla
        const saveData = navigator.connection && navigator.connection.saveData;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (this.dataset.preview && !saveData && !reduce && 'IntersectionObserver' in window) {
          this.reelIO = new IntersectionObserver((entries) => {
            entries.forEach((en) => {
              const v = en.target.querySelector('video');
              if (!v) return;
              if (en.isIntersecting && !(this.modal && this.modal.open)) {
                const p = v.play();
                if (p && p.catch) p.catch(() => {});
              } else {
                v.pause();
                if (en.target.classList.contains('is-sound')) this.setSound(en.target, false);
              }
            });
          }, { threshold: 0.5 });
          this.observeReels();
        }
      }

      setSound(reel, on) {
        const v = reel.querySelector('video');
        if (v) v.muted = !on;
        reel.classList.toggle('is-sound', on);
        const btn = reel.querySelector('.bz-hist__reel-sound');
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.setAttribute('aria-label', on ? 'Silenciar' : 'Activar sonido');
      }

      toggleSound(i) {
        const reel = this.reels[i];
        const on = !reel.classList.contains('is-sound');
        this.reels.forEach((r) => { if (r !== reel) this.setSound(r, false); });
        this.setSound(reel, on);
        const v = reel.querySelector('video');
        if (on && v) {
          const p = v.play();
          if (p && p.catch) p.catch(() => {});
        }
      }

      observeReels() {
        if (!this.reelIO) return;
        this.reels.forEach((r) => { this.reelIO.unobserve(r); this.reelIO.observe(r); });
      }

      openReel(index) {
        const n = this.reels.length;
        this.reelIndex = ((index % n) + n) % n;
        const src = this.reels[this.reelIndex].querySelector('video');
        if (!src) return;
        this.reels.forEach((r) => { const v = r.querySelector('video'); if (v) v.pause(); this.setSound(r, false); });
        const v = this.modalVideo;
        v.pause();
        v.innerHTML = src.innerHTML;
        if (src.getAttribute('poster')) v.setAttribute('poster', src.getAttribute('poster'));
        v.muted = false;
        v.load();
        if (!this.modal.open) {
          if (typeof this.modal.showModal === 'function') this.modal.showModal(); else this.modal.setAttribute('open', '');
        }
        const p = v.play();
        if (p && p.catch) p.catch(() => {});
      }

      closeReel() {
        this.modalVideo.pause();
        if (typeof this.modal.close === 'function') this.modal.close(); else this.modal.removeAttribute('open');
      }

      disconnectedCallback() {
        if (this.reelIO) this.reelIO.disconnect();
        clearInterval(this.timer);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      show(index, byUser, focus) {
        const n = this.panels.length;
        this.active = ((index % n) + n) % n;
        if (byUser) clearInterval(this.timer);
        this.tabs.forEach((tab, i) => {
          const on = i === this.active;
          tab.classList.toggle('is-active', on);
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.tabIndex = on ? 0 : -1;
          if (on && focus) tab.focus();
        });
        this.panels.forEach((panel, i) => {
          const on = i === this.active;
          panel.classList.toggle('is-active', on);
          panel.hidden = !on;
        });
      }
    });
  }
</script>

