{%- comment -%}
  DR WOMAN · Bronze · Historias / testimonios interactivos
  Sección nativa: Editar código > Secciones > Agregar sección "bronze-historias" y pegar este archivo.
  Después: Personalizar > Agregar sección > "Bronze · Historias".
  Cada historia es un bloque (avatar, foto antes, foto después, nombre, relato, etiquetas, uso y nota).
  Arriba: tira de videos UGC (bloques "Video" o metacampo del producto custom.videos_ugc).
  Si el avatar queda vacío se usa la foto "después". Tipografía editable desde el editor (Poppins por defecto, o la del tema).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign historias = section.blocks | where: 'type', 'historia'
  assign total = historias.size

  # Videos UGC: bloques "Video" del editor o lista de videos cargada en el producto (metacampo)
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign usar_producto = false
  if s.videos_origen == 'producto'
    assign usar_producto = true
  elsif s.videos_origen == 'auto' and video_blocks.size == 0
    assign usar_producto = true
  endif
  assign mf_videos = blank
  if usar_producto and product
    assign mf_key = s.videos_metafield | default: 'custom.videos_ugc' | strip | split: '.'
    if mf_key.size == 2
      assign mf_videos = product.metafields[mf_key[0]][mf_key[1]].value
    endif
  endif
  assign reel_count = 0
  if usar_producto
    for v in mf_videos
      if v.media_type == 'video'
        assign reel_count = reel_count | plus: 1
      endif
    endfor
  else
    for block in video_blocks
      if block.settings.video != blank
        assign reel_count = reel_count | plus: 1
      endif
    endfor
  endif
  assign autoplay = s.autoplay
  if request.design_mode
    assign autoplay = 0
  endif

  # Fotos de ejemplo (las del diseño original) para las 3 primeras historias mientras no tengan foto elegida
  assign fb_antes = 'https://cdn.shopify.com/s/files/1/0789/3421/2779/files/Diseno_sin_titulo_10_fc9108a9-6ad4-4a4e-b219-ea218f0f1a80.png?v=1788268808|https://cdn.shopify.com/s/files/1/0789/3421/2779/files/Diseno_sin_titulo_11.png?v=1788268816|https://cdn.shopify.com/s/files/1/0789/3421/2779/files/Diseno_sin_titulo_14_d8980f01-0274-4107-b062-4547383e2dee.png?v=1788268816' | split: '|'
  assign fb_despues = 'https://cdn.shopify.com/s/files/1/0789/3421/2779/files/Diseno_sin_titulo_9_22719434-a501-445c-8913-cd0042a99bf1.png?v=1788268808|https://cdn.shopify.com/s/files/1/0789/3421/2779/files/Diseno_sin_titulo_12_30de7d5a-1cc6-4df1-9ac2-bb71a70f4924.png?v=1788268815|https://cdn.shopify.com/s/files/1/0789/3421/2779/files/Diseno_sin_titulo_13_6d66048d-aeaa-4a93-8f8f-9ef36010ff90.png?v=1788268815' | split: '|'
  assign img_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 30vw, 50vw'
-%}

<style>
  #bz-hist-{{ section.id }} {
    --bzh-cobre: {{ s.color_cobre }};
    --bzh-cobre-dark: {{ s.color_cobre_dark }};
    --bzh-tag-1: {{ s.color_tag_1 }};
    --bzh-tag-2: {{ s.color_tag_2 }};
    --bzh-card: {{ s.color_card }};
    --bzh-texto: {{ s.color_texto }};
    --bzh-texto-soft: {{ s.color_texto | color_modify: 'alpha', 0.48 }};
    --bzh-borde: {{ s.color_cobre | color_modify: 'alpha', 0.2 }};
    --bzh-pt: {{ s.padding_top }}px;
    --bzh-pb: {{ s.padding_bottom }}px;
    --bzh-max: {{ s.max_width }}px;
    --bzh-reel-w: {{ s.reel_ancho }}px;
    --bzh-reel-w-mob: {{ s.reel_ancho_mobile }}vw;
    {%- if s.color_bg != blank and s.color_bg.alpha > 0 %}
    --bzh-bg: {{ s.color_bg }};
    {%- endif %}
  }
</style>

{%- if section.settings.evitar_scroll_lateral -%}
<style>
  /* Evita que cualquier bloque de la página genere scroll hacia la derecha (franja blanca). */
  html, body { overflow-x: hidden; }
  @supports (overflow-x: clip) { html, body { overflow-x: clip; } }
</style>
{%- endif -%}

{%- liquid
  assign f_t = section.settings.font_titulo
  assign f_b = section.settings.font_texto
  assign f_b_500 = f_b | font_modify: 'weight', '500'
  assign f_b_600 = f_b | font_modify: 'weight', '600'
  assign f_b_700 = f_b | font_modify: 'weight', 'bold'
  assign f_b_i = f_b | font_modify: 'style', 'italic'
-%}
{%- unless section.settings.usar_fuente_tema -%}
<style>
  {{ f_t | font_face: font_display: 'swap' }}
  {{ f_b | font_face: font_display: 'swap' }}
  {{ f_b_500 | font_face: font_display: 'swap' }}
  {{ f_b_600 | font_face: font_display: 'swap' }}
  {{ f_b_700 | font_face: font_display: 'swap' }}
  {{ f_b_i | font_face: font_display: 'swap' }}
  #bz-hist-{{ section.id }} {
    --bzh-ft: "{{ f_t.family }}", {{ f_t.fallback_families }};
    --bzh-ft-w: {{ f_t.weight }};
    --bzh-fb: "{{ f_b.family }}", {{ f_b.fallback_families }};
  }
</style>
{%- endunless -%}

<bronze-historias
  id="bz-hist-{{ section.id }}"
  class="bz-hist"
  data-autoplay="{{ autoplay }}"
  data-preview="{% if s.vista_previa %}1{% endif %}"
  {%- unless s.vista_previa %} data-no-preview{% endunless %}
>
  <div class="bz-hist__contenedor">
    {%- if s.subtitulo != blank or s.titulo != blank -%}
      <div class="bz-hist__head">
        {%- if s.subtitulo != blank -%}<p class="bz-hist__kicker">{{ s.subtitulo }}</p>{%- endif -%}
        {%- if s.titulo != blank -%}<h2 class="bz-hist__titulo">{{ s.titulo }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if reel_count > 0 -%}
      <div class="bz-hist__reels">
        {%- if s.videos_titulo != blank or s.videos_sub != blank -%}
          <div class="bz-hist__reels-head">
            {%- if s.videos_titulo != blank -%}<p class="bz-hist__reels-titulo">{{ s.videos_titulo }}</p>{%- endif -%}
            {%- if s.videos_sub != blank -%}<p class="bz-hist__reels-sub">{{ s.videos_sub }}</p>{%- endif -%}
          </div>
        {%- endif -%}
        <ul class="bz-hist__reels-track" role="list">
          {%- if usar_producto -%}
            {%- for v in mf_videos -%}
              {%- if v.media_type != 'video' -%}{%- continue -%}{%- endif -%}
              <li class="bz-hist__reel">
                <div class="bz-hist__reel-card">
                  {{ v | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', controls: false, image_size: '540x', class: 'bz-hist__reel-video' }}
                  <span class="bz-hist__reel-bar" aria-hidden="true"><i></i></span>
                  <span class="bz-hist__reel-play" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4a.8.8 0 0 0 1.2.7l9.6-6.2a.8.8 0 0 0 0-1.4L9.7 5.1a.8.8 0 0 0-1.2.7z"/></svg></span>
                  <span class="bz-hist__reel-info">
                    {%- if s.estrellas_producto -%}<span class="bz-hist__reel-stars" aria-label="5 estrellas">★★★★★</span>{%- endif -%}
                    
                  </span>
                  <button type="button" class="bz-hist__reel-open" aria-label="Ver video {{ forloop.index }} en grande"><span class="bz-hist__reel-expand"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4.5h5v5M9.5 19.5h-5v-5M19.5 4.5l-6 6M4.5 19.5l6-6"/></svg></span></button>
                  <button type="button" class="bz-hist__reel-sound" aria-label="Activar sonido" aria-pressed="false"><svg class="ico-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.6v12.8l-4.8-3.9H4z"/><path d="M16 9.5l4.5 5M20.5 9.5l-4.5 5"/></svg><svg class="ico-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.6v12.8l-4.8-3.9H4z"/><path d="M15.5 9a4.2 4.2 0 0 1 0 6M18.2 6.5a8 8 0 0 1 0 11"/></svg></button>
                </div>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for block in video_blocks -%}
              {%- assign vb = block.settings -%}
              {%- if vb.video == blank -%}{%- continue -%}{%- endif -%}
              <li class="bz-hist__reel" {{ block.shopify_attributes }}>
                <div class="bz-hist__reel-card">
                  {{ vb.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', controls: false, image_size: '540x', class: 'bz-hist__reel-video' }}
                  <span class="bz-hist__reel-bar" aria-hidden="true"><i></i></span>
                  <span class="bz-hist__reel-play" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4a.8.8 0 0 0 1.2.7l9.6-6.2a.8.8 0 0 0 0-1.4L9.7 5.1a.8.8 0 0 0-1.2.7z"/></svg></span>
                  <span class="bz-hist__reel-info">
                    {%- if vb.estrellas -%}<span class="bz-hist__reel-stars" aria-label="5 estrellas">★★★★★</span>{%- endif -%}
                    {%- if vb.texto != blank -%}<span class="bz-hist__reel-cap">{{ vb.texto }}</span>{%- endif -%}
                  </span>
                  <button type="button" class="bz-hist__reel-open" aria-label="Ver video{% if vb.texto != blank %} de {{ vb.texto | escape }}{% endif %} en grande"><span class="bz-hist__reel-expand"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4.5h5v5M9.5 19.5h-5v-5M19.5 4.5l-6 6M4.5 19.5l6-6"/></svg></span></button>
                  <button type="button" class="bz-hist__reel-sound" aria-label="Activar sonido" aria-pressed="false"><svg class="ico-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.6v12.8l-4.8-3.9H4z"/><path d="M16 9.5l4.5 5M20.5 9.5l-4.5 5"/></svg><svg class="ico-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.6v12.8l-4.8-3.9H4z"/><path d="M15.5 9a4.2 4.2 0 0 1 0 6M18.2 6.5a8 8 0 0 1 0 11"/></svg></button>
                </div>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>

      <dialog class="bz-hist__modal" aria-label="Video">
        <div class="bz-hist__modal-box">
          <video class="bz-hist__modal-video" playsinline controls preload="none"></video>
          <button type="button" class="bz-hist__modal-close" aria-label="Cerrar video"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
          <button type="button" class="bz-hist__modal-nav bz-hist__modal-nav--prev" data-dir="-1" aria-label="Video anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 5.5"/></svg></button>
          <button type="button" class="bz-hist__modal-nav bz-hist__modal-nav--next" data-dir="1" aria-label="Video siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6.5L15 12l-5.5 5.5"/></svg></button>
          {%- if s.modal_cta != blank -%}
            <a class="bz-hist__modal-cta" href="{% if s.modal_cta_link != blank %}{{ s.modal_cta_link }}{% else %}#{% endif %}"{% if s.modal_cta_link == blank %} data-scroll-compra{% endif %}>
              <span>{{ s.modal_cta }}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6.5L18.5 12 13 17.5"/></svg>
            </a>
          {%- endif -%}
        </div>
      </dialog>
    {%- elsif request.design_mode -%}
      <div class="bz-hist__reels-vacio">
        {%- if usar_producto -%}
          Para mostrar videos: cargalos en el producto, en el metacampo <b>{{ s.videos_metafield | default: 'custom.videos_ugc' }}</b> (lista de archivos), o agregá bloques "Video" a esta sección.
        {%- else -%}
          Elegí un video en cada bloque "Video".
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if total > 0 -%}
      <div class="bz-hist__selector"{% if total < 2 %} hidden{% endif %}>
        <button type="button" class="bz-hist__flecha" data-dir="-1" aria-label="Historia anterior">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 5.5"/></svg>
        </button>

        <div class="bz-hist__avatares" role="tablist" aria-label="Historias">
          {%- for block in historias -%}
            {%- assign b = block.settings -%}
            {%- assign av = b.avatar | default: b.despues -%}
            {%- assign av_fb = '' -%}
            {%- if av == blank and s.usar_ejemplos and forloop.index0 < 3 -%}{%- assign av_fb = fb_despues[forloop.index0] -%}{%- endif -%}
            <button
              type="button"
              role="tab"
              class="bz-hist__avatar{% if forloop.first %} is-active{% endif %}"
              id="bz-hist-tab-{{ block.id }}"
              aria-controls="bz-hist-panel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Ver historia de {{ b.nombre | escape }}"
              data-index="{{ forloop.index0 }}"
            >
              <span class="bz-hist__halo" aria-hidden="true"></span>
              {%- if av != blank -%}
                {{ av | image_url: width: 160 | image_tag: width: 64, height: 64, loading: 'lazy', alt: '', sizes: '64px', widths: '96, 128, 160' }}
              {%- elsif av_fb != '' -%}
                <img src="{{ av_fb }}&width=128" srcset="{{ av_fb }}&width=96 96w, {{ av_fb }}&width=128 128w, {{ av_fb }}&width=160 160w" sizes="64px" width="64" height="64" loading="lazy" alt="">
              {%- else -%}
                <span class="bz-hist__avatar-ph">{{ forloop.index }}</span>
              {%- endif -%}
            </button>
          {%- endfor -%}
        </div>

        <button type="button" class="bz-hist__flecha" data-dir="1" aria-label="Historia siguiente">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6.5L15 12l-5.5 5.5"/></svg>
        </button>
      </div>

      <div class="bz-hist__track">
        {%- for block in historias -%}
          {%- assign b = block.settings -%}
          <article
            class="bz-hist__historia{% if forloop.first %} is-active{% endif %}"
            id="bz-hist-panel-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="bz-hist-tab-{{ block.id }}"
            data-index="{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="bz-hist__comparativa">
              <div class="bz-hist__foto bz-hist__foto--antes">
                {%- if b.antes != blank -%}
                  {%- assign fp = '' -%}
                  {%- if b.antes.presentation.focal_point != blank -%}{%- assign fp = b.antes.presentation.focal_point | prepend: 'object-position: ' -%}{%- endif -%}
                  {%- capture alt_antes -%}{{ b.nombre }} · {{ s.label_antes }}{%- endcapture -%}
                  {{ b.antes | image_url: width: 1000 | image_tag: loading: 'lazy', alt: alt_antes, sizes: img_sizes, widths: '300, 450, 600, 800, 1000', style: fp }}
                {%- elsif s.usar_ejemplos and forloop.index0 < 3 -%}
                  {%- assign u = fb_antes[forloop.index0] -%}
                  <img src="{{ u }}&width=800" srcset="{{ u }}&width=400 400w, {{ u }}&width=600 600w, {{ u }}&width=800 800w, {{ u }}&width=1000 1000w" sizes="{{ img_sizes }}" width="800" height="1000" loading="lazy" alt="{{ b.nombre | escape }} · {{ s.label_antes | escape }}">
                {%- else -%}
                  <div class="bz-hist__ph"><span>Elegí la foto de antes</span></div>
                {%- endif -%}
                <span class="bz-hist__label">{{ s.label_antes }}</span>
              </div>

              <div class="bz-hist__foto bz-hist__foto--despues">
                {%- if b.despues != blank -%}
                  {%- assign fp = '' -%}
                  {%- if b.despues.presentation.focal_point != blank -%}{%- assign fp = b.despues.presentation.focal_point | prepend: 'object-position: ' -%}{%- endif -%}
                  {%- capture alt_despues -%}{{ b.nombre }} · {{ s.label_despues }}{%- endcapture -%}
                  {{ b.despues | image_url: width: 1000 | image_tag: loading: 'lazy', alt: alt_despues, sizes: img_sizes, widths: '300, 450, 600, 800, 1000', style: fp }}
                {%- elsif s.usar_ejemplos and forloop.index0 < 3 -%}
                  {%- assign u = fb_despues[forloop.index0] -%}
                  <img src="{{ u }}&width=800" srcset="{{ u }}&width=400 400w, {{ u }}&width=600 600w, {{ u }}&width=800 800w, {{ u }}&width=1000 1000w" sizes="{{ img_sizes }}" width="800" height="1000" loading="lazy" alt="{{ b.nombre | escape }} · {{ s.label_despues | escape }}">
                {%- else -%}
                  <div class="bz-hist__ph"><span>Elegí la foto de después</span></div>
                {%- endif -%}
                <span class="bz-hist__label bz-hist__label--despues">{{ s.label_despues }}</span>
                <span class="bz-hist__sun-glow" aria-hidden="true"></span>
              </div>
            </div>

            <div class="bz-hist__contenido">
              <div class="bz-hist__nombre-wrap">
                <h3 class="bz-hist__nombre">{{ b.nombre }}</h3>
                <span class="bz-hist__sol" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.7"/><path d="M12 2.4v2.2M12 19.4v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.4 12h2.2M19.4 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/></svg>
                </span>
              </div>

              {%- if b.relato != blank -%}
                <div class="bz-hist__relato">{{ b.relato }}</div>
              {%- endif -%}

              {%- assign tags = b.etiquetas | split: ',' -%}
              {%- if tags.size > 0 -%}
                <ul class="bz-hist__tags">
                  {%- for t in tags -%}
                    {%- assign tt = t | strip -%}
                    {%- if tt != blank -%}<li>{{ tt }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if b.uso != blank or s.nota != blank -%}
                <div class="bz-hist__footer">
                  {%- if b.uso != blank -%}<p class="bz-hist__uso">{{ b.uso }}</p>{%- endif -%}
                  {%- if s.nota != blank -%}<p class="bz-hist__nota">{{ s.nota }}</p>{%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="bz-hist__vacio">Agregá un bloque "Historia" para mostrar testimonios.</p>
    {%- endif -%}
  </div>
</bronze-historias>

<style>
  .bz-hist {
    display: block;
    width: 100%;
    margin: 0;
    padding: var(--bzh-pt) 30px var(--bzh-pb);
    background: var(--bzh-bg, transparent);
    overflow: hidden;
    overflow: clip;
    color: var(--bzh-texto);
    font-family: var(--bzh-fb, inherit);
    box-sizing: border-box;
  }
  .bz-hist *, .bz-hist *::before, .bz-hist *::after { box-sizing: border-box; font-family: inherit; }
  .bz-hist [hidden] { display: none !important; }
  .bz-hist .bz-hist__contenedor { width: 100%; max-width: var(--bzh-max); margin: 0 auto; }

  .bz-hist .bz-hist__head { text-align: center; margin: 0 auto 22px; max-width: 720px; }
  .bz-hist .bz-hist__kicker { margin: 0 0 6px; color: var(--bzh-cobre); font-size: .78em; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }
  .bz-hist .bz-hist__titulo { font-family: var(--bzh-ft, inherit); font-weight: var(--bzh-ft-w, 700); margin: 0; color: var(--bzh-texto); font-size: 1.9em; line-height: 1.12; }

  /* Selector */
  .bz-hist .bz-hist__selector { width: 100%; max-width: 460px; margin: 0 auto 18px; display: grid; grid-template-columns: 38px minmax(0, 1fr) 38px; align-items: center; gap: 18px; }
  .bz-hist .bz-hist__flecha {
    width: 36px; height: 36px; margin: 0; padding: 0; border: 1px solid var(--bzh-borde); border-radius: 50%;
    background: linear-gradient(145deg, #FFF9F2, #FFE8D1); color: var(--bzh-cobre);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    box-shadow: 0 4px 12px rgba(154, 75, 34, .07), inset 0 1px 0 rgba(255, 255, 255, .9);
    transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
  }
  .bz-hist .bz-hist__flecha svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) {
    .bz-hist .bz-hist__flecha:hover { transform: translateY(-1px); background: linear-gradient(145deg, #FFF0DF, #FFDABB); box-shadow: 0 6px 16px rgba(154, 75, 34, .11); }
  }
  .bz-hist .bz-hist__flecha:focus-visible, .bz-hist .bz-hist__avatar:focus-visible { outline: 2px solid var(--bzh-cobre); outline-offset: 3px; }

  .bz-hist .bz-hist__avatares { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 25px; row-gap: 14px; min-width: 0; padding: 6px 0; }
  .bz-hist .bz-hist__avatar {
    position: relative; isolation: isolate; width: 54px; height: 54px; margin: 0; padding: 3px;
    border: 1px solid var(--bzh-borde); border-radius: 50%; background: #FFF8EF; opacity: .48; cursor: pointer;
    transition: opacity .25s ease, transform .25s ease, border-color .25s ease;
  }
  .bz-hist .bz-hist__halo {
    position: absolute; z-index: -1; inset: -8px; border-radius: 50%; opacity: 0; pointer-events: none;
