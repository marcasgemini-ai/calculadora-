{%- comment -%}
  Bronzer · Reseñas
  Carrusel de reseñas con fotos de antes y después.
  Todo es editable desde Tienda online > Personalizar:
  - Encabezado: bloques Calificación, Subtítulo, Título y Texto (se reordenan arrastrando).
  - Reseñas: un bloque por reseña.
  - Botón: bloque Botón (va debajo del carrusel).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = '#bz-rev-' | append: section.id
  assign header_types = 'calificacion,subtitulo,titulo,texto' | split: ','
  assign review_count = 0
  for block in section.blocks
    if block.type == 'resena'
      assign review_count = review_count | plus: 1
    endif
  endfor
  assign autoplay = s.autoplay
  if request.design_mode
    assign autoplay = false
  endif
-%}

<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}

  {{ sid }} {
    --bz-bg: {{ s.color_bg | default: '#F7EFE6' }};
    --bz-card: {{ s.color_card | default: '#FFFCF8' }};
    --bz-text: {{ s.color_text | default: '#1E140F' }};
    --bz-text-soft: {{ s.color_text | default: '#1E140F' | color_modify: 'alpha', 0.72 }};
    --bz-line: {{ s.color_text | default: '#1E140F' | color_modify: 'alpha', 0.1 }};
    --bz-accent: {{ s.color_accent | default: '#B46F34' }};
    --bz-stars: {{ s.color_stars | default: '#E0A33A' }};
    --bz-btn-bg: {{ s.color_button_bg | default: '#B46F34' }};
    --bz-btn-text: {{ s.color_button_text | default: '#FFFFFF' }};
    --bz-display-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    --bz-display-weight: {{ s.heading_font.weight }};
    --bz-radius: {{ s.card_radius }}px;
    --bz-cols: {{ s.cards_desktop }};
    --bz-pt: {{ s.padding_top }}px;
    --bz-pb: {{ s.padding_bottom }}px;
  }

  {{ sid }}, {{ sid }} *, {{ sid }} *::before, {{ sid }} *::after { box-sizing: border-box; }
  {{ sid }} p, {{ sid }} li, {{ sid }} span { color: inherit; }

  {{ sid }} {
    display: block;
    background: var(--bz-bg);
    color: var(--bz-text);
    padding: calc(var(--bz-pt) * 0.7) 0 calc(var(--bz-pb) * 0.7);
    overflow: hidden;
  }

  /* ---------- Encabezado ---------- */
  {{ sid }} .bz-rev__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 920px;
    margin: 0 auto 36px;
    padding: 0 20px;
    text-align: center;
  }
  {{ sid }} .bz-rev__header > * { margin: 0; }
  {{ sid }} .bz-rev__rating {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  {{ sid }} .bz-rev__stars { display: inline-flex; gap: 3px; }
  {{ sid }} .bz-rev__stars svg { width: 18px; height: 18px; fill: var(--bz-stars); }
  {{ sid }} .bz-rev__eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--bz-accent);
  }
  {{ sid }} .bz-rev__heading {
    font-family: var(--bz-display-font);
    font-weight: var(--bz-display-weight);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--bz-text);
    text-wrap: balance;
  }
  {{ sid }} .bz-rev__heading--medium { font-size: clamp(28px, 7vw, 36px); }
  {{ sid }} .bz-rev__heading--large { font-size: clamp(32px, 8vw, 42px); }
  {{ sid }} .bz-rev__heading em { font-style: italic; color: var(--bz-accent); }
  {{ sid }} .bz-rev__sub {
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--bz-text-soft);
  }
  {{ sid }} .bz-rev__sub p { margin: 0; }
  {{ sid }} .bz-rev__sub p + p { margin-top: 0.6em; }

  /* ---------- Carrusel ---------- */
  {{ sid }} .bz-rev__track {
    position: relative;
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 8px 20px 44px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 20px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  {{ sid }} .bz-rev__track::-webkit-scrollbar { display: none; }
  {{ sid }} .bz-rev__slide {
    flex: 0 0 86%;
    scroll-snap-align: start;
    display: flex;
  }
  {{ sid }}.bz-rev--mobile-full .bz-rev__slide { flex-basis: 100%; }

  /* ---------- Tarjeta ---------- */
  {{ sid }} .bz-rev__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border-radius: var(--bz-radius);
    background: var(--bz-card);
    border: 1px solid var(--bz-line);
  }
  {{ sid }}.bz-rev--shadow .bz-rev__card { box-shadow: 0 18px 36px -26px rgba(30, 20, 15, 0.35); }

  {{ sid }} .bz-rev__ba {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    aspect-ratio: 8 / 5;
    background: var(--bz-card);
  }
  {{ sid }}.bz-rev--ratio-square .bz-rev__ba { aspect-ratio: 1 / 1; }
  {{ sid }}.bz-rev--ratio-portrait .bz-rev__ba { aspect-ratio: 4 / 5; }
  {{ sid }} .bz-rev__ba--single { grid-template-columns: 1fr; }
  {{ sid }} .bz-rev__photo { position: relative; overflow: hidden; background: #e9dccd; }
  {{ sid }} .bz-rev__photo img,
  {{ sid }} .bz-rev__photo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  {{ sid }} .bz-rev__photo svg { fill: rgba(30, 20, 15, 0.18); }
  {{ sid }} .bz-rev__label {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 1;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    color: #fff;
    background: rgba(20, 13, 9, 0.45);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  {{ sid }} .bz-rev__label--after { background: var(--bz-accent); }
  {{ sid }} .bz-rev__arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bz-card);
    color: var(--bz-accent);
    box-shadow: 0 6px 16px -6px rgba(30, 20, 15, 0.4);
  }
  {{ sid }} .bz-rev__arrow svg { width: 16px; height: 16px; }

  {{ sid }} .bz-rev__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    gap: 12px;
    padding: 24px 22px 26px;
    text-align: center;
  }
  {{ sid }}.bz-rev--align-left .bz-rev__body,
  {{ sid }}.bz-rev--align-left .bz-rev__author { align-items: flex-start; text-align: left; }
  {{ sid }} .bz-rev__body > * { margin: 0; }
  {{ sid }} .bz-rev__card .bz-rev__stars svg { width: 16px; height: 16px; }
  {{ sid }} .bz-rev__title {
    font-family: var(--bz-display-font);
    font-weight: var(--bz-display-weight);
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--bz-text);
  }
  {{ sid }} .bz-rev__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--bz-text-soft);
  }
  {{ sid }} .bz-rev__text p { margin: 0; }
  {{ sid }} .bz-rev__text p + p { margin-top: 0.6em; }
  {{ sid }} .bz-rev__author {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  {{ sid }} .bz-rev__name { font-size: 15px; font-weight: 700; }
  {{ sid }} .bz-rev__detail { font-size: 12px; letter-spacing: 0.04em; color: var(--bz-text-soft); }
  {{ sid }} .bz-rev__verified {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--bz-text-soft);
  }
  {{ sid }} .bz-rev__verified svg { width: 16px; height: 16px; color: var(--bz-accent); }

  /* ---------- Controles ---------- */
  {{ sid }} .bz-rev__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 0 20px;
  }
  {{ sid }} .bz-rev__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--bz-text);
    color: var(--bz-bg);
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  {{ sid }} .bz-rev__nav:hover { transform: scale(1.06); }
  {{ sid }} .bz-rev__nav[disabled] { opacity: 0.25; cursor: default; transform: none; }
  {{ sid }} .bz-rev__nav svg { width: 18px; height: 18px; }
  {{ sid }} .bz-rev__dots { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  {{ sid }} .bz-rev__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--bz-line);
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  {{ sid }} .bz-rev__dot[aria-current="true"] { width: 26px; background: var(--bz-accent); }

  {{ sid }} .bz-rev__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    padding: 0 20px;
  }
  {{ sid }} .bz-rev__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 420px;
    min-height: 58px;
    padding: 0 28px;
    border-radius: 12px;
    border: 1.5px solid var(--bz-btn-bg);
    background: var(--bz-btn-bg);
    color: var(--bz-btn-text);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: transform 0.25s ease, filter 0.25s ease;
  }
  {{ sid }} .bz-rev__button--outline { background: transparent; color: var(--bz-btn-bg); }
  {{ sid }} .bz-rev__button:hover { transform: translateY(-2px); filter: brightness(1.08); }
  {{ sid }} .bz-rev__note { margin: 0; font-size: 12px; letter-spacing: 0.06em; color: var(--bz-text-soft); }

  /* ---------- Tablet ---------- */
  @media screen and (min-width: 750px) {
    {{ sid }} { padding: var(--bz-pt) 0 var(--bz-pb); }
    {{ sid }} .bz-rev__header { margin-bottom: 48px; gap: 16px; }
    {{ sid }} .bz-rev__eyebrow { font-size: 12px; }
    {{ sid }} .bz-rev__heading--medium { font-size: clamp(34px, 4vw, 48px); }
    {{ sid }} .bz-rev__heading--large { font-size: clamp(40px, 5vw, 64px); }
    {{ sid }} .bz-rev__sub { font-size: 18px; }
    {{ sid }} .bz-rev__track {
      --bz-gutter: max(40px, calc((100vw - 1240px) / 2));
      gap: 24px;
      padding: 8px var(--bz-gutter) 48px;
      scroll-padding: 0 var(--bz-gutter);
    }
    {{ sid }} .bz-rev__slide,
    {{ sid }}.bz-rev--mobile-full .bz-rev__slide { flex-basis: calc((100vw - var(--bz-gutter) * 2 - 24px) / 2); }
    {{ sid }} .bz-rev__title { font-size: 24px; }
  }

  /* ---------- Escritorio ---------- */
  @media screen and (min-width: 1100px) {
    {{ sid }} .bz-rev__slide,
    {{ sid }}.bz-rev--mobile-full .bz-rev__slide {
      flex-basis: calc((100vw - var(--bz-gutter) * 2 - 24px * (var(--bz-cols) - 1)) / var(--bz-cols));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    {{ sid }} .bz-rev__track { scroll-behavior: auto; }
  }
</style>

<bz-reviews
  id="bz-rev-{{ section.id }}"
  class="bz-rev bz-rev--ratio-{{ s.image_ratio }} bz-rev--align-{{ s.text_align }}{% if s.mobile_layout == 'full' %} bz-rev--mobile-full{% endif %}{% if s.card_shadow %} bz-rev--shadow{% endif %}"
  {% if autoplay %}data-autoplay="{{ s.autoplay_speed | times: 1000 }}"{% endif %}
>
  {%- capture header -%}
    {%- for block in section.blocks -%}
      {%- unless header_types contains block.type -%}{%- continue -%}{%- endunless -%}
      {%- case block.type -%}
        {%- when 'calificacion' -%}
          <div class="bz-rev__rating" {{ block.shopify_attributes }}>
            {%- if block.settings.show_stars -%}
              <span class="bz-rev__stars" aria-hidden="true">
                {%- for i in (1..block.settings.stars) -%}
                  <svg viewBox="0 0 24 24"><path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.4 6.6L12 17.2l-5.9 3.3 1.4-6.6-5-4.5 6.6-.7z"/></svg>
                {%- endfor -%}
              </span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- when 'subtitulo' -%}
          <p class="bz-rev__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'titulo' -%}
          <h2 class="bz-rev__heading bz-rev__heading--{{ block.settings.size }}" {{ block.shopify_attributes }}>
            {{- block.settings.heading -}}
          </h2>
        {%- when 'texto' -%}
          <div class="bz-rev__sub" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- endcase -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if header != blank -%}
    <div class="bz-rev__header">{{ header }}</div>
  {%- endif -%}

  <ul class="bz-rev__track" role="list" data-track>
    {%- for block in section.blocks -%}
      {%- if block.type != 'resena' -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign b = block.settings
        assign label_before = b.label_before | default: s.label_before
        assign label_after = b.label_after | default: s.label_after
        assign single = false
        if b.image_before == blank and b.image_after != blank
          assign single = true
        endif
      -%}
      <li class="bz-rev__slide" data-slide {{ block.shopify_attributes }}>
        <article class="bz-rev__card">
          {%- if b.show_photos -%}
            <div class="bz-rev__ba{% if single %} bz-rev__ba--single{% endif %}">
              {%- unless single -%}
                <div class="bz-rev__photo">
                  {%- if b.image_before != blank -%}
                    {{
                      b.image_before
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600, 800',
                        sizes: '(min-width: 1100px) 300px, (min-width: 750px) 25vw, 45vw',
                        alt: b.image_before.alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag }}
                  {%- endif -%}
                  {%- if label_before != blank -%}
                    <span class="bz-rev__label">{{ label_before | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endunless -%}
              <div class="bz-rev__photo">
                {%- if b.image_after != blank -%}
                  {{
                    b.image_after
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 800',
                      sizes: '(min-width: 1100px) 300px, (min-width: 750px) 25vw, 45vw',
                      alt: b.image_after.alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
                {%- if label_after != blank -%}
                  <span class="bz-rev__label bz-rev__label--after">{{ label_after | escape }}</span>
                {%- endif -%}
              </div>
              {%- if s.show_ba_arrow and single == false -%}
                <span class="bz-rev__arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="bz-rev__body">
            {%- if b.stars > 0 -%}
              <span class="bz-rev__stars" role="img" aria-label="{{ b.stars }} de 5 estrellas">
                {%- for i in (1..b.stars) -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.4 6.6L12 17.2l-5.9 3.3 1.4-6.6-5-4.5 6.6-.7z"/></svg>
                {%- endfor -%}
              </span>
            {%- endif -%}
            {%- if b.title != blank -%}
              <h3 class="bz-rev__title">{{ b.title | escape }}</h3>
            {%- endif -%}
            {%- if b.text != blank -%}
              <div class="bz-rev__text">{{ b.text }}</div>
            {%- endif -%}
            <div class="bz-rev__author">
              {%- if b.author != blank -%}
                <span class="bz-rev__name">{{ b.author | escape }}</span>
              {%- endif -%}
              {%- if b.detail != blank -%}
                <span class="bz-rev__detail">{{ b.detail | escape }}</span>
              {%- endif -%}
              {%- if b.verified and s.verified_text != blank -%}
                <span class="bz-rev__verified">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.4 1.8 3-.2.9 2.9 2.5 1.7-1 2.8 1 2.8-2.5 1.7-.9 2.9-3-.2L12 22l-2.4-1.8-3 .2-.9-2.9-2.5-1.7 1-2.8-1-2.8 2.5-1.7.9-2.9 3 .2z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>
                  {{ s.verified_text | escape }}
                </span>
              {%- endif -%}
            </div>
          </div>
        </article>
      </li>
    {%- endfor -%}
  </ul>

  {%- liquid
    assign show_controls = false
    if review_count > 1
      if s.show_arrows or s.show_dots
        assign show_controls = true
      endif
    endif
  -%}
  {%- if show_controls -%}
    <div class="bz-rev__controls">
      {%- if s.show_arrows -%}
        <button type="button" class="bz-rev__nav" data-prev aria-label="Reseña anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
      {%- endif -%}
      {%- if s.show_dots -%}
        <div class="bz-rev__dots" data-dots>
          {%- for i in (1..review_count) -%}
            <button type="button" class="bz-rev__dot" aria-label="Ir a la reseña {{ i }}"{% if i == 1 %} aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if s.show_arrows -%}
        <button type="button" class="bz-rev__nav" data-next aria-label="Reseña siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'boton' and block.settings.label != blank -%}
      <div class="bz-rev__footer" {{ block.shopify_attributes }}>
        <a
          href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#oferta{% endif %}"
          class="bz-rev__button bz-rev__button--{{ block.settings.style }}"
        >
          {{- block.settings.label | escape -}}
        </a>
        {%- if block.settings.note != blank -%}
          <p class="bz-rev__note">{{ block.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
</bz-reviews>

<script>
  if (!customElements.get('bz-reviews')) {
    customElements.define('bz-reviews', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.slides = Array.from(this.querySelectorAll('[data-slide]'));
        this.prev = this.querySelector('[data-prev]');
        this.next = this.querySelector('[data-next]');
        this.dots = Array.from(this.querySelectorAll('[data-dots] button'));
        if (!this.track || !this.slides.length) return;

        this.onScroll = () => {
          cancelAnimationFrame(this.raf);
          this.raf = requestAnimationFrame(() => this.update());
        };
        this.track.addEventListener('scroll', this.onScroll, { passive: true });
        window.addEventListener('resize', this.onScroll);
        if (this.prev) this.prev.addEventListener('click', () => this.go(this.index() - 1));
        if (this.next) this.next.addEventListener('click', () => this.go(this.index() + 1));
        this.dots.forEach((dot, i) => dot.addEventListener('click', () => this.go(i)));
        this.addEventListener('shopify:block:select', (event) => {
          const i = this.slides.indexOf(event.target);
          if (i > -1) this.go(i);
        });

        const delay = parseInt(this.dataset.autoplay, 10);
        if (delay > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const stop = () => clearInterval(this.timer);
          const start = () => {
            stop();
            this.timer = setInterval(() => (this.atEnd() ? this.go(0) : this.go(this.index() + 1)), delay);
          };
          ['pointerenter', 'focusin', 'touchstart'].forEach((e) => this.addEventListener(e, stop, { passive: true }));
          ['pointerleave', 'focusout'].forEach((e) => this.addEventListener(e, start));
          start();
        }
        this.update();
      }

      disconnectedCallback() {
        window.removeEventListener('resize', this.onScroll);
        clearInterval(this.timer);
      }

      pad() {
        return parseFloat(getComputedStyle(this.track).paddingLeft) || 0;
      }

      index() {
        const start = this.track.scrollLeft;
        const pad = this.pad();
        let best = 0;
        let min = Infinity;
        this.slides.forEach((slide, i) => {
          const d = Math.abs(slide.offsetLeft - pad - start);
          if (d < min) { min = d; best = i; }
        });
        return best;
      }

      atEnd() {
        return this.track.scrollLeft + this.track.clientWidth >= this.track.scrollWidth - 4;
      }

      go(i) {
        const target = this.slides[Math.max(0, Math.min(i, this.slides.length - 1))];
        this.track.scrollTo({ left: target.offsetLeft - this.pad() });
      }

      update() {
        const i = this.index();
        this.dots.forEach((dot, n) => dot.setAttribute('aria-current', n === i ? 'true' : 'false'));
        if (this.prev) this.prev.disabled = this.track.scrollLeft <= 4;
        if (this.next) this.next.disabled = this.atEnd();
      }
    });
  }
</script>

