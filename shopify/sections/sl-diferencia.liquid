{%- comment -%}
  SUAVELAND · CLOUD SOCKS · SECCIÓN "LA DIFERENCIA"
  Sección nativa · Imágenes desde el editor · Estilos del theme
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .sl-dif__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.8rem;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .sl-dif__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 6rem;
    }
    .sl-dif__grid--small { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
    .sl-dif__grid--large { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
    .sl-dif__grid--reverse .sl-dif__media { order: 2; }
  }

  .sl-dif__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--media-radius, 0);
    background: rgba(var(--color-foreground, 0, 0, 0), 0.04);
  }
  .sl-dif__media--square { aspect-ratio: 1 / 1; }
  .sl-dif__media--portrait { aspect-ratio: 4 / 5; }
  .sl-dif__media img,
  .sl-dif__media .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sl-dif__media--adapt img { height: auto; }

  .sl-dif__content > * + * { margin-top: 1.6rem; }
  .sl-dif__content > :first-child { margin-top: 0; }
  .sl-dif__content--center { text-align: center; }
  .sl-dif__content .sl-dif__heading { margin-bottom: 0; }

  .sl-dif__list {
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    border-top: 0.1rem solid rgba(var(--color-foreground, 0, 0, 0), 0.1);
    text-align: left;
  }
  .sl-dif__item {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin: 0;
    padding: 1.4rem 0;
    border-bottom: 0.1rem solid rgba(var(--color-foreground, 0, 0, 0), 0.1);
  }
  .sl-dif__icon {
    flex: 0 0 auto;
    width: var(--sl-icon-size, 3rem);
    height: var(--sl-icon-size, 3rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sl-dif__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sl-dif__icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sl-dif__buttons { margin-top: 3rem; }

  /* CTA tipo píldora */
  .sl-dif__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.6rem;
    padding: 1.4rem 4rem;
    border: 0;
    border-radius: 10rem;
    background: var(--sl-cta-bg, #2B2B2B);
    color: var(--sl-cta-text, #FFFFFF);
    font-family: var(--font-body-family);
    font-weight: var(--font-body-weight-bold, 700);
    font-size: 1.6rem;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: opacity .2s ease, transform .2s ease;
  }
  .sl-dif__cta:hover { opacity: .9; transform: translateY(-1px); }
  .sl-dif__cta:focus-visible { outline: 0.2rem solid var(--sl-cta-bg, #2B2B2B); outline-offset: 0.3rem; }

  /* MOBILE: margen lateral para que nada toque el borde */
  @media screen and (max-width: 749px) {
    .sl-dif.page-width { padding-left: 2rem; padding-right: 2rem; }
    .sl-dif__item { align-items: flex-start; }
    .sl-dif__icon { margin-top: 0.2rem; }
    .sl-dif__cta { width: 100%; padding-left: 2rem; padding-right: 2rem; }
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="sl-dif page-width section-{{ section.id }}-padding">
    <div class="sl-dif__grid sl-dif__grid--{{ section.settings.image_width }}{% if section.settings.layout == 'text_first' %} sl-dif__grid--reverse{% endif %}">

      <div class="sl-dif__media sl-dif__media--{{ section.settings.image_ratio }}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 50vw, 100vw',
              widths: '375, 550, 750, 1000, 1250, 1500',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="sl-dif__content sl-dif__content--{{ section.settings.content_alignment }}">
        {%- if section.settings.caption != blank -%}
          <p class="caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="sl-dif__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sl-dif__list" role="list" style="--sl-icon-size: {{ section.settings.icon_size | divided_by: 10.0 }}rem;">
            {%- for block in section.blocks -%}
              <li class="sl-dif__item" {{ block.shopify_attributes }}>
                <span class="sl-dif__icon" aria-hidden="true">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.5l3 3 6-6.5"/></svg>
                  {%- endif -%}
                </span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="sl-dif__buttons">
            <a
              href="{{ section.settings.button_link | default: '#' }}"
              class="sl-dif__cta"
              style="--sl-cta-bg: {{ section.settings.button_bg }}; --sl-cta-text: {{ section.settings.button_text_color }};"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "La diferencia",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "default": "square",
      "options": [
        { "value": "adapt", "label": "Adaptar a la imagen" },
        { "value": "square", "label": "Cuadrada" },
        { "value": "portrait", "label": "Vertical" }
      ]
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Ancho de la imagen en escritorio",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Pequeño" },
        { "value": "medium", "label": "Mediano" },
        { "value": "large", "label": "Grande" }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Ubicación de la imagen en escritorio",
      "default": "image_first",
      "options": [
        { "value": "image_first", "label": "Imagen primero" },
        { "value": "text_first", "label": "Imagen segunda" }
      ]
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Subtítulo",
      "default": "La diferencia"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Encabezado",
      "default": "¿Por qué seguimos usando medias que incomodan?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del encabezado",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Estamos acostumbrados a que una media apriete, acumule humedad y termine resultando incómoda. <strong>Cloud Socks™</strong> fue creada para cambiar esa experiencia.</p>"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación del contenido",
      "default": "left",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Tamaño de los íconos",
      "default": 30
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Etiqueta del botón",
      "default": "Quiero probar Cloud Socks™"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    { "type": "color", "id": "button_bg", "label": "Color del botón", "default": "#2B2B2B" },
    { "type": "color", "id": "button_text_color", "label": "Color del texto del botón", "default": "#FFFFFF" },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de colores",
      "default": "background-2",
      "options": [
        { "value": "accent-1", "label": "Acento 1" },
        { "value": "accent-2", "label": "Acento 2" },
        { "value": "background-1", "label": "Fondo 1" },
        { "value": "background-2", "label": "Fondo 2" },
        { "value": "inverse", "label": "Inverso" }
      ]
    },
    {
      "type": "header",
      "content": "Relleno de sección"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Ícono",
          "info": "Si no elegís uno se muestra un check"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texto",
          "default": "Beneficio"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "La diferencia",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Dedos más libres y sin sensación de presión." } },
        { "type": "benefit", "settings": { "text": "Pies más secos y frescos durante todo el día." } },
        { "type": "benefit", "settings": { "text": "Más comodidad desde que te las ponés." } }
      ]
    }
  ]
}
{% endschema %}
