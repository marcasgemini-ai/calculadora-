{%- comment -%}
  SUAVELAND · CLOUD SOCKS · SECCIÓN "LA DIFERENCIA"
  Sección nativa · Tipografía, títulos y botón heredados del theme
{%- endcomment -%}

{%- style -%}
  #sl-dif-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
    {%- if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' -%}
      background: {{ section.settings.bg_color }};
    {%- endif -%}
  }
  @media screen and (min-width: 750px) {
    #sl-dif-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .sl-dif, .sl-dif * { box-sizing: border-box; }

  .sl-dif__container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .9fr);
    align-items: center;
    gap: 72px;
  }
  .sl-dif--reverse .sl-dif__media { order: 2; }

  /* IMAGEN */
  .sl-dif__media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 24px;
    overflow: hidden;
    background: rgba(0, 0, 0, .04);
  }
  .sl-dif__media img,
  .sl-dif__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* CONTENIDO: sin fuentes ni tamaños fijos, los pone el theme */
  .sl-dif__content { max-width: 520px; }

  .sl-dif__eyebrow { margin: 0 0 10px; }
  .sl-dif__title { margin: 0 0 18px; }
  .sl-dif__description { margin: 0 0 26px; }
  .sl-dif__description p { margin: 0 0 10px; }
  .sl-dif__description p:last-child { margin-bottom: 0; }

  /* BENEFICIOS */
  .sl-dif__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(0, 0, 0, .10);
  }
  .sl-dif__benefit {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 15px 0;
    border-bottom: 1px solid rgba(0, 0, 0, .10);
    line-height: 1.45;
  }
  .sl-dif__benefit::before,
  .sl-dif__benefit::marker { content: none; display: none; }

  .sl-dif__icon {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sl-dif__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* BOTÓN: usa el estilo de botón del theme */
  .sl-dif__button { margin-top: 30px; }

  /* TABLET */
  @media screen and (min-width: 750px) and (max-width: 999px) {
    .sl-dif__container { gap: 42px; }
  }

  /* MOBILE */
  @media screen and (max-width: 749px) {
    .sl-dif__container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 28px;
    }
    .sl-dif--reverse .sl-dif__media { order: 0; }
    .sl-dif__media { border-radius: 18px; }
    .sl-dif__content { max-width: 100%; }
    .sl-dif__benefit { gap: 12px; padding: 13px 0; }
    .sl-dif__icon { flex-basis: 26px; width: 26px; height: 26px; }
    .sl-dif__button { width: 100%; margin-top: 25px; }
  }
</style>

<div
  id="sl-dif-{{ section.id }}"
  class="sl-dif color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="sl-dif__container{% if section.settings.image_right %} sl-dif--reverse{% endif %}">

      <div class="sl-dif__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '375, 550, 750, 1000, 1200, 1400',
              alt: section.settings.image.alt
          }}
        {%- elsif section.settings.image_url != blank -%}
          <img
            src="{{ section.settings.image_url }}"
            alt="Cloud Socks™"
            loading="lazy"
            decoding="async"
            width="1200"
            height="1200"
          >
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </div>

      <div class="sl-dif__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="sl-dif__eyebrow caption-with-letter-spacing">
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="sl-dif__title {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="sl-dif__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sl-dif__benefits" role="list">
            {%- for block in section.blocks -%}
              <li class="sl-dif__benefit" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank or block.settings.icon_url != blank -%}
                  <span class="sl-dif__icon" aria-hidden="true">
                    {%- if block.settings.icon != blank -%}
                      {{ block.settings.icon | image_url: width: 90 | image_tag: loading: 'lazy', alt: '', width: 30, height: 30 }}
                    {%- else -%}
                      <img src="{{ block.settings.icon_url }}" alt="" loading="lazy" decoding="async" width="30" height="30">
                    {%- endif -%}
                  </span>
                {%- endif -%}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            class="sl-dif__button button button--primary"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "La diferencia",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "text",
      "id": "image_url",
      "label": "URL de imagen (si no elegís una arriba)",
      "default": "https://cdn.shopify.com/s/files/1/0838/4738/1165/files/Calcetines_Cloud_junto_al_lago_montanoso.png?v=1791156631"
    },
    { "type": "checkbox", "id": "image_right", "label": "Imagen a la derecha (escritorio)", "default": false },

    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Subtítulo", "default": "La diferencia" },
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "¿Por qué seguimos usando medias que incomodan?" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Estamos acostumbrados a que una media apriete, acumule humedad y termine resultando incómoda. <strong>Cloud Socks™</strong> fue creada para cambiar esa experiencia.</p>"
    },

    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Quiero probar Cloud Socks™" },
    { "type": "url", "id": "button_link", "label": "Link del botón" },

    { "type": "header", "content": "Colores y espaciado" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de colores",
      "default": "background-1",
      "options": [
        { "value": "background-1", "label": "Fondo 1" },
        { "value": "background-2", "label": "Fondo 2" },
        { "value": "accent-1", "label": "Acento 1" },
        { "value": "accent-2", "label": "Acento 2" },
        { "value": "inverse", "label": "Inverso" }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo personalizado",
      "default": "#FAF8F5",
      "info": "Vacío = usa el fondo del esquema de colores"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Relleno superior", "default": 68 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Relleno inferior", "default": 68 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "limit": 6,
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Texto", "default": "Beneficio" },
        { "type": "image_picker", "id": "icon", "label": "Ícono" },
        { "type": "text", "id": "icon_url", "label": "URL del ícono (si no elegís uno arriba)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "La diferencia",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "text": "Dedos más libres y sin sensación de presión.",
            "icon_url": "https://cdn.shopify.com/s/files/1/0838/4738/1165/files/pie.png?v=1790542108"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Pies más secos y frescos durante todo el día.",
            "icon_url": "https://cdn.shopify.com/s/files/1/0838/4738/1165/files/ventoso.png?v=1790542108"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Más comodidad desde que te las ponés.",
            "icon_url": "https://cdn.shopify.com/s/files/1/0838/4738/1165/files/pie_1.png?v=1790542108"
          }
        }
      ]
    }
  ]
}
{% endschema %}
