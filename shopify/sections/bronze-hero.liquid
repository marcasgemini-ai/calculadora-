{%- comment -%}
  DR WOMAN · Bronze · Hero aspiracional
  Sección nativa: Editar código > Secciones > Agregar sección "bronze-hero" y pegar este archivo.
  Después: Personalizar > Agregar sección > "Bronze · Hero".
  Estructura: título en 2 líneas + texto + beneficios con ícono (bloques) + botón,
  sobre una foto aspiracional que se funde con el color de fondo. Pote flotante opcional con halo y rayos.
  Hereda la tipografía del tema. Si el botón no tiene link, baja hasta el botón de compra de la página.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign fb_bg = 'https://cdn.shopify.com/s/files/1/0789/3421/2779/files/ChatGPT_Image_1_sept_2026_10_42_14.png?v=1788270193'
  assign fb_product = 'https://cdn.shopify.com/s/files/1/0789/3421/2779/files/Diseno_sin_titulo_15_c8a53613-f530-499c-a5cc-3e3edce57261.png?v=1788271571'
  assign img_bg = s.imagen
  assign img_bg_mob = s.imagen_mobile | default: s.imagen
  assign img_prod = s.producto_imagen
  assign beneficios = section.blocks | where: 'type', 'beneficio'
-%}

<style>
  #bzh2-{{ section.id }} {
    --bzh2-bg: {{ s.color_bg }};
    --bzh2-bg-0: {{ s.color_bg | color_modify: 'alpha', 0 }};
    --bzh2-texto: {{ s.color_texto }};
    --bzh2-titulo: {{ s.color_titulo }};
    --bzh2-acento: {{ s.color_acento }};
    --bzh2-icono-1: {{ s.color_icono_1 }};
    --bzh2-icono-2: {{ s.color_icono_2 }};
    --bzh2-btn-1: {{ s.color_btn_1 }};
    --bzh2-btn-2: {{ s.color_btn_2 }};
    --bzh2-btn-texto: {{ s.color_btn_texto }};
    --bzh2-max: {{ s.max_width }}px;
    --bzh2-h: {{ s.altura_desktop }}px;
    --bzh2-ratio-mob: {{ s.ratio_mobile }};
    --bzh2-fade: {{ s.fundido }}%;
    --bzh2-prod-w: {{ s.producto_ancho }}%;
    --bzh2-prod-w-mob: {{ s.producto_ancho_mobile }}%;
    --bzh2-title-size: {{ s.titulo_tamano | divided_by: 10.0 }};
  }
</style>

{%- if section.settings.evitar_scroll_lateral -%}
<style>
  /* Evita que cualquier bloque de la página genere scroll hacia la derecha (franja blanca). */
  html, body { overflow-x: hidden; }
  @supports (overflow-x: clip) { html, body { overflow-x: clip; } }
</style>
{%- endif -%}

{%- liquid
  assign f_t = section.settings.font_titulo
  assign f_b = section.settings.font_texto
  assign f_b_500 = f_b | font_modify: 'weight', '500'
  assign f_b_600 = f_b | font_modify: 'weight', '600'
  assign f_b_700 = f_b | font_modify: 'weight', 'bold'
  assign f_b_i = f_b | font_modify: 'style', 'italic'
-%}
{%- unless section.settings.usar_fuente_tema -%}
<style>
  {{ f_t | font_face: font_display: 'swap' }}
  {{ f_b | font_face: font_display: 'swap' }}
  {{ f_b_500 | font_face: font_display: 'swap' }}
  {{ f_b_600 | font_face: font_display: 'swap' }}
  {{ f_b_700 | font_face: font_display: 'swap' }}
  {{ f_b_i | font_face: font_display: 'swap' }}
  #bzh2-{{ section.id }} {
    --bzh2-ft: "{{ f_t.family }}", {{ f_t.fallback_families }};
    --bzh2-ft-w: {{ f_t.weight }};
    --bzh2-fb: "{{ f_b.family }}", {{ f_b.fallback_families }};
  }
</style>
{%- endunless -%}

<bronze-hero
  id="bzh2-{{ section.id }}"
  class="bzh2 bzh2--{{ s.alineacion_mobile }}{% if s.producto_mostrar %} bzh2--prod-{{ s.producto_lado }}{% endif %}{% if s.animar %} bzh2--animar{% endif %}"
>
  <div class="bzh2__grid">

    <div class="bzh2__content">
      {%- if s.eyebrow != blank -%}
        <p class="bzh2__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- if s.titulo_1 != blank or s.titulo_2 != blank -%}
        <h2 class="bzh2__title">
          {%- if s.titulo_1 != blank -%}<span class="bzh2__title-1">{{ s.titulo_1 }}</span>{%- endif -%}
          {%- if s.titulo_2 != blank -%}<span class="bzh2__title-2">{{ s.titulo_2 }}</span>{%- endif -%}
        </h2>
      {%- endif -%}

      {%- if s.texto != blank -%}
        <div class="bzh2__text">{{ s.texto }}</div>
      {%- endif -%}

      {%- if beneficios.size > 0 -%}
        <ul class="bzh2__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type != 'beneficio' -%}{%- continue -%}{%- endif -%}
            {%- assign b = block.settings -%}
            <li class="bzh2__item" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <span class="bzh2__icon" aria-hidden="true">
                {%- if b.icono_propio != blank -%}
                  {{ b.icono_propio | image_url: width: 96 | image_tag: width: 48, height: 48, loading: 'lazy', alt: '' }}
                {%- else -%}
                  <svg viewBox="0 0 24 24">
                    {%- case b.icono -%}
                      {%- when 'sol' -%}<circle cx="12" cy="12" r="3.8"/><path d="M12 2.6v2.3M12 19.1v2.3M2.6 12h2.3M19.1 12h2.3M5.4 5.4l1.6 1.6M17 17l1.6 1.6M5.4 18.6L7 17M17 7l1.6-1.6"/>
                      {%- when 'brillo' -%}<path d="M11 3.5l1.7 4.8 4.8 1.7-4.8 1.7L11 16.5l-1.7-4.8L4.5 10l4.8-1.7z"/><path d="M18 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/>
                      {%- when 'parejo' -%}<path d="M3.5 8c2.8-2 5.7 2 8.5 0s5.7-2 8.5 0M3.5 12c2.8-2 5.7 2 8.5 0s5.7-2 8.5 0M3.5 16c2.8-2 5.7 2 8.5 0s5.7-2 8.5 0"/>
                      {%- when 'capsula' -%}<g transform="rotate(-45 12 12)"><rect x="3.5" y="8.8" width="17" height="6.4" rx="3.2"/><path d="M12 8.8v6.4"/></g>
                      {%- when 'reloj' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 7.3V12l3.2 2"/>
                      {%- when 'hoja' -%}<path d="M5 19C5 10.7 10.7 5 19 5c0 8.3-5.7 14-14 14z"/><path d="M5 19l7.5-7.5"/>
                      {%- when 'gota' -%}<path d="M12 3.5s6 6.4 6 10.8a6 6 0 0 1-12 0c0-4.4 6-10.8 6-10.8z"/>
                      {%- when 'escudo' -%}<path d="M12 3.3l7 2.9v5.6c0 4.4-3 7.6-7 8.9-4-1.3-7-4.5-7-8.9V6.2z"/><path d="M8.8 12l2.2 2.2 4.2-4.4"/>
                      {%- else -%}<path d="M12 20s-7.2-4.4-7.2-10A4.1 4.1 0 0 1 12 7.5 4.1 4.1 0 0 1 19.2 10c0 5.6-7.2 10-7.2 10z"/>
                    {%- endcase -%}
                  </svg>
                {%- endif -%}
              </span>
              <span class="bzh2__item-text">{{ b.texto }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if s.boton_texto != blank -%}
        <div class="bzh2__cta">
          <a
            class="bzh2__btn"
            href="{% if s.boton_link != blank %}{{ s.boton_link }}{% else %}#{% endif %}"
            {% if s.boton_link == blank %}data-scroll-compra{% endif %}
          >
            <span>{{ s.boton_texto }}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6.5L18.5 12 13 17.5"/></svg>
          </a>
          {%- if s.boton_nota != blank -%}<p class="bzh2__btn-note">{{ s.boton_nota }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.disclaimer != blank -%}
        <p class="bzh2__disclaimer">{{ s.disclaimer }}</p>
      {%- endif -%}
    </div>

    <div class="bzh2__media">
      {%- if img_bg != blank -%}
        {%- assign fp = img_bg.presentation.focal_point | default: '50% 50%' -%}
        {%- assign fpm = img_bg_mob.presentation.focal_point | default: fp -%}
        <picture>
          {%- if s.imagen_mobile != blank -%}
            <source media="(max-width: 749px)" srcset="{{ img_bg_mob | image_url: width: 500 }} 500w, {{ img_bg_mob | image_url: width: 750 }} 750w, {{ img_bg_mob | image_url: width: 1000 }} 1000w, {{ img_bg_mob | image_url: width: 1300 }} 1300w" sizes="100vw">
          {%- endif -%}
          {{ img_bg | image_url: width: 2000 | image_tag: class: 'bzh2__bg', loading: 'eager', fetchpriority: 'high', alt: s.imagen_alt, sizes: '(min-width: 750px) 56vw, 100vw', widths: '500, 750, 1000, 1300, 1600, 2000', style: 'object-position: var(--bzh2-pos)' }}
        </picture>
        <style>
          #bzh2-{{ section.id }} { --bzh2-pos: {{ fp }}; }
          @media screen and (max-width: 749px) { #bzh2-{{ section.id }} { --bzh2-pos: {{ fpm }}; } }
        </style>
      {%- elsif s.usar_ejemplos -%}
        <img
          class="bzh2__bg"
          src="{{ fb_bg }}&width=1300"
          srcset="{{ fb_bg }}&width=500 500w, {{ fb_bg }}&width=750 750w, {{ fb_bg }}&width=1000 1000w, {{ fb_bg }}&width=1300 1300w, {{ fb_bg }}&width=1536 1536w"
          sizes="(min-width: 750px) 56vw, 100vw"
          width="1536" height="1536" loading="eager" fetchpriority="high"
          alt="{{ s.imagen_alt | escape }}"
          style="object-position: 55% 40%"
        >
      {%- else -%}
        <div class="bzh2__bg bzh2__bg--ph"><span>Elegí la foto de fondo</span></div>
      {%- endif -%}

      <span class="bzh2__fade" aria-hidden="true"></span>

      {%- if s.producto_mostrar -%}
        {%- assign prod_src = '' -%}
        {%- if img_prod == blank and s.usar_ejemplos -%}{%- assign prod_src = fb_product -%}{%- endif -%}
        {%- if img_prod != blank or prod_src != '' -%}
          <div class="bzh2__product" aria-hidden="true">
            <span class="bzh2__halo"></span>
            <span class="bzh2__rays">
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </span>
            <span class="bzh2__spark bzh2__spark--1"><svg viewBox="0 0 24 24"><path d="M12 2.5c.45 5.5 4 9.05 9.5 9.5-5.5.45-9.05 4-9.5 9.5-.45-5.5-4-9.05-9.5-9.5 5.5-.45 9.05-4 9.5-9.5z"/></svg></span>
            <span class="bzh2__spark bzh2__spark--2"><svg viewBox="0 0 24 24"><path d="M12 2.5c.45 5.5 4 9.05 9.5 9.5-5.5.45-9.05 4-9.5 9.5-.45-5.5-4-9.05-9.5-9.5 5.5-.45 9.05-4 9.5-9.5z"/></svg></span>
            <span class="bzh2__spark bzh2__spark--3"><svg viewBox="0 0 24 24"><path d="M12 2.5c.45 5.5 4 9.05 9.5 9.5-5.5.45-9.05 4-9.5 9.5-.45-5.5-4-9.05-9.5-9.5 5.5-.45 9.05-4 9.5-9.5z"/></svg></span>
            <span class="bzh2__product-img">
              {%- if img_prod != blank -%}
                {{ img_prod | image_url: width: 800 | image_tag: loading: 'eager', alt: '', sizes: '(min-width: 750px) 18vw, 40vw', widths: '300, 450, 600, 800' }}
              {%- else -%}
                <img src="{{ prod_src }}&width=600" srcset="{{ prod_src }}&width=300 300w, {{ prod_src }}&width=450 450w, {{ prod_src }}&width=600 600w, {{ prod_src }}&width=800 800w" sizes="(min-width: 750px) 18vw, 40vw" width="700" height="900" loading="eager" alt="">
              {%- endif -%}
            </span>
            <span class="bzh2__shadow"></span>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

  </div>
</bronze-hero>

<style>
  .bzh2 {
    position: relative; display: block; width: 100%; max-width: 100%; margin: 0; padding: 0;
    overflow: hidden; overflow: clip; background: var(--bzh2-bg); color: var(--bzh2-texto); font-family: var(--bzh2-fb, inherit);
  }
  .bzh2 *, .bzh2 *::before, .bzh2 *::after { box-sizing: border-box; font-family: inherit; }
  .bzh2 img { max-width: none; border: 0; border-radius: 0; box-shadow: none; }

  /* ---------- Desktop: texto a la izquierda, foto a la derecha fundida con el fondo ---------- */
  .bzh2 .bzh2__grid {
    position: relative; width: 100%; max-width: var(--bzh2-max); margin: 0 auto; min-height: var(--bzh2-h);
    display: grid; grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); align-items: stretch;
  }
  .bzh2 .bzh2__content {
    position: relative; z-index: 3; align-self: center; padding: 64px 28px 64px max(40px, 5vw); text-align: left;
  }
  .bzh2 .bzh2__media { position: relative; z-index: 1; min-height: 100%; }
  .bzh2 .bzh2__bg { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: var(--bzh2-pos, 50% 50%); }
  .bzh2 .bzh2__bg--ph { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #F6E1CC, #E9C3A0); color: rgba(56, 34, 25, .5); font-size: .85em; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .bzh2 .bzh2__fade {
    position: absolute; inset: 0 auto 0 0; z-index: 2; width: var(--bzh2-fade); pointer-events: none;
    background: linear-gradient(90deg, var(--bzh2-bg) 0%, var(--bzh2-bg-0) 100%);
  }

  /* ---------- Textos ---------- */
  .bzh2 .bzh2__eyebrow {
    display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px; padding: 7px 13px; border-radius: 999px;
    background: rgba(255, 255, 255, .55); border: 1px solid rgba(184, 97, 50, .22); color: var(--bzh2-acento);
    font-size: .7em; font-weight: 700; line-height: 1; letter-spacing: .16em; text-transform: uppercase;
  }
  .bzh2 .bzh2__eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--bzh2-acento); box-shadow: 0 0 0 3px rgba(198, 110, 56, .18); }
  .bzh2 .bzh2__title { font-family: var(--bzh2-ft, inherit);
    margin: 0; padding: 0; display: flex; flex-direction: column; gap: .04em;
    color: var(--bzh2-titulo); font-size: calc(var(--bzh2-title-size) * 3.4em); line-height: 1.02; letter-spacing: -.01em; text-transform: none;
  }
  .bzh2 .bzh2__title-1 { display: block; font-weight: var(--bzh2-ft-w, 800); }
  .bzh2 .bzh2__title-2 { font-family: var(--bzh2-fb, inherit);
    display: block; font-weight: 400; font-style: italic; letter-spacing: 0;
    background: linear-gradient(100deg, var(--bzh2-icono-2) 0%, var(--bzh2-acento) 55%, #E9A76A 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em;
  }
  .bzh2 .bzh2__text { max-width: 470px; margin: 18px 0 0; color: var(--bzh2-texto); font-size: 1.06em; line-height: 1.55; }
  .bzh2 .bzh2__text p { margin: 0; padding: 0; color: inherit; font-size: inherit; line-height: inherit; }
  .bzh2 .bzh2__text strong { color: var(--bzh2-titulo); }

  /* ---------- Beneficios ---------- */
  .bzh2 .bzh2__list { margin: 28px 0 0; padding: 0; list-style: none; display: grid; gap: 16px; }
  .bzh2 .bzh2__item { margin: 0; padding: 0; display: flex; align-items: center; gap: 16px; list-style: none; }
  .bzh2 .bzh2__item::before, .bzh2 .bzh2__item::marker { content: none; display: none; }
  .bzh2 .bzh2__icon {
    position: relative; flex: 0 0 54px; width: 54px; height: 54px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; color: #FFFFFF;
    background: radial-gradient(circle at 30% 25%, var(--bzh2-icono-1) 0%, var(--bzh2-icono-2) 78%);
    box-shadow: 0 8px 18px rgba(143, 69, 36, .26), inset 0 1px 0 rgba(255, 255, 255, .35), inset 0 -2px 6px rgba(80, 30, 10, .18);
  }
  .bzh2 .bzh2__icon::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .28); pointer-events: none; }
  .bzh2 .bzh2__icon svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .bzh2 .bzh2__icon img { width: 30px; height: 30px; object-fit: contain; }
  .bzh2 .bzh2__item-text { font-family: var(--bzh2-ft, inherit); color: var(--bzh2-titulo); font-size: 1.22em; font-weight: var(--bzh2-ft-w, 700); line-height: 1.2; }

  /* ---------- Botón ---------- */
  .bzh2 .bzh2__cta { margin-top: 30px; }
  .bzh2 a.bzh2__btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 56px; padding: 16px 30px;
    border-radius: 999px; overflow: hidden; text-decoration: none; color: var(--bzh2-btn-texto);
    background: linear-gradient(135deg, var(--bzh2-btn-1) 0%, var(--bzh2-btn-2) 100%);
    box-shadow: 0 12px 26px rgba(143, 69, 36, .3), inset 0 1px 0 rgba(255, 255, 255, .3);
    font-size: 1.02em; font-weight: 700; line-height: 1; letter-spacing: .02em; text-transform: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .bzh2 a.bzh2__btn::after {
    content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%; pointer-events: none;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .35), transparent); animation: bzh2Shine 3.6s ease-in-out infinite;
  }
  .bzh2 a.bzh2__btn svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .2s ease; }
  @media (hover: hover) {
    .bzh2 a.bzh2__btn:hover { transform: translateY(-2px); box-shadow: 0 16px 32px rgba(143, 69, 36, .36), inset 0 1px 0 rgba(255, 255, 255, .3); }
    .bzh2 a.bzh2__btn:hover svg { transform: translateX(3px); }
  }
  .bzh2 a.bzh2__btn:focus-visible { outline: 2px solid var(--bzh2-titulo); outline-offset: 3px; }
  .bzh2 .bzh2__btn-note { margin: 10px 0 0; padding: 0; color: var(--bzh2-texto); opacity: .75; font-size: .8em; line-height: 1.4; }
  .bzh2 .bzh2__disclaimer { margin: 22px 0 0; padding: 0; color: var(--bzh2-texto); opacity: .55; font-size: .68em; line-height: 1.4; max-width: 440px; }
  @keyframes bzh2Shine { 0%, 60% { left: -60%; } 100% { left: 130%; } }

  /* ---------- Pote flotante ---------- */
  .bzh2 .bzh2__product {
    position: absolute; z-index: 4; bottom: 6%; left: 4%; width: var(--bzh2-prod-w); aspect-ratio: 1 / 1.15; pointer-events: none;
  }
  .bzh2.bzh2--prod-derecha .bzh2__product { left: auto; right: 5%; }
  .bzh2 .bzh2__halo {
    position: absolute; top: 46%; left: 50%; width: 120%; aspect-ratio: 1 / 1; border-radius: 50%; transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(255, 249, 217, .92) 0%, rgba(255, 223, 155, .45) 30%, rgba(243, 159, 82, .16) 52%, rgba(243, 159, 82, 0) 72%);
    animation: bzh2Halo 4s ease-in-out infinite;
  }
  .bzh2 .bzh2__rays {
    position: absolute; top: 46%; left: 50%; width: 150%; aspect-ratio: 1 / 1; transform: translate(-50%, -50%);
    -webkit-mask: radial-gradient(circle, transparent 0 26%, #000 34%, transparent 70%); mask: radial-gradient(circle, transparent 0 26%, #000 34%, transparent 70%);
    animation: bzh2Spin 40s linear infinite;
  }
  .bzh2 .bzh2__rays i {
    position: absolute; top: 50%; left: 50%; width: 50%; height: 2px; margin-top: -1px; transform-origin: 0 50%; border-radius: 2px;
    background: linear-gradient(90deg, rgba(255, 244, 205, .95), rgba(255, 224, 159, 0)); box-shadow: 0 0 8px rgba(255, 211, 128, .35);
  }
  .bzh2 .bzh2__rays i:nth-child(1) { transform: rotate(-160deg); }
  .bzh2 .bzh2__rays i:nth-child(2) { transform: rotate(-135deg); }
  .bzh2 .bzh2__rays i:nth-child(3) { transform: rotate(-110deg); }
  .bzh2 .bzh2__rays i:nth-child(4) { transform: rotate(-70deg); }
  .bzh2 .bzh2__rays i:nth-child(5) { transform: rotate(-45deg); }
  .bzh2 .bzh2__rays i:nth-child(6) { transform: rotate(-20deg); }
  .bzh2 .bzh2__rays i:nth-child(7) { transform: rotate(160deg); }
  .bzh2 .bzh2__rays i:nth-child(8) { transform: rotate(20deg); }
  .bzh2 .bzh2__product-img { position: absolute; z-index: 3; left: 10%; right: 10%; top: 4%; bottom: 10%; animation: bzh2Float 4.3s ease-in-out infinite; }
  .bzh2 .bzh2__product-img img {
    display: block; width: 100%; height: 100%; object-fit: contain;
    filter: drop-shadow(0 18px 22px rgba(67, 24, 5, .3)) drop-shadow(0 4px 8px rgba(255, 229, 175, .2));
  }
  .bzh2 .bzh2__shadow {
    position: absolute; z-index: 2; left: 50%; bottom: 3%; width: 50%; height: 7%; border-radius: 50%; transform: translateX(-50%);
    background: radial-gradient(ellipse, rgba(59, 20, 4, .38) 0%, rgba(59, 20, 4, .14) 45%, rgba(59, 20, 4, 0) 75%);
    animation: bzh2Shadow 4.3s ease-in-out infinite;
  }
  .bzh2 .bzh2__spark { position: absolute; z-index: 4; color: #FFF2C4; filter: drop-shadow(0 0 8px rgba(255, 217, 140, .85)); animation: bzh2Spark 2.8s ease-in-out infinite; }
  .bzh2 .bzh2__spark svg { display: block; width: 100%; height: 100%; fill: currentColor; }
  .bzh2 .bzh2__spark--1 { width: 18px; height: 18px; top: 8%; left: 6%; }
  .bzh2 .bzh2__spark--2 { width: 12px; height: 12px; right: 4%; top: 32%; animation-delay: 1.1s; }
  .bzh2 .bzh2__spark--3 { width: 10px; height: 10px; left: 14%; bottom: 22%; animation-delay: .6s; }
  @keyframes bzh2Halo { 0%, 100% { opacity: .75; transform: translate(-50%, -50%) scale(.95); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); } }
  @keyframes bzh2Spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
  @keyframes bzh2Float { 0%, 100% { transform: translateY(0) rotate(-1.5deg); } 50% { transform: translateY(-4%) rotate(1deg); } }
  @keyframes bzh2Shadow { 0%, 100% { opacity: .75; transform: translateX(-50%) scale(1); } 50% { opacity: .42; transform: translateX(-50%) scale(.84); } }
  @keyframes bzh2Spark { 0%, 100% { opacity: .35; transform: scale(.75) rotate(0); } 50% { opacity: 1; transform: scale(1.15) rotate(9deg); } }

  /* ---------- Entrada suave (solo si JS activo) ---------- */
  .bzh2.bzh2--animar.is-ready .bzh2__content > *, .bzh2.bzh2--animar.is-ready .bzh2__item {
    opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s ease;
  }
  .bzh2.bzh2--animar.is-ready .bzh2__item { transition-delay: calc(.25s + var(--i) * .09s); }
  .bzh2.bzh2--animar.is-ready .bzh2__list { opacity: 1; transform: none; }
  .bzh2.bzh2--animar.is-visible .bzh2__content > *, .bzh2.bzh2--animar.is-visible .bzh2__item { opacity: 1; transform: none; }

  /* ---------- Tablet ---------- */
  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .bzh2 .bzh2__grid { grid-template-columns: minmax(0, 52fr) minmax(0, 48fr); }
    .bzh2 .bzh2__content { padding: 52px 18px 52px 32px; }
    .bzh2 .bzh2__title { font-size: calc(var(--bzh2-title-size) * 2.7em); }
    .bzh2 .bzh2__item-text { font-size: 1.08em; }
    .bzh2 .bzh2__icon { flex-basis: 48px; width: 48px; height: 48px; }
    .bzh2 .bzh2__icon svg { width: 23px; height: 23px; }
  }

  /* ---------- Mobile: texto arriba, foto abajo fundida ---------- */
  @media screen and (max-width: 749px) {
    .bzh2 .bzh2__grid { display: flex; flex-direction: column; min-height: 0; }
    .bzh2 .bzh2__content { padding: 38px 22px 0; }
    .bzh2.bzh2--center .bzh2__content { text-align: center; }
    .bzh2.bzh2--center .bzh2__text { margin-left: auto; margin-right: auto; }
    .bzh2.bzh2--center .bzh2__list { display: inline-grid; text-align: left; max-width: 100%; }
    .bzh2.bzh2--center .bzh2__disclaimer { margin-left: auto; margin-right: auto; }
    .bzh2 .bzh2__eyebrow { margin-bottom: 12px; font-size: .62em; padding: 6px 11px; }
    .bzh2 .bzh2__title { font-size: calc(var(--bzh2-title-size) * 2.35em); }
    .bzh2 .bzh2__text { margin-top: 12px; font-size: .98em; line-height: 1.5; }
    .bzh2 .bzh2__list { margin-top: 22px; gap: 13px; }
    .bzh2.bzh2--center .bzh2__item { text-align: left; }
    .bzh2 .bzh2__icon { flex-basis: 46px; width: 46px; height: 46px; }
    .bzh2 .bzh2__icon svg { width: 22px; height: 22px; }
    .bzh2 .bzh2__item { gap: 13px; }
    .bzh2 .bzh2__item-text { font-size: 1.12em; }
    .bzh2 .bzh2__cta { margin-top: 24px; }
    .bzh2 a.bzh2__btn { width: 100%; max-width: 380px; }
    .bzh2 .bzh2__disclaimer { margin-top: 14px; }
    .bzh2 .bzh2__media { min-height: 0; aspect-ratio: var(--bzh2-ratio-mob); margin-top: -12%; }
    .bzh2 .bzh2__fade { inset: 0 0 auto 0; width: 100%; height: var(--bzh2-fade); background: linear-gradient(180deg, var(--bzh2-bg) 0%, var(--bzh2-bg-0) 100%); }
    .bzh2 .bzh2__product { width: var(--bzh2-prod-w-mob); bottom: 5%; left: 3%; }
    .bzh2.bzh2--prod-derecha .bzh2__product { left: auto; right: 3%; }
  }
  @media screen and (max-width: 390px) {
    .bzh2 .bzh2__content { padding: 32px 16px 0; }
    .bzh2 .bzh2__title { font-size: calc(var(--bzh2-title-size) * 2.1em); }
    .bzh2 .bzh2__item-text { font-size: 1.04em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bzh2 .bzh2__halo, .bzh2 .bzh2__rays, .bzh2 .bzh2__product-img, .bzh2 .bzh2__shadow, .bzh2 .bzh2__spark, .bzh2 a.bzh2__btn::after { animation: none !important; }
    .bzh2.bzh2--animar.is-ready .bzh2__content > *, .bzh2.bzh2--animar.is-ready .bzh2__item { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  if (!customElements.get('bronze-hero')) {
    customElements.define('bronze-hero', class extends HTMLElement {
      connectedCallback() {
        // Botón sin link: baja hasta el formulario de compra de la página
        const btn = this.querySelector('[data-scroll-compra]');
        if (btn) {
          btn.addEventListener('click', (e) => {
            const target = document.querySelector('.dw-offer, [id^="bz-of-"], product-form, form[action*="/cart/add"]');
            if (!target) return;
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        }

        // Entrada suave al aparecer en pantalla (en el editor se muestra directo)
        if (!this.classList.contains('bzh2--animar') || window.Shopify && Shopify.designMode || !('IntersectionObserver' in window)) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.classList.add('is-ready');
        this.io = new IntersectionObserver((entries) => {
          if (entries.some((en) => en.isIntersecting)) {
            this.classList.add('is-visible');
            this.io.disconnect();
          }
        }, { threshold: 0.15 });
        this.io.observe(this);
      }
      disconnectedCallback() { if (this.io) this.io.disconnect(); }
    });
  }
</script>

