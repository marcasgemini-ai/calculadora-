{%- comment -%}
  Bronzer · Oferta
  Sección de compra completa: encabezado de oferta, galería del producto con contador,
  selector de packs con upsell y regalos, botón al carrito, confianza, garantía y desplegables.
  Todo se edita desde Tienda online > Personalizar.

  Packs (bloque "Pack"):
  - Modo "Descuento": agrega N unidades de la primera variante. El precio del pack lo cobra
    un descuento automático de Shopify (cargá en "Precio del pack" el mismo valor que el descuento).
  - Modo "Variantes": cada pack es una variante del producto (indicá su posición: 1, 2, 3...).
  Upsell: elegí el producto. Si además elegís un "Producto de oferta" con 2 variantes
  (1ª = precio promo, 2ª = regalo $0), el upsell se cobra con ese producto sin descuentos.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = '#bz-of-' | append: section.id
  assign p = s.product | default: product
  assign base_variant = p.selected_or_first_available_variant
  assign days_per_bottle = s.days_per_bottle | default: 60 | at_least: 1

  assign pack_count = 0
  assign preselected = 0
  assign max_off = 0
  assign max_bottles = 1
  for block in section.blocks
    if block.type != 'pack'
      continue
    endif
    if block.settings.preselected and preselected == 0
      assign preselected = pack_count | plus: 1
    endif
    assign pack_count = pack_count | plus: 1
    assign bottles = block.settings.bottles | default: 1
    if bottles > max_bottles
      assign max_bottles = bottles
    endif
    if s.pack_mode == 'discount'
      assign tp = block.settings.price | default: 0 | times: 100
      if tp == 0
        assign tp = base_variant.price | times: bottles
      endif
      assign cp = base_variant.price | times: bottles
    else
      assign vi = block.settings.variant_position | default: 1 | minus: 1
      assign vv = p.variants[vi]
      assign tp = vv.price
      assign cp = vv.compare_at_price | default: vv.price
    endif
    if cp > tp and cp > 0
      assign off = cp | minus: tp | times: 100 | divided_by: cp | floor
      if off > max_off
        assign max_off = off
      endif
    endif
  endfor
  if preselected == 0
    assign preselected = 1
  endif
  assign max_off_str = max_off | append: '%'

  for block in section.blocks
    case block.type
      when 'encabezado'
        assign top_block = block
      when 'contador'
        assign timer_block = block
      when 'upsell'
        assign bump_block = block
      when 'garantia'
        assign guarantee_block = block
      when 'cupon'
        assign coupon_block = block
    endcase
  endfor
  assign bs = bump_block.settings
  assign bump_free_min = bs.bump_free_min | default: 9999
  assign bump_product = bs.bump_product
  assign bump_variant = bump_product.selected_or_first_available_variant
  assign bump_mode = 'discount'
  assign bump_cents = bs.bump_price | default: 0 | times: 100
  assign bump_free_id = ''
  assign bump_promo_id = ''
  if bs.bump_offer_product != blank and bs.bump_offer_product.variants.size >= 2
    assign bump_mode = 'product'
    assign bump_promo = bs.bump_offer_product.variants[0]
    assign bump_cents = bump_promo.price
    assign bump_promo_id = bump_promo.id
    assign bump_free_id = bs.bump_offer_product.variants[1].id
  endif
  assign bump_orig = bump_variant.price
  if bump_mode == 'product' and bump_variant == blank
    assign bump_product = bs.bump_offer_product
    assign bump_variant = bump_promo
    assign bump_orig = bump_promo.compare_at_price
  endif
  if bump_orig == blank or bump_orig <= bump_cents
    assign bump_orig = bump_cents | times: 2
  endif
  assign bump_title = bs.bump_title | default: bump_product.title
  assign bump_id = bump_variant.id
  if bump_mode == 'product'
    assign bump_id = bump_promo_id
  endif
  assign show_bump = false
  if bump_block != blank and bump_variant != blank
    assign show_bump = true
  endif

  assign gift_count = 0
  assign first_gift_min = 0
  for block in section.blocks
    if block.type == 'regalo'
      assign gift_count = gift_count | plus: 1
      if first_gift_min == 0
        assign first_gift_min = block.settings.min_bottles | default: 0
      endif
    endif
  endfor

  assign title = s.title | default: p.title
-%}

<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}

  {{ sid }} {
    --of-bg: {{ s.color_bg | default: '#FFFFFF' }};
    --of-accent: {{ s.color_accent | default: '#F2B47F' }};
    --of-soft: {{ s.color_soft | default: '#FEF5EC' }};
    --of-brand: {{ s.color_brand | default: '#9A4F1C' }};
    --of-ink: {{ s.color_ink | default: '#3B1F14' }};
    --of-muted: {{ s.color_ink | default: '#3B1F14' | color_modify: 'alpha', 0.65 }};
    --of-line: {{ s.color_ink | default: '#3B1F14' | color_modify: 'alpha', 0.14 }};
    --of-cta: {{ s.color_cta | default: '#3B1F14' }};
    --of-cta-text: {{ s.color_cta_text | default: '#FFFFFF' }};
    --of-stars: {{ s.color_stars | default: '#E0A33A' }};
    --of-display: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    --of-display-w: {{ s.heading_font.weight }};
    --of-pt: {{ s.padding_top }}px;
    --of-pb: {{ s.padding_bottom }}px;
  }
  {{ sid }}, {{ sid }} *, {{ sid }} *::before, {{ sid }} *::after { box-sizing: border-box; }
  {{ sid }} p, {{ sid }} li, {{ sid }} span { color: inherit; }
  {{ sid }} {
    display: block;
    background: var(--of-bg);
    color: var(--of-ink);
    font-size: 16px;
    line-height: 1.4;
    padding: calc(var(--of-pt) * 0.6) 16px calc(var(--of-pb) * 0.6);
  }
  {{ sid }} p { margin: 0; }
  {{ sid }} s { color: var(--of-muted); font-weight: 500; }
  {{ sid }} .of-i { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  {{ sid }} .of-stars { display: inline-flex; gap: 2px; color: var(--of-stars); }
  {{ sid }} .of-stars svg { width: 16px; height: 16px; fill: currentColor; }
  {{ sid }} .of__wrap { max-width: 1240px; margin: 0 auto; }

  /* ---------- Encabezado de oferta ---------- */
  {{ sid }} .of__top { display: flex; flex-direction: column; align-items: center; gap: 10px; max-width: 820px; margin: 0 auto 28px; text-align: center; }
  {{ sid }} .of__eyebrow { font-family: var(--of-display); font-weight: var(--of-display-w); font-size: clamp(20px, 5vw, 28px); line-height: 1.1; color: var(--of-ink); }
  {{ sid }} .of__headline { margin: 0; font-family: var(--of-display); font-weight: var(--of-display-w); font-size: clamp(30px, 7.5vw, 52px); line-height: 1.05; letter-spacing: -0.015em; color: var(--of-brand); text-wrap: balance; }
  {{ sid }} .of__headline em { font-style: italic; }
  {{ sid }} .of__lead { max-width: 60ch; font-size: 15px; line-height: 1.55; color: var(--of-muted); }
  {{ sid }} .of__lead p + p { margin-top: 0.5em; }
  {{ sid }} .of__proof { display: inline-flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 10px; font-size: 13px; }
  {{ sid }} .of__proof b, {{ sid }} .of__proof strong { font-weight: 800; }
  {{ sid }} .of__proof i { width: 1px; height: 16px; background: var(--of-line); }

  /* ---------- Layout ---------- */
  {{ sid }} .of__grid { display: flex; flex-direction: column; gap: 24px; }
  {{ sid }} .of__left, {{ sid }} .of__right { min-width: 0; display: flex; flex-direction: column; gap: 14px; }

  /* ---------- Contador ---------- */
  {{ sid }} .of__timer { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 14px; background: var(--of-soft); }
  {{ sid }} .of__timer-ico { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--of-accent); color: var(--of-ink); flex: none; }
  {{ sid }} .of__timer-label { flex: 1; font-size: 13px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  {{ sid }} .of__timer-clock { display: flex; align-items: center; gap: 4px; font-size: 12px; }
  {{ sid }} .of__timer-clock em { font-style: normal; font-weight: 700; margin-right: 4px; }
  {{ sid }} .of__timer-clock b { min-width: 30px; padding: 4px 0; border: 1.5px solid var(--of-ink); border-radius: 6px; background: #fff; text-align: center; font-size: 14px; font-variant-numeric: tabular-nums; }

  /* ---------- Galería ---------- */
  {{ sid }} .of__gallery { position: relative; overflow: hidden; border-radius: 22px; border: 1.5px solid var(--of-line); background: var(--of-soft); }
  {{ sid }} .of__ribbon { position: relative; z-index: 2; padding: 12px 16px; background: linear-gradient(90deg, var(--of-brand), var(--of-accent)); color: #fff; text-align: center; font-size: 14px; font-weight: 800; font-style: italic; letter-spacing: 0.02em; text-transform: uppercase; }
  {{ sid }} .of__ribbon b, {{ sid }} .of__ribbon strong { color: var(--of-ink); background: #fff; padding: 0 6px; border-radius: 4px; font-style: normal; }
  {{ sid }} .of__track { display: flex; margin: 0; padding: 0; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  {{ sid }} .of__track::-webkit-scrollbar { display: none; }
  {{ sid }} .of__slide { flex: 0 0 100%; aspect-ratio: 1 / 1; scroll-snap-align: start; position: relative; }
  {{ sid }} .of__slide img, {{ sid }} .of__slide svg { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: {{ s.gallery_fit }}; }
  {{ sid }} .of__slide svg { fill: var(--of-line); }
  {{ sid }} .of__nav { position: absolute; top: 55%; z-index: 3; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.9); color: var(--of-ink); cursor: pointer; box-shadow: 0 4px 14px -6px rgba(0, 0, 0, 0.35); }
  {{ sid }} .of__nav--prev { left: 10px; }
  {{ sid }} .of__nav--next { right: 10px; background: var(--of-ink); color: #fff; }
  {{ sid }} .of__nav[disabled] { opacity: 0.35; cursor: default; }
  {{ sid }} .of__nav .of-i { width: 18px; height: 18px; stroke-width: 2.2; }
  {{ sid }} .of__features { position: absolute; z-index: 2; right: 12px; top: calc(50% + 22px); transform: translateY(-50%); display: flex; flex-direction: column; gap: 10px; width: 112px; margin: 0; padding: 12px 8px; list-style: none; border-radius: 14px; border: 1.5px solid var(--of-ink); background: rgba(255, 255, 255, 0.94); text-align: center; }
  {{ sid }} .of__features li { display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; line-height: 1.2; }
  {{ sid }} .of__features .of-i { width: 26px; height: 26px; color: var(--of-brand); }
  {{ sid }}.of--features-desktop .of__features { display: none; }
  {{ sid }} .of__thumbs { display: flex; gap: 8px; margin: 0; padding: 2px; list-style: none; overflow-x: auto; scrollbar-width: none; }
  {{ sid }} .of__thumbs::-webkit-scrollbar { display: none; }
  {{ sid }} .of__thumb { flex: 0 0 64px; width: 64px; height: 64px; padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; background: var(--of-soft); cursor: pointer; }
  {{ sid }} .of__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  {{ sid }} .of__thumb[aria-current="true"] { border-color: var(--of-brand); }

  {{ sid }} .of__tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  {{ sid }} .of__tiles li { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 16px 8px; border-radius: 14px; background: #fff; border: 1px solid var(--of-line); box-shadow: 0 8px 20px -16px rgba(0, 0, 0, 0.4); text-align: center; font-size: 11.5px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--of-brand); }
  {{ sid }} .of__tiles .of-i { width: 28px; height: 28px; }

  /* ---------- Info del producto ---------- */
  {{ sid }} .of__meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  {{ sid }} .of__rating { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; }
  {{ sid }} .of__hot { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; background: var(--of-ink); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  {{ sid }} .of__hot .of-i { width: 14px; height: 14px; stroke-width: 2.4; }
  {{ sid }} .of__title { margin: 0; font-family: var(--of-display); font-weight: var(--of-display-w); font-size: clamp(28px, 7vw, 40px); line-height: 1.08; letter-spacing: -0.015em; color: var(--of-ink); }
  {{ sid }} .of__promo { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--of-muted); }
  {{ sid }} .of__promo b, {{ sid }} .of__promo strong { color: var(--of-brand); }
  {{ sid }} .of__promo .of-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--of-accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--of-accent) 30%, transparent); animation: of-pulse 1.6s ease-in-out infinite; flex: none; }
  @keyframes of-pulse { 50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--of-accent) 0%, transparent); } }

  /* ---------- Selector ---------- */
  {{ sid }} .of__box { padding: 16px 14px 18px; border-radius: 18px; border: 1.5px solid var(--of-line); background: #fff; }
  {{ sid }} .of__heading { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  {{ sid }} .of__heading span { flex: 1; height: 1.5px; background: var(--of-line); }
  {{ sid }} .of__heading p { font-size: 13px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; white-space: nowrap; }
  {{ sid }} .of__tip { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 2px 0 8px; padding: 6px 12px; border-radius: 999px; background: var(--of-soft); border: 1px solid color-mix(in srgb, var(--of-accent) 60%, transparent); font-size: 13px; color: var(--of-muted); text-align: center; }
  {{ sid }} .of__tip b, {{ sid }} .of__tip strong { color: var(--of-ink); font-weight: 800; }
  {{ sid }} .of__tip .of-i { width: 17px; height: 17px; color: var(--of-brand); }
  {{ sid }} .of__tiers { display: grid; gap: 22px; padding-top: 12px; }

  {{ sid }} .gt { position: relative; border: 2px solid var(--of-line); border-radius: 12px; background: #fff; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s; }
  {{ sid }} .gt:hover { border-color: var(--of-accent); }
  {{ sid }} .gt.is-active { border: 2.5px solid var(--of-brand); box-shadow: 0 14px 30px -16px color-mix(in srgb, var(--of-brand) 70%, transparent); }
  {{ sid }} .gt__badges { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 4px; margin: -11px 0 0 12px; }
  {{ sid }} .gt__badges span { padding: 3px 10px; border-radius: 999px; background: var(--of-accent); color: var(--of-ink); font-size: 11px; font-weight: 800; line-height: 1.3; white-space: nowrap; }
  {{ sid }} .gt__badges span.is-dark { background: var(--of-ink); color: #fff; }
  {{ sid }} .gt__main { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 12px; align-items: center; margin: 0; padding: 12px 14px 14px; border-radius: 10px; cursor: pointer; }
  {{ sid }} .gt.is-active .gt__main { background: var(--of-soft); }
  {{ sid }} .gt__radio { position: absolute; opacity: 0; pointer-events: none; }
  {{ sid }} .gt__radio:focus-visible + .gt__dot { outline: 2px solid var(--of-ink); outline-offset: 2px; }
  {{ sid }} .gt__dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--of-muted); background: #fff; display: flex; align-items: center; justify-content: center; }
  {{ sid }} .gt.is-active .gt__dot { border-color: var(--of-brand); }
  {{ sid }} .gt.is-active .gt__dot::after { content: ""; width: 11px; height: 11px; border-radius: 50%; background: var(--of-brand); }
  {{ sid }} .gt__name { display: flex; flex-direction: column; min-width: 0; }
  {{ sid }} .gt__name strong { font-size: 17px; line-height: 1.2; }
  {{ sid }} .gt__meta { margin-top: 1px; font-size: 13px; color: var(--of-muted); }
  {{ sid }} .gt__sub { display: none; margin-top: 6px; font-size: 13.5px; line-height: 1.4; color: var(--of-muted); }
  {{ sid }} .gt.is-active .gt__sub { display: block; }
  {{ sid }} .gt__price { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; white-space: nowrap; }
  {{ sid }} .gt__row { display: flex; align-items: center; gap: 6px; }
  {{ sid }} .gt__price s { font-size: 13px; }
  {{ sid }} .gt__price strong { font-size: 20px; line-height: 1.15; }
  {{ sid }} .gt.is-active .gt__price strong { color: var(--of-brand); }
  {{ sid }} .gt__off { padding: 2px 7px; border-radius: 6px; background: var(--of-ink); color: #fff; font-size: 11px; font-weight: 800; }
  {{ sid }} .gt__save { font-size: 11.5px; font-weight: 700; color: var(--of-brand); }

  {{ sid }} .gb { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 9px 14px; border-top: 1px solid var(--of-line); background: var(--of-soft); cursor: pointer; outline: none; }
  {{ sid }} .gb__box { display: none; width: 20px; height: 20px; border-radius: 4px; border: 2px solid var(--of-ink); background: #fff; align-items: center; justify-content: center; }
  {{ sid }} .gt.is-active .gb { grid-template-columns: 20px 44px minmax(0, 1fr) auto; background: var(--of-accent); }
  {{ sid }} .gt.is-active .gb__box { display: flex; }
  {{ sid }} .gt.is-active .gb:focus-visible { box-shadow: inset 0 0 0 2px var(--of-ink); }
  {{ sid }}.bump-on .gt.is-active .gb__box { background: var(--of-ink); }
  {{ sid }}.bump-on .gt.is-active .gb__box::after { content: ""; width: 5px; height: 10px; margin-top: -2px; border: solid #fff; border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
  {{ sid }} .gb__img { width: 44px; height: 44px; border-radius: 6px; overflow: hidden; background: #fff; }
  {{ sid }} .gb__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  {{ sid }} .gb__text { font-size: 13.5px; line-height: 1.3; color: var(--of-brand); }
  {{ sid }} .gt.is-active .gb__text { color: var(--of-ink); }
  {{ sid }} .gb__text b, {{ sid }} .gb__text strong { font-weight: 800; }
  {{ sid }} .gb__price { display: flex; flex-direction: column; align-items: flex-end; white-space: nowrap; }
  {{ sid }} .gb__price strong { font-size: 15px; }
  {{ sid }} .gb__price s { font-size: 12px; }

  {{ sid }} .gg { border-top: 1px solid var(--of-line); }
  {{ sid }} .gg__sum { display: flex; align-items: center; gap: 8px; padding: 9px 14px; }
  {{ sid }} .gg__count { flex: 1; font-size: 13.5px; font-weight: 800; }
  {{ sid }} .gg__count .of-i { width: 18px; height: 18px; color: var(--of-brand); vertical-align: -4px; margin-right: 4px; }
  {{ sid }} .gg__thumbs { display: flex; gap: 4px; }
  {{ sid }} .gg__thumb { width: 30px; height: 30px; flex: none; border-radius: 6px; overflow: hidden; background: #fff; border: 1px solid var(--of-line); display: flex; align-items: center; justify-content: center; color: var(--of-brand); }
  {{ sid }} .gg__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  {{ sid }} .gg__thumb .of-i { width: 60%; height: 60%; }
  {{ sid }} .is-locked .gg__thumb, {{ sid }} .gg__thumb.is-locked { filter: grayscale(1); opacity: 0.7; }
  {{ sid }} .gg__list { display: none; margin: 0; padding: 4px 14px 8px; list-style: none; background: var(--of-soft); border-radius: 0 0 10px 10px; }
  {{ sid }} .gt.is-active .gg__sum { display: none; }
  {{ sid }} .gt.is-active .gg__list { display: block; }
  {{ sid }} .gg__list li { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 7px 0; border-bottom: 1px solid var(--of-line); }
  {{ sid }} .gg__list li:last-child { border-bottom: 0; }
  {{ sid }} .gg__list .gg__thumb { width: 34px; height: 34px; }
  {{ sid }} .gg__name { font-size: 14px; font-weight: 700; line-height: 1.25; }
  {{ sid }} .gg__list li.is-locked .gg__name { color: var(--of-muted); }
  {{ sid }} .gg__val { display: flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 13.5px; }
  {{ sid }} .gg__val em { padding: 2px 7px; border-radius: 999px; background: var(--of-brand); color: #fff; font-style: normal; font-size: 10.5px; font-weight: 800; letter-spacing: 0.04em; }
  {{ sid }} .gg__val em.is-dark { background: var(--of-ink); }
  {{ sid }} .gg__val b { color: var(--of-brand); font-weight: 800; }
  {{ sid }} .gg__val s { font-size: 12px; }
  {{ sid }} .gg__need { display: inline-flex; align-items: center; gap: 4px; color: var(--of-muted); font-size: 12px; font-weight: 700; }
  {{ sid }} .gg__need .of-i { width: 14px; height: 14px; }

  {{ sid }} .of__cta { position: relative; display: grid; place-items: center; width: 100%; min-height: 60px; margin-top: 18px; padding: 10px 16px; border: 0; border-radius: 12px; background: var(--of-cta); color: var(--of-cta-text); cursor: pointer; box-shadow: 0 12px 24px -14px var(--of-cta); transition: transform 0.15s, filter 0.2s; }
  {{ sid }} .of__cta:hover { transform: translateY(-1px); filter: brightness(1.1); }
  {{ sid }} .of__cta-idle, {{ sid }} .of__cta-busy { grid-area: 1 / 1; display: flex; flex-direction: column; align-items: center; gap: 2px; transition: opacity 0.2s; }
  {{ sid }} .of__cta-main { font-size: 17px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
  {{ sid }} .of__cta-sub { font-size: 13px; font-weight: 500; color: var(--of-accent); }
  {{ sid }} .of__cta-busy { flex-direction: row; gap: 10px; opacity: 0; font-size: 16px; font-weight: 700; }
  {{ sid }} .of__cta.is-loading, {{ sid }} .of__cta.is-done { pointer-events: none; }
  {{ sid }} .of__cta.is-loading .of__cta-idle, {{ sid }} .of__cta.is-done .of__cta-idle { opacity: 0; }
  {{ sid }} .of__cta.is-loading .of__cta-busy, {{ sid }} .of__cta.is-done .of__cta-busy { opacity: 1; }
  {{ sid }} .of__cta.is-done .of__spin { display: none; }
  {{ sid }} .of__spin { width: 20px; height: 20px; border-radius: 50%; border: 3px solid rgba(255, 255, 255, 0.3); border-top-color: var(--of-accent); animation: of-spin 0.7s linear infinite; }
  @keyframes of-spin { to { transform: rotate(360deg); } }
  {{ sid }} .of__error { margin-top: 8px; color: #b42318; font-size: 14px; text-align: center; }

  {{ sid }} .of__checks { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; margin: 16px 0 0; padding: 0; list-style: none; font-size: 13px; }
  {{ sid }} .of__checks li { display: flex; align-items: center; gap: 8px; }
  {{ sid }} .of__checks .of-check { width: 20px; height: 20px; flex: none; border-radius: 50%; background: var(--of-ink); color: #fff; display: flex; align-items: center; justify-content: center; }
  {{ sid }} .of__checks .of-check .of-i { width: 12px; height: 12px; stroke-width: 3; }
  {{ sid }} .of__coupon { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 10px; margin-top: 14px; padding: 10px 12px; border: 1.5px dashed var(--of-accent); border-radius: 12px; background: var(--of-soft); font-size: 13px; font-weight: 700; color: var(--of-brand); text-align: center; }
  {{ sid }} .of__coupon code { padding: 4px 10px; border-radius: 6px; background: var(--of-brand); color: #fff; font-family: inherit; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; }

  {{ sid }} .of__trust { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 6px 0 0; padding: 0; list-style: none; }
  {{ sid }} .of__trust li { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; font-size: 12px; font-weight: 700; line-height: 1.25; }
  {{ sid }} .of__trust .of-i { width: 30px; height: 30px; color: var(--of-ink); }

  {{ sid }} .of__guarantee { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 14px; border: 1.5px solid var(--of-accent); background: #fff; }
  {{ sid }} .of__guarantee .of-i { width: 36px; height: 36px; color: var(--of-brand); }
  {{ sid }} .of__guarantee p { font-size: 13.5px; line-height: 1.4; }
  {{ sid }} .of__guarantee strong { font-weight: 800; }

  {{ sid }} .of__acc { border-top: 1px solid var(--of-line); }
  {{ sid }} .of__acc details { border-bottom: 1px solid var(--of-line); }
  {{ sid }} .of__acc summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 2px; font-size: 16px; font-weight: 700; cursor: pointer; list-style: none; }
  {{ sid }} .of__acc summary::-webkit-details-marker { display: none; }
  {{ sid }} .of__acc summary .of-i { width: 20px; height: 20px; transition: transform 0.25s; }
  {{ sid }} .of__acc details[open] summary .of-i { transform: rotate(45deg); }
  {{ sid }} .of__acc-body { padding: 0 2px 18px; font-size: 15px; line-height: 1.6; color: var(--of-muted); }
  {{ sid }} .of__acc-body p + p, {{ sid }} .of__acc-body ul { margin-top: 0.6em; }

  /* ---------- Celular ---------- */
  @media screen and (max-width: 749px) {
    {{ sid }} .of__timer { gap: 10px; padding: 10px 12px; }
    {{ sid }} .of__timer-ico { width: 32px; height: 32px; }
    {{ sid }} .of__timer-ico .of-i { width: 18px; height: 18px; }
    {{ sid }} .of__timer-label { font-size: 11px; letter-spacing: 0.03em; line-height: 1.25; }
    {{ sid }} .of__timer-clock em { display: none; }
    {{ sid }} .of__tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
    {{ sid }} .of__tiles li { padding: 12px 4px; gap: 6px; font-size: 9.5px; letter-spacing: 0.03em; }
    {{ sid }} .of__tiles .of-i { width: 22px; height: 22px; }
    {{ sid }} .of__box { padding: 14px 10px 16px; }
    {{ sid }} .gt__main { gap: 10px; padding: 12px 10px 13px; }
    {{ sid }} .gt__name strong { font-size: 16px; }
    {{ sid }} .gt__meta { font-size: 12.5px; }
    {{ sid }} .gt__price .gt__row:first-child { flex-direction: column; align-items: flex-end; gap: 0; }
    {{ sid }} .gt__price strong { font-size: 18px; }
    {{ sid }} .gt__badges { margin-left: 8px; gap: 3px; }
    {{ sid }} .gt__badges span { padding: 2px 7px; font-size: 10.5px; }
    {{ sid }} .gb, {{ sid }} .gt.is-active .gb { padding: 9px 10px; gap: 8px; }
    {{ sid }} .gt.is-active .gb { grid-template-columns: 20px 40px minmax(0, 1fr) auto; }
    {{ sid }} .gb { grid-template-columns: 40px minmax(0, 1fr) auto; }
    {{ sid }} .gb__img { width: 40px; height: 40px; }
    {{ sid }} .gb__text { font-size: 13px; }
    {{ sid }} .gg__sum, {{ sid }} .gg__list { padding-left: 10px; padding-right: 10px; }
    {{ sid }} .gg__name { font-size: 13.5px; }
    {{ sid }} .of__checks { font-size: 12.5px; gap: 10px; }
  }

  /* ---------- Escritorio ---------- */
  @media screen and (min-width: 750px) {
    {{ sid }} { padding: var(--of-pt) 32px var(--of-pb); }
    {{ sid }} .of__top { margin-bottom: 40px; }
    {{ sid }} .of__lead { font-size: 16px; }
    {{ sid }} .of__tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    {{ sid }}.of--features-desktop .of__features { display: flex; }
    {{ sid }} .of__features { width: 128px; right: 16px; }
    {{ sid }} .of__features li { font-size: 12px; }
    {{ sid }} .of__box { padding: 20px 20px 22px; }
    {{ sid }} .of__thumb { flex-basis: 76px; width: 76px; height: 76px; }
  }
  @media screen and (min-width: 990px) {
    {{ sid }} .of__grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: start; gap: 48px; }
    {{ sid }} .of__left { position: sticky; top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    {{ sid }} .of__track { scroll-behavior: auto; }
    {{ sid }} .of__promo .of-dot { animation: none; }
  }
</style>

