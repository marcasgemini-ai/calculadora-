{%- capture stars -%}
  <span class="of-stars" aria-hidden="true">
    {%- for i in (1..5) -%}<svg viewBox="0 0 24 24"><use href="#ofi-starfill-{{ section.id }}"/></svg>{%- endfor -%}
  </span>
{%- endcapture -%}

{%- if request.design_mode -%}
  {%- if p == blank -%}
    <p style="margin:0 auto 8px;max-width:1240px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: elegí el producto en los ajustes de la sección (o usá la sección en la plantilla de producto).</p>
  {%- endif -%}
  {%- if s.pack_mode == 'variant' and p.variants.size < pack_count -%}
    <p style="margin:0 auto 8px;max-width:1240px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: el modo "Variantes" necesita {{ pack_count }} variantes y el producto tiene {{ p.variants.size }}.</p>
  {%- endif -%}
  {%- if bump_block != blank and bump_variant == blank -%}
    <p style="margin:0 auto 8px;max-width:1240px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: elegí el producto del upsell en "Upsell".</p>
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'regalo' and block.settings.gift_product != blank -%}
      {%- unless block.settings.gift_product.selected_or_first_available_variant.available -%}
        <p style="margin:0 auto 8px;max-width:1240px;padding:8px 10px;border-radius:6px;background:#fff4e5;color:#8a4b00;font-size:13px;">⚠️ Solo el editor ve esto: el regalo "{{ block.settings.title }}" no se puede agregar al carrito (sin stock, en borrador o fuera de Tienda online).</p>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- capture gift_media -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'regalo' -%}{%- continue -%}{%- endif -%}
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
    {%- elsif block.settings.gift_product.featured_image != blank -%}
      {{ block.settings.gift_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
    {%- else -%}
      <svg class="of-i" aria-hidden="true"><use href="#ofi-{{ block.settings.icon }}-{{ section.id }}"/></svg>
    {%- endif -%}
    @@@
  {%- endfor -%}
{%- endcapture -%}
{%- assign gift_media = gift_media | split: '@@@' -%}

<bz-offer
  id="bz-of-{{ section.id }}"
  class="of{% if s.features_mobile == false %} of--features-desktop{% endif %}"
  data-redirect="{{ s.redirect }}"
  data-bump-id="{{ bump_id }}"
  data-bump-free-id="{{ bump_free_id }}"
  data-bump-free-min="{{ bump_free_min }}"
  data-cart-add="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}"
  data-timer="{% if timer_block != blank %}{{ timer_block.settings.timer_minutes }}{% else %}0{% endif %}"
  data-key="{{ section.id }}"
>
  <div class="of__wrap">
    {%- if top_block != blank -%}
      {%- assign ts = top_block.settings -%}
      <div class="of__top" {{ top_block.shopify_attributes }}>
        {%- if ts.top_eyebrow != blank -%}<p class="of__eyebrow">{{ ts.top_eyebrow | escape }}</p>{%- endif -%}
        {%- if ts.top_heading != blank -%}<h2 class="of__headline">{{ ts.top_heading | replace: '[max_off]', max_off_str }}</h2>{%- endif -%}
        {%- if ts.top_text != blank -%}<div class="of__lead">{{ ts.top_text | replace: '[max_off]', max_off_str }}</div>{%- endif -%}
        {%- if ts.top_rating != blank or ts.top_reviews != blank -%}
          <div class="of__proof">
            {{ stars }}
            {%- if ts.top_rating != blank -%}<span>{{ ts.top_rating }}</span>{%- endif -%}
            {%- if ts.top_rating != blank and ts.top_reviews != blank -%}<i></i>{%- endif -%}
            {%- if ts.top_reviews != blank -%}<span>{{ ts.top_reviews }}</span>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="of__grid">
      {%- comment -%} ===================== Columna izquierda ===================== {%- endcomment -%}
      <div class="of__left">
        {%- if timer_block != blank -%}
          {%- assign cs = timer_block.settings -%}
          <div class="of__timer" {{ timer_block.shopify_attributes }}>
            <span class="of__timer-ico"><svg class="of-i" aria-hidden="true"><use href="#ofi-fire-{{ section.id }}"/></svg></span>
            <p class="of__timer-label">{{ cs.timer_label | escape }}</p>
            <div class="of__timer-clock" role="timer" aria-live="off">
              {%- if cs.timer_prefix != blank -%}<em>{{ cs.timer_prefix | escape }}</em>{%- endif -%}
              <b data-h>00</b>:<b data-m>{{ cs.timer_minutes | at_most: 59 | prepend: '0' | slice: -2, 2 }}</b>:<b data-s>00</b>
            </div>
          </div>
        {%- endif -%}

        <div class="of__gallery">
          {%- if s.ribbon != blank -%}
            <div class="of__ribbon">{{ s.ribbon | replace: '[max_off]', max_off_str }}</div>
          {%- endif -%}
          <ul class="of__track" data-track role="list">
            {%- assign media_count = 0 -%}
            {%- for media in p.media -%}
              {%- if media.preview_image == blank -%}{%- continue -%}{%- endif -%}
              {%- assign media_count = media_count | plus: 1 -%}
              {%- assign media_alt = media.alt | default: p.title -%}
              <li class="of__slide" data-slide>
                {{
                  media.preview_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'eager',
                    widths: '500, 750, 1000, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: media_alt
                }}
              </li>
            {%- endfor -%}
            {%- if media_count == 0 -%}
              {%- assign media_count = 1 -%}
              <li class="of__slide" data-slide>{{ 'product-1' | placeholder_svg_tag }}</li>
            {%- endif -%}
          </ul>
          {%- if media_count > 1 -%}
            <button type="button" class="of__nav of__nav--prev" data-prev aria-label="Foto anterior"><svg class="of-i"><use href="#ofi-left-{{ section.id }}"/></svg></button>
            <button type="button" class="of__nav of__nav--next" data-next aria-label="Foto siguiente"><svg class="of-i"><use href="#ofi-right-{{ section.id }}"/></svg></button>
          {%- endif -%}
          {%- capture features -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'destacado' -%}
                <li {{ block.shopify_attributes }}><svg class="of-i" aria-hidden="true"><use href="#ofi-{{ block.settings.icon }}-{{ section.id }}"/></svg>{{ block.settings.text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if features != blank -%}<ul class="of__features" role="list">{{ features }}</ul>{%- endif -%}
        </div>

        {%- if media_count > 1 -%}
          <ul class="of__thumbs" role="list">
            {%- assign n = 0 -%}
            {%- for media in p.media -%}
              {%- if media.preview_image == blank -%}{%- continue -%}{%- endif -%}
              <li>
                <button type="button" class="of__thumb" data-thumb="{{ n }}" aria-label="Ver foto {{ n | plus: 1 }}"{% if n == 0 %} aria-current="true"{% endif %}>
                  {{ media.preview_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
              {%- assign n = n | plus: 1 -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- capture tiles -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'beneficio' -%}
              <li {{ block.shopify_attributes }}><svg class="of-i" aria-hidden="true"><use href="#ofi-{{ block.settings.icon }}-{{ section.id }}"/></svg>{{ block.settings.text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if tiles != blank -%}<ul class="of__tiles" role="list">{{ tiles }}</ul>{%- endif -%}
      </div>

      {%- comment -%} ===================== Columna derecha ===================== {%- endcomment -%}
      <div class="of__right">
        {%- if s.rating_text != blank or s.hot_badge != blank -%}
          <div class="of__meta">
            {%- if s.rating_text != blank -%}<span class="of__rating">{{ stars }}<span>{{ s.rating_text }}</span></span>{%- endif -%}
            {%- if s.hot_badge != blank -%}<span class="of__hot"><svg class="of-i" aria-hidden="true"><use href="#ofi-check-{{ section.id }}"/></svg>{{ s.hot_badge | escape }}</span>{%- endif -%}
          </div>
        {%- endif -%}
        <h1 class="of__title">{{ title | escape }}</h1>
        {%- if s.promo_line != blank -%}
          <p class="of__promo"><span class="of-dot" aria-hidden="true"></span><span>{{ s.promo_line | replace: '[max_off]', max_off_str }}</span></p>
        {%- endif -%}

        <div class="of__box">
          {%- if s.selector_heading != blank -%}
            <div class="of__heading"><span></span><p>{{ s.selector_heading | escape }}</p><span></span></div>
          {%- endif -%}
          {%- if s.tip != blank -%}
            <div class="of__tip"><svg class="of-i" aria-hidden="true"><use href="#ofi-sparkle-{{ section.id }}"/></svg><span>{{ s.tip }}</span></div>
          {%- endif -%}

          <div class="of__tiers" role="radiogroup" aria-label="{{ s.selector_heading | default: 'Elegí tu pack' | escape }}">
            {%- assign pi = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'pack' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign b = block.settings
                assign pi = pi | plus: 1
                assign bottles = b.bottles | default: 1
                if s.pack_mode == 'discount'
                  assign variant = base_variant
                  assign qty = bottles
                  assign tier_price = b.price | default: 0 | times: 100
                  if tier_price == 0
                    assign tier_price = variant.price | times: bottles
                  endif
                  assign compare = variant.price | times: bottles
                else
                  assign vi = b.variant_position | default: 1 | minus: 1
                  assign variant = p.variants[vi]
                  assign qty = 1
                  assign tier_price = variant.price
                  assign compare = variant.compare_at_price | default: variant.price
                endif
                if compare < tier_price
                  assign compare = tier_price
                endif
                assign savings = compare | minus: tier_price
                assign off = 0
                if savings > 0 and compare > 0
                  assign off = savings | times: 100 | divided_by: compare | floor
                endif
                assign days = bottles | times: days_per_bottle
                assign per_day = tier_price | divided_by: days | floor
                assign bump_free = false
                if bottles >= bump_free_min
                  assign bump_free = true
                endif
                assign unlocked = 0
                for gb in section.blocks
                  if gb.type == 'regalo'
                    assign gmin = gb.settings.min_bottles | default: 0
                    if bottles >= gmin
                      assign unlocked = unlocked | plus: 1
                    endif
                  endif
                endfor
                assign is_active = false
                if pi == preselected
                  assign is_active = true
                endif
              -%}
              {%- if variant != blank -%}
                <div
                  class="gt{% if is_active %} is-active{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-qty="{{ qty }}"
                  data-bottles="{{ bottles }}"
                  data-name="{{ b.title | escape }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if b.badges != blank -%}
                    <div class="gt__badges">
                      {%- assign badges = b.badges | split: ',' -%}
                      {%- for badge in badges -%}
                        {%- assign bt = badge | strip -%}
                        {%- if bt != blank -%}<span{% if forloop.first %} class="is-dark"{% endif %}>{{ bt | escape }}</span>{%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  <label class="gt__main">
                    <input type="radio" class="gt__radio" name="bz-tier-{{ section.id }}" value="{{ variant.id }}"{% if is_active %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                    <span class="gt__dot" aria-hidden="true"></span>
                    <span class="gt__name">
                      <strong>{{ b.title | escape }}</strong>
                      <span class="gt__meta">
                        {{- b.meta | escape -}}
                        {%- if s.show_per_day and per_day > 0 -%}{% if b.meta != blank %} · {% endif %}{{ per_day | money_without_trailing_zeros }} {{ s.per_day_label | escape }}{%- endif -%}
                      </span>
                      {%- if b.subtitle != blank -%}<span class="gt__sub">{{ b.subtitle | escape }}</span>{%- endif -%}
                    </span>
                    <span class="gt__price">
                      <span class="gt__row">
                        {%- if savings > 0 -%}<s>{{ compare | money_without_trailing_zeros }}</s>{%- endif -%}
                        <strong>{{ tier_price | money_without_trailing_zeros }}</strong>
                      </span>
                      {%- if off > 0 and s.show_off -%}
                        <span class="gt__row"><span class="gt__off">{{ off }}% OFF</span></span>
                      {%- endif -%}
                      {%- if savings > 0 and s.show_savings -%}
                        <span class="gt__save">{{ s.savings_label | escape }} {{ savings | money_without_trailing_zeros }}</span>
                      {%- endif -%}
                    </span>
                  </label>

                  {%- if show_bump -%}
                    <div class="gb" role="checkbox" tabindex="-1" aria-checked="false" data-bump-row>
                      <span class="gb__box" aria-hidden="true"></span>
                      <span class="gb__img">
                        {%- if bump_product.featured_image -%}
                          {{ bump_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: bump_title }}
                        {%- endif -%}
                      </span>
                      <span class="gb__text">{% if bump_free %}{{ bs.bump_text_free }}{% else %}{{ bs.bump_text }}{% endif %}</span>
                      <span class="gb__price">
                        <strong>{% if bump_free %}{{ bs.free_label | escape }}{% else %}{{ bump_cents | money_without_trailing_zeros }}{% endif %}</strong>
                        <s>{{ bump_orig | money_without_trailing_zeros }}</s>
                      </span>
                    </div>
                  {%- endif -%}

                  {%- if gift_count > 0 -%}
                    <div class="gg">
                      <div class="gg__sum">
                        <span class="gg__count">
                          <svg class="of-i" aria-hidden="true"><use href="#ofi-gift-{{ section.id }}"/></svg>
                          {%- if unlocked > 0 -%}{{ unlocked }}/{{ gift_count }} {{ s.gifts_label | escape }}{%- else -%}{{ s.gifts_from_label | escape }} {{ first_gift_min }} {{ s.unit_plural | escape }}{%- endif -%}
                        </span>
                        <span class="gg__thumbs">
                          {%- assign gi = 0 -%}
                          {%- for gb in section.blocks -%}
                            {%- if gb.type != 'regalo' -%}{%- continue -%}{%- endif -%}
                            {%- assign gmin = gb.settings.min_bottles | default: 0 -%}
                            <span class="gg__thumb{% if bottles < gmin %} is-locked{% endif %}">{{ gift_media[gi] }}</span>
                            {%- assign gi = gi | plus: 1 -%}
                          {%- endfor -%}
                        </span>
                      </div>
                      <ul class="gg__list" role="list">
                        {%- assign gi = 0 -%}
                        {%- for gb in section.blocks -%}
                          {%- if gb.type != 'regalo' -%}{%- continue -%}{%- endif -%}
                          {%- assign g = gb.settings -%}
                          {%- assign gmin = g.min_bottles | default: 0 -%}
                          <li class="{% if bottles < gmin %}is-locked{% endif %}">
                            <span class="gg__thumb">{{ gift_media[gi] }}</span>
                            <span class="gg__name">+ {{ g.title | escape }}</span>
                            {%- if bottles >= gmin -%}
                              <span class="gg__val">
                                {%- if g.tag != blank -%}<em{% if g.is_raffle %} class="is-dark"{% endif %}>{{ g.tag | escape }}</em>{%- endif -%}
                                {%- unless g.is_raffle -%}<b>$0</b>{%- endunless -%}
                                {%- if g.value != blank -%}<s>{{ g.value | escape }}</s>{%- endif -%}
                              </span>
                            {%- else -%}
                              <span class="gg__val gg__need"><svg class="of-i" aria-hidden="true"><use href="#ofi-lock-{{ section.id }}"/></svg>{{ s.gift_need_label | escape }} {{ gmin }} {{ s.unit_plural | escape }}</span>
                            {%- endif -%}
                          </li>
                          {%- assign gi = gi | plus: 1 -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <button type="button" class="of__cta" data-cta{% if p == blank %} disabled{% endif %}>
            <span class="of__cta-idle">
              <span class="of__cta-main">{{ s.cta_label | escape }}</span>
              {%- if s.cta_sub != blank -%}<span class="of__cta-sub">{{ s.cta_sub | escape }}</span>{%- endif -%}
            </span>
            <span class="of__cta-busy" aria-hidden="true"><span class="of__spin"></span><span data-busy-text>{{ s.adding_label | escape }}</span></span>
          </button>
          <p class="of__error" data-error hidden></p>

          {%- capture checks -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'ventaja' -%}
                <li {{ block.shopify_attributes }}><span class="of-check"><svg class="of-i" aria-hidden="true"><use href="#ofi-check-{{ section.id }}"/></svg></span>{{ block.settings.text | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if checks != blank -%}<ul class="of__checks" role="list">{{ checks }}</ul>{%- endif -%}

          {%- if coupon_block != blank and coupon_block.settings.coupon_text != blank -%}
            <div class="of__coupon" {{ coupon_block.shopify_attributes }}>
              {%- if coupon_block.settings.coupon_code != blank -%}<code>{{ coupon_block.settings.coupon_code | escape }}</code>{%- endif -%}
              <span>{{ coupon_block.settings.coupon_text | escape }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- capture trust -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'confianza' -%}
              <li {{ block.shopify_attributes }}><svg class="of-i" aria-hidden="true"><use href="#ofi-{{ block.settings.icon }}-{{ section.id }}"/></svg>{{ block.settings.text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if trust != blank -%}<ul class="of__trust" role="list">{{ trust }}</ul>{%- endif -%}

        {%- if guarantee_block != blank -%}
          <div class="of__guarantee" {{ guarantee_block.shopify_attributes }}>
            <svg class="of-i" aria-hidden="true"><use href="#ofi-shield-{{ section.id }}"/></svg>
            <p><strong>{{ guarantee_block.settings.guarantee_title | escape }}</strong> {{ guarantee_block.settings.guarantee_text | escape }}</p>
          </div>
        {%- endif -%}

        {%- capture acc -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'acordeon' -%}
              <details {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>{{ block.settings.title | escape }}<svg class="of-i" aria-hidden="true"><use href="#ofi-plus-{{ section.id }}"/></svg></summary>
                <div class="of__acc-body">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if acc != blank -%}<div class="of__acc">{{ acc }}</div>{%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-gifts>
    [
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type != 'regalo' -%}{%- continue -%}{%- endif -%}
        {%- assign gid = 'null' -%}
        {%- assign gv = block.settings.gift_product.selected_or_first_available_variant -%}
        {%- if gv != blank and gv.available -%}{%- assign gid = gv.id -%}{%- endif -%}
        {%- unless first -%},{%- endunless -%}
        { "min": {{ block.settings.min_bottles | default: 0 }}, "variantId": {{ gid }} }
        {%- assign first = false -%}
      {%- endfor -%}
    ]
  </script>
</bz-offer>

<script>
  if (!customElements.get('bz-offer')) {
    customElements.define('bz-offer', class extends HTMLElement {
      connectedCallback() {
        if (this._ready) return;
        this._ready = true;
        this.initGallery();
        this.initTimer();
        this.initTiers();
      }

      disconnectedCallback() {
        clearInterval(this.timerId);
      }

      /* ---------- Galería ---------- */
      initGallery() {
        const track = this.querySelector('[data-track]');
        if (!track) return;
        const slides = Array.from(track.querySelectorAll('[data-slide]'));
        const thumbs = Array.from(this.querySelectorAll('[data-thumb]'));
        const prev = this.querySelector('[data-prev]');
        const next = this.querySelector('[data-next]');
        const index = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
        const go = (i) => {
          const n = Math.max(0, Math.min(i, slides.length - 1));
          track.scrollTo({ left: n * track.clientWidth });
        };
        const update = () => {
          const i = index();
          thumbs.forEach((t, n) => t.setAttribute('aria-current', n === i ? 'true' : 'false'));
          if (prev) prev.disabled = i <= 0;
          if (next) next.disabled = i >= slides.length - 1;
        };
        let raf;
        track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
        if (prev) prev.addEventListener('click', () => go(index() - 1));
        if (next) next.addEventListener('click', () => go(index() + 1));
        thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.thumb))));
        update();
      }

      /* ---------- Contador (se reinicia solo al terminar) ---------- */
      initTimer() {
        const h = this.querySelector('[data-h]');
        const m = this.querySelector('[data-m]');
        const sEl = this.querySelector('[data-s]');
        const minutes = Number(this.dataset.timer) || 0;
        if (!h || !minutes) return;
        const key = 'bz-offer-end-' + this.dataset.key;
        const read = () => { try { return Number(localStorage.getItem(key)) || 0; } catch (e) { return 0; } };
        const write = (v) => { try { localStorage.setItem(key, String(v)); } catch (e) {} };
        let end = read();
        const pad = (v) => String(v).padStart(2, '0');
        const tick = () => {
          let left = end - Date.now();
          if (left <= 0) { end = Date.now() + minutes * 60000; write(end); left = end - Date.now(); }
          const t = Math.floor(left / 1000);
          h.textContent = pad(Math.floor(t / 3600));
          m.textContent = pad(Math.floor((t % 3600) / 60));
          sEl.textContent = pad(t % 60);
        };
        tick();
        this.timerId = setInterval(tick, 1000);
      }

      /* ---------- Packs, upsell, regalos y carrito ---------- */
      initTiers() {
        const root = this;
        const tiers = Array.from(this.querySelectorAll('.gt'));
        const cta = this.querySelector('[data-cta]');
        const errorEl = this.querySelector('[data-error]');
        if (!tiers.length || !cta) return;
        let gifts = [];
        try { gifts = JSON.parse(this.querySelector('[data-gifts]').textContent); } catch (e) {}
        const bumpId = Number(this.dataset.bumpId) || null;
        const bumpFreeId = Number(this.dataset.bumpFreeId) || null;
        const bumpFreeMin = Number(this.dataset.bumpFreeMin) || Infinity;
        let bumpOn = false;
        let wasFree = false;

        const active = () => root.querySelector('.gt.is-active') || tiers[0];
        const bottlesOf = (t) => Number(t.dataset.bottles);
        const render = () => {
          const tier = active();
          const free = bottlesOf(tier) >= bumpFreeMin;
          if (free && !wasFree) bumpOn = true;
          wasFree = free;
          root.classList.toggle('bump-on', bumpOn && !!bumpId);
          tiers.forEach((t) => {
            const row = t.querySelector('[data-bump-row]');
            if (!row) return;
            const on = t === tier;
            row.setAttribute('tabindex', on ? '0' : '-1');
            row.setAttribute('aria-checked', on && bumpOn ? 'true' : 'false');
          });
        };
        const select = (tier) => {
          tiers.forEach((t) => {
            const on = t === tier;
            t.classList.toggle('is-active', on);
            t.querySelector('.gt__radio').checked = on;
          });
          render();
        };

        tiers.forEach((tier) => {
          const radio = tier.querySelector('.gt__radio');
          radio.addEventListener('change', () => select(tier));
          tier.addEventListener('click', (e) => {
            const row = e.target.closest('[data-bump-row]');
            if (row && tier.classList.contains('is-active')) { bumpOn = !bumpOn; render(); return; }
            if (!radio.disabled && !tier.classList.contains('is-active')) select(tier);
          });
          const row = tier.querySelector('[data-bump-row]');
          if (row) row.addEventListener('keydown', (e) => {
            if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); row.click(); }
          });
        });

        this.addEventListener('shopify:block:select', (e) => {
          if (e.target.classList && e.target.classList.contains('gt')) select(e.target);
        });

        const post = (body) => fetch(root.dataset.cartAdd, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body)
        });
        const resetCta = () => setTimeout(() => { cta.classList.remove('is-done'); cta.removeAttribute('aria-busy'); }, 600);
        const openThemeCart = () => {
          ['cart:refresh', 'cart:updated', 'cart:build'].forEach((n) => document.dispatchEvent(new CustomEvent(n, { bubbles: true })));
          const toggle = document.querySelector('[data-cart-drawer-toggle], [data-drawer-toggle="cart"], .js-drawer-open-cart, [aria-controls="CartDrawer"], [aria-controls="cart-drawer"]');
          if (toggle) { toggle.click(); return true; }
          return false;
        };

        cta.addEventListener('click', () => {
          const tier = active();
          const bottles = bottlesOf(tier);
          const offer = tier.dataset.name;
          const items = [{ id: Number(tier.dataset.variantId), quantity: Number(tier.dataset.qty) || 1, properties: { _oferta: offer } }];
          if (bumpOn && bumpId) items.push({ id: (bottles >= bumpFreeMin && bumpFreeId) ? bumpFreeId : bumpId, quantity: 1, properties: { _oferta: offer + ' · upsell' } });
          const giftItems = gifts
            .filter((g) => g.variantId && bottles >= g.min)
            .map((g) => ({ id: g.variantId, quantity: 1, properties: { _regalo: offer } }));

          const busyText = cta.querySelector('[data-busy-text]');
          const busyDefault = busyText.dataset.default || busyText.textContent;
          busyText.dataset.default = busyDefault;
          busyText.textContent = busyDefault;
          cta.classList.add('is-loading');
          cta.setAttribute('aria-busy', 'true');
          errorEl.hidden = true;

          const drawer = document.querySelector('cart-drawer');
          const useDrawer = root.dataset.redirect === 'drawer' && drawer && typeof drawer.renderContents === 'function';
          const payload = { items };
          if (useDrawer) {
            payload.sections = ['cart-drawer', 'cart-icon-bubble'];
            payload.sections_url = window.location.pathname;
          }
          let cartData;
          const giftReq = giftItems.length ? post({ items: giftItems }).catch(() => {}) : Promise.resolve();
          giftReq
            .then(() => post(payload))
            .then((res) => res.json().then((d) => { if (!res.ok) throw d; return d; }))
            .then((d) => {
              cartData = d;
              cta.classList.remove('is-loading');
              cta.classList.add('is-done');
              busyText.textContent = '✓';
              return new Promise((r) => setTimeout(r, useDrawer ? 350 : 450));
            })
            .then(() => {
              const mode = root.dataset.redirect;
              if (mode === 'checkout') { window.location.href = '/checkout'; return; }
              if (mode === 'drawer') {
                if (useDrawer && cartData && cartData.sections) {
                  try {
                    const inner = drawer.querySelector('.drawer__inner');
                    if (inner) inner.classList.remove('is-empty');
                    drawer.classList.remove('is-empty');
                    drawer.renderContents(cartData);
                    resetCta();
                    return;
                  } catch (e) { /* el tema no responde: vamos al carrito */ }
                }
                if (openThemeCart()) { resetCta(); return; }
              }
              window.location.href = root.dataset.cartUrl;
            })
            .catch((err) => {
              cta.classList.remove('is-loading');
              cta.removeAttribute('aria-busy');
              errorEl.textContent = (err && (err.description || err.message)) || 'No pudimos agregar el pack. Probá de nuevo.';
              errorEl.hidden = false;
            });
        });

        select(active());
      }
    });
  }
</script>

{% schema %}
{
  "name": "Bronzer · Oferta",
  "tag": "section",
  "class": "section-bronzer-oferta",
  "max_blocks": 40,
  "settings": [
    {
      "type": "header",
      "content": "Producto"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto",
      "info": "En la plantilla de producto podés dejarlo vacío: usa el producto de la página."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título (opcional)",
      "info": "Si lo dejás vacío usa el nombre del producto."
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Fotos de la galería",
      "options": [
        {
          "value": "contain",
          "label": "Completas"
        },
        {
          "value": "cover",
          "label": "Rellenar (recorta)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "paragraph",
      "content": "En la cinta podés usar [max_off] para mostrar el mayor % de descuento."
    },
    {
      "type": "inline_richtext",
      "id": "ribbon",
      "label": "Cinta sobre la foto",
      "default": "Oferta: hasta <strong>[max_off]</strong> off + envío gratis"
    },
    {
      "type": "checkbox",
      "id": "features_mobile",
      "label": "Mostrar íconos sobre la foto en celular",
      "default": false
    },
    {
      "type": "header",
      "content": "Información del producto"
    },
    {
      "type": "inline_richtext",
      "id": "rating_text",
      "label": "Calificación",
      "default": "<strong>4.9</strong> · +3mil reseñas"
    },
    {
      "type": "text",
      "id": "hot_badge",
      "label": "Etiqueta",
      "default": "Se agota rápido"
    },
    {
      "type": "inline_richtext",
      "id": "promo_line",
      "label": "Línea de promoción",
      "default": "Pedí hoy y ahorrá hasta <strong>[max_off]</strong>"
    },
    {
      "type": "header",
      "content": "Selector de packs"
    },
    {
      "type": "select",
      "id": "pack_mode",
      "label": "Cómo se cobra cada pack",
      "info": "Descuento: suma N frascos de la 1ª variante y cobra un descuento automático. Variantes: cada pack es una variante.",
      "options": [
        {
          "value": "discount",
          "label": "Descuento automático (N frascos)"
        },
        {
          "value": "variant",
          "label": "Cada pack es una variante"
        }
      ],
      "default": "discount"
    },
    {
      "type": "text",
      "id": "selector_heading",
      "label": "Título del selector",
      "default": "Elegí tu pack"
    },
    {
      "type": "inline_richtext",
      "id": "tip",
      "label": "Recomendación",
      "default": "<strong>Recomendado:</strong> 3 meses para un tono duradero"
    },
    {
      "type": "number",
      "id": "days_per_bottle",
      "label": "Días que dura un frasco",
      "info": "Se usa para el precio por día. 60 cápsulas, 1 por día = 60.",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "show_per_day",
      "label": "Mostrar precio por día",
      "default": true
    },
    {
      "type": "text",
      "id": "per_day_label",
      "label": "Texto del precio por día",
      "default": "por día"
    },
    {
      "type": "checkbox",
      "id": "show_off",
      "label": "Mostrar % OFF",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Mostrar \"Ahorrás $\"",
      "default": true
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Texto de ahorro",
      "default": "Ahorrás"
    },
    {
      "type": "text",
      "id": "unit_plural",
      "label": "Unidad (plural)",
      "default": "frascos"
