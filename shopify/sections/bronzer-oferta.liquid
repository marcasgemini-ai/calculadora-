    <symbol id="ofi-users-{{ section.id }}" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.6 2.7-6 6-6s6 2.4 6 6"/><path d="M15.5 4.9a3.2 3.2 0 010 6.2M17.5 14.4c2.1.8 3.5 2.8 3.5 5.6"/></symbol>
