{%- comment -%}
  DR WOMAN · Selector de packs Bronzer + upsell CELUFIT
  Pegar en: Personalizar > Producto > Agregar bloque > Liquid personalizado
  Packs: Lleva 1 y Pack 2x1 (1 frasco, mismo precio), 2 y 3 frascos de 60 cápsulas.
  Precio del producto en Shopify: $49.990 (1 frasco). Los packs se cobran con descuentos automáticos por cantidad:
  $17.995 por unidad desde 2 y $18.660 por unidad desde 3 (solo para Bronzer).
  Upsell: producto CELUFIT oferta (handle celufit-oferta-upsell), precio ya rebajado, sin descuento.
  Regalo: SLIMFIT GRATIS en Pack 6 Meses (handle slimfit-upsell-gra, variante de $0).
  Cabecera CYBER MONDAY: la cuenta regresiva termina en cyber_end (hora Argentina). Pasada esa fecha se oculta sola.
{%- endcomment -%}
{%- assign cyber_end = '2026-11-04T23:59:59-03:00' -%}
{%- assign dw_celufit_handle = 'celufit-oferta-upsell' -%}
{%- assign dw_variant = product.selected_or_first_available_variant -%}
{%- assign dw_celufit = all_products[dw_celufit_handle] -%}
{%- assign dw_celufit_variant = dw_celufit.selected_or_first_available_variant -%}
{%- liquid
  # Regalo: usa la variante de $0 del producto SLIMFIT.
  # gift_value = precio normal de 1 SLIMFIT (se muestra tachado y se suma al ahorro).
  assign dw_gift_handle = 'slimfit-upsell-gra'
  assign gift_value = 39990
  assign dw_gift = all_products[dw_gift_handle]
  assign dw_gift_variant = blank
  assign gift_found = false
  for v in dw_gift.variants
    if gift_found == false and v.price == 0 and v.available
      assign dw_gift_variant = v
      assign gift_found = true
    endif
  endfor
  assign n = gift_value
  assign th = n | divided_by: 1000 | floor
  assign rest = n | modulo: 1000 | prepend: '00' | slice: -3, 3
  if th > 0
    assign gift_txt = '$' | append: th | append: '.' | append: rest
  else
    assign gift_txt = '$' | append: n
  endif
-%}

<div class="dw-offer" id="dw-offer" data-variant="{{ dw_variant.id }}" data-cart-add="{{ routes.cart_add_url }}.js" data-cart="{{ routes.cart_url }}" data-root="{{ routes.root_url }}" data-upsell="{{ dw_celufit_handle }}" data-gift-handle="{{ dw_gift_handle }}" data-gift="{% if gift_found %}{{ dw_gift_variant.id }}{% endif %}" data-gift-value="{{ gift_value }}">
  <div class="dw-cyber">
    <span class="dw-cyber-kicker">⚡ Precios más bajos del año ⚡</span>
    <span class="dw-cyber-title">CYBER<span>MONDAY</span></span>
    <span class="dw-cyber-sub">Hasta <b>37% OFF</b> + <b>ENVÍO GRATIS</b> + regalo</span>
    <div class="dw-cyber-timer" data-dw-end="{{ cyber_end }}" hidden>
      <span class="dw-cyber-ends">Termina en</span>
      <span class="dw-t"><b data-t="d">00</b><small>días</small></span><i>:</i>
      <span class="dw-t"><b data-t="h">00</b><small>hs</small></span><i>:</i>
      <span class="dw-t"><b data-t="m">00</b><small>min</small></span><i>:</i>
      <span class="dw-t"><b data-t="s">00</b><small>seg</small></span>
    </div>
  </div>

  <label class="dw-bar">
    <input type="radio" name="dw-pack" value="1" data-save="0" data-total="49990">
    <span class="dw-radio"></span>
    <span class="dw-info">
      <span class="dw-title">Lleva 1 <span class="dw-tag">30 cápsulas</span></span>
      <span class="dw-sub">Para <b>1 mes</b> + <b>ENVÍO GRATIS</b></span>
    </span>
    <span class="dw-prices">
      <span class="dw-price">$49.990</span>
    </span>
  </label>

  <label class="dw-bar">
    <input type="radio" name="dw-pack" value="1" data-save="0" data-total="49990">
    <span class="dw-radio"></span>
    <span class="dw-info">
      <span class="dw-title">Pack 2x1 <span class="dw-tag">60 cápsulas</span></span>
      <span class="dw-sub">Para <b>2 meses</b> + <b>ENVÍO GRATIS</b></span>
    </span>
    <span class="dw-prices">
      <span class="dw-price">$49.990</span>
    </span>
  </label>

  <label class="dw-bar is-active">
    <span class="dw-badge">Más elegido</span>
    <input type="radio" name="dw-pack" value="2" data-save="35990" data-total="63990" checked>
    <span class="dw-radio"></span>
    <span class="dw-info">
      <span class="dw-title">Pack 4 Meses <span class="dw-tag">120 cápsulas</span></span>
      <span class="dw-sub">Para <b>4 meses</b> + <b>ENVÍO GRATIS</b></span>
    </span>
    <span class="dw-prices">
      <span class="dw-price">$63.990</span>
      <span class="dw-compare-row"><s class="dw-compare">$99.980</s><span class="dw-off">-36%</span></span>
    </span>
  </label>

  <label class="dw-bar dw-bar--gift">
    <span class="dw-badge">Mejor opción</span>
    <input type="radio" name="dw-pack" value="3" data-gift="1" data-save="55980" data-total="93990">
    <span class="dw-radio"></span>
    <span class="dw-info">
      <span class="dw-title">Pack 6 Meses <span class="dw-tag">180 cápsulas</span></span>
      <span class="dw-sub">Para <b>6 meses</b> + <b>ENVÍO GRATIS</b></span>
    </span>
    <span class="dw-prices">
      <span class="dw-price">$93.990</span>
      <span class="dw-compare-row"><s class="dw-compare">$149.970</s><span class="dw-off">-37%</span></span>
    </span>
    <span class="dw-gift"{% unless gift_found %} hidden{% endunless %}>
      <img class="dw-gift-img" src="{% if dw_gift.featured_image %}{{ dw_gift.featured_image | image_url: width: 120 }}{% endif %}" alt="SLIMFIT" width="40" height="40" loading="lazy"{% unless dw_gift.featured_image %} hidden{% endunless %}>
      <span class="dw-gift-text"><span class="dw-gift-name">🔥 Quemador de grasa natural</span><span class="dw-gift-sub">+ <b>SLIMFIT</b> de regalo 🎁</span></span>
      <span class="dw-gift-price"><s class="dw-gift-old">{{ gift_txt }}</s><span class="dw-gift-free">GRATIS</span></span>
    </span>
  </label>

  <label class="dw-upsell"{% unless dw_celufit_variant.available %} hidden{% endunless %}>
    <input type="checkbox" id="dw-celufit" value="{% if dw_celufit_variant.available %}{{ dw_celufit_variant.id }}{% endif %}" data-save="29850" data-total="29850">
    <span class="dw-check"></span>
    <span class="dw-up-text">Elimina la celulitis <b>al 50% OFF</b></span>
    <span class="dw-up-price">$29.850</span>
  </label>

  <div class="dw-save">→ Estás ahorrando <strong data-dw-save>$35.990</strong> en este pedido</div>

  <button type="button" class="dw-btn"><span data-dw-btn-label>Agregar al carrito</span><span class="dw-btn-total" data-dw-total></span></button>
  <p class="dw-msg" data-dw-msg role="alert" hidden></p>

</div>

<style>
  .dw-offer{--dw-brown:#4A2C1D;--dw-peach:#F6D9C4;--dw-cream:#FBF6F0;--dw-line:#E8DCD0;
    width:100%;max-width:100%;margin:14px 0;padding:0;background:transparent;overflow:visible;
    color:var(--dw-brown);font-family:inherit;line-height:1.3;letter-spacing:0;box-sizing:border-box}
  .dw-offer *,.dw-offer *:before,.dw-offer *:after{box-sizing:border-box;letter-spacing:0}
  .dw-offer .dw-cyber{--cy-cyan:#00E5FF;--cy-pink:#FF2D95;position:relative;display:flex;flex-direction:column;align-items:center;gap:4px;
    margin:0 0 20px;padding:14px 14px 12px;border-radius:14px;overflow:hidden;text-align:center;color:#fff;
    background:radial-gradient(120% 140% at 0% 0%,#3B0D5C 0%,transparent 55%),radial-gradient(120% 140% at 100% 100%,#062B4F 0%,transparent 55%),#120A24;
    box-shadow:0 0 0 1.5px rgba(0,229,255,.45),0 6px 22px rgba(255,45,149,.22)}
  .dw-offer .dw-cyber:after{content:"";position:absolute;top:0;left:-60%;width:40%;height:100%;pointer-events:none;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.18),transparent);animation:dwShine 3.2s ease-in-out infinite}
  @keyframes dwShine{0%,55%{left:-60%}100%{left:130%}}
  .dw-cyber-kicker{font-size:11px;font-weight:700;text-transform:uppercase;color:var(--cy-cyan);letter-spacing:.06em}
  .dw-offer .dw-cyber-title{display:block;font-size:30px;line-height:1;font-weight:900;font-style:italic;letter-spacing:.02em;
    text-shadow:0 0 12px rgba(0,229,255,.55)}
  .dw-offer .dw-cyber-title span{margin-left:6px;color:var(--cy-pink);text-shadow:0 0 12px rgba(255,45,149,.7)}
  .dw-cyber-sub{font-size:13px;font-weight:500;opacity:.95}
  .dw-cyber-sub b{color:#FFE14D;font-weight:800}
  .dw-offer .dw-cyber-timer{display:flex;align-items:center;justify-content:center;gap:5px;margin-top:6px;flex-wrap:wrap}
  .dw-offer .dw-cyber-timer[hidden]{display:none}
  .dw-cyber-ends{width:100%;font-size:11px;font-weight:600;opacity:.8;text-transform:uppercase}
  .dw-t{display:flex;flex-direction:column;align-items:center;min-width:44px;padding:5px 4px 3px;border-radius:8px;
    background:rgba(255,255,255,.08);border:1px solid rgba(0,229,255,.35)}
  .dw-t b{font-size:19px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
  .dw-t small{font-size:9px;opacity:.75;text-transform:uppercase;margin-top:2px}
  .dw-cyber-timer i{font-style:normal;font-weight:800;color:var(--cy-pink)}
  .dw-compare-row{display:flex;align-items:center;gap:5px}
  .dw-offer .dw-off{background:#FF2D95;color:#fff;font-size:11px;font-weight:800;padding:1px 5px;border-radius:5px;line-height:1.3}
  .dw-offer .dw-bar{position:relative;display:flex;align-items:center;gap:12px;width:100%;margin:0 0 14px;padding:16px 18px;
    background:#fff;border:1.5px solid var(--dw-line);border-radius:12px;cursor:pointer;
    transition:border-color .2s,box-shadow .2s;-webkit-tap-highlight-color:transparent}
  .dw-offer .dw-bar.dw-bar--gift{flex-wrap:wrap;row-gap:0}
  .dw-bar--gift .dw-info{flex-basis:0}
  .dw-offer .dw-gift{flex:0 0 calc(100% + 36px);display:flex;align-items:center;gap:10px;margin:14px -18px -16px;padding:10px 18px;
    background:var(--dw-cream);border-top:1.5px dashed #D7C3B2;border-radius:0 0 10px 10px;font-size:14px}
  .dw-offer .dw-gift[hidden]{display:none}
  .dw-offer .dw-gift-img{flex:0 0 40px;width:40px;height:40px;object-fit:contain;border-radius:8px;background:#fff;border:1px solid var(--dw-line)}
  .dw-offer .dw-gift-img[hidden]{display:none}
  .dw-gift-text{flex:1;min-width:0;font-weight:500}
  .dw-gift-text b{font-weight:700}
  .dw-offer .dw-gift-text{display:flex;flex-direction:column;gap:1px}
  .dw-offer .dw-gift-name{font-weight:700}
  .dw-offer .dw-gift-sub{font-size:12px;opacity:.8}
  .dw-gift-price{display:flex;flex-direction:column;align-items:flex-end;gap:3px;white-space:nowrap}
  .dw-gift-old{font-size:13px;opacity:.55;white-space:nowrap}
  .dw-offer .dw-gift-free{background:var(--dw-brown);color:#fff;font-size:12px;font-weight:700;padding:3px 9px;border-radius:6px;white-space:nowrap}
  .dw-offer .dw-bar.is-active{border:2px solid var(--dw-brown);box-shadow:0 2px 12px rgba(74,44,29,.12)}
  .dw-offer input{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
  .dw-radio{flex:0 0 20px;width:20px;height:20px;border:2px solid #B9A99B;border-radius:50%;position:relative}
  .dw-bar.is-active .dw-radio{border-color:var(--dw-brown)}
  .dw-bar.is-active .dw-radio:after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--dw-brown)}
  .dw-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .dw-title{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:17px;font-weight:700}
  .dw-sub{font-size:13px;opacity:.75;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .dw-sub b{font-weight:700}
  .dw-tag{background:var(--dw-peach);font-size:12px;font-weight:700;padding:2px 8px;border-radius:6px;white-space:nowrap}
  .dw-prices{display:flex;flex-direction:column;align-items:flex-end;white-space:nowrap}
  .dw-price{font-size:18px;font-weight:700}
  .dw-compare{font-size:13px;opacity:.55}
  .dw-msg[hidden]{display:none}
  .dw-btn-total{font-weight:600;opacity:.85}
  .dw-btn-total:not(:empty):before{content:" · "}
  .dw-msg{margin:8px 0 0;font-size:13px;color:#B4432B;text-align:center}
  .dw-badge{position:absolute;top:-11px;right:14px;background:var(--dw-brown);color:#fff;font-size:12px;font-weight:700;
    padding:3px 10px;border-radius:6px;line-height:1.3}
  .dw-badge--hot{background:#B4432B}
  .dw-offer .dw-upsell[hidden],.dw-save[hidden]{display:none}
  .dw-offer .dw-upsell{position:relative;display:flex;align-items:center;gap:10px;width:100%;margin:0 0 12px;padding:14px 18px;
    background:var(--dw-cream);border:1.5px dashed #D7C3B2;border-radius:12px;cursor:pointer;font-size:14px}
  .dw-check{flex:0 0 18px;width:18px;height:18px;border:2px solid var(--dw-brown);border-radius:4px;position:relative;background:#fff}
  .dw-upsell input:checked + .dw-check{background:var(--dw-brown)}
  .dw-upsell input:checked + .dw-check:after{content:"";position:absolute;left:4px;top:0;width:5px;height:10px;
    border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
  .dw-up-text{flex:1;min-width:0;font-weight:500}
  .dw-up-price{font-weight:700;white-space:nowrap}
  .dw-save{margin:0 0 12px;padding:10px 14px;border:1px solid var(--dw-line);border-radius:10px;font-size:14px;text-align:center}
  .dw-offer .dw-btn{display:block;width:100%;min-height:54px;margin:0;padding:16px;background:var(--dw-brown);color:#fff;
    border:0;border-radius:10px;font-family:inherit;font-size:17px;font-weight:700;text-transform:none;
    cursor:pointer;-webkit-appearance:none;appearance:none;transition:opacity .2s}
  .dw-offer .dw-btn:hover{opacity:.92}
  .dw-offer .dw-btn:disabled{opacity:.6;cursor:wait}
  @media (max-width:749px){
    .dw-offer .dw-bar{padding:14px 14px;gap:10px}
    .dw-title{font-size:16px;gap:6px}
    .dw-sub{font-size:12px}
    .dw-price{font-size:17px}
    .dw-compare{font-size:12px}
    .dw-offer .dw-cyber-title{font-size:26px}
    .dw-t{min-width:40px}
    .dw-offer .dw-upsell{padding:13px 14px;font-size:13px}
    .dw-offer .dw-gift{flex-basis:calc(100% + 28px);margin:12px -14px -14px;padding:9px 14px;gap:8px;font-size:13px}
    .dw-gift-old{font-size:12px}
    .dw-save{font-size:13px;padding:9px 10px}
  }
</style>

<script>
(function(){
  var root = document.getElementById('dw-offer');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  var up = document.getElementById('dw-celufit');
  var btn = root.querySelector('.dw-btn');
  var label = root.querySelector('[data-dw-btn-label]');
  var totalEl = root.querySelector('[data-dw-total]');
  var saveEl = root.querySelector('[data-dw-save]');
  var msg = root.querySelector('[data-dw-msg]');
  var base = (root.dataset.root || '/').replace(/\/$/, '');
  var busy = false;
  var gift = root.dataset.gift;
  var giftValue = Number(root.dataset.giftValue) || 0;
  var fmt = function(n){ return '$' + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };

  /* ---------- Cuenta regresiva CYBER MONDAY ---------- */
  var timer = root.querySelector('.dw-cyber-timer');
  var endAt = timer ? Date.parse(timer.dataset.dwEnd) : NaN;
  if (timer && !isNaN(endAt)) {
    var pad = function(n){ return (n < 10 ? '0' : '') + n; };
    var tick = function(){
      var left = Math.floor((endAt - Date.now()) / 1000);
      if (left <= 0) { timer.hidden = true; clearInterval(iv); return; }
      timer.querySelector('[data-t="d"]').textContent = pad(Math.floor(left / 86400));
      timer.querySelector('[data-t="h"]').textContent = pad(Math.floor(left % 86400 / 3600));
      timer.querySelector('[data-t="m"]').textContent = pad(Math.floor(left % 3600 / 60));
      timer.querySelector('[data-t="s"]').textContent = pad(left % 60);
      timer.hidden = false;
    };
    var iv = setInterval(tick, 1000);
    tick();
  }

  /* ---------- Precios, ahorro y total en el botón ---------- */
  function update(){
    var save = 0, total = 0;
    root.querySelectorAll('.dw-bar').forEach(function(bar){
      var input = bar.querySelector('input');
      bar.classList.toggle('is-active', input.checked);
      if (input.checked) {
        save += Number(input.dataset.save); total += Number(input.dataset.total);
        if (gift && input.dataset.gift) save += giftValue;
      }
    });
    if (up && up.value && up.checked) { save += Number(up.dataset.save); total += Number(up.dataset.total); }
    saveEl.textContent = fmt(save);
    saveEl.parentNode.hidden = save <= 0;
    totalEl.textContent = fmt(total);
  }
  root.addEventListener('change', update);
  update();

  /* ---------- Upsell CELUFIT ---------- */
  if (up && !up.value) {
    fetch(base + '/products/' + root.dataset.upsell + '.js')
      .then(function(r){ if (!r.ok) throw new Error('Upsell no encontrado'); return r.json(); })
      .then(function(prod){
        var v = prod.variants.filter(function(x){ return x.available; })[0];
        if (!v) return;
        up.value = v.id;
        up.closest('.dw-upsell').hidden = false;
        update();
      })
      .catch(function(e){ console.warn('[DW offer]', e); });
  }

  /* ---------- Regalo SLIMFIT (si Liquid no lo encontró, lo busca por handle) ---------- */
  if (!gift && root.dataset.giftHandle) {
    fetch(base + '/products/' + root.dataset.giftHandle + '.js')
      .then(function(r){ if (!r.ok) throw new Error('Regalo no encontrado'); return r.json(); })
      .then(function(prod){
        var v = (prod.variants || []).filter(function(x){ return x.available && x.price === 0; })[0];
        if (!v) return;
        gift = String(v.id);
        root.querySelectorAll('.dw-gift').forEach(function(row){
          var img = row.querySelector('.dw-gift-img');
          if (img && prod.featured_image) { img.src = prod.featured_image; img.hidden = false; }
          row.hidden = false;
        });
        update();
      })
      .catch(function(e){ console.warn('[DW offer]', e); });
  }

  /* ---------- Botón ---------- */
  function setIdle(){
    busy = false;
    btn.disabled = false;
    btn.classList.remove('is-done');
    label.textContent = 'Agregar al carrito';
    update();
  }
  function showError(text){
    msg.textContent = text;
    msg.hidden = false;
    setTimeout(function(){ msg.hidden = true; }, 5000);
  }
  // Si vuelven con el botón "atrás" del navegador, el botón queda usable
  window.addEventListener('pageshow', setIdle);

  /* ---------- Carrito lateral (Dawn y temas basados en Dawn) ---------- */
  function getDrawer(){
    var d = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
    return d && typeof d.renderContents === 'function' ? d : null;
  }

  function openOtherDrawers(){
    // Otros temas: eventos habituales para refrescar y abrir el carrito lateral
    ['cart:refresh', 'cart:build', 'cart:open', 'theme:cart:reload', 'theme:cart:open', 'ajaxProduct:added', 'dispatch:cart-drawer:refresh', 'dispatch:cart-drawer:open']
      .forEach(function(name){ document.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { open: true } })); });
    var trigger = document.querySelector('[data-cart-drawer-toggle], [data-drawer-toggle="cart"], .js-drawer-open-cart, [data-action="open-cart"], #cart-icon-bubble, a.header__icon--cart');
    if (trigger) { trigger.click(); return true; }
    return false;
  }

  btn.addEventListener('click', function(){
    if (busy) return;
    var sel = root.querySelector('input[name="dw-pack"]:checked');
    if (!sel) return;
    busy = true;
    btn.disabled = true;
    msg.hidden = true;
    label.textContent = 'Agregando...';
    totalEl.textContent = '';

    var items = [{ id: Number(root.dataset.variant), quantity: Number(sel.value) }];
    if (up && up.value && up.checked) items.push({ id: Number(up.value), quantity: 1 });
    if (gift && sel.dataset.gift) items.push({ id: Number(gift), quantity: 1 });

    var drawer = getDrawer();
    var body = { items: items };
    if (drawer && drawer.getSectionsToRender) {
      body.sections = drawer.getSectionsToRender().map(function(s){ return s.id; });
      body.sections_url = window.location.pathname;
    }

    fetch(root.dataset.cartAdd, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    })
    .then(function(r){
      return r.json().then(function(data){
        if (!r.ok || data.status) throw new Error();
        return data;
      });
    })
    .then(function(data){
      label.textContent = '✓ Agregado';
      btn.classList.add('is-done');
      setTimeout(setIdle, 1800);

      if (drawer && data.sections) {
        drawer.classList.remove('is-empty');
        drawer.renderContents(data);
        return;
      }
      if (!openOtherDrawers()) window.location.href = root.dataset.cart;
    })
    .catch(function(e){
      setIdle();
      showError('No pudimos agregar el producto. Probá de nuevo.');
    });
  });
})();
</script>
