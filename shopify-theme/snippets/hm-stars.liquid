{%- comment -%} Estrellas. Parámetros: rating (0-5, admite decimales) {%- endcomment -%}
{%- assign r = rating | default: 5 | times: 1.0 -%}
<span class="hm-stars" role="img" aria-label="{{ r }} de 5 estrellas">
  {%- for i in (1..5) -%}
    {%- assign full = i | times: 1.0 -%}
    {%- assign half = full | minus: 0.5 -%}
    {%- if r >= full -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- elsif r >= half -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="hm-half-{{ i }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity=".25"/></linearGradient></defs><path fill="url(#hm-half-{{ i }})" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-opacity=".25" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- endif -%}
  {%- endfor -%}
</span>
