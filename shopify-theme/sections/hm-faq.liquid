{%- comment -%}
  HM · Bloque 10 — Preguntas frecuentes: acordeón + FAQ para Google + contacto
  Sección autónoma: CSS y JS incluidos. Todo editable desde el personalizador.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign acc = s.color_acento | default: '#6b3fc0'
  assign hm_font = s.fuente
  assign hm_font_stack = "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  if hm_font != blank
    assign hm_font_stack = hm_font.family | prepend: "'" | append: "', " | append: hm_font.fallback_families
  endif
-%}

{%- if hm_font != blank -%}
  <style>
    {{ hm_font | font_face: font_display: 'swap' }}
    {%- assign hm_f = hm_font | font_modify: 'weight', '500' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
    {%- assign hm_f = hm_font | font_modify: 'weight', '600' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
    {%- assign hm_f = hm_font | font_modify: 'weight', '700' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}

<style>
  /* ===== Reset: el theme no puede romper la sección ===== */
  .hm-gf, .hm-gf *, .hm-gf *::before, .hm-gf *::after { box-sizing: border-box; }
  .hm-gf :where(h2, h3, p, span, strong, em, a, img, svg, ul, li, div, details, summary) {
    margin: 0; padding: 0; border: 0; text-transform: none; letter-spacing: normal;
    font-family: inherit; line-height: inherit; box-shadow: none; background: none; color: inherit; list-style: none;
  }
  .hm-gf :where(img, svg) { display: block; max-width: 100%; border-radius: 0; }
  .hm-gf summary::-webkit-details-marker { display: none; }

  .hm-gf { font-family: var(--gf-font); font-size: 16px; line-height: 1.5; -webkit-font-smoothing: antialiased; overflow-x: clip; }
  .hm-gf__wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 750px) { .hm-gf__wrap { padding: 0 32px; } }

  /* ===== FAQ ===== */
  .hm-gf__f { background: var(--gf-f-bg); color: var(--gf-f-fg); padding: var(--gf-f-pt) 0 var(--gf-f-pb); }
  .hm-gf__f-title { text-align: center; font-size: var(--gf-title-m); font-weight: 600; line-height: 1.25; margin-bottom: 28px !important; }
  .hm-gf__f-title em { font-style: normal; color: var(--gf-f-hl); }
  @media (min-width: 750px) { .hm-gf__f-title { font-size: var(--gf-title-d); margin-bottom: 36px !important; } }
  .hm-gf__list { display: grid; gap: 10px; max-width: var(--gf-f-w); margin: 0 auto; }
  .hm-gf__q { border-radius: var(--gf-radius); background: var(--gf-q-bg); color: var(--gf-q-fg); overflow: hidden; }
  .hm-gf__q summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; cursor: pointer; font-size: 15px; font-weight: 500; line-height: 1.4; -webkit-tap-highlight-color: transparent; }
  @media (min-width: 750px) { .hm-gf__q summary { padding: 18px 22px; font-size: 16px; } }
  .hm-gf__plus { position: relative; flex: none; width: 14px; height: 14px; color: var(--gf-q-icon); transition: transform .25s ease; }
  .hm-gf__plus::before, .hm-gf__plus::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: currentColor; border-radius: 2px; }
  .hm-gf__plus::after { transform: rotate(90deg); transition: transform .25s ease; }
  .hm-gf__q[open] .hm-gf__plus::after { transform: rotate(0deg); }
  .hm-gf__a { padding: 0 18px 18px !important; font-size: 14.5px; line-height: 1.65; color: var(--gf-q-muted); }
  @media (min-width: 750px) { .hm-gf__a { padding: 0 22px 20px !important; font-size: 15px; } }
  .hm-gf__a p + p, .hm-gf__a ul + p, .hm-gf__a p + ul { margin-top: .6em; }
  .hm-gf__a ul { list-style: disc !important; padding-left: 1.2em !important; }
  .hm-gf__a li { list-style: disc !important; }
  .hm-gf__a a { color: var(--gf-accent); text-decoration: underline; }
  .hm-gf__q[open] .hm-gf__a { animation: hm-gf-in .25s ease; }
  @keyframes hm-gf-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .hm-gf__f-sub { text-align: center; margin: -16px auto 28px !important; max-width: 640px; font-size: 15px; color: var(--gf-f-muted); }
  .hm-gf__contact { text-align: center; margin-top: 24px !important; font-size: 15px; color: var(--gf-f-muted); }
  .hm-gf__contact a { color: var(--gf-f-hl) !important; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>

<section
  id="hm-gf-{{ section.id }}"
  class="hm-gf"
  style="
    --gf-font: {{ hm_font_stack }};
    --gf-accent: {{ acc }};
    --gf-f-bg: {{ s.f_fondo }};
    --gf-f-fg: {{ s.f_texto }};
    --gf-f-muted: {{ s.f_texto | color_modify: 'alpha', 0.75 }};
    --gf-f-hl: {{ s.f_resaltado }};
    --gf-q-bg: {{ s.q_fondo }};
    --gf-q-fg: {{ s.q_texto }};
    --gf-q-muted: {{ s.q_texto | color_modify: 'alpha', 0.75 }};
    --gf-q-icon: {{ s.q_icono | default: acc }};
    --gf-f-w: {{ s.f_ancho }}px;
    --gf-f-pt: {{ s.f_espacio }}px;
    --gf-f-pb: {{ s.f_espacio }}px;
    --gf-radius: {{ s.redondeo }}px;
    --gf-title-d: {{ s.titulo_desktop }}px;
    --gf-title-m: {{ s.titulo_mobile }}px;
  "
>
    <div class="hm-gf__f" id="{{ s.ancla | default: 'hm-faq' | handleize }}">
      <div class="hm-gf__wrap">
        {%- if s.f_titulo != blank -%}<h2 class="hm-gf__f-title">{{ s.f_titulo }}</h2>{%- endif -%}
        {%- if s.f_subtitulo != blank -%}<p class="hm-gf__f-sub">{{ s.f_subtitulo }}</p>{%- endif -%}
        <div class="hm-gf__list" data-hm-gf-list data-single="{{ s.una_abierta }}">
          {%- for block in section.blocks -%}
            <details class="hm-gf__q" {% if block.settings.abierta %}open{% endif %} {{ block.shopify_attributes }}>
              <summary><span>{{ block.settings.pregunta }}</span><span class="hm-gf__plus" aria-hidden="true"></span></summary>
              <div class="hm-gf__a">{{ block.settings.respuesta }}</div>
            </details>
          {%- endfor -%}
        </div>
        {%- if s.contacto_texto != blank -%}
          <p class="hm-gf__contact">{{ s.contacto_texto }}{% if s.contacto_link_texto != blank %} <a href="{{ s.contacto_link | default: '#' }}"{% if s.contacto_link contains 'http' %} target="_blank" rel="noopener"{% endif %}>{{ s.contacto_link_texto }}</a>{% endif %}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if s.faq_seo and section.blocks.size > 0 -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.pregunta | strip_html | json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.respuesta | strip_html | json }} }
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
</section>

<script>
  (function () {
    var list = document.querySelector('#hm-gf-{{ section.id }} [data-hm-gf-list]');
    if (!list || list.dataset.ready) return;
    list.dataset.ready = '1';
    if (list.dataset.single !== 'true') return;
    /* Solo una pregunta abierta a la vez */
    list.addEventListener('toggle', function (e) {
      var d = e.target;
      if (!d.open) return;
      list.querySelectorAll('details[open]').forEach(function (o) { if (o !== d) o.open = false; });
    }, true);
  })();
</script>

{% schema %}
{
  "name": "HM · Preguntas frecuentes",
  "tag": "div",
  "class": "hm-section-faq",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "inline_richtext",
      "id": "f_titulo",
      "label": "Título",
      "default": "Preguntas frecuentes"
    },
    {
      "type": "text",
      "id": "f_subtitulo",
      "label": "Subtítulo (opcional)"
    },
    {
      "type": "header",
      "content": "Comportamiento"
    },
    {
      "type": "checkbox",
      "id": "una_abierta",
      "label": "Solo una pregunta abierta a la vez",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "faq_seo",
      "label": "Mostrar las preguntas en Google (SEO)",
      "default": true
    },
    {
      "type": "text",
      "id": "ancla",
      "label": "Ancla (para links)",
      "default": "hm-faq",
      "info": "Un link a #hm-faq baja directo acá."
    },
    {
      "type": "header",
      "content": "Contacto (abajo, opcional)"
    },
    {
      "type": "text",
      "id": "contacto_texto",
      "label": "Texto",
      "default": "¿Te quedó alguna duda?"
    },
    {
      "type": "text",
      "id": "contacto_link_texto",
      "label": "Texto del link",
      "default": "Escribinos por WhatsApp"
    },
    {
      "type": "url",
      "id": "contacto_link",
      "label": "Link",
      "info": "Ej: https://wa.me/5491112345678"
    },
    {
      "type": "header",
      "content": "Colores y tipografía"
    },
    {
      "type": "font_picker",
      "id": "fuente",
      "label": "Tipografía",
      "default": "poppins_n4"
    },
    {
      "type": "color",
      "id": "color_acento",
      "label": "Color de marca",
      "default": "#6b3fc0"
    },
    {
      "type": "color",
      "id": "f_fondo",
      "label": "Fondo preguntas",
      "default": "#16101f"
    },
    {
      "type": "color",
      "id": "f_texto",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "f_resaltado",
      "label": "Resaltado del título (cursiva)",
      "default": "#c9b2ff"
    },
    {
      "type": "color",
      "id": "q_fondo",
      "label": "Fondo de cada pregunta",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "q_texto",
      "label": "Texto de cada pregunta",
      "default": "#121116"
    },
    {
      "type": "color",
      "id": "q_icono",
      "label": "Color del + (opcional)",
      "info": "Vacío = color de marca."
    },
    {
      "type": "header",
      "content": "Tamaños y espacios"
    },
    {
      "type": "range",
      "id": "titulo_desktop",
      "label": "Tamaño de títulos en PC",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "titulo_mobile",
      "label": "Tamaño de títulos en celular",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "f_ancho",
      "label": "Ancho de la lista",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    {
      "type": "range",
      "id": "redondeo",
      "label": "Redondeo de las preguntas",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "f_espacio",
      "label": "Espacio arriba y abajo",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "pregunta",
          "label": "Pregunta",
          "default": "¿Pregunta?"
        },
        {
          "type": "richtext",
          "id": "respuesta",
          "label": "Respuesta",
          "default": "<p>Respuesta.</p>"
        },
        {
          "type": "checkbox",
          "id": "abierta",
          "label": "Abierta al entrar",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HM · Preguntas frecuentes",
      "blocks": [
        {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué es HAIR?",
            "respuesta": "<p>HAIR es un bloqueador de DHT en cápsulas, formulado para hombres. Combina biotina, zinc, selenio, L-cistina, colágeno tipo II y vitaminas C, B5 y B6 para frenar la caída desde la raíz y ayudar a que el pelo crezca más fuerte.</p>"
          }
        },
        {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Es seguro tomar HAIR?",
            "respuesta": "<p>HAIR es un suplemento dietario a base de vitaminas, minerales, aminoácidos y colágeno, libre de gluten. Si tenés alguna condición médica, tomás medicación o tenés dudas, consultá a tu médico antes de empezar.</p>"
          }
        },
        {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tiempo tarda en verse resultados?",
            "respuesta": "<p>El pelo crece lento. En general se nota menos caída en las primeras semanas, y más cuerpo y densidad a partir del segundo o tercer mes de uso constante. Por eso recomendamos un tratamiento de 3 a 6 meses.</p>"
          }
        },
        {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Sirve para cualquier tipo de pelo?",
            "respuesta": "<p>Sí. HAIR está pensado para hombres con cualquier tipo de pelo que notan caída, pelo más fino o entradas.</p>"
          }
        },
        {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cómo se toma?",
            "respuesta": "<p>1 cápsula por día con agua, preferentemente con una comida. Cada frasco trae 60 cápsulas: te dura 60 días.</p>"
          }
        },
        {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tarda el envío?",
            "respuesta": "<p>Despachamos en 24 hs hábiles y te pasamos el seguimiento. Según tu zona, llega en 2 a 6 días hábiles. Envío gratis desde 2 frascos.</p>"
          }
        },
        {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Tienen garantía?",
            "respuesta": "<p>Sí. Tenés 30 días de garantía de satisfacción: si HAIR no te convence, escribinos y te devolvemos el dinero.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
