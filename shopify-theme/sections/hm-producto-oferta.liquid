  .hm-gal__track::-webkit-scrollbar { display: none; }
  .hm-gal__slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 1 / 1; }
  .hm-gal--retrato .hm-gal__slide { aspect-ratio: 4 / 5; }
