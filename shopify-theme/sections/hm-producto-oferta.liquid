<section id="hm-{{ section.id }}" class="hm hm--{{ s.esquema | default: 'claro' }} hm-pdp" style="--hm-accent: {{ acc }}; --hm-a6: {{ acc | color_modify: 'alpha', 0.06 }}; --hm-a8: {{ acc | color_modify: 'alpha', 0.08 }}; --hm-a10: {{ acc | color_modify: 'alpha', 0.1 }}; --hm-a14: {{ acc | color_modify: 'alpha', 0.14 }}; --hm-a25: {{ acc | color_modify: 'alpha', 0.25 }}; --hm-a28: {{ acc | color_modify: 'alpha', 0.28 }}; --hm-a35: {{ acc | color_modify: 'alpha', 0.35 }}; --hm-a40: {{ acc | color_modify: 'alpha', 0.4 }}; --hm-a55: {{ acc | color_modify: 'alpha', 0.55 }}; --hm-dark30: {{ acc | color_mix: '#0c0b10', 30 }}; --hm-dark55: {{ acc | color_mix: '#0c0b10', 55 }}; --hm-pt: {{ s.padding_top | default: 24 }}px; --hm-pb: {{ s.padding_bottom | default: 48 }}px; --hm-font-body: {{ hm_font_stack }}; --hm-font-display: {{ hm_font_stack }}; --hm-title-d: {{ s.titulo_desktop | default: 30 }}px; --hm-title-m: {{ s.titulo_mobile | default: 26 }}px;{% if s.color_texto != blank %} --hm-fg: {{ s.color_texto }};{% endif %}{% if s.color_fondo != blank %} --hm-bg: {{ s.color_fondo }};{% endif %}{% if s.color_texto_sec != blank %} --hm-muted: {{ s.color_texto_sec }};{% endif %}{% if s.color_bordes != blank %} --hm-line: {{ s.color_bordes }};{% endif %}{% if s.color_tarjetas != blank %} --hm-card: {{ s.color_tarjetas }};{% endif %} --hm-star: {{ s.color_estrellas | default: '#f5b301' }}; --hm-ok: {{ s.color_positivo | default: '#1f9d55' }};{% if s.color_aviso != blank %} --hm-alert-bg: {{ s.color_aviso }};{% endif %}{% if s.color_aviso_texto != blank %} --hm-alert-fg: {{ s.color_aviso_texto }}; --hm-alert-line: {{ s.color_aviso_texto | color_modify: 'alpha', 0.4 }};{% endif %} --hm-r: {{ s.redondeo | default: 8 }}px;">
  <div class="hm-container">
    <div class="hm-pdp__grid">

      {%- comment -%} ===================== GALERÍA ===================== {%- endcomment -%}
      <div class="hm-pdp__media">
        <div class="hm-gal hm-gal--{{ s.proporcion }} hm-gal--{{ s.ajuste }}" data-hm-gallery>
          <div class="hm-gal__main">
            <div class="hm-gal__track" data-hm-track>
              {%- assign img_count = 0 -%}
              {%- if use_custom_gallery -%}
                {%- for block in section.blocks -%}
                  {%- if block.type != 'foto_galeria' or block.settings.imagen == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign img_count = img_count | plus: 1 -%}
                  {%- assign g_img = block.settings.imagen -%}
                  {%- assign g_alt = block.settings.alt | default: product.title -%}
                  <div class="hm-gal__slide" {{ block.shopify_attributes }}>
                    {%- if img_count == 1 -%}
                      {{ g_img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: g_alt }}
                      {%- if overlay_html != blank -%}<div class="hm-gal__chips">{{ overlay_html }}</div>{%- endif -%}
                    {%- else -%}
                      {{ g_img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: g_alt }}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for media in product.media -%}
                  {%- if media.media_type != 'image' -%}{%- continue -%}{%- endif -%}
                  {%- assign img_count = img_count | plus: 1 -%}
                  {%- assign m_alt = media.alt | default: product.title -%}
                  <div class="hm-gal__slide">
                    {%- if img_count == 1 -%}
                      {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: m_alt }}
                      {%- if overlay_html != blank -%}<div class="hm-gal__chips">{{ overlay_html }}</div>{%- endif -%}
                    {%- else -%}
                      {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: m_alt }}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- endif -%}
              {%- if img_count == 0 -%}
                <div class="hm-gal__slide">{{ 'product-1' | placeholder_svg_tag: 'hm-ph' }}</div>
              {%- endif -%}
            </div>
            {%- if img_count > 1 -%}
              <button type="button" class="hm-gal__arrow hm-gal__arrow--prev" data-hm-gprev aria-label="Imagen anterior"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-arrow-left"/></svg></button>
              <button type="button" class="hm-gal__arrow hm-gal__arrow--next" data-hm-gnext aria-label="Imagen siguiente"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-arrow-right"/></svg></button>
              {%- if s.mostrar_contador -%}<span class="hm-gal__count"><span data-hm-count>1</span>/{{ img_count }}</span>{%- endif -%}
            {%- endif -%}
          </div>

          {%- if img_count > 1 and s.mostrar_miniaturas -%}
            <div class="hm-gal__thumbs" data-hm-thumbs>
              {%- assign ti = 0 -%}
              {%- if use_custom_gallery -%}
                {%- for block in section.blocks -%}
                  {%- if block.type != 'foto_galeria' or block.settings.imagen == blank -%}{%- continue -%}{%- endif -%}
                  <button type="button" class="hm-gal__thumb{% if ti == 0 %} is-active{% endif %}" data-hm-thumb="{{ ti }}" aria-label="{{ ti | plus: 1 }}">
                    {{ block.settings.imagen | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: '' }}
                  </button>
                  {%- assign ti = ti | plus: 1 -%}
                {%- endfor -%}
              {%- else -%}
                {%- for media in product.media -%}
                  {%- if media.media_type != 'image' -%}{%- continue -%}{%- endif -%}
                  <button type="button" class="hm-gal__thumb{% if ti == 0 %} is-active{% endif %}" data-hm-thumb="{{ ti }}" aria-label="{{ ti | plus: 1 }}">
                    {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: '' }}
                  </button>
                  {%- assign ti = ti | plus: 1 -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if cards_html != blank -%}
          <div class="hm-cards2 hm-cards2--media hm-cards2--m-{{ s.tarjetas_mobile }}">{{ cards_html }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} ===================== INFO + OFERTA (Liquid) ===================== {%- endcomment -%}
      <div class="hm-pdp__info" id="hm-comprar">
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'rating' -%}
              <div class="hm-rating" {{ block.shopify_attributes }}>
                {%- assign r = bs.estrellas | default: 5 | times: 1.0 -%}
<span class="hm-stars" role="img" aria-label="{{ r }} de 5 estrellas">
  {%- for i in (1..5) -%}
    {%- assign full = i | times: 1.0 -%}
    {%- assign half = full | minus: 0.5 -%}
    {%- if r >= full -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- elsif r >= half -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="hm-half-{{ i }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity=".25"/></linearGradient></defs><path fill="url(#hm-half-{{ i }})" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-opacity=".25" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- endif -%}
  {%- endfor -%}
</span>
                <span>{{ bs.texto }}</span>
                {%- if bs.link_texto != blank -%}
                  <span class="hm-rating__sep" aria-hidden="true">|</span>
                  <a href="{{ bs.link | default: '#' }}">{{ bs.link_texto }}</a>
                {%- endif -%}
              </div>

            {%- when 'titulo' -%}
              <div class="hm-pdp__heading" {{ block.shopify_attributes }}>
                {%- if bs.marca != blank -%}<p class="hm-pdp__brand">{{ bs.marca }}</p>{%- endif -%}
                <h1 class="hm-pdp__title">
                  {%- if bs.titulo != blank -%}{{ bs.titulo }}{%- else -%}{{ product.title | escape }}{%- endif -%}
                </h1>
                {%- if bs.subtitulo != blank -%}<p class="hm-pdp__subtitle">{{ bs.subtitulo }}</p>{%- endif -%}
              </div>

            {%- when 'texto' -%}
              <div class="hm-pdp__text" {{ block.shopify_attributes }}>{{ bs.texto }}</div>

            {%- when 'beneficio' -%}
              <p class="hm-feat" {{ block.shopify_attributes }}>
                <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ bs.icono }}"/></svg>
                <span>{{ bs.texto }}</span>
              </p>

            {%- when 'envio' -%}
              <p class="hm-eta" data-hm-eta data-days="{{ bs.dias }}" {{ block.shopify_attributes }}>
                <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-clock"/></svg>
                <span>{{ bs.texto | replace: '[fecha]', '<strong data-hm-eta-date></strong>' }}</span>
              </p>

            {%- when 'social' -%}
              <div class="hm-social" {{ block.shopify_attributes }}>
                <span class="hm-social__faces">
                  {%- for i in (1..4) -%}
                    {%- assign ak = 'avatar_' | append: i -%}
                    {%- if bs[ak] != blank -%}{{ bs[ak] | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40, 80', sizes: '32px', alt: '' }}{%- endif -%}
                  {%- endfor -%}
                  <span class="hm-social__ok"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-check"/></svg></span>
                </span>
                <span class="hm-social__text">
                  <strong>{{ bs.titulo }}</strong>
                  {%- if bs.texto != blank -%}<span>{{ bs.texto }}</span>{%- endif -%}
                </span>
              </div>

            {%- when 'aviso' -%}
              <div class="hm-alert hm-alert--{{ bs.estilo }}" {{ block.shopify_attributes }}>
                <p class="hm-alert__title"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ bs.icono }}"/></svg><strong>{{ bs.titulo }}</strong></p>
                {%- if bs.texto != blank -%}<p class="hm-alert__text">{{ bs.texto }}</p>{%- endif -%}
              </div>

            {%- when 'acordeon' -%}
              <details class="hm-acc" {% if bs.abierto %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="hm-acc__sum">
                  <span>{{ bs.titulo }}</span>
                  <span class="hm-acc__icon" aria-hidden="true"></span>
                </summary>
                <div class="hm-acc__body">{{ bs.contenido }}</div>
              </details>

            {%- when 'liquid' -%}
              {%- if bs.codigo != blank -%}
                <div class="hm-liquid" {{ block.shopify_attributes }}>{{ bs.codigo }}</div>
              {%- elsif request.design_mode -%}
                <div class="hm-liquid" {{ block.shopify_attributes }}><p class="hm-liquid__empty">Pegá acá el código Liquid de la oferta (bloque «Liquid personalizado»).</p></div>
              {%- endif -%}

            {%- when 'espacio' -%}
              <div class="hm-space" style="height: {{ bs.alto }}px" {{ block.shopify_attributes }}></div>

          {%- endcase -%}
        {%- endfor -%}
        {%- if cards_html != blank and s.tarjetas_mobile == 'final' -%}
          <div class="hm-cards2 hm-cards2--end">{{ cards_html }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>

</section>

<script>
/* DR.MEN · HAIR — JS de las secciones de landing (prefijo hm-).
   Se carga desde cada sección; el guard evita que se ejecute dos veces. */
(function () {
  if (window.HMLanding) return;

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function once(el, key) {
    var flag = 'hm' + key + 'Ready';
    if (el.dataset[flag]) return false;
    el.dataset[flag] = '1';
    return true;
  }

  /* ---------- Carrusel con flechas y barra de progreso ---------- */
  function initSlider(root) {
    if (!once(root, 'Slider')) return;
    var track = root.querySelector('[data-hm-track]');
    if (!track) return;
    var prev = root.querySelector('[data-hm-prev]');
    var next = root.querySelector('[data-hm-next]');
    var bar = root.querySelector('[data-hm-bar]');

    function step() {
      var first = track.children[0];
      if (!first) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first.getBoundingClientRect().width + gap;
    }
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var ratio = max > 0 ? track.scrollLeft / max : 0;
      var visible = track.scrollWidth > 0 ? track.clientWidth / track.scrollWidth : 1;
      if (bar) {
        bar.style.width = Math.max(visible * 100, 12) + '%';
        bar.style.transform = 'translateX(' + ratio * (100 / Math.max(visible, .12) - 100) + '%)';
      }
      if (prev) prev.disabled = track.scrollLeft <= 4;
      if (next) next.disabled = track.scrollLeft >= max - 4;
      var nav = root.querySelector('.hm-slider__nav');
      if (nav) nav.hidden = max <= 4;
    }
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);
    update();

    var autoplay = parseInt(root.dataset.autoplay || '0', 10);
    if (autoplay > 0 && !reduceMotion) {
      var paused = false;
      root.addEventListener('pointerenter', function () { paused = true; });
      root.addEventListener('pointerleave', function () { paused = false; });
      root.addEventListener('touchstart', function () { paused = true; }, { passive: true });
      setInterval(function () {
        if (paused || document.hidden) return;
        var max = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= max - 4) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: step(), behavior: 'smooth' });
      }, autoplay * 1000);
    }
  }

  /* ---------- Aparición al hacer scroll ---------- */
  var revealObserver = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('is-in'); revealObserver.unobserve(e.target); }
    });
  }, { rootMargin: '0px 0px -8% 0px' }) : null;

  function initReveal(el) {
    if (!once(el, 'Reveal')) return;
    if (!revealObserver || reduceMotion) { el.classList.add('is-in'); return; }
    revealObserver.observe(el);
  }

  /* ---------- Cuenta regresiva ---------- */
  function initCountdown(el) {
    if (!once(el, 'Countdown')) return;
    var mode = el.dataset.mode || 'hoy';
    var end;
    if (mode === 'fecha' && el.dataset.end) {
      end = new Date(el.dataset.end.replace(' ', 'T')).getTime();
    }
    function target() {
      if (mode === 'fecha' && end) return end;
      var d = new Date();
      d.setHours(23, 59, 59, 999);
      return d.getTime();
    }
    var parts = {
      d: el.querySelector('[data-hm-d]'),
      h: el.querySelector('[data-hm-h]'),
      m: el.querySelector('[data-hm-m]'),
      s: el.querySelector('[data-hm-s]')
    };
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var diff = Math.max(0, target() - Date.now());
      var s = Math.floor(diff / 1000);
      var days = Math.floor(s / 86400);
      var h = Math.floor((s % 86400) / 3600);
      var m = Math.floor((s % 3600) / 60);
      var sec = s % 60;
      if (parts.d) { parts.d.textContent = pad(days); parts.d.parentElement.hidden = days === 0; }
      if (parts.h) parts.h.textContent = pad(parts.d ? h : h + days * 24);
      if (parts.m) parts.m.textContent = pad(m);
      if (parts.s) parts.s.textContent = pad(sec);
    }
    tick();
    setInterval(tick, 1000);
  }

  /* ---------- Antes / después con deslizador ---------- */
  function initCompare(el) {
    if (!once(el, 'Compare')) return;
    var input = el.querySelector('input[type="range"]');
    if (!input) return;
    function set() { el.style.setProperty('--hm-pos', input.value + '%'); }
    input.addEventListener('input', set);
    set();
  }

  /* ---------- Videos UGC: autoplay en pantalla + sonido al tocar ---------- */
  var videoObserver = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      var v = e.target;
      if (e.isIntersecting) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      else v.pause();
    });
  }, { threshold: .55 }) : null;

  function initVideo(card) {
    if (!once(card, 'Video')) return;
    var video = card.querySelector('video');
    if (!video) return;
    video.muted = true;
    video.playsInline = true;
    video.loop = true;
    if (videoObserver && !reduceMotion) videoObserver.observe(video);
    var btn = card.querySelector('[data-hm-sound]');
    function toggle() {
      var allVideos = document.querySelectorAll('[data-hm-video] video');
      var willUnmute = video.muted;
      allVideos.forEach(function (v) { v.muted = true; v.closest('[data-hm-video]').classList.remove('is-sound'); });
      video.muted = !willUnmute;
      if (willUnmute) {
        video.currentTime = 0;
        var p = video.play(); if (p && p.catch) p.catch(function () {});
        card.classList.add('is-sound');
      }
    }
    if (btn) btn.addEventListener('click', toggle);
  }

  /* ---------- Galería del producto ---------- */
  function initGallery(root) {
    if (!once(root, 'Gallery')) return;
    var track = root.querySelector('[data-hm-track]');
    if (!track) return;
    var thumbsWrap = root.querySelector('[data-hm-thumbs]');
    var thumbs = root.querySelectorAll('[data-hm-thumb]');
    var count = root.querySelector('[data-hm-count]');
    var prev = root.querySelector('[data-hm-gprev]');
    var next = root.querySelector('[data-hm-gnext]');
    var total = track.children.length;
    var current = 0;

    function goTo(i, smooth) {
      i = Math.max(0, Math.min(total - 1, i));
      var slide = track.children[i];
      if (!slide) return;
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: smooth === false ? 'auto' : 'smooth' });
      setActive(i);
    }
    function setActive(i) {
      if (i === current && count && count.textContent === String(i + 1)) return;
      current = i;
      if (count) count.textContent = i + 1;
      thumbs.forEach(function (t) {
        var on = parseInt(t.dataset.hmThumb, 10) === i;
        t.classList.toggle('is-active', on);
        if (on && thumbsWrap) {
          /* Mantiene la miniatura activa a la vista sin mover la página */
          var vertical = thumbsWrap.scrollHeight > thumbsWrap.clientHeight + 2;
          if (vertical) thumbsWrap.scrollTo({ top: t.offsetTop - thumbsWrap.clientHeight / 2 + t.clientHeight / 2, behavior: 'smooth' });
          else thumbsWrap.scrollTo({ left: t.offsetLeft - thumbsWrap.clientWidth / 2 + t.clientWidth / 2, behavior: 'smooth' });
        }
      });
    }

    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { goTo(parseInt(t.dataset.hmThumb, 10)); });
    });
    if (prev) prev.addEventListener('click', function () { goTo(current === 0 ? total - 1 : current - 1); });
    if (next) next.addEventListener('click', function () { goTo(current === total - 1 ? 0 : current + 1); });

    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        ticking = false;
        var i = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
        if (i !== current) setActive(i);
      });
    }, { passive: true });

    /* Al elegir un pack con foto propia, la galería salta a esa foto */
    var section = root.closest('.hm');
    if (section) section.addEventListener('hm:pack', function (e) {
      var slide = e.detail && e.detail.slide;
      if (slide !== '' && slide !== undefined && !isNaN(parseInt(slide, 10))) goTo(parseInt(slide, 10));
    });
  }

  /* ---------- Links internos suaves (#hm-comprar) ---------- */
  document.addEventListener('click', function (ev) {
    var a = ev.target.closest && ev.target.closest('a[href^="#"]');
    if (!a || a.getAttribute('href').length < 2) return;
    var t = document.getElementById(a.getAttribute('href').slice(1));
    if (!t || !t.closest('.hm, [id^="hm-"]')) return;
    ev.preventDefault();
    t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  function init(scope) {
    scope = scope || document;
    scope.querySelectorAll('[data-hm-slider]').forEach(initSlider);
    scope.querySelectorAll('.hm-reveal').forEach(initReveal);
    scope.querySelectorAll('[data-hm-countdown]').forEach(initCountdown);
    scope.querySelectorAll('[data-hm-compare]').forEach(initCompare);
    scope.querySelectorAll('[data-hm-video]').forEach(initVideo);
    scope.querySelectorAll('[data-hm-gallery]').forEach(initGallery);
  }

  window.HMLanding = { init: init };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(); });
  else init();

  /* Editor de temas: re-inicializa al editar una sección */
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  document.addEventListener('shopify:block:select', function (e) {
    var slide = e.target;
    var track = slide.parentElement;
    if (track && track.hasAttribute('data-hm-track')) track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
  });
})();

</script>

<script>
  (function () {
    var root = document.getElementById('hm-{{ section.id }}');
    if (!root || root.dataset.hmLocal) return;
    root.dataset.hmLocal = '1';

    /* Fecha estimada de entrega en días hábiles */
    var meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    root.querySelectorAll('[data-hm-eta]').forEach(function (el) {
      var n = parseInt(el.dataset.days || '5', 10);
      var d = new Date();
      while (n > 0) { d.setDate(d.getDate() + 1); if (d.getDay() !== 0 && d.getDay() !== 6) n--; }
      var out = el.querySelector('[data-hm-eta-date]');
      if (out) out.textContent = d.getDate() + ' de ' + meses[d.getMonth()];
    });
  })();
</script>


{% schema %}
{
  "name": "HM · Producto (oferta)",
  "tag": "div",
  "class": "hm-section-pdp",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "paragraph",
      "content": "Las fotos salen del producto (admin → Productos → Multimedia)."
    },
    {
      "type": "select",
      "id": "proporcion",
      "label": "Formato de las fotos",
      "options": [
        {
          "value": "cuadrado",
          "label": "Cuadrado (1:1)"
        },
        {
          "value": "retrato",
          "label": "Vertical (4:5)"
        }
      ],
      "default": "cuadrado"
    },
    {
      "type": "select",
      "id": "ajuste",
      "label": "Ajuste de las fotos",
      "options": [
        {
          "value": "completa",
          "label": "Mostrar la foto completa"
        },
        {
          "value": "recortar",
          "label": "Recortar para llenar"
        }
      ],
      "default": "completa"
    },
    {
      "type": "checkbox",
      "id": "mostrar_miniaturas",
      "label": "Mostrar miniaturas",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_contador",
      "label": "Mostrar contador (1/8)",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "¿Querés otras fotos en vez de las del producto? Agregá bloques \"Foto de la galería\"."
    },
    {
      "type": "select",
      "id": "tarjetas_mobile",
      "label": "Tarjetas bajo la galería en celular",
      "options": [
        {
          "value": "final",
          "label": "Al final de la info (recomendado)"
        },
        {
          "value": "galeria",
          "label": "Debajo de la galería"
        },
        {
          "value": "ocultar",
          "label": "Ocultar"
        }
      ],
      "default": "final"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "select",
      "id": "esquema",
      "label": "Fondo",
      "options": [
        {
          "value": "claro",
          "label": "Blanco"
        },
        {
          "value": "suave",
          "label": "Lila suave"
        },
        {
          "value": "oscuro",
          "label": "Negro"
        },
        {
          "value": "acento",
          "label": "Violeta (marca)"
        }
      ],
      "default": "claro"
    },
    {
      "type": "color",
      "id": "color_acento",
      "label": "Color de marca",
      "default": "#6b3fc0",
      "info": "Color principal: packs seleccionados, íconos, etiquetas, precio y botón."
    },
    {
      "type": "color",
      "id": "color_texto",
      "label": "Color del texto (opcional)"
    },
    {
      "type": "color",
      "id": "color_fondo",
      "label": "Color de fondo (opcional)",
      "info": "Pisa el fondo elegido arriba."
    },
    {
      "type": "color",
      "id": "color_texto_sec",
      "label": "Color del texto secundario (opcional)"
    },
    {
      "type": "color",
      "id": "color_tarjetas",
      "label": "Fondo de galería y tarjetas (opcional)"
    },
    {
      "type": "color",
      "id": "color_bordes",
      "label": "Color de bordes y líneas (opcional)"
    },
    {
      "type": "color",
      "id": "color_estrellas",
      "label": "Color de las estrellas",
      "default": "#f5b301"
    },
    {
      "type": "color",
      "id": "color_positivo",
      "label": "Color positivo (stock, check)",
      "default": "#1f9d55"
    },
    {
      "type": "color",
      "id": "color_aviso",
      "label": "Fondo del aviso rojo (opcional)"
    },
    {
      "type": "color",
      "id": "color_aviso_texto",
      "label": "Texto del aviso rojo (opcional)"
    },
    {
      "type": "range",
      "id": "redondeo",
      "label": "Redondeo de tarjetas y packs",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "titulo_desktop",
      "label": "Tamaño del título en PC",
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "titulo_mobile",
      "label": "Tamaño del título en celular",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "font_picker",
      "id": "fuente",
      "label": "Tipografía",
      "default": "poppins_n4",
      "info": "Por defecto Poppins, igual que el theme."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio arriba",
      "min": 0,
      "max": 120,
