<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4zM16 9.5l5 5M21 9.5l-5 5"/></symbol><symbol id="hmi-sound-on" viewBox="0 0 24 24"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4zM16 9a4.2 4.2 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/></symbol><symbol id="hmi-play" viewBox="0 0 24 24"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"/></symbol><symbol id="hmi-hair" viewBox="0 0 24 24"><path d="M6 21c1-6 0-10-1-14M10 21c.5-6 0-11 2-17M14.5 21c-.5-5 .5-9 3.5-14M18.5 21c-.5-3 0-6 2-9"/></symbol><symbol id="hmi-stethoscope" viewBox="0 0 24 24"><path d="M5 3v5a5 5 0 0 0 10 0V3M10 13v2.5a5 5 0 0 0 10 0V13"/><circle cx="20" cy="11" r="2"/></symbol><symbol id="hmi-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.2"/><path d="M5.5 5.5l13 13"/></symbol><symbol id="hmi-map-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.3-7-11.5a7 7 0 0 1 14 0C19 14.7 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></symbol><symbol id="hmi-percent" viewBox="0 0 24 24"><path d="M19 5L5 19"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/></symbol><symbol id="hmi-box" viewBox="0 0 24 24"><path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5zM3.5 7.5L12 12l8.5-4.5M12 12v9"/></symbol><symbol id="hmi-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></symbol><symbol id="hmi-moon" viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></symbol><symbol id="hmi-trend-up" viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8M15 7h6v6"/></symbol></defs></svg>

{%- liquid
  assign s = section.settings
  assign acc = s.color_acento | default: '#6b3fc0'

  assign use_custom_gallery = false
  for block in section.blocks
    if block.type == 'foto_galeria' and block.settings.imagen != blank
      assign use_custom_gallery = true
    endif
  endfor
-%}

{%- capture overlay_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'beneficio_foto' -%}
      <div class="hm-gal__chip" {{ block.shopify_attributes }}>
        <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ block.settings.icono }}"/></svg>
        <span>{{ block.settings.texto }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture cards_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tarjeta' -%}
      {%- assign bs = block.settings -%}
      <div class="hm-card2" {{ block.shopify_attributes }}>
        <p class="hm-card2__title"><svg class="hm-icon hm-card2__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-check-circle"/></svg>{{ bs.titulo }}</p>
        <div class="hm-card2__body">
          <span class="hm-card2__img">
            {%- if bs.imagen != blank -%}
              {{ bs.imagen | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '56px', alt: '' }}
            {%- else -%}
              <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ bs.icono }}"/></svg>
            {%- endif -%}
          </span>
          <span class="hm-card2__text">
            {{ bs.texto }}
            {%- if bs.valor != blank -%}
              <span class="hm-card2__value"><s>{{ bs.valor }}</s> <strong>{{ bs.valor_texto }}</strong></span>
            {%- endif -%}
          </span>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- liquid
  assign hm_font = section.settings.fuente
  assign hm_font_stack = "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  if hm_font != blank
    assign hm_font_stack = hm_font.family | prepend: "'" | append: "', " | append: hm_font.fallback_families
  endif
-%}
{%- if hm_font != blank -%}
  <style>
    {{ hm_font | font_face: font_display: 'swap' }}
    {%- assign hm_f = hm_font | font_modify: 'weight', '500' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
    {%- assign hm_f = hm_font | font_modify: 'weight', '600' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
    {%- assign hm_f = hm_font | font_modify: 'weight', '700' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}
<style>
/* =========================================================================
   DR.MEN · HAIR — Sistema de secciones de landing (prefijo hm-)
   Todas las clases van prefijadas con .hm- para no chocar con el theme.
   ========================================================================= */

#hm-{{ section.id }} {
  --hm-accent: #6b3fc0;
  --hm-accent-ink: #ffffff;
  --hm-accent-soft: var(--hm-a14);
  --hm-bg: #ffffff;
  --hm-fg: #121116;
  --hm-muted: #5d5a66;
  --hm-card: #f7f5fb;
  --hm-card-fg: var(--hm-fg);
  --hm-line: #e8e3f1;
  --hm-star: #f5b301;
  --hm-ok: #1f9d55;
  --hm-radius: 16px;
  --hm-radius-sm: 10px;
  --hm-shadow: 0 10px 30px rgba(20, 10, 40, .08);
  --hm-font-display: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --hm-font-body: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --hm-pt: 64px;
  --hm-pb: 64px;

  background: var(--hm-bg);
  color: var(--hm-fg);
  font-family: var(--hm-font-body);
  font-size: 16px;
  line-height: 1.55;
  padding-top: var(--hm-pt);
  padding-bottom: var(--hm-pb);
  position: relative;
  overflow-x: clip;
  -webkit-font-smoothing: antialiased;
}
#hm-{{ section.id }} *, #hm-{{ section.id }} *::before, #hm-{{ section.id }} *::after { box-sizing: border-box; }
#hm-{{ section.id }} [hidden] { display: none !important; }


/* Reset: evita que estilos genéricos del theme (h1, p, label, button, img...) rompan la sección */
#hm-{{ section.id }} :where(h1, h2, h3, p, ul, li, label, summary, details, button, a, s, strong, span, small, input, em):where(:not(.hm-liquid *)) {
  text-transform: none; letter-spacing: normal; font-family: inherit; line-height: inherit; box-shadow: none;
}
#hm-{{ section.id }} :where(p):where(:not(.hm-liquid *)) { margin: 0 0 .75em; }
#hm-{{ section.id }} :where(p:last-child):where(:not(.hm-liquid *)) { margin-bottom: 0; }
#hm-{{ section.id }} :where(h1, h2, h3):where(:not(.hm-liquid *)) { font-weight: 700; }
#hm-{{ section.id }} :where(button):where(:not(.hm-liquid *)) { min-width: 0; width: auto; }
#hm-{{ section.id }} :where(label):where(:not(.hm-liquid *)) { margin: 0; }
#hm-{{ section.id }} :where(details, summary):where(:not(.hm-liquid *)) { border: 0; background: none; padding: 0; margin: 0; }
#hm-{{ section.id }} :where(ul):where(:not(.hm-liquid *)) { list-style: none; margin: 0; padding: 0; }
#hm-{{ section.id }} :where(a, s):where(:not(.hm-liquid *)) { color: inherit; }
#hm-{{ section.id }} :where(img, video, svg):where(:not(.hm-liquid *)) { border-radius: 0; border: 0; max-width: 100%; display: block; }

/* ---------- Esquemas de color ---------- */
#hm-{{ section.id }}.hm--claro { --hm-bg: #ffffff; --hm-fg: #121116; --hm-muted: #5d5a66; --hm-card: #f7f5fb; --hm-line: #e8e3f1; }
#hm-{{ section.id }}.hm--suave { --hm-bg: #f4effc; --hm-fg: #121116; --hm-muted: #57536a; --hm-card: #ffffff; --hm-line: #e2d9f3; }
#hm-{{ section.id }}.hm--oscuro { --hm-bg: #0c0b10; --hm-fg: #ffffff; --hm-muted: #b8b2c6; --hm-card: #17141f; --hm-line: #2a2535; }
#hm-{{ section.id }}.hm--acento {
  --hm-bg: var(--hm-dark30);
  --hm-fg: #ffffff; --hm-muted: rgba(255,255,255,.78);
  --hm-card: rgba(255,255,255,.08); --hm-line: rgba(255,255,255,.16);
  background: radial-gradient(120% 120% at 100% 0%, var(--hm-dark55) 0%, var(--hm-bg) 60%);
}
#hm-{{ section.id }}.hm--oscuro, #hm-{{ section.id }}.hm--acento { --hm-accent-soft: var(--hm-a28); }

/* ---------- Layout ---------- */
#hm-{{ section.id }} .hm-container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 16px; }
#hm-{{ section.id }} .hm-container--narrow { max-width: 860px; }
@media (min-width: 750px) { #hm-{{ section.id }} .hm-container { padding: 0 32px; } }

#hm-{{ section.id }} .hm-head { text-align: center; max-width: 760px; margin: 0 auto 36px; }
#hm-{{ section.id }} .hm-head--left { text-align: left; margin-left: 0; }

/* ---------- Tipografía ---------- */
#hm-{{ section.id }} .hm-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font: 700 12px/1 var(--hm-font-body); letter-spacing: .14em; text-transform: uppercase;
  color: var(--hm-accent); background: var(--hm-accent-soft);
  padding: 8px 14px; border-radius: 999px; margin-bottom: 14px;
}
#hm-{{ section.id }}.hm--oscuro .hm-eyebrow, #hm-{{ section.id }}.hm--acento .hm-eyebrow { color: #fff; }
#hm-{{ section.id }} .hm-title {
  font-family: var(--hm-font-display); font-weight: 800; text-transform: uppercase;
  font-size: clamp(32px, 6.2vw, 56px); line-height: .98; letter-spacing: -.005em;
  margin: 0 0 14px; color: var(--hm-fg);
}
#hm-{{ section.id }} .hm-title em, #hm-{{ section.id }} .hm-title i { font-style: italic; color: var(--hm-accent); }
#hm-{{ section.id }}.hm--acento .hm-title em, #hm-{{ section.id }}.hm--acento .hm-title i { color: #d9c6ff; }
#hm-{{ section.id }} .hm-title--sm { font-size: clamp(28px, 4.6vw, 42px); }
#hm-{{ section.id }} .hm-sub { color: var(--hm-muted); font-size: clamp(15px, 1.6vw, 18px); margin: 0; }
#hm-{{ section.id }} .hm-sub p { margin: 0; }
#hm-{{ section.id }} .hm-small { font-size: 13px; color: var(--hm-muted); }
#hm-{{ section.id }} .hm-disclaimer { font-size: 12px; color: var(--hm-muted); text-align: center; max-width: 760px; margin: 22px auto 0; opacity: .85; }

/* ---------- Botones ---------- */
#hm-{{ section.id }} .hm-btn{
  --b-bg: var(--hm-btn-bg, var(--hm-accent)); --b-fg: var(--hm-btn-fg, var(--hm-accent-ink));
  appearance: none; border: 0; cursor: pointer; text-decoration: none;
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 54px; padding: 0 24px; border-radius: 10px;
  background: var(--b-bg); color: var(--b-fg);
  font: 600 16px/1.2 var(--hm-font-body); letter-spacing: 0;
  transition: filter .2s ease, transform .1s ease;
  position: relative; overflow: hidden;
}
#hm-{{ section.id }} .hm-btn:hover{ filter: brightness(1.1); }
#hm-{{ section.id }} .hm-btn:active{ transform: translateY(1px); }
#hm-{{ section.id }} .hm-btn--block{ width: 100%; }
#hm-{{ section.id }} .hm-btn--dark{ --b-bg: #0c0b10; --b-fg: #fff; }
#hm-{{ section.id }} .hm-btn--light{ --b-bg: #fff; --b-fg: #0c0b10; }
#hm-{{ section.id }} .hm-btn--shine::after{
  content: ''; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,.35), transparent);
  animation: hm-shine 3.2s ease-in-out infinite;
}
@keyframes hm-shine { 0%, 60% { left: -60%; } 100% { left: 130%; } }
#hm-{{ section.id }} .hm-btn[aria-busy="true"]{ pointer-events: none; opacity: .8; }
#hm-{{ section.id }} .hm-btn[aria-busy="true"] .hm-btn__label{ opacity: 0; }
#hm-{{ section.id }} .hm-btn[aria-busy="true"]::before{
  content: ''; position: absolute; width: 22px; height: 22px; border-radius: 50%;
  border: 3px solid currentColor; border-right-color: transparent; animation: hm-spin .7s linear infinite;
}
@keyframes hm-spin { to { transform: rotate(360deg); } }

#hm-{{ section.id }} .hm-cta { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 36px; text-align: center; }
#hm-{{ section.id }} .hm-cta .hm-btn { width: 100%; max-width: 420px; }
#hm-{{ section.id }} .hm-cta__note { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--hm-muted); }
#hm-{{ section.id }} .hm-cta__note svg { width: 16px; height: 16px; }

/* ---------- Íconos / estrellas ---------- */
#hm-{{ section.id }} .hm-icon { width: 22px; height: 22px; flex: none; }
#hm-{{ section.id }} .hm-stars { display: inline-flex; gap: 2px; color: var(--hm-star); }
#hm-{{ section.id }} .hm-stars svg { width: 16px; height: 16px; }
#hm-{{ section.id }} .hm-check { color: var(--hm-ok); }

/* ---------- Tarjetas ---------- */
#hm-{{ section.id }} .hm-card {
  background: var(--hm-card); color: var(--hm-card-fg);
  border: 1px solid var(--hm-line); border-radius: var(--hm-radius); padding: 22px;
}
#hm-{{ section.id }}.hm--claro .hm-card, #hm-{{ section.id }}.hm--suave .hm-card { box-shadow: var(--hm-shadow); }

/* ---------- Media ---------- */
#hm-{{ section.id }} .hm-media { position: relative; overflow: hidden; border-radius: var(--hm-radius); background: var(--hm-card); }
#hm-{{ section.id }} .hm-media img, #hm-{{ section.id }} .hm-media video, #hm-{{ section.id }} .hm-media svg { width: 100%; height: 100%; object-fit: cover; }
#hm-{{ section.id }} .hm-ph { width: 100%; height: 100%; background: #ece7f5; fill: #b9acd4; }
#hm-{{ section.id }}.hm--oscuro .hm-ph, #hm-{{ section.id }}.hm--acento .hm-ph { background: #221d2c; fill: #4a4160; }

/* ---------- Carrusel (scroll-snap) ---------- */
#hm-{{ section.id }} .hm-slider { position: relative; }
#hm-{{ section.id }} .hm-slider__track {
  display: grid; grid-auto-flow: column; grid-auto-columns: var(--hm-slide, 82%);
  gap: var(--hm-gap, 14px); overflow-x: auto; scroll-snap-type: x mandatory;
  scroll-behavior: smooth; overscroll-behavior-x: contain;
  padding: 4px 16px 18px; margin: 0 -16px; scrollbar-width: none;
  scroll-padding-inline: 16px;
}
#hm-{{ section.id }} .hm-slider__track::-webkit-scrollbar { display: none; }
#hm-{{ section.id }} .hm-slider__track > * { scroll-snap-align: start; min-width: 0; }
@media (min-width: 750px) {
  #hm-{{ section.id }} .hm-slider__track { padding: 4px 0 18px; margin: 0; scroll-padding-inline: 0; }
}
#hm-{{ section.id }} .hm-slider__nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 10px; }
