  .hm-pay strong { color: var(--hm-fg); }

  /* ---------- Prueba social ---------- */
  .hm-social { display: flex; align-items: center; gap: 12px; padding: 8px 14px 8px 8px; border-radius: 999px; background: var(--hm-card); margin-top: 18px !important; }
  .hm-social__faces { position: relative; display: flex; flex: none; min-width: 32px; min-height: 32px; }
  .hm-social__faces img { width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--hm-bg); object-fit: cover; margin-left: -10px; }
  .hm-social__faces img:first-child { margin-left: 0; }
  .hm-social__ok { position: absolute; right: -4px; top: -4px; width: 16px; height: 16px; border-radius: 50%; background: var(--hm-accent); color: #fff; display: grid; place-items: center; }
  .hm-social__ok svg { width: 10px; height: 10px; stroke-width: 3.5; }
  .hm-social__text { display: grid; font-size: 12.5px; line-height: 1.3; color: var(--hm-muted); }
  .hm-social__text strong { font-size: 13.5px; color: var(--hm-fg); }

  /* ---------- Aviso ---------- */
  .hm-alert { border-radius: var(--hm-r, 8px); padding: 12px 14px; font-size: 13px; line-height: 1.45; }
  .hm-alert__title { display: flex; align-items: center; gap: 6px; margin: 0 0 4px; font-size: 13px; }
  .hm-alert__title svg { width: 16px; height: 16px; flex: none; }
  .hm-alert__text { margin: 0; }
  .hm-alert--alerta { background: var(--hm-alert-bg, #fff5f5); border: 1px dashed var(--hm-alert-line, #e8a0a0); color: var(--hm-alert-fg, #7a2323); }
  .hm-alert--alerta .hm-alert__title { color: var(--hm-alert-fg, #c62828); }
  .hm-alert--info { background: var(--hm-a6); border: 1px dashed var(--hm-a40); }
  .hm-alert--info .hm-alert__title { color: var(--hm-accent); }

  /* ---------- Desplegables ---------- */
  .hm-acc { border-bottom: 1px solid var(--hm-line); }
  .hm-pdp__info > :not(.hm-acc) + .hm-acc { border-top: 1px solid var(--hm-line); margin-top: 22px; }
  .hm-acc__sum { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 2px; cursor: pointer; font-size: 15px; font-weight: 600; }
  .hm-acc__sum::-webkit-details-marker { display: none; }
  .hm-acc__icon { position: relative; width: 12px; height: 12px; flex: none; color: var(--hm-accent); }
  .hm-acc__icon::before, .hm-acc__icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: currentColor; border-radius: 2px; transition: transform .2s ease; }
  .hm-acc__icon::after { transform: rotate(90deg); }
  .hm-acc[open] .hm-acc__icon::after { transform: rotate(0deg); }
  .hm-acc__body { padding: 0 2px 16px; font-size: 14.5px; line-height: 1.55; color: var(--hm-muted); }
  .hm-acc__body p { margin: 0 0 .6em; }
  .hm-acc__body ul { margin: 0 0 .6em; padding-left: 1.1em; list-style: disc; }
  .hm-acc__body li + li { margin-top: 4px; }
  .hm-acc__body strong { color: var(--hm-fg); }

  /* ---------- Barra fija ---------- */
  .hm-sticky {
    --hm-bg: #ffffff; --hm-fg: #121116; --hm-muted: #5d5a66; --hm-line: #e8e3f1; --hm-accent-ink: #ffffff;
    font-family: var(--hm-font-body, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    color: var(--hm-fg); line-height: 1.4; box-sizing: border-box;
  }
  .hm-sticky *, .hm-sticky *::before, .hm-sticky *::after { box-sizing: border-box; }
  .hm-sticky [hidden] { display: none !important; }
  .hm-sticky strong, .hm-sticky span, .hm-sticky s, .hm-sticky button { text-transform: none; letter-spacing: normal; font-family: inherit; }
  .hm-sticky {
    position: fixed; z-index: 60; left: 0; right: 0; bottom: 0;
    background: var(--hm-bg); border-top: 1px solid var(--hm-line);
    transform: translateY(110%); visibility: hidden; transition: transform .25s ease, visibility 0s .25s;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  }
  .hm-sticky.is-visible { transform: none; visibility: visible; transition: transform .25s ease; box-shadow: 0 -4px 20px rgba(0,0,0,.08); }
  .hm-sticky__inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .hm-sticky__product { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .hm-sticky__product img { display: block; width: 44px; height: 44px; border-radius: 6px; object-fit: cover; flex: none; }
  .hm-sticky__product > div { min-width: 0; }
  .hm-sticky__product strong { display: block; font-size: 13px; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hm-sticky__price { display: flex; gap: 6px; align-items: baseline; font-weight: 700; font-size: 15px; color: var(--hm-accent); }
  .hm-sticky__price s { font-weight: 400; font-size: 12px; color: var(--hm-muted); }
  .hm-sticky .hm-sticky__btn { min-height: 46px; padding: 0 20px; font-size: 15px; border-radius: var(--hm-r-btn, 8px); flex: none; }
  @media (min-width: 990px) {
    .hm-sticky { padding: 12px 32px; }
    .hm-sticky .hm-sticky__btn { min-width: 260px; }
  }
  .hm-upper .hm-btn__label { text-transform: uppercase; letter-spacing: .04em; }
</style>

<section id="hm-{{ section.id }}" class="hm hm--{{ s.esquema }} hm-pdp{% if s.boton_mayus %} hm-upper{% endif %}" style="--hm-accent: {{ acc }}; --hm-a6: {{ acc | color_modify: 'alpha', 0.06 }}; --hm-a8: {{ acc | color_modify: 'alpha', 0.08 }}; --hm-a10: {{ acc | color_modify: 'alpha', 0.1 }}; --hm-a14: {{ acc | color_modify: 'alpha', 0.14 }}; --hm-a25: {{ acc | color_modify: 'alpha', 0.25 }}; --hm-a28: {{ acc | color_modify: 'alpha', 0.28 }}; --hm-a35: {{ acc | color_modify: 'alpha', 0.35 }}; --hm-a40: {{ acc | color_modify: 'alpha', 0.4 }}; --hm-a55: {{ acc | color_modify: 'alpha', 0.55 }}; --hm-dark30: {{ acc | color_mix: '#0c0b10', 30 }}; --hm-dark55: {{ acc | color_mix: '#0c0b10', 55 }}; --hm-pt: {{ s.padding_top }}px; --hm-pb: {{ s.padding_bottom }}px; --hm-font-body: {{ hm_font_stack }}; --hm-font-display: {{ hm_font_stack }}; --hm-title-d: {{ s.titulo_desktop }}px; --hm-title-m: {{ s.titulo_mobile }}px;{% if s.color_boton != blank %} --hm-btn-bg: {{ s.color_boton }};{% endif %}{% if s.color_boton_texto != blank %} --hm-btn-fg: {{ s.color_boton_texto }};{% endif %}{% if s.color_texto != blank %} --hm-fg: {{ s.color_texto }};{% endif %}{% if s.color_fondo != blank %} --hm-bg: {{ s.color_fondo }};{% endif %}{% if s.color_precio != blank %} --hm-price: {{ s.color_precio }};{% endif %}{% if s.color_texto_sec != blank %} --hm-muted: {{ s.color_texto_sec }};{% endif %}{% if s.color_bordes != blank %} --hm-line: {{ s.color_bordes }};{% endif %}{% if s.color_tarjetas != blank %} --hm-card: {{ s.color_tarjetas }};{% endif %} --hm-star: {{ s.color_estrellas }}; --hm-ok: {{ s.color_positivo }};{% if s.color_promo != blank %} --hm-promo-bg: {{ s.color_promo }};{% endif %}{% if s.color_promo_texto != blank %} --hm-promo-fg: {{ s.color_promo_texto }};{% endif %}{% if s.color_aviso != blank %} --hm-alert-bg: {{ s.color_aviso }};{% endif %}{% if s.color_aviso_texto != blank %} --hm-alert-fg: {{ s.color_aviso_texto }}; --hm-alert-line: {{ s.color_aviso_texto | color_modify: 'alpha', 0.4 }};{% endif %} --hm-r: {{ s.redondeo }}px; --hm-r-btn: {{ s.redondeo_boton }}px; --hm-pill-line: {{ s.color_boton_texto | default: '#ffffff' | color_modify: 'alpha', 0.4 }};">
  <div class="hm-container">
    <div class="hm-pdp__grid">

      {%- comment -%} ===================== GALERÍA ===================== {%- endcomment -%}
      <div class="hm-pdp__media">
        <div class="hm-gal hm-gal--{{ s.proporcion }} hm-gal--{{ s.ajuste }}" data-hm-gallery>
          <div class="hm-gal__main">
            <div class="hm-gal__track" data-hm-track>
              {%- assign img_count = 0 -%}
              {%- if use_custom_gallery -%}
                {%- for block in section.blocks -%}
                  {%- if block.type != 'foto_galeria' or block.settings.imagen == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign img_count = img_count | plus: 1 -%}
                  {%- assign g_img = block.settings.imagen -%}
                  {%- assign g_alt = block.settings.alt | default: product.title -%}
                  <div class="hm-gal__slide" {{ block.shopify_attributes }}>
                    {%- if img_count == 1 -%}
                      {{ g_img | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: g_alt }}
                      {%- if overlay_html != blank -%}<div class="hm-gal__chips">{{ overlay_html }}</div>{%- endif -%}
                    {%- else -%}
                      {{ g_img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: g_alt }}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for media in product.media -%}
                  {%- if media.media_type != 'image' -%}{%- continue -%}{%- endif -%}
                  {%- assign img_count = img_count | plus: 1 -%}
                  {%- assign m_alt = media.alt | default: product.title -%}
                  <div class="hm-gal__slide">
                    {%- if img_count == 1 -%}
                      {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: m_alt }}
                      {%- if overlay_html != blank -%}<div class="hm-gal__chips">{{ overlay_html }}</div>{%- endif -%}
                    {%- else -%}
                      {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: m_alt }}
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- endif -%}
              {%- if img_count == 0 -%}
                <div class="hm-gal__slide">{{ 'product-1' | placeholder_svg_tag: 'hm-ph' }}</div>
              {%- endif -%}
            </div>
            {%- if img_count > 1 -%}
              <button type="button" class="hm-gal__arrow hm-gal__arrow--prev" data-hm-gprev aria-label="Imagen anterior"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-arrow-left"/></svg></button>
              <button type="button" class="hm-gal__arrow hm-gal__arrow--next" data-hm-gnext aria-label="Imagen siguiente"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-arrow-right"/></svg></button>
              {%- if s.mostrar_contador -%}<span class="hm-gal__count"><span data-hm-count>1</span>/{{ img_count }}</span>{%- endif -%}
            {%- endif -%}
          </div>

          {%- if img_count > 1 and s.mostrar_miniaturas -%}
            <div class="hm-gal__thumbs" data-hm-thumbs>
              {%- assign ti = 0 -%}
              {%- if use_custom_gallery -%}
                {%- for block in section.blocks -%}
                  {%- if block.type != 'foto_galeria' or block.settings.imagen == blank -%}{%- continue -%}{%- endif -%}
                  <button type="button" class="hm-gal__thumb{% if ti == 0 %} is-active{% endif %}" data-hm-thumb="{{ ti }}" aria-label="{{ ti | plus: 1 }}">
                    {{ block.settings.imagen | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: '' }}
                  </button>
                  {%- assign ti = ti | plus: 1 -%}
                {%- endfor -%}
              {%- else -%}
                {%- for media in product.media -%}
                  {%- if media.media_type != 'image' -%}{%- continue -%}{%- endif -%}
                  <button type="button" class="hm-gal__thumb{% if ti == 0 %} is-active{% endif %}" data-hm-thumb="{{ ti }}" aria-label="{{ ti | plus: 1 }}">
                    {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: '' }}
                  </button>
                  {%- assign ti = ti | plus: 1 -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if cards_html != blank -%}
          <div class="hm-cards2 hm-cards2--media hm-cards2--m-{{ s.tarjetas_mobile }}">{{ cards_html }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} ===================== INFO + OFERTA ===================== {%- endcomment -%}
      <div class="hm-pdp__info" id="hm-comprar" data-hm-buybox data-after="{{ s.despues_de_agregar }}" data-error="{{ s.error_label | escape }}">
        {%- assign packs_rendered = false -%}
        {%- for block in section.blocks -%}
          {%- assign bs = block.settings -%}
          {%- case block.type -%}

            {%- when 'rating' -%}
              <div class="hm-rating" {{ block.shopify_attributes }}>
                {%- assign r = bs.estrellas | default: 5 | times: 1.0 -%}
<span class="hm-stars" role="img" aria-label="{{ r }} de 5 estrellas">
  {%- for i in (1..5) -%}
    {%- assign full = i | times: 1.0 -%}
    {%- assign half = full | minus: 0.5 -%}
    {%- if r >= full -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- elsif r >= half -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="hm-half-{{ i }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="currentColor" stop-opacity=".25"/></linearGradient></defs><path fill="url(#hm-half-{{ i }})" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-opacity=".25" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
    {%- endif -%}
  {%- endfor -%}
</span>
                <span>{{ bs.texto }}</span>
                {%- if bs.link_texto != blank -%}
                  <span class="hm-rating__sep" aria-hidden="true">|</span>
                  <a href="{{ bs.link | default: '#' }}">{{ bs.link_texto }}</a>
                {%- endif -%}
              </div>

            {%- when 'titulo' -%}
              <div class="hm-pdp__heading" {{ block.shopify_attributes }}>
                {%- if bs.marca != blank -%}<p class="hm-pdp__brand">{{ bs.marca }}</p>{%- endif -%}
                <h1 class="hm-pdp__title">
                  {%- if bs.titulo != blank -%}{{ bs.titulo }}{%- else -%}{{ product.title | escape }}{%- endif -%}
                </h1>
                {%- if bs.subtitulo != blank -%}<p class="hm-pdp__subtitle">{{ bs.subtitulo }}</p>{%- endif -%}
              </div>

            {%- when 'texto' -%}
              <div class="hm-pdp__text" {{ block.shopify_attributes }}>{{ bs.texto }}</div>

            {%- when 'beneficio' -%}
              <p class="hm-feat" {{ block.shopify_attributes }}>
                <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ bs.icono }}"/></svg>
                <span>{{ bs.texto }}</span>
              </p>

            {%- when 'precio' -%}
              <div class="hm-price" {{ block.shopify_attributes }}>
                <span class="hm-price__now" data-hm-price>{{ sel_price }}</span>
                <s class="hm-price__was" data-hm-compare {% if sel_compare == '' %}hidden{% endif %}>{{ sel_compare }}</s>
                <span class="hm-price__promo" data-hm-promo {% if sel_promo == '' %}hidden{% endif %}>{{ sel_promo }}</span>
              </div>

            {%- when 'pack' -%}
              {%- unless packs_rendered -%}
                {%- assign packs_rendered = true -%}
                <div class="hm-packs" role="radiogroup" aria-label="Elegí tu pack">
                  {{ packs_html }}
                </div>
              {%- endunless -%}

            {%- when 'regalos' -%}
              <div class="hm-gifts" {{ block.shopify_attributes }}>
                <span class="hm-gifts__title">{{ bs.titulo }}</span>
                <div class="hm-gifts__row">
                  {%- for i in (1..3) -%}
                    {%- assign gk = 'regalo_' | append: i -%}
                    {%- assign gi = 'regalo_' | append: i | append: '_img' -%}
                    {%- assign gd = 'regalo_' | append: i | append: '_desde' -%}
                    {%- if bs[gk] != blank -%}
                      {%- unless forloop.first -%}<span class="hm-gifts__plus" aria-hidden="true">+</span>{%- endunless -%}
                      <div class="hm-gift" data-hm-gift data-from="{{ bs[gd] }}">
                        <span class="hm-gift__img">
                          {%- if bs[gi] != blank -%}
                            {{ bs[gi] | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '56px', alt: bs[gk] }}
                          {%- else -%}
                            <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-gift"/></svg>
                          {%- endif -%}
                          <span class="hm-gift__lock"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-lock"/></svg></span>
                        </span>
                        <span class="hm-gift__state" data-on="{{ bs[gk] | escape }}" data-off="{{ bs.texto_bloqueado | escape }}">{{ bs.texto_bloqueado }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>

            {%- when 'envio' -%}
              <p class="hm-eta" data-hm-eta data-days="{{ bs.dias }}" {{ block.shopify_attributes }}>
                <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-clock"/></svg>
                <span>{{ bs.texto | replace: '[fecha]', '<strong data-hm-eta-date></strong>' }}</span>
              </p>

            {%- when 'boton' -%}
              <div class="hm-buy" id="hm-buy-{{ section.id }}" {{ block.shopify_attributes }}>
                {%- form 'product', product, class: 'hm-buy__form', data-hm-form: '', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ sel_variant.id }}" data-hm-variant-id>
                  <input type="hidden" name="quantity" value="{{ sel_qty }}" data-hm-qty>
                  <button
                    type="submit"
                    class="hm-btn hm-btn--block hm-buy__btn"
                    data-hm-submit
                    data-label="{{ bs.texto | escape }}"
                    data-soldout="{{ s.soldout_label | escape }}"
                    {% unless sel_variant.available %}disabled{% endunless %}
                  >
                    <span class="hm-btn__label">{% if sel_variant.available %}{{ bs.texto }}{% else %}{{ s.soldout_label }}{% endif %}</span>
                    <span class="hm-buy__pill">
                      <s data-hm-compare {% if sel_compare == '' %}hidden{% endif %}>{{ sel_compare }}</s>
                      <strong data-hm-price>{{ sel_price }}</strong>
                      {%- if bs.garantia != blank -%}
                        <span class="hm-buy__guar"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-check-circle"/></svg>{{ bs.garantia }}</span>
                      {%- endif -%}
                    </span>
                    <svg class="hm-icon hm-buy__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-arrow-right"/></svg>
                  </button>
                {%- endform -%}
                <p class="hm-buy__error" data-hm-error role="alert" hidden></p>
                <p class="hm-buy__added" data-hm-added hidden><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-check-circle"/></svg> {{ s.added_label }}</p>
              </div>

            {%- when 'pagos' -%}
              <div class="hm-pay" {{ block.shopify_attributes }}>
                {%- if cuotas > 1 -%}
                  <p><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-card"/></svg><span>{{ bs.texto_cuotas | replace: '[n]', cuotas }} <strong data-hm-cuota>{{ sel_cuota }}</strong></span></p>
                {%- endif -%}
                {%- if transfer_pct > 0 -%}
                  <p><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-percent"/></svg><span><strong data-hm-transfer>{{ sel_transfer }}</strong> {{ bs.texto_transferencia | replace: '[pct]', transfer_pct }}</span></p>
                {%- endif -%}
                {%- if bs.texto_seguro != blank -%}
                  <p><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-lock"/></svg><span>{{ bs.texto_seguro }}</span></p>
                {%- endif -%}
              </div>

            {%- when 'social' -%}
              <div class="hm-social" {{ block.shopify_attributes }}>
                <span class="hm-social__faces">
                  {%- for i in (1..4) -%}
                    {%- assign ak = 'avatar_' | append: i -%}
                    {%- if bs[ak] != blank -%}{{ bs[ak] | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40, 80', sizes: '32px', alt: '' }}{%- endif -%}
                  {%- endfor -%}
                  <span class="hm-social__ok"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-check"/></svg></span>
                </span>
                <span class="hm-social__text">
                  <strong>{{ bs.titulo }}</strong>
                  {%- if bs.texto != blank -%}<span>{{ bs.texto }}</span>{%- endif -%}
                </span>
              </div>

            {%- when 'aviso' -%}
              <div class="hm-alert hm-alert--{{ bs.estilo }}" {{ block.shopify_attributes }}>
                <p class="hm-alert__title"><svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ bs.icono }}"/></svg><strong>{{ bs.titulo }}</strong></p>
                {%- if bs.texto != blank -%}<p class="hm-alert__text">{{ bs.texto }}</p>{%- endif -%}
              </div>

            {%- when 'acordeon' -%}
              <details class="hm-acc" {% if bs.abierto %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="hm-acc__sum">
                  <span>{{ bs.titulo }}</span>
                  <span class="hm-acc__icon" aria-hidden="true"></span>
                </summary>
                <div class="hm-acc__body">{{ bs.contenido }}</div>
              </details>

            {%- when 'espacio' -%}
              <div class="hm-space" style="height: {{ bs.alto }}px" {{ block.shopify_attributes }}></div>

          {%- endcase -%}
        {%- endfor -%}
        {%- if cards_html != blank and s.tarjetas_mobile == 'final' -%}
          <div class="hm-cards2 hm-cards2--end">{{ cards_html }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if s.sticky -%}
    <div class="hm-sticky{% if s.boton_mayus %} hm-upper{% endif %}" data-hm-sticky data-hm-owner="hm-{{ section.id }}" data-target="hm-buy-{{ section.id }}" role="region" aria-label="{{ s.sticky_texto | escape }}">
      <div class="hm-sticky__inner">
        <div class="hm-sticky__product">
          {%- if product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '44px', alt: '' }}
          {%- endif -%}
          <div>
            <strong data-hm-pack-name>{{ sel_name }}</strong>
            <span class="hm-sticky__price">
              <span data-hm-price>{{ sel_price }}</span>
              <s data-hm-compare {% if sel_compare == '' %}hidden{% endif %}>{{ sel_compare }}</s>
            </span>
          </div>
        </div>
        <button type="button" class="hm-btn hm-sticky__btn" data-hm-submit-external>
          <span class="hm-btn__label">{{ s.sticky_texto }}</span>
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
/* DR.MEN · HAIR — JS de las secciones de landing (prefijo hm-).
   Se carga desde cada sección; el guard evita que se ejecute dos veces. */
(function () {
  if (window.HMLanding) return;

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function once(el, key) {
    var flag = 'hm' + key + 'Ready';
    if (el.dataset[flag]) return false;
    el.dataset[flag] = '1';
    return true;
  }

  /* ---------- Carrusel con flechas y barra de progreso ---------- */
  function initSlider(root) {
    if (!once(root, 'Slider')) return;
    var track = root.querySelector('[data-hm-track]');
    if (!track) return;
    var prev = root.querySelector('[data-hm-prev]');
    var next = root.querySelector('[data-hm-next]');
    var bar = root.querySelector('[data-hm-bar]');

    function step() {
      var first = track.children[0];
      if (!first) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first.getBoundingClientRect().width + gap;
    }
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      var ratio = max > 0 ? track.scrollLeft / max : 0;
      var visible = track.scrollWidth > 0 ? track.clientWidth / track.scrollWidth : 1;
      if (bar) {
        bar.style.width = Math.max(visible * 100, 12) + '%';
        bar.style.transform = 'translateX(' + ratio * (100 / Math.max(visible, .12) - 100) + '%)';
      }
      if (prev) prev.disabled = track.scrollLeft <= 4;
      if (next) next.disabled = track.scrollLeft >= max - 4;
      var nav = root.querySelector('.hm-slider__nav');
      if (nav) nav.hidden = max <= 4;
    }
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);
    update();

    var autoplay = parseInt(root.dataset.autoplay || '0', 10);
    if (autoplay > 0 && !reduceMotion) {
      var paused = false;
      root.addEventListener('pointerenter', function () { paused = true; });
      root.addEventListener('pointerleave', function () { paused = false; });
      root.addEventListener('touchstart', function () { paused = true; }, { passive: true });
      setInterval(function () {
        if (paused || document.hidden) return;
        var max = track.scrollWidth - track.clientWidth;
        if (track.scrollLeft >= max - 4) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: step(), behavior: 'smooth' });
      }, autoplay * 1000);
    }
  }

  /* ---------- Aparición al hacer scroll ---------- */
  var revealObserver = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('is-in'); revealObserver.unobserve(e.target); }
    });
  }, { rootMargin: '0px 0px -8% 0px' }) : null;

  function initReveal(el) {
    if (!once(el, 'Reveal')) return;
    if (!revealObserver || reduceMotion) { el.classList.add('is-in'); return; }
    revealObserver.observe(el);
  }

  /* ---------- Cuenta regresiva ---------- */
  function initCountdown(el) {
    if (!once(el, 'Countdown')) return;
    var mode = el.dataset.mode || 'hoy';
    var end;
    if (mode === 'fecha' && el.dataset.end) {
      end = new Date(el.dataset.end.replace(' ', 'T')).getTime();
    }
    function target() {
      if (mode === 'fecha' && end) return end;
      var d = new Date();
      d.setHours(23, 59, 59, 999);
      return d.getTime();
    }
    var parts = {
      d: el.querySelector('[data-hm-d]'),
      h: el.querySelector('[data-hm-h]'),
      m: el.querySelector('[data-hm-m]'),
      s: el.querySelector('[data-hm-s]')
    };
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      var diff = Math.max(0, target() - Date.now());
      var s = Math.floor(diff / 1000);
      var days = Math.floor(s / 86400);
      var h = Math.floor((s % 86400) / 3600);
      var m = Math.floor((s % 3600) / 60);
      var sec = s % 60;
      if (parts.d) { parts.d.textContent = pad(days); parts.d.parentElement.hidden = days === 0; }
      if (parts.h) parts.h.textContent = pad(parts.d ? h : h + days * 24);
      if (parts.m) parts.m.textContent = pad(m);
      if (parts.s) parts.s.textContent = pad(sec);
    }
    tick();
    setInterval(tick, 1000);
  }

  /* ---------- Antes / después con deslizador ---------- */
  function initCompare(el) {
    if (!once(el, 'Compare')) return;
    var input = el.querySelector('input[type="range"]');
    if (!input) return;
    function set() { el.style.setProperty('--hm-pos', input.value + '%'); }
    input.addEventListener('input', set);
    set();
  }

  /* ---------- Videos UGC: autoplay en pantalla + sonido al tocar ---------- */
  var videoObserver = 'IntersectionObserver' in window ? new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      var v = e.target;
      if (e.isIntersecting) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      else v.pause();
    });
  }, { threshold: .55 }) : null;

  function initVideo(card) {
    if (!once(card, 'Video')) return;
    var video = card.querySelector('video');
    if (!video) return;
    video.muted = true;
    video.playsInline = true;
    video.loop = true;
    if (videoObserver && !reduceMotion) videoObserver.observe(video);
    var btn = card.querySelector('[data-hm-sound]');
    function toggle() {
      var allVideos = document.querySelectorAll('[data-hm-video] video');
      var willUnmute = video.muted;
      allVideos.forEach(function (v) { v.muted = true; v.closest('[data-hm-video]').classList.remove('is-sound'); });
      video.muted = !willUnmute;
      if (willUnmute) {
        video.currentTime = 0;
        var p = video.play(); if (p && p.catch) p.catch(function () {});
        card.classList.add('is-sound');
      }
    }
    if (btn) btn.addEventListener('click', toggle);
  }

  /* ---------- Galería del producto ---------- */
  function initGallery(root) {
    if (!once(root, 'Gallery')) return;
    var track = root.querySelector('[data-hm-track]');
    if (!track) return;
    var thumbsWrap = root.querySelector('[data-hm-thumbs]');
    var thumbs = root.querySelectorAll('[data-hm-thumb]');
    var count = root.querySelector('[data-hm-count]');
    var prev = root.querySelector('[data-hm-gprev]');
    var next = root.querySelector('[data-hm-gnext]');
    var total = track.children.length;
    var current = 0;

    function goTo(i, smooth) {
      i = Math.max(0, Math.min(total - 1, i));
      var slide = track.children[i];
      if (!slide) return;
      track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: smooth === false ? 'auto' : 'smooth' });
      setActive(i);
    }
    function setActive(i) {
      if (i === current && count && count.textContent === String(i + 1)) return;
      current = i;
      if (count) count.textContent = i + 1;
      thumbs.forEach(function (t) {
        var on = parseInt(t.dataset.hmThumb, 10) === i;
        t.classList.toggle('is-active', on);
        if (on && thumbsWrap) {
          /* Mantiene la miniatura activa a la vista sin mover la página */
          var vertical = thumbsWrap.scrollHeight > thumbsWrap.clientHeight + 2;
          if (vertical) thumbsWrap.scrollTo({ top: t.offsetTop - thumbsWrap.clientHeight / 2 + t.clientHeight / 2, behavior: 'smooth' });
          else thumbsWrap.scrollTo({ left: t.offsetLeft - thumbsWrap.clientWidth / 2 + t.clientWidth / 2, behavior: 'smooth' });
        }
      });
    }

    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { goTo(parseInt(t.dataset.hmThumb, 10)); });
    });
    if (prev) prev.addEventListener('click', function () { goTo(current === 0 ? total - 1 : current - 1); });
    if (next) next.addEventListener('click', function () { goTo(current === total - 1 ? 0 : current + 1); });

    var ticking = false;
    track.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        ticking = false;
        var i = Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
        if (i !== current) setActive(i);
      });
    }, { passive: true });

    /* Al elegir un pack con foto propia, la galería salta a esa foto */
    var section = root.closest('.hm');
    if (section) section.addEventListener('hm:pack', function (e) {
      var slide = e.detail && e.detail.slide;
      if (slide !== '' && slide !== undefined && !isNaN(parseInt(slide, 10))) goTo(parseInt(slide, 10));
    });
  }

  /* ---------- Caja de compra: packs + agregar al carrito ---------- */
  function initBuybox(root) {
    if (!once(root, 'Buybox')) return;
    var form = root.querySelector('form[data-hm-form], form.hm-buy__form');
    var idInput = root.querySelector('[data-hm-variant-id]');
    var qtyInput = root.querySelector('[data-hm-qty]');
    var packs = root.querySelectorAll('[data-hm-pack]');
    var section = root.closest('.hm') || document;

    /* La barra fija se mueve al <body> para que ningún contenedor del theme la rompa */
    var sticky = section.querySelector ? section.querySelector('[data-hm-sticky]') : null;
    if (sticky && section.id) {
      document.querySelectorAll('body > [data-hm-owner="' + section.id + '"]').forEach(function (old) { if (old !== sticky) old.remove(); });
      sticky.setAttribute('style', section.getAttribute('style') || '');
      document.body.appendChild(sticky);
    }
    function scopeAll(selector) {
      var list = Array.prototype.slice.call(section.querySelectorAll(selector));
      if (sticky) list = list.concat(Array.prototype.slice.call(sticky.querySelectorAll(selector)));
      return list;
    }

    function fill(selector, value) {
      scopeAll(selector).forEach(function (n) {
        if (value) { n.innerHTML = value; n.hidden = false; }
        else n.hidden = true;
      });
    }

    function select(pack, fromUser) {
      if (pack.dataset.available === 'false' && fromUser) return;
      packs.forEach(function (p) {
        var on = p === pack;
        p.classList.toggle('is-selected', on);
        var r = p.querySelector('input[type="radio"]');
        if (r) r.checked = on;
      });
      var d = pack.dataset;
      if (idInput) idInput.value = d.variantId;
      if (qtyInput) qtyInput.value = d.qty || 1;
      fill('[data-hm-price]', d.price);
      fill('[data-hm-compare]', d.compare);
      fill('[data-hm-transfer]', d.transfer);
      fill('[data-hm-cuota]', d.cuota);
      fill('[data-hm-pack-name]', d.name);
      if (fromUser) section.dispatchEvent(new CustomEvent('hm:pack', { detail: { slide: d.slide, index: d.index } }));
      var soldOut = d.available === 'false';
      scopeAll('[data-hm-submit]').forEach(function (b) {
        b.disabled = soldOut;
        var label = b.querySelector('.hm-btn__label');
        if (label) label.textContent = soldOut ? (b.dataset.soldout || 'Sin stock') : b.dataset.label;
      });
    }

    packs.forEach(function (p) {
      var r = p.querySelector('input[type="radio"]');
      if (r) r.addEventListener('change', function () { if (r.checked) select(p, true); });
    });
    var initial = root.querySelector('[data-hm-pack].is-selected') || packs[0];
    if (initial) select(initial);

    if (!form) return;
    form.addEventListener('submit', function (ev) {
      if (!window.fetch) return;
      ev.preventDefault();
      addToCart(root, form);
    });
    scopeAll('[data-hm-submit-external]').forEach(function (b) {
      b.addEventListener('click', function () { addToCart(root, form, b); });
    });
  }

  function addToCart(root, form, extraButton) {
    var buttons = [form.querySelector('[data-hm-submit]')];
    if (extraButton) buttons.push(extraButton);
    var error = root.querySelector('[data-hm-error]');
    buttons.forEach(function (b) { if (b) b.setAttribute('aria-busy', 'true'); });
    if (error) error.hidden = true;

    var id = form.querySelector('[data-hm-variant-id]').value;
    var qty = parseInt(form.querySelector('[data-hm-qty]').value || '1', 10);
    var root_url = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var after = root.dataset.after || 'checkout';

    fetch(root_url + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ items: [{ id: parseInt(id, 10), quantity: qty }] })
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, json: j }; }); })
      .then(function (res) {
        if (!res.ok) throw new Error(res.json.description || res.json.message || root.dataset.error || 'Error');
        document.dispatchEvent(new CustomEvent('hm:added', { detail: res.json }));
        if (after === 'checkout') window.location.href = root_url + 'checkout';
        else if (after === 'cart') window.location.href = root_url + 'cart';
        else {
          buttons.forEach(function (b) { if (b) b.removeAttribute('aria-busy'); });
          var ok = root.querySelector('[data-hm-added]');
          if (ok) { ok.hidden = false; setTimeout(function () { ok.hidden = true; }, 4000); }
          refreshCartCount();
        }
      })
      .catch(function (e) {
        buttons.forEach(function (b) { if (b) b.removeAttribute('aria-busy'); });
        if (error) { error.textContent = e.message; error.hidden = false; }
      });
  }

  function refreshCartCount() {
    var root_url = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    fetch(root_url + 'cart.js').then(function (r) { return r.json(); }).then(function (cart) {
      document.querySelectorAll('.cart-count-bubble span[aria-hidden], [data-cart-count], .cart-count').forEach(function (n) {
        n.textContent = cart.item_count;
      });
    }).catch(function () {});
  }

  /* ---------- Barra fija de compra ---------- */
  function initSticky(bar) {
    if (!once(bar, 'Sticky')) return;
    var target = document.getElementById(bar.dataset.target);
    if (!target) return;
    var visible = false;
    var ticking = false;
    /* Se muestra cuando el botón de compra quedó arriba, fuera de pantalla */
    function check() {
      ticking = false;
      var past = target.getBoundingClientRect().bottom < 0;
      if (past === visible) return;
      visible = past;
      bar.classList.toggle('is-visible', past);
      document.documentElement.classList.toggle('hm-sticky-on', past);
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; window.requestAnimationFrame(check); }
    }, { passive: true });
    window.addEventListener('resize', check);
    check();
  }

  /* ---------- Links internos suaves (#hm-comprar) ---------- */
  document.addEventListener('click', function (ev) {
    var a = ev.target.closest && ev.target.closest('a[href^="#"]');
    if (!a || a.getAttribute('href').length < 2) return;
    var t = document.getElementById(a.getAttribute('href').slice(1));
    if (!t || !t.closest('.hm, [id^="hm-"]')) return;
    ev.preventDefault();
    t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  function init(scope) {
    scope = scope || document;
    scope.querySelectorAll('[data-hm-slider]').forEach(initSlider);
    scope.querySelectorAll('.hm-reveal').forEach(initReveal);
    scope.querySelectorAll('[data-hm-countdown]').forEach(initCountdown);
    scope.querySelectorAll('[data-hm-compare]').forEach(initCompare);
    scope.querySelectorAll('[data-hm-video]').forEach(initVideo);
    scope.querySelectorAll('[data-hm-gallery]').forEach(initGallery);
    scope.querySelectorAll('[data-hm-buybox]').forEach(initBuybox);
    scope.querySelectorAll('[data-hm-sticky]').forEach(initSticky);
  }

  window.HMLanding = { init: init };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { init(); });
  else init();

  /* Editor de temas: re-inicializa al editar una sección */
  document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  document.addEventListener('shopify:section:unload', function (e) {
    var id = e.detail && e.detail.sectionId;
    if (id) document.querySelectorAll('body > [data-hm-owner="hm-' + id + '"]').forEach(function (n) { n.remove(); });
  });
  document.addEventListener('shopify:block:select', function (e) {
    var slide = e.target;
    var track = slide.parentElement;
    if (track && track.hasAttribute('data-hm-track')) track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
  });
})();

</script>

<script>
  (function () {
    var root = document.getElementById('hm-{{ section.id }}');
    if (!root || root.dataset.hmLocal) return;
    root.dataset.hmLocal = '1';

    /* Regalos: se desbloquean según el pack elegido */
    function syncGifts() {
      var sel = root.querySelector('[data-hm-pack].is-selected');
      var idx = sel ? parseInt(sel.dataset.index, 10) : 1;
      root.querySelectorAll('[data-hm-gift]').forEach(function (g) {
        var on = idx >= parseInt(g.dataset.from || '1', 10);
        g.classList.toggle('is-unlocked', on);
        var st = g.querySelector('.hm-gift__state');
        if (st) st.textContent = on ? st.dataset.on : st.dataset.off;
      });
      /* Promo del precio */
      var promo = root.querySelector('[data-hm-promo]');
      if (promo && sel) { promo.textContent = sel.dataset.promo; promo.hidden = !sel.dataset.promo; }
    }
    root.addEventListener('change', function (e) { if (e.target.closest('[data-hm-pack]')) syncGifts(); });
    syncGifts();

    /* Fecha estimada de entrega en días hábiles */
    var meses = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    root.querySelectorAll('[data-hm-eta]').forEach(function (el) {
      var n = parseInt(el.dataset.days || '5', 10);
      var d = new Date();
      while (n > 0) { d.setDate(d.getDate() + 1); if (d.getDay() !== 0 && d.getDay() !== 6) n--; }
      var out = el.querySelector('[data-hm-eta-date]');
      if (out) out.textContent = d.getDate() + ' de ' + meses[d.getMonth()];
    });
  })();
</script>


{% schema %}
{
  "name": "HM · Producto (oferta)",
  "tag": "div",
  "class": "hm-section-pdp",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "paragraph",
      "content": "Las fotos salen del producto (admin → Productos → Multimedia)."
    },
    {
      "type": "select",
      "id": "proporcion",
      "label": "Formato de las fotos",
      "options": [
        {
          "value": "cuadrado",
          "label": "Cuadrado (1:1)"
        },
        {
          "value": "retrato",
          "label": "Vertical (4:5)"
        }
      ],
      "default": "cuadrado"
    },
    {
      "type": "select",
      "id": "ajuste",
      "label": "Ajuste de las fotos",
      "options": [
        {
          "value": "completa",
          "label": "Mostrar la foto completa"
        },
        {
          "value": "recortar",
          "label": "Recortar para llenar"
        }
      ],
      "default": "completa"
    },
    {
      "type": "checkbox",
      "id": "mostrar_miniaturas",
      "label": "Mostrar miniaturas",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mostrar_contador",
      "label": "Mostrar contador (1/8)",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "¿Querés otras fotos en vez de las del producto? Agregá bloques \"Foto de la galería\"."
    },
    {
      "type": "select",
      "id": "tarjetas_mobile",
      "label": "Tarjetas bajo la galería en celular",
      "options": [
        {
          "value": "final",
          "label": "Al final de la info (recomendado)"
        },
        {
          "value": "galeria",
          "label": "Debajo de la galería"
        },
        {
          "value": "ocultar",
          "label": "Ocultar"
        }
      ],
      "default": "final"
