{%- liquid
  assign s = section.settings
  assign acc = s.color_acento | default: '#6b3fc0'
  assign cuotas = s.cuotas | default: 1
  assign transfer_pct = s.transfer_pct | default: 0
  assign transfer_mult = 100 | minus: transfer_pct
  assign base_variant = product.selected_or_first_available_variant

  assign sel_id = ''
  assign first_pack_id = ''
  for block in section.blocks
    if block.type == 'pack'
      if first_pack_id == ''
        assign first_pack_id = block.id
      endif
      if block.settings.preseleccionado and sel_id == ''
        assign sel_id = block.id
      endif
    endif
  endfor
  if sel_id == ''
    assign sel_id = first_pack_id
  endif

  assign sel_variant = base_variant
  assign sel_qty = 1
  assign sel_price = base_variant.price | money_without_trailing_zeros
  assign sel_compare = ''
  assign sel_promo = ''
  if base_variant.compare_at_price > base_variant.price
    assign sel_compare = base_variant.compare_at_price | money_without_trailing_zeros
    assign tmp = base_variant.compare_at_price | minus: base_variant.price | money_without_trailing_zeros
    assign sel_promo = s.promo_label | replace: '[monto]', tmp
  endif
  assign tmp = base_variant.price | times: transfer_mult | divided_by: 10000 | times: 100
  assign sel_transfer = tmp | money_without_trailing_zeros
  assign tmp = base_variant.price | divided_by: cuotas | divided_by: 100 | times: 100
  assign sel_cuota = tmp | money_without_trailing_zeros
  assign sel_name = product.title
  assign ref_unit = 0

  assign use_custom_gallery = false
  for block in section.blocks
    if block.type == 'foto_galeria' and block.settings.imagen != blank
      assign use_custom_gallery = true
    endif
  endfor
  assign image_ids = ''
  for media in product.media
    if media.media_type == 'image'
      assign image_ids = image_ids | append: media.id | append: ','
    endif
  endfor
  assign image_ids = image_ids | split: ','
-%}

{%- capture packs_html -%}
  {%- assign pack_index = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'pack' -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign pack_index = pack_index | plus: 1
      assign bs = block.settings
      assign p = product
      if bs.producto != blank
        assign p = bs.producto
      endif
      assign vi = bs.variante | minus: 1
      assign v = p.variants[vi]
      if v == blank
        assign v = p.selected_or_first_available_variant
      endif
      assign qty = bs.cantidad | default: 1
      assign frascos = bs.frascos | default: 1
      assign total = v.price | times: qty
      assign variant_total = total
      if bs.precio != blank and bs.precio > 0
        assign total = bs.precio | times: 100
      endif

      if ref_unit == 0
        assign ref_unit = total | divided_by: frascos
      endif
      assign compare = 0
      if v.compare_at_price > v.price
        assign compare = v.compare_at_price | times: qty
      endif
      assign ref_total = ref_unit | times: frascos
      if bs.comparar_con_unitario and ref_total > compare
        assign compare = ref_total
      endif
      if bs.precio_tachado != blank and bs.precio_tachado > 0
        assign compare = bs.precio_tachado | times: 100
      endif

      assign compare_txt = ''
      assign save_txt = ''
      assign promo_txt = ''
      if compare > total
        assign compare_txt = compare | money_without_trailing_zeros
        assign save_amount = compare | minus: total
        assign save_amount_txt = save_amount | money_without_trailing_zeros
        assign half = compare | divided_by: 2
        assign pct = save_amount | times: 100 | plus: half | divided_by: compare
        assign save_txt = s.save_label | replace: '[monto]', save_amount_txt | replace: '[pct]', pct
        if bs.texto_ahorro != blank
          assign save_txt = bs.texto_ahorro | replace: '[monto]', save_amount_txt | replace: '[pct]', pct
        endif
        assign promo_txt = s.promo_label | replace: '[monto]', save_amount_txt | replace: '[pct]', pct
      endif

      assign total_txt = total | money_without_trailing_zeros
      assign tmp = total | times: transfer_mult | divided_by: 10000 | times: 100
      assign transfer_txt = tmp | money_without_trailing_zeros
      assign tmp = total | divided_by: cuotas | divided_by: 100 | times: 100
      assign cuota_txt = tmp | money_without_trailing_zeros

      assign slide = ''
      if bs.foto_numero > 0
        assign slide = bs.foto_numero | minus: 1
      endif
      if slide == '' and use_custom_gallery == false and v.featured_media != blank
        assign fm_s = v.featured_media.id | append: ''
        for img_id in image_ids
          if img_id == fm_s
            assign slide = forloop.index0
          endif
        endfor
      endif

      assign is_sel = false
      if block.id == sel_id
        assign is_sel = true
        assign sel_variant = v
        assign sel_qty = qty
        assign sel_price = total_txt
        assign sel_compare = compare_txt
        assign sel_promo = promo_txt
        assign sel_transfer = transfer_txt
        assign sel_cuota = cuota_txt
        assign sel_name = bs.titulo
      endif
    -%}
    <label
      class="hm-pack{% if is_sel %} is-selected{% endif %}{% unless v.available %} is-soldout{% endunless %}{% if bs.etiqueta != blank %} has-tag{% endif %}"
      data-hm-pack
      data-index="{{ pack_index }}"
      data-slide="{{ slide }}"
      data-variant-id="{{ v.id }}"
      data-qty="{{ qty }}"
      data-available="{{ v.available }}"
      data-price="{{ total_txt | escape }}"
      data-compare="{{ compare_txt | escape }}"
      data-promo="{{ promo_txt | escape }}"
      data-transfer="{{ transfer_txt | escape }}"
      data-cuota="{{ cuota_txt | escape }}"
      data-name="{{ bs.titulo | escape }}"
      {{ block.shopify_attributes }}
    >
      <input type="radio" name="hm-pack-{{ section.id }}" value="{{ v.id }}" class="hm-visually-hidden" {% if is_sel %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
      {%- if bs.etiqueta != blank -%}
        <span class="hm-pack__tag hm-pack__tag--{{ bs.etiqueta_color }}"{% if bs.etiqueta_color_libre != blank %} style="background: {{ bs.etiqueta_color_libre }}; color: {{ bs.etiqueta_texto_color | default: '#ffffff' }};"{% endif %}>{{ bs.etiqueta }}</span>
      {%- endif -%}
      <span class="hm-pack__info">
        <span class="hm-pack__title">{{ bs.titulo }}</span>
        {%- if save_txt != '' -%}
          <span class="hm-pack__save">{{ save_txt }}</span>
        {%- elsif bs.subtitulo != blank -%}
          <span class="hm-pack__sub">{{ bs.subtitulo }}</span>
        {%- endif -%}
        {%- if request.design_mode and total != variant_total -%}<span class="hm-pack__warn">⚠ Solo lo ves vos en el editor: en Shopify esta variante cuesta {{ variant_total | money_without_trailing_zeros }}. Se cobra ese precio: actualizalo en el producto.</span>{%- endif -%}
        {%- unless v.available -%}<span class="hm-pack__soldout">{{ s.soldout_label }}</span>{%- endunless -%}
      </span>
      <span class="hm-pack__img">
        {%- if bs.imagen != blank -%}
          {{ bs.imagen | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '96px', alt: bs.titulo }}
        {%- elsif v.featured_image != blank -%}
          {{ v.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '96px', alt: bs.titulo }}
        {%- elsif p.featured_image != blank -%}
          {{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '96px', alt: bs.titulo }}
        {%- endif -%}
      </span>
      <span class="hm-pack__price">
        <span class="hm-pack__now">{{ total_txt }}</span>
        {%- if compare_txt != '' -%}<s class="hm-pack__was">{{ compare_txt }}</s>{%- endif -%}
      </span>
    </label>
  {%- endfor -%}
{%- endcapture -%}

{%- capture overlay_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'beneficio_foto' -%}
      <div class="hm-gal__chip" {{ block.shopify_attributes }}>
        <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ block.settings.icono }}"/></svg>
        <span>{{ block.settings.texto }}</span>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture cards_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tarjeta' -%}
      {%- assign bs = block.settings -%}
      <div class="hm-card2" {{ block.shopify_attributes }}>
        <p class="hm-card2__title"><svg class="hm-icon hm-card2__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-check-circle"/></svg>{{ bs.titulo }}</p>
        <div class="hm-card2__body">
          <span class="hm-card2__img">
            {%- if bs.imagen != blank -%}
              {{ bs.imagen | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '56px', alt: '' }}
            {%- else -%}
              <svg class="hm-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><use href="#hmi-{{ bs.icono }}"/></svg>
            {%- endif -%}
          </span>
          <span class="hm-card2__text">
            {{ bs.texto }}
            {%- if bs.valor != blank -%}
              <span class="hm-card2__value"><s>{{ bs.valor }}</s> <strong>{{ bs.valor_texto }}</strong></span>
            {%- endif -%}
          </span>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- liquid
  assign hm_font = section.settings.fuente
  assign hm_font_stack = "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
  if hm_font != blank
    assign hm_font_stack = hm_font.family | prepend: "'" | append: "', " | append: hm_font.fallback_families
  endif
-%}
{%- if hm_font != blank -%}
  <style>
    {{ hm_font | font_face: font_display: 'swap' }}
    {%- assign hm_f = hm_font | font_modify: 'weight', '500' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
    {%- assign hm_f = hm_font | font_modify: 'weight', '600' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
    {%- assign hm_f = hm_font | font_modify: 'weight', '700' -%}{%- if hm_f -%}{{ hm_f | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}
<style>
/* =========================================================================
   DR.MEN · HAIR — Sistema de secciones de landing (prefijo hm-)
   Todas las clases van prefijadas con .hm- para no chocar con el theme.
   ========================================================================= */
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,800&family=Inter:wght@400;500;600;700&display=swap');

.hm {
  --hm-accent: #6b3fc0;
  --hm-accent-ink: #ffffff;
  --hm-accent-soft: var(--hm-a14);
  --hm-bg: #ffffff;
  --hm-fg: #121116;
  --hm-muted: #5d5a66;
  --hm-card: #f7f5fb;
  --hm-card-fg: var(--hm-fg);
  --hm-line: #e8e3f1;
  --hm-star: #f5b301;
  --hm-ok: #1f9d55;
  --hm-radius: 16px;
  --hm-radius-sm: 10px;
  --hm-shadow: 0 10px 30px rgba(20, 10, 40, .08);
  --hm-font-display: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --hm-font-body: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --hm-pt: 64px;
  --hm-pb: 64px;

  background: var(--hm-bg);
  color: var(--hm-fg);
  font-family: var(--hm-font-body);
  font-size: 16px;
  line-height: 1.55;
  padding-top: var(--hm-pt);
  padding-bottom: var(--hm-pb);
  position: relative;
  overflow-x: clip;
  -webkit-font-smoothing: antialiased;
}
.hm *, .hm *::before, .hm *::after { box-sizing: border-box; }
.hm [hidden] { display: none !important; }


/* Reset: evita que estilos genéricos del theme (h1, p, label, button, img...) rompan la sección */
.hm :where(h1, h2, h3, p, ul, li, label, summary, details, button, a, s, strong, span, small, input, em),
.hm-sticky :where(p, button, a, s, strong, span, small) {
  text-transform: none; letter-spacing: normal; font-family: inherit; line-height: inherit; box-shadow: none;
}
.hm :where(p) { margin: 0 0 .75em; }
.hm :where(p:last-child) { margin-bottom: 0; }
.hm :where(h1, h2, h3) { font-weight: 700; }
.hm :where(button), .hm-sticky :where(button) { min-width: 0; width: auto; }
.hm :where(label) { margin: 0; }
.hm :where(details, summary) { border: 0; background: none; padding: 0; margin: 0; }
.hm :where(ul) { list-style: none; margin: 0; padding: 0; }
.hm :where(a, s) { color: inherit; }
.hm :where(img, video, svg), .hm-sticky :where(img) { border-radius: 0; border: 0; max-width: 100%; display: block; }

/* ---------- Esquemas de color ---------- */
.hm--claro  { --hm-bg: #ffffff; --hm-fg: #121116; --hm-muted: #5d5a66; --hm-card: #f7f5fb; --hm-line: #e8e3f1; }
.hm--suave  { --hm-bg: #f4effc; --hm-fg: #121116; --hm-muted: #57536a; --hm-card: #ffffff; --hm-line: #e2d9f3; }
.hm--oscuro { --hm-bg: #0c0b10; --hm-fg: #ffffff; --hm-muted: #b8b2c6; --hm-card: #17141f; --hm-line: #2a2535; }
.hm--acento {
  --hm-bg: var(--hm-dark30);
  --hm-fg: #ffffff; --hm-muted: rgba(255,255,255,.78);
  --hm-card: rgba(255,255,255,.08); --hm-line: rgba(255,255,255,.16);
  background: radial-gradient(120% 120% at 100% 0%, var(--hm-dark55) 0%, var(--hm-bg) 60%);
}
.hm--oscuro, .hm--acento { --hm-accent-soft: var(--hm-a28); }

/* ---------- Layout ---------- */
.hm-container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 16px; }
.hm-container--narrow { max-width: 860px; }
@media (min-width: 750px) { .hm-container { padding: 0 32px; } }

.hm-head { text-align: center; max-width: 760px; margin: 0 auto 36px; }
.hm-head--left { text-align: left; margin-left: 0; }

/* ---------- Tipografía ---------- */
.hm-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font: 700 12px/1 var(--hm-font-body); letter-spacing: .14em; text-transform: uppercase;
  color: var(--hm-accent); background: var(--hm-accent-soft);
  padding: 8px 14px; border-radius: 999px; margin-bottom: 14px;
}
.hm--oscuro .hm-eyebrow, .hm--acento .hm-eyebrow { color: #fff; }
.hm-title {
  font-family: var(--hm-font-display); font-weight: 800; text-transform: uppercase;
  font-size: clamp(32px, 6.2vw, 56px); line-height: .98; letter-spacing: -.005em;
  margin: 0 0 14px; color: var(--hm-fg);
}
.hm-title em, .hm-title i { font-style: italic; color: var(--hm-accent); }
.hm--acento .hm-title em, .hm--acento .hm-title i { color: #d9c6ff; }
.hm-title--sm { font-size: clamp(28px, 4.6vw, 42px); }
.hm-sub { color: var(--hm-muted); font-size: clamp(15px, 1.6vw, 18px); margin: 0; }
.hm-sub p { margin: 0; }
.hm-small { font-size: 13px; color: var(--hm-muted); }
.hm-disclaimer { font-size: 12px; color: var(--hm-muted); text-align: center; max-width: 760px; margin: 22px auto 0; opacity: .85; }

/* ---------- Botones ---------- */
.hm-btn {
  --b-bg: var(--hm-btn-bg, var(--hm-accent)); --b-fg: var(--hm-btn-fg, var(--hm-accent-ink));
  appearance: none; border: 0; cursor: pointer; text-decoration: none;
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 54px; padding: 0 24px; border-radius: 10px;
  background: var(--b-bg); color: var(--b-fg);
  font: 600 16px/1.2 var(--hm-font-body); letter-spacing: 0;
  transition: filter .2s ease, transform .1s ease;
  position: relative; overflow: hidden;
}
.hm-btn:hover { filter: brightness(1.1); }
.hm-btn:active { transform: translateY(1px); }
.hm-btn--block { width: 100%; }
.hm-btn--dark { --b-bg: #0c0b10; --b-fg: #fff; }
.hm-btn--light { --b-bg: #fff; --b-fg: #0c0b10; }
.hm-btn--shine::after {
  content: ''; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255,255,255,.35), transparent);
  animation: hm-shine 3.2s ease-in-out infinite;
}
@keyframes hm-shine { 0%, 60% { left: -60%; } 100% { left: 130%; } }
.hm-btn[aria-busy="true"] { pointer-events: none; opacity: .8; }
.hm-btn[aria-busy="true"] .hm-btn__label { opacity: 0; }
.hm-btn[aria-busy="true"]::before {
  content: ''; position: absolute; width: 22px; height: 22px; border-radius: 50%;
  border: 3px solid currentColor; border-right-color: transparent; animation: hm-spin .7s linear infinite;
}
@keyframes hm-spin { to { transform: rotate(360deg); } }

.hm-cta { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 36px; text-align: center; }
.hm-cta .hm-btn { width: 100%; max-width: 420px; }
.hm-cta__note { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--hm-muted); }
.hm-cta__note svg { width: 16px; height: 16px; }

/* ---------- Íconos / estrellas ---------- */
.hm-icon { width: 22px; height: 22px; flex: none; }
.hm-stars { display: inline-flex; gap: 2px; color: var(--hm-star); }
.hm-stars svg { width: 16px; height: 16px; }
.hm-check { color: var(--hm-ok); }

/* ---------- Tarjetas ---------- */
.hm-card {
  background: var(--hm-card); color: var(--hm-card-fg);
  border: 1px solid var(--hm-line); border-radius: var(--hm-radius); padding: 22px;
}
.hm--claro .hm-card, .hm--suave .hm-card { box-shadow: var(--hm-shadow); }

/* ---------- Media ---------- */
.hm-media { position: relative; overflow: hidden; border-radius: var(--hm-radius); background: var(--hm-card); }
.hm-media img, .hm-media video, .hm-media svg { width: 100%; height: 100%; object-fit: cover; }
.hm-ph { width: 100%; height: 100%; background: #ece7f5; fill: #b9acd4; }
.hm--oscuro .hm-ph, .hm--acento .hm-ph { background: #221d2c; fill: #4a4160; }

/* ---------- Carrusel (scroll-snap) ---------- */
.hm-slider { position: relative; }
.hm-slider__track {
  display: grid; grid-auto-flow: column; grid-auto-columns: var(--hm-slide, 82%);
  gap: var(--hm-gap, 14px); overflow-x: auto; scroll-snap-type: x mandatory;
  scroll-behavior: smooth; overscroll-behavior-x: contain;
  padding: 4px 16px 18px; margin: 0 -16px; scrollbar-width: none;
  scroll-padding-inline: 16px;
}
.hm-slider__track::-webkit-scrollbar { display: none; }
.hm-slider__track > * { scroll-snap-align: start; min-width: 0; }
@media (min-width: 750px) {
  .hm-slider__track { padding: 4px 0 18px; margin: 0; scroll-padding-inline: 0; }
}
.hm-slider__nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 10px; }
.hm-slider__progress { width: 160px; height: 3px; border-radius: 3px; background: var(--hm-line); overflow: hidden; }
.hm-slider__bar { display: block; height: 100%; width: 20%; background: var(--hm-accent); border-radius: 3px; transition: transform .25s ease, width .25s ease; }
.hm-arrow {
  width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--hm-line);
  background: var(--hm-bg); color: var(--hm-fg); display: grid; place-items: center; cursor: pointer;
  transition: background .2s, color .2s, border-color .2s;
}
.hm-arrow:hover { background: var(--hm-accent); color: #fff; border-color: var(--hm-accent); }
.hm-arrow[disabled] { opacity: .35; pointer-events: none; }
.hm-arrow svg { width: 18px; height: 18px; }

/* ---------- Marquesina ---------- */
.hm-marquee { display: flex; overflow: hidden; user-select: none; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
.hm-marquee__group { display: flex; flex: none; gap: var(--hm-mq-gap, 40px); padding-right: var(--hm-mq-gap, 40px); animation: hm-marquee var(--hm-mq-speed, 30s) linear infinite; }
.hm-marquee:hover .hm-marquee__group { animation-play-state: paused; }
@keyframes hm-marquee { to { transform: translateX(-100%); } }

/* ---------- Animación de entrada ---------- */
.hm-reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s ease, transform .6s ease; }
.hm-reveal.is-in { opacity: 1; transform: none; }
.shopify-design-mode .hm-reveal { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  .hm-reveal { opacity: 1; transform: none; transition: none; }
  .hm-marquee__group, .hm-btn--shine::after { animation: none; }
}

.hm-visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

@media (max-width: 749px) {
  .hm { padding-top: calc(var(--hm-pt) * .72); padding-bottom: calc(var(--hm-pb) * .72); font-size: 15px; }
  .hm-head { margin-bottom: 26px; }
}

/* ===== Sección ===== */
  /* ---------- Layout ---------- */
  .hm-pdp__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .hm-pdp__media, .hm-pdp__info { min-width: 0; }
