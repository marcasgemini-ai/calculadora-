<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4zM16 9.5l5 5M21 9.5l-5 5"/></symbol><symbol id="hmi-sound-on" viewBox="0 0 24 24"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4zM16 9a4.2 4.2 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/></symbol><symbol id="hmi-play" viewBox="0 0 24 24"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"/></symbol><symbol id="hmi-hair" viewBox="0 0 24 24"><path d="M6 21c1-6 0-10-1-14M10 21c.5-6 0-11 2-17M14.5 21c-.5-5 .5-9 3.5-14M18.5 21c-.5-3 0-6 2-9"/></symbol><symbol id="hmi-stethoscope" viewBox="0 0 24 24"><path d="M5 3v5a5 5 0 0 0 10 0V3M10 13v2.5a5 5 0 0 0 10 0V13"/><circle cx="20" cy="11" r="2"/></symbol><symbol id="hmi-ban" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.2"/><path d="M5.5 5.5l13 13"/></symbol><symbol id="hmi-map-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.3-7-11.5a7 7 0 0 1 14 0C19 14.7 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></symbol><symbol id="hmi-percent" viewBox="0 0 24 24"><path d="M19 5L5 19"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/></symbol><symbol id="hmi-box" viewBox="0 0 24 24"><path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5zM3.5 7.5L12 12l8.5-4.5M12 12v9"/></symbol><symbol id="hmi-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></symbol><symbol id="hmi-moon" viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></symbol><symbol id="hmi-trend-up" viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8M15 7h6v6"/></symbol></defs></svg>

<style>
  /* ===== Reset: el theme no puede romper la sección ===== */
  .hm-tr, .hm-tr *, .hm-tr *::before, .hm-tr *::after { box-sizing: border-box; }
  .hm-tr :where(h2, p, span, strong, em, button, a, figure, figcaption, img, svg, ul, li) {
    margin: 0; padding: 0; border: 0; text-transform: none; letter-spacing: normal;
    font-family: inherit; line-height: inherit; box-shadow: none; background: none; color: inherit;
  }
  .hm-tr :where(img, svg) { display: block; max-width: 100%; border-radius: 0; }
  .hm-tr :where(button) { min-width: 0; width: auto; min-height: 0; cursor: pointer; }
  .hm-tr [hidden] { display: none !important; }

  .hm-tr {
    font-family: var(--tr-font); color: var(--tr-fg); background: var(--tr-bg);
    font-size: 16px; line-height: 1.5; -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  .hm-tr__wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 750px) { .hm-tr__wrap { padding: 0 32px; } }

  /* ===== Cinta de confianza ===== */
  .hm-tr__strip { background: var(--tr-strip-bg); color: var(--tr-strip-fg); padding: var(--tr-strip-py) 0; }
  .hm-tr__badges { display: grid; grid-template-columns: repeat(var(--tr-badges), minmax(0, 1fr)); gap: 16px; }
  .hm-tr__badge {
    display: flex; align-items: center; justify-content: center; gap: 10px; text-align: center;
    min-height: 48px; padding: 10px 14px; border: 1px solid var(--tr-strip-line); border-radius: 8px;
    font-size: 14px; font-weight: 600; line-height: 1.25; letter-spacing: .02em;
  }
  .hm-tr--upper .hm-tr__badge span { text-transform: uppercase; }
  .hm-tr__badge svg { width: 24px; height: 24px; flex: none; }
  .hm-tr__marquee { display: none; }
  @media (max-width: 749px) {
    .hm-tr--anim .hm-tr__badges { display: none; }
    .hm-tr--anim .hm-tr__marquee { display: flex; overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
    .hm-tr__group { display: flex; flex: none; gap: 10px; padding-right: 10px; animation: hm-tr-mq var(--tr-speed) linear infinite; }
    .hm-tr__group .hm-tr__badge { flex: none; min-height: 42px; padding: 8px 14px; font-size: 12.5px; white-space: nowrap; }
    .hm-tr__group .hm-tr__badge svg { width: 20px; height: 20px; }
    .hm-tr:not(.hm-tr--anim) .hm-tr__badges { grid-template-columns: 1fr; gap: 8px; }
    .hm-tr:not(.hm-tr--anim) .hm-tr__badge { justify-content: flex-start; font-size: 13px; min-height: 42px; }
  }
  @keyframes hm-tr-mq { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) { .hm-tr__group { animation: none; } }

  /* ===== Transformaciones ===== */
  .hm-tr__main { padding: var(--tr-pt) 0 var(--tr-pb); }
  .hm-tr__head { text-align: var(--tr-align); max-width: 1100px; margin: 0 auto 28px; }
  .hm-tr__eyebrow { display: inline-block; margin-bottom: 10px !important; font-size: 12px; font-weight: 700; letter-spacing: .12em !important; text-transform: uppercase !important; color: var(--tr-accent); }
  .hm-tr__title { font-size: var(--tr-title-m); font-weight: 600; line-height: 1.2; color: var(--tr-fg); }
  .hm-tr__title em { font-style: normal; color: var(--tr-accent); }
  .hm-tr__sub { margin-top: 10px !important; font-size: 15px; color: var(--tr-muted); }
  @media (min-width: 750px) { .hm-tr__title { font-size: var(--tr-title-d); } .hm-tr__sub { font-size: 16px; } }

  .hm-tr__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: var(--tr-slide-m);
    gap: var(--tr-gap); overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch;
    padding: 4px 16px 6px; margin: 0 -16px; scroll-padding-inline: 16px;
  }
  .hm-tr__track::-webkit-scrollbar { display: none; }
  @media (min-width: 750px) {
    .hm-tr__track { grid-auto-columns: calc((100% - (var(--tr-per) - 1) * var(--tr-gap)) / var(--tr-per)); padding: 4px 0 6px; margin: 0; scroll-padding-inline: 0; }
  }
  .hm-tr__slide { scroll-snap-align: start; min-width: 0; }
  .hm-tr__card { position: relative; overflow: hidden; border-radius: var(--tr-radius); background: var(--tr-card); box-shadow: var(--tr-shadow); }
  .hm-tr__img { position: relative; aspect-ratio: var(--tr-ratio); overflow: hidden; background: var(--tr-card); }
  .hm-tr__img img, .hm-tr__img svg { width: 100%; height: 100%; object-fit: cover; }
  .hm-tr__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--tr-card); }
  .hm-tr__label {
    position: absolute; z-index: 1; bottom: 10px; padding: 5px 10px; border-radius: 999px;
    font-size: 11.5px; font-weight: 700; line-height: 1; letter-spacing: .06em !important; text-transform: uppercase !important;
    background: rgba(18, 17, 22, .78); color: #fff;
  }
  .hm-tr__label--l { left: 10px; }
  .hm-tr__label--r { right: 10px; background: var(--tr-accent); }
  .hm-tr__cap { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 14px; font-size: 14px; }
  .hm-tr__cap strong { font-weight: 600; }
  .hm-tr__cap span { font-size: 12.5px; font-weight: 600; color: var(--tr-accent); white-space: nowrap; }
  .hm-tr__quote { padding: 0 14px 14px !important; font-size: 13.5px; color: var(--tr-muted); }

  /* Navegación */
  .hm-tr__nav { display: flex; flex-direction: column; align-items: center; gap: 18px; margin-top: 26px; }
  .hm-tr__progress { width: min(200px, 50%); height: 4px; border-radius: 4px; background: var(--tr-line); overflow: hidden; }
  .hm-tr__bar { display: block; height: 100%; width: 30%; border-radius: 4px; background: var(--tr-accent); transition: transform .25s ease, width .25s ease; }
  .hm-tr__arrows { display: flex; gap: 12px; }
  .hm-tr__arrow {
    width: 44px; height: 44px; border-radius: 50% !important; display: grid; place-items: center;
    background: #fff !important; color: #121116 !important; box-shadow: 0 2px 10px rgba(0, 0, 0, .1) !important;
    transition: background .2s, color .2s, opacity .2s;
  }
  .hm-tr__arrow svg { width: 18px; height: 18px; }
  .hm-tr__arrow:hover { background: var(--tr-accent) !important; color: #fff !important; }
  .hm-tr__arrow[disabled] { opacity: .35; pointer-events: none; }
  .hm-tr__nav[hidden] { display: none !important; }

  .hm-tr__disc { max-width: 760px; margin: 22px auto 0 !important; text-align: center; font-size: 12.5px; line-height: 1.5; color: var(--tr-muted); }

  .hm-tr__cta { display: flex; justify-content: center; margin-top: 24px; }
  .hm-tr__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 0 28px;
    border-radius: 8px; background: var(--tr-btn-bg); color: var(--tr-btn-fg) !important; font-size: 16px; font-weight: 600; text-decoration: none;
    transition: filter .2s;
  }
  .hm-tr__btn:hover { filter: brightness(1.1); }
  .hm-tr__btn svg { width: 18px; height: 18px; }
  @media (max-width: 749px) { .hm-tr__btn { width: 100%; } }
</style>

<section
  id="hm-tr-{{ section.id }}"
  class="hm-tr{% if s.mayusculas %} hm-tr--upper{% endif %}{% if s.animar_mobile %} hm-tr--anim{% endif %}"
  style="
    --tr-font: {{ hm_font_stack }};
    --tr-accent: {{ acc }};
    --tr-bg: {{ s.color_fondo }};
    --tr-fg: {{ s.color_texto }};
    --tr-muted: {{ s.color_texto | color_modify: 'alpha', 0.7 }};
    --tr-line: {{ s.color_texto | color_modify: 'alpha', 0.12 }};
    --tr-card: {{ s.color_tarjeta }};
    --tr-shadow: {% if s.sombra %}0 4px 14px rgba(0, 0, 0, .07){% else %}none{% endif %};
    --tr-strip-bg: {{ s.cinta_fondo }};
    --tr-strip-fg: {{ s.cinta_texto }};
    --tr-strip-line: {{ s.cinta_texto | color_modify: 'alpha', 0.45 }};
    --tr-strip-py: {{ s.cinta_espacio }}px;
    --tr-badges: {{ badge_count | at_least: 1 }};
    --tr-speed: {{ s.velocidad }}s;
    --tr-btn-bg: {{ s.color_boton | default: acc }};
    --tr-btn-fg: {{ s.color_boton_texto | default: '#ffffff' }};
    --tr-title-d: {{ s.titulo_desktop }}px;
    --tr-title-m: {{ s.titulo_mobile }}px;
    --tr-align: {{ s.alineacion }};
    --tr-per: {{ s.por_vista }};
    --tr-slide-m: {{ s.ancho_mobile }}%;
    --tr-gap: {{ s.separacion }}px;
    --tr-ratio: {{ s.proporcion }};
    --tr-radius: {{ s.bordes }}px;
    --tr-pt: {{ s.padding_top }}px;
    --tr-pb: {{ s.padding_bottom }}px;
  "
>
  {%- if s.mostrar_cinta and badge_count > 0 -%}
    {%- capture badges -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'insignia' -%}
          <span class="hm-tr__badge" {{ block.shopify_attributes }}>
            {%- if block.settings.imagen != blank -%}
              {{ block.settings.imagen | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32, 64', sizes: '24px', alt: '', style: 'width:24px;height:24px;object-fit:contain' }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#hmi-{{ block.settings.icono }}"/></svg>
            {%- endif -%}
            <span>{{ block.settings.texto }}</span>
          </span>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    <div class="hm-tr__strip">
      <div class="hm-tr__wrap">
        <div class="hm-tr__badges">{{ badges }}</div>
      </div>
      <div class="hm-tr__marquee" aria-hidden="true">
        <div class="hm-tr__group">{{ badges }}</div>
        <div class="hm-tr__group">{{ badges }}</div>
      </div>
    </div>
  {%- endif -%}

  <div class="hm-tr__main">
    <div class="hm-tr__wrap">
      {%- if s.eyebrow != blank or s.titulo != blank or s.subtitulo != blank -%}
        <div class="hm-tr__head">
          {%- if s.eyebrow != blank -%}<span class="hm-tr__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.titulo != blank -%}<h2 class="hm-tr__title">{{ s.titulo }}</h2>{%- endif -%}
          {%- if s.subtitulo != blank -%}<p class="hm-tr__sub">{{ s.subtitulo }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="hm-tr__slider" data-hm-tr-slider data-autoplay="{{ s.autoplay }}">
        <div class="hm-tr__track" data-hm-tr-track>
          {%- for block in section.blocks -%}
            {%- if block.type != 'transformacion' -%}{%- continue -%}{%- endif -%}
            {%- assign bs = block.settings -%}
            <div class="hm-tr__slide" {{ block.shopify_attributes }}>
              <figure class="hm-tr__card">
                {%- if bs.antes != blank and bs.despues != blank -%}
                  <div class="hm-tr__pair">
                    <div class="hm-tr__img">
                      {{ bs.antes | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 450, 600, 700', sizes: '(min-width: 990px) 17vw, 45vw', alt: bs.alt_antes }}
                      {%- if s.mostrar_etiquetas -%}<span class="hm-tr__label hm-tr__label--l">{{ s.label_antes }}</span>{%- endif -%}
                    </div>
                    <div class="hm-tr__img">
                      {{ bs.despues | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 450, 600, 700', sizes: '(min-width: 990px) 17vw, 45vw', alt: bs.alt_despues }}
                      {%- if s.mostrar_etiquetas -%}<span class="hm-tr__label hm-tr__label--r">{{ s.label_despues }}</span>{%- endif -%}
                    </div>
                  </div>
                {%- else -%}
                  <div class="hm-tr__img">
                    {%- assign one = bs.imagen | default: bs.antes | default: bs.despues -%}
                    {%- if one != blank -%}
                      {{ one | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 85vw', alt: bs.alt_antes }}
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag }}
                    {%- endif -%}
                    {%- if s.mostrar_etiquetas and bs.imagen != blank -%}
                      <span class="hm-tr__label hm-tr__label--l">{{ s.label_antes }}</span>
                      <span class="hm-tr__label hm-tr__label--r">{{ s.label_despues }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if bs.nombre != blank or bs.tiempo != blank -%}
                  <figcaption class="hm-tr__cap">
                    {%- if bs.nombre != blank -%}<strong>{{ bs.nombre }}</strong>{%- endif -%}
                    {%- if bs.tiempo != blank -%}<span>{{ bs.tiempo }}</span>{%- endif -%}
                  </figcaption>
                {%- endif -%}
                {%- if bs.comentario != blank -%}<p class="hm-tr__quote">{{ bs.comentario }}</p>{%- endif -%}
              </figure>
            </div>
          {%- endfor -%}
        </div>

        <div class="hm-tr__nav" data-hm-tr-nav>
          {%- if s.mostrar_barra -%}
            <div class="hm-tr__progress" aria-hidden="true"><span class="hm-tr__bar" data-hm-tr-bar></span></div>
          {%- endif -%}
          {%- if s.mostrar_flechas -%}
            <div class="hm-tr__arrows">
              <button type="button" class="hm-tr__arrow" data-hm-tr-prev aria-label="{{ s.label_anterior | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
              </button>
              <button type="button" class="hm-tr__arrow" data-hm-tr-next aria-label="{{ s.label_siguiente | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if s.boton_texto != blank -%}
        <div class="hm-tr__cta">
          <a class="hm-tr__btn" href="{{ s.boton_link | default: '#hm-comprar' }}">
            {{ s.boton_texto }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      {%- endif -%}

      {%- if s.aclaracion != blank -%}
        <p class="hm-tr__disc">{{ s.aclaracion }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    function initTr(root) {
      var slider = root.querySelector('[data-hm-tr-slider]');
      if (!slider || slider.dataset.ready) return;
      slider.dataset.ready = '1';
      var track = slider.querySelector('[data-hm-tr-track]');
      var prev = slider.querySelector('[data-hm-tr-prev]');
      var next = slider.querySelector('[data-hm-tr-next]');
      var bar = slider.querySelector('[data-hm-tr-bar]');
      var nav = slider.querySelector('[data-hm-tr-nav]');
      if (!track) return;

      function step() {
        var first = track.children[0];
        if (!first) return track.clientWidth;
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return first.getBoundingClientRect().width + gap;
      }
      function update() {
        var max = track.scrollWidth - track.clientWidth;
        var visible = track.scrollWidth > 0 ? Math.min(1, track.clientWidth / track.scrollWidth) : 1;
        var ratio = max > 0 ? track.scrollLeft / max : 0;
        if (bar) {
          var w = Math.max(visible * 100, 15);
          bar.style.width = w + '%';
          bar.style.transform = 'translateX(' + (ratio * (100 / w * 100 - 100)) + '%)';
        }
        if (prev) prev.disabled = track.scrollLeft <= 4;
        if (next) next.disabled = track.scrollLeft >= max - 4;
        if (nav) nav.hidden = max <= 4;
      }
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      var ticking = false;
      track.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () { ticking = false; update(); });
      }, { passive: true });
      window.addEventListener('resize', update);
      Array.prototype.forEach.call(track.querySelectorAll('img'), function (img) { if (!img.complete) img.addEventListener('load', update, { once: true }); });
      update();

      var autoplay = parseInt(slider.dataset.autoplay || '0', 10);
      if (autoplay > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var paused = false;
        slider.addEventListener('pointerenter', function () { paused = true; });
        slider.addEventListener('pointerleave', function () { paused = false; });
        track.addEventListener('touchstart', function () { paused = true; }, { passive: true });
        setInterval(function () {
          if (paused || document.hidden) return;
          var max = track.scrollWidth - track.clientWidth;
          if (track.scrollLeft >= max - 4) track.scrollTo({ left: 0, behavior: 'smooth' });
          else track.scrollBy({ left: step(), behavior: 'smooth' });
        }, autoplay * 1000);
      }
    }

    var root = document.getElementById('hm-tr-{{ section.id }}');
    if (root) initTr(root);

    if (!window.__hmTrEditor) {
      window.__hmTrEditor = true;
      document.addEventListener('shopify:section:load', function (e) {
        var r = e.target.querySelector('.hm-tr');
        if (r) initTr(r);
      });
      document.addEventListener('shopify:block:select', function (e) {
        var slide = e.target;
        var track = slide && slide.parentElement;
        if (track && track.hasAttribute('data-hm-tr-track')) track.scrollTo({ left: slide.offsetLeft - track.offsetLeft, behavior: 'smooth' });
      });
    }
  })();
</script>

