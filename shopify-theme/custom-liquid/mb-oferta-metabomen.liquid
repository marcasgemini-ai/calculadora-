{%- comment -%}
  DR.MEN · Selector de packs METABOMEN + upsell MULTIMAGNESIO (misma oferta que HAIR / Bronzer)
  Pegar en: bloque "Liquid (oferta)" de MB · Compra (Liquid), o Agregar bloque > Liquid personalizado.
  - Packs: agregan 1, 2 o 3 unidades de METABOMEN. Los precios de los packs los cobra Shopify con
    descuentos automáticos (ver README: "Descuentos para los packs").
  - Upsell: producto MULTIMAGNESIO (handle abajo). Precio y precio tachado salen del producto, sin descuento.
{%- endcomment -%}
{%- assign hm_up_handle = 'super-magnesio-13-upsell' -%}
{%- assign hm_up_nombre = 'Multimagnesio' -%}
{%- assign hm_up_beneficio_1 = 'Mejor descanso, menos estrés' -%}
{%- assign hm_up_beneficio_2 = 'Más energía, menos calambres' -%}
{%- assign hm_variant = product.selected_or_first_available_variant -%}
{%- assign hm_up = all_products[hm_up_handle] -%}
{%- assign hm_up_variant = hm_up.selected_or_first_available_variant -%}
{%- liquid
  assign hm_up_price = hm_up_variant.price | divided_by: 100
  assign hm_up_save = 0
  assign hm_up_pct = 0
  if hm_up_variant.compare_at_price > hm_up_variant.price
    assign hm_up_save = hm_up_variant.compare_at_price | minus: hm_up_variant.price | divided_by: 100
    assign hm_up_pct = hm_up_variant.compare_at_price | minus: hm_up_variant.price | times: 100 | divided_by: hm_up_variant.compare_at_price
  endif
-%}

<div class="hm-of" id="hm-offer" data-variant="{{ hm_variant.id }}" data-cart-add="{{ routes.cart_add_url }}.js" data-cart="{{ routes.cart_url }}" data-root="{{ routes.root_url }}" data-upsell="{{ hm_up_handle }}">
  <div class="hm-of-head"><span>Envío a todo el país + 3 cuotas sin interés</span></div>

  <label class="hm-of-bar">
    <input type="radio" name="hm-of-pack" value="1" data-save="0" data-total="59900">
    <span class="hm-of-radio"></span>
    <span class="hm-of-info">
      <span class="hm-of-title">1 frasco <span class="hm-of-tag">33% OFF</span></span>
      <span class="hm-of-sub">30 días de tratamiento</span>
    </span>
    <span class="hm-of-prices">
      <span class="hm-of-price">$59.900</span>
      <s class="hm-of-compare">$89.850</s>
    </span>
  </label>

  <label class="hm-of-bar">
    <span class="hm-of-badge">Más comprado</span>
    <input type="radio" name="hm-of-pack" value="2" data-save="97990" data-total="97990">
    <span class="hm-of-radio"></span>
    <span class="hm-of-info">
      <span class="hm-of-title">2 frascos <span class="hm-of-tag">50% OFF</span></span>
      <span class="hm-of-sub">60 días de tratamiento</span>
    </span>
    <span class="hm-of-prices">
      <span class="hm-of-price">$97.990</span>
      <s class="hm-of-compare">$195.980</s>
    </span>
  </label>

  <label class="hm-of-bar is-active">
    <span class="hm-of-badge hm-of-badge--hot">🔥 Descuento Exclusivo solo por hoy</span>
    <input type="radio" name="hm-of-pack" value="3" data-save="59900" data-total="119800" checked>
    <span class="hm-of-radio"></span>
    <span class="hm-of-info">
      <span class="hm-of-title">3 frascos <span class="hm-of-tag">3x2</span></span>
      <span class="hm-of-sub">90 días de tratamiento</span>
    </span>
    <span class="hm-of-prices">
      <span class="hm-of-price">$119.800</span>
      <s class="hm-of-compare">$179.700</s>
    </span>
  </label>

  <label class="hm-of-upsell"{% unless hm_up_variant.available %} hidden{% endunless %}>
    <span class="hm-of-up-badge">Sumalo a tu pedido</span>
    <input type="checkbox" id="hm-of-upsell" value="{% if hm_up_variant.available %}{{ hm_up_variant.id }}{% endif %}" data-save="{{ hm_up_save }}" data-total="{{ hm_up_price }}">
    <span class="hm-of-check"></span>
    <span class="hm-of-up-img" data-hm-up-img>
      {%- if hm_up.featured_image != blank -%}
        {{ hm_up.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '64px', alt: hm_up_nombre }}
      {%- endif -%}
    </span>
    <span class="hm-of-up-info">
      <span class="hm-of-up-title">{{ hm_up_nombre }}<span class="hm-of-tag" data-hm-up-pct{% if hm_up_pct == 0 %} hidden{% endif %}>{{ hm_up_pct }}% OFF</span></span>
      <span class="hm-of-up-ben"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{ hm_up_beneficio_1 }}</span>
      <span class="hm-of-up-ben"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{{ hm_up_beneficio_2 }}</span>
    </span>
    <span class="hm-of-prices">
      <span class="hm-of-up-price" data-hm-up-price>{{ hm_up_variant.price | money_without_trailing_zeros }}</span>
      <s class="hm-of-compare" data-hm-up-compare{% if hm_up_pct == 0 %} hidden{% endif %}>{{ hm_up_variant.compare_at_price | money_without_trailing_zeros }}</s>
    </span>
  </label>

  <div class="hm-of-save">→ Estás ahorrando <strong data-hm-save>$59.900</strong> en este pedido</div>

  <button type="button" class="hm-of-btn"><span data-hm-btn-label>Agregar al carrito</span><span class="hm-of-btn-total" data-hm-total></span></button>
  <p class="hm-of-msg" data-hm-msg role="alert" hidden></p>

</div>

<style>
  .hm-of{--of-ink:#141517;--of-accent:#E1261C;--of-soft:#fde4e2;--of-cream:#fdf3f2;--of-line:#e2ddd4;
    width:100%;max-width:100%;margin:14px 0;padding:0;background:transparent;overflow:visible;
    color:var(--of-ink);font-family:inherit;line-height:1.3;letter-spacing:0;box-sizing:border-box}
  .hm-of *,.hm-of *:before,.hm-of *:after{box-sizing:border-box;letter-spacing:0}
  .hm-of span,.hm-of strong,.hm-of b,.hm-of s,.hm-of p{color:inherit;text-transform:none;margin:0}
  .hm-of .hm-of-head{display:flex;align-items:center;gap:10px;margin:0 0 16px;font-size:14px;font-weight:600;white-space:nowrap}
  .hm-of .hm-of-head:before,.hm-of .hm-of-head:after{content:"";flex:1;height:1px;background:var(--of-line)}
  .hm-of .hm-of-bar{position:relative;display:flex;align-items:center;gap:12px;width:100%;margin:0 0 14px;padding:16px 18px;
    background:#fff;border:1.5px solid var(--of-line);border-radius:12px;cursor:pointer;
    transition:border-color .2s,box-shadow .2s;-webkit-tap-highlight-color:transparent}
  .hm-of .hm-of-bar.is-active{border:2px solid var(--of-ink);box-shadow:0 2px 12px rgba(20,21,23,.12)}
  .hm-of input{position:absolute;opacity:0;width:1px;height:1px;margin:0;pointer-events:none}
  .hm-of .hm-of-radio{flex:0 0 20px;width:20px;height:20px;border:2px solid #b5bcc3;border-radius:50%;position:relative}
  .hm-of .hm-of-bar.is-active .hm-of-radio{border-color:var(--of-ink)}
  .hm-of .hm-of-bar.is-active .hm-of-radio:after{content:"";position:absolute;inset:3px;border-radius:50%;background:var(--of-ink)}
  .hm-of .hm-of-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .hm-of .hm-of-title{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:17px;font-weight:700}
  .hm-of .hm-of-sub{font-size:13px;opacity:.7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .hm-of .hm-of-tag{background:var(--of-soft);color:var(--of-accent);font-size:12px;font-weight:700;padding:2px 8px;border-radius:6px;white-space:nowrap}
  .hm-of .hm-of-prices{display:flex;flex-direction:column;align-items:flex-end;white-space:nowrap}
  .hm-of .hm-of-price{font-size:18px;font-weight:700}
  .hm-of .hm-of-compare{font-size:13px;opacity:.55}
  .hm-of .hm-of-msg[hidden],.hm-of [hidden]{display:none !important}
  .hm-of .hm-of-badge{position:absolute;top:-11px;right:14px;background:var(--of-ink);color:#fff;font-size:12px;font-weight:700;
    padding:3px 10px;border-radius:6px;line-height:1.3}
  .hm-of .hm-of-badge--hot{background:var(--of-accent)}
  .hm-of .hm-of-upsell{position:relative;display:flex;align-items:center;gap:12px;width:100%;margin:6px 0 12px;padding:16px 16px 14px;
    background:var(--of-cream);border:1.5px dashed #f0a49e;border-radius:12px;cursor:pointer;font-size:14px;-webkit-tap-highlight-color:transparent;
    transition:border-color .2s,background .2s}
  .hm-of .hm-of-upsell:has(input:checked){border-style:solid;border-color:var(--of-accent);background:#fff}
  .hm-of .hm-of-up-badge{position:absolute;top:-11px;left:14px;background:var(--of-accent);color:#fff;font-size:12px;font-weight:700;
    padding:3px 10px;border-radius:6px;line-height:1.3}
  .hm-of .hm-of-check{flex:0 0 20px;width:20px;height:20px;border:2px solid var(--of-ink);border-radius:5px;position:relative;background:#fff}
  .hm-of .hm-of-upsell input:checked + .hm-of-check{background:var(--of-ink)}
  .hm-of .hm-of-upsell input:checked + .hm-of-check:after{content:"";position:absolute;left:5px;top:1px;width:5px;height:10px;
    border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}
  .hm-of .hm-of-up-img{flex:0 0 64px;width:64px;height:64px;border-radius:10px;background:#fff;border:1px solid var(--of-line);overflow:hidden;display:flex;align-items:center;justify-content:center}
  .hm-of .hm-of-up-img:empty{display:none}
  .hm-of .hm-of-up-img img{display:block;width:100%;height:100%;object-fit:contain;margin:0;border:0;border-radius:0;max-width:none}
  .hm-of .hm-of-up-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
  .hm-of .hm-of-up-title{display:flex;align-items:center;flex-wrap:wrap;gap:6px;font-size:15px;font-weight:700;line-height:1.25}
  .hm-of .hm-of-up-ben{display:flex;align-items:flex-start;gap:5px;font-size:12.5px;line-height:1.3;opacity:.8}
  .hm-of .hm-of-up-ben svg{flex:0 0 14px;width:14px;height:14px;margin-top:1px;fill:none;stroke:var(--of-accent);stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
  .hm-of .hm-of-up-price{font-size:16px;font-weight:700;white-space:nowrap}
  .hm-of .hm-of-save{margin:0 0 12px;padding:10px 14px;border:1px solid var(--of-line);border-radius:10px;font-size:14px;text-align:center}
  .hm-of .hm-of-save strong{color:var(--of-accent)}
  .hm-of .hm-of-btn{display:block;width:100%;min-height:54px;margin:0;padding:16px;background:var(--of-ink);color:#fff;
    border:0;border-radius:10px;font-family:inherit;font-size:17px;font-weight:700;text-transform:none;letter-spacing:0;line-height:1.2;
    cursor:pointer;-webkit-appearance:none;appearance:none;transition:opacity .2s;box-shadow:none}
  .hm-of .hm-of-btn span{color:inherit}
  .hm-of .hm-of-btn:hover{opacity:.9}
  .hm-of .hm-of-btn:disabled{opacity:.6;cursor:wait}
  .hm-of .hm-of-btn-total{font-weight:600;opacity:.85}
  .hm-of .hm-of-btn-total:not(:empty):before{content:" · "}
  .hm-of .hm-of-msg{margin:8px 0 0;font-size:13px;color:#c0392b;text-align:center}
  @media (max-width:749px){
    .hm-of .hm-of-bar{padding:14px 14px;gap:10px}
    .hm-of .hm-of-title{font-size:16px;gap:6px}
    .hm-of .hm-of-sub{font-size:12px}
    .hm-of .hm-of-price{font-size:17px}
    .hm-of .hm-of-compare{font-size:12px}
    .hm-of .hm-of-upsell{padding:15px 12px 13px;gap:10px}
    .hm-of .hm-of-up-img{flex-basis:56px;width:56px;height:56px}
    .hm-of .hm-of-up-title{font-size:14px}
    .hm-of .hm-of-up-ben{font-size:12px}
    .hm-of .hm-of-save{font-size:13px;padding:9px 10px}
  }
</style>

<script>
(function(){
  var root = document.getElementById('hm-offer');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';

  var up = document.getElementById('hm-of-upsell');
  var btn = root.querySelector('.hm-of-btn');
  var label = root.querySelector('[data-hm-btn-label]');
  var totalEl = root.querySelector('[data-hm-total]');
  var saveEl = root.querySelector('[data-hm-save]');
  var msg = root.querySelector('[data-hm-msg]');
  var base = (root.dataset.root || '/').replace(/\/$/, '');
  var busy = false;
  var fmt = function(n){ return '$' + String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };

  /* ---------- Precios, ahorro y total en el botón ---------- */
  function update(){
    var save = 0, total = 0;
    root.querySelectorAll('.hm-of-bar').forEach(function(bar){
      var input = bar.querySelector('input');
      bar.classList.toggle('is-active', input.checked);
      if (input.checked) { save += Number(input.dataset.save); total += Number(input.dataset.total); }
    });
    if (up && up.value && up.checked) { save += Number(up.dataset.save); total += Number(up.dataset.total); }
    saveEl.textContent = fmt(save);
    saveEl.parentNode.hidden = save <= 0;
    totalEl.textContent = fmt(total);
  }
  root.addEventListener('change', update);
  update();

  /* ---------- Upsell MULTIMAGNESIO (si el theme no lo trae por Liquid, se busca por handle) ---------- */
  if (up && !up.value) {
    fetch(base + '/products/' + root.dataset.upsell + '.js')
      .then(function(r){ if (!r.ok) throw new Error('Upsell no encontrado'); return r.json(); })
      .then(function(prod){
        var v = prod.variants.filter(function(x){ return x.available; })[0];
        if (!v) return;
        up.value = v.id;
        up.dataset.total = v.price / 100;
        up.dataset.save = v.compare_at_price > v.price ? (v.compare_at_price - v.price) / 100 : 0;
        root.querySelector('[data-hm-up-price]').textContent = fmt(v.price / 100);
        if (v.compare_at_price > v.price) {
          var pct = root.querySelector('[data-hm-up-pct]');
          pct.textContent = Math.floor((v.compare_at_price - v.price) * 100 / v.compare_at_price) + '% OFF';
          pct.hidden = false;
          var cmp = root.querySelector('[data-hm-up-compare]');
          cmp.textContent = fmt(v.compare_at_price / 100);
          cmp.hidden = false;
        }
        var box = root.querySelector('[data-hm-up-img]');
        var src = prod.featured_image || (prod.images && prod.images[0]);
        if (box && !box.children.length && src) {
          var img = document.createElement('img');
          img.src = (src.indexOf('//') === 0 ? 'https:' + src : src) + (src.indexOf('?') > -1 ? '&' : '?') + 'width=200';
          img.alt = prod.title; img.loading = 'lazy';
          box.appendChild(img);
        }
        up.closest('.hm-of-upsell').hidden = false;
        update();
      })
      .catch(function(e){ console.warn('[MB offer]', e); });
  }

  /* ---------- Botón ---------- */
  function setIdle(){
    busy = false;
    btn.disabled = false;
    btn.classList.remove('is-done');
    label.textContent = 'Agregar al carrito';
    update();
  }
  function showError(text){
    msg.textContent = text;
    msg.hidden = false;
    setTimeout(function(){ msg.hidden = true; }, 5000);
  }
  // Si vuelven con el botón "atrás" del navegador, el botón queda usable
  window.addEventListener('pageshow', setIdle);

  /* ---------- Carrito lateral (Dawn y temas basados en Dawn) ---------- */
  function getDrawer(){
    var d = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
    return d && typeof d.renderContents === 'function' ? d : null;
  }

  function openOtherDrawers(){
    // Otros temas: eventos habituales para refrescar y abrir el carrito lateral
    ['cart:refresh', 'cart:build', 'cart:open', 'theme:cart:reload', 'theme:cart:open', 'ajaxProduct:added', 'dispatch:cart-drawer:refresh', 'dispatch:cart-drawer:open']
      .forEach(function(name){ document.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { open: true } })); });
    var trigger = document.querySelector('[data-cart-drawer-toggle], [data-drawer-toggle="cart"], .js-drawer-open-cart, [data-action="open-cart"], #cart-icon-bubble, a.header__icon--cart');
    if (trigger) { trigger.click(); return true; }
    return false;
  }

  btn.addEventListener('click', function(){
    if (busy) return;
    var sel = root.querySelector('input[name="hm-of-pack"]:checked');
    if (!sel) return;
    busy = true;
    btn.disabled = true;
    msg.hidden = true;
    label.textContent = 'Agregando...';
    totalEl.textContent = '';

    var items = [{ id: Number(root.dataset.variant), quantity: Number(sel.value) }];
    if (up && up.value && up.checked) items.push({ id: Number(up.value), quantity: 1 });

    var drawer = getDrawer();
    var body = { items: items };
    if (drawer && drawer.getSectionsToRender) {
      body.sections = drawer.getSectionsToRender().map(function(s){ return s.id; });
      body.sections_url = window.location.pathname;
    }

    fetch(root.dataset.cartAdd, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    })
    .then(function(r){
      return r.json().then(function(data){
        if (!r.ok || data.status) throw new Error();
        return data;
      });
    })
    .then(function(data){
      label.textContent = '✓ Agregado';
      btn.classList.add('is-done');
      setTimeout(setIdle, 1800);

      if (drawer && data.sections) {
        drawer.classList.remove('is-empty');
        drawer.renderContents(data);
        return;
      }
      if (!openOtherDrawers()) window.location.href = root.dataset.cart;
    })
    .catch(function(){
      setIdle();
      showError('No pudimos agregar el producto. Probá de nuevo.');
    });
  });
})();
</script>
