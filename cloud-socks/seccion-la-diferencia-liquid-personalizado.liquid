{% comment %}
  SUAVELAND · CLOUD SOCKS · SECCIÓN "LA DIFERENCIA"
  Para el bloque "Liquid personalizado".
  - 1 imagen cuadrada (1:1)
  - Fondo claro, tipografía negra, hereda las fuentes del theme
  - Pegá los enlaces de Contenido → Archivos entre las comillas
{% endcomment %}

{%- assign sl_imagen = 'https://cdn.shopify.com/s/files/1/0838/4738/1165/files/ChatGPT_Image_26_sept_2026_03_57_53_p.m..png?v=1790454727' -%}
{%- assign sl_icono_1 = 'https://cdn.shopify.com/s/files/1/0838/4738/1165/files/pie.png?v=1790542108' -%}
{%- assign sl_icono_2 = 'https://cdn.shopify.com/s/files/1/0838/4738/1165/files/ventoso.png?v=1790542108' -%}
{%- assign sl_icono_3 = 'https://cdn.shopify.com/s/files/1/0838/4738/1165/files/pie_1.png?v=1790542108' -%}
{%- assign sl_boton_link = '#' -%}

<section class="sl-dif">
  <div class="sl-dif__container">

    {%- if sl_imagen != blank -%}
      <div class="sl-dif__media">
        <img src="{{ sl_imagen }}" alt="Cloud Socks™" loading="lazy" width="1200" height="1200">
      </div>
    {%- endif -%}

    <div class="sl-dif__content">
      <p class="sl-dif__eyebrow">La diferencia</p>

      <h2 class="sl-dif__title">¿Por qué seguimos usando medias que incomodan?</h2>

      <p class="sl-dif__description">
        Estamos acostumbrados a que una media apriete, acumule humedad y termine resultando incómoda.
        <strong>Cloud Socks™</strong> fue creada para cambiar esa experiencia.
      </p>

      <ul class="sl-dif__benefits" role="list">
        <li class="sl-dif__benefit">
          <span class="sl-dif__icon">{%- if sl_icono_1 != blank -%}<img src="{{ sl_icono_1 }}" alt="" loading="lazy" width="28" height="28">{%- endif -%}</span>
          <span>Dedos más libres y sin sensación de presión.</span>
        </li>
        <li class="sl-dif__benefit">
          <span class="sl-dif__icon">{%- if sl_icono_2 != blank -%}<img src="{{ sl_icono_2 }}" alt="" loading="lazy" width="28" height="28">{%- endif -%}</span>
          <span>Pies más secos y frescos durante todo el día.</span>
        </li>
        <li class="sl-dif__benefit">
          <span class="sl-dif__icon">{%- if sl_icono_3 != blank -%}<img src="{{ sl_icono_3 }}" alt="" loading="lazy" width="28" height="28">{%- endif -%}</span>
          <span>Más comodidad desde que te las ponés.</span>
        </li>
      </ul>

      <a href="{{ sl_boton_link }}" class="sl-dif__button">Quiero probar Cloud Socks™</a>
    </div>

  </div>
</section>

<style>
  .sl-dif { --sl-fondo: #FAF8F5; --sl-texto: #111111; --sl-suave: #5A5A5A; --sl-linea: rgba(17,17,17,.08);
    width: 100%; margin: 0; padding: 72px 0; background: var(--sl-fondo); color: var(--sl-texto); font-family: inherit; }
  .sl-dif, .sl-dif * { box-sizing: border-box; }

  .sl-dif__container { max-width: 1180px; margin: 0 auto; padding: 0 32px;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); align-items: center; gap: 72px; }

  /* IMAGEN */
  .sl-dif__media { width: 100%; aspect-ratio: 1 / 1; border-radius: 24px; overflow: hidden; background: #EFEAE3; }
  .sl-dif__media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* CONTENIDO */
  .sl-dif__content { max-width: 500px; }
  .sl-dif__eyebrow { margin: 0 0 14px; font-size: 12px; font-weight: 500; letter-spacing: .16em;
    text-transform: uppercase; color: var(--sl-suave); }
  .sl-dif__title { margin: 0 0 18px; font-family: var(--font-heading-family, inherit); font-weight: var(--font-heading-weight, 600);
    font-size: clamp(30px, 3.2vw, 46px); line-height: 1.08; letter-spacing: -.025em; color: var(--sl-texto); }
  .sl-dif__description { margin: 0 0 28px; font-size: 17px; line-height: 1.6; color: var(--sl-suave); }
  .sl-dif__description strong { color: var(--sl-texto); font-weight: 600; }

  /* BENEFICIOS */
  .sl-dif__benefits { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--sl-linea); }
  .sl-dif__benefit { display: flex; align-items: center; gap: 14px; margin: 0; padding: 14px 0;
    border-bottom: 1px solid var(--sl-linea); font-size: 15.5px; line-height: 1.4; color: var(--sl-texto); }
  .sl-dif__icon { flex: 0 0 26px; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; }
  .sl-dif__icon img { width: 100%; height: 100%; object-fit: contain; display: block; }

  /* BOTÓN */
  .sl-dif__button { display: inline-flex; align-items: center; justify-content: center; margin-top: 30px;
    min-height: 52px; padding: 0 32px; border-radius: 999px; background: var(--sl-texto); color: #FFFFFF;
    text-decoration: none; font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; transition: transform .2s ease, opacity .2s ease; }
  .sl-dif__button:hover { opacity: .88; transform: translateY(-1px); }

  /* TABLET */
  @media screen and (min-width: 750px) and (max-width: 999px) {
    .sl-dif__container { gap: 40px; padding: 0 24px; }
    .sl-dif__title { font-size: 34px; }
  }

  /* MOBILE */
  @media screen and (max-width: 749px) {
    .sl-dif { padding: 44px 0; }
    .sl-dif__container { display: flex; flex-direction: column; align-items: stretch; gap: 28px; padding: 0 18px; }
    .sl-dif__media { border-radius: 18px; }
    .sl-dif__content { max-width: 100%; }
    .sl-dif__eyebrow { font-size: 11px; margin-bottom: 10px; }
    .sl-dif__title { font-size: 29px; line-height: 1.1; margin-bottom: 14px; }
    .sl-dif__description { font-size: 15.5px; line-height: 1.55; margin-bottom: 22px; }
    .sl-dif__benefit { font-size: 14.5px; gap: 12px; padding: 12px 0; }
    .sl-dif__icon { flex-basis: 24px; width: 24px; height: 24px; }
    .sl-dif__button { width: 100%; margin-top: 24px; min-height: 52px; font-size: 12px; }
  }
</style>
