{%- comment -%}
  Cloud Socks · Sección "¿Son para vos?"
  Grilla de beneficios con íconos, editable desde el personalizador de Shopify.
  Celular: 2 columnas · Computadora: 2, 3 o 4 columnas (configurable).
{%- endcomment -%}

{%- if section.settings.usar_poppins -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #cs-benef-{{ section.id }} {
    background: {% if section.settings.fondo_transparente %}transparent{% else %}{{ section.settings.color_fondo }}{% endif %};
    color: {{ section.settings.color_texto }};
    padding: {{ section.settings.padding_mobile }}px 16px;
    text-align: center;
    {% if section.settings.usar_poppins %}font-family: 'Poppins', sans-serif;{% endif %}
  }
  #cs-benef-{{ section.id }} .cs-wrap { max-width: 1120px; margin: 0 auto; }
  #cs-benef-{{ section.id }} .cs-titulo {
    font-family: inherit; font-weight: 700; color: inherit; margin: 0;
    font-size: clamp(30px, 8vw, 56px); line-height: 1.1; letter-spacing: -0.02em;
  }
  #cs-benef-{{ section.id }} .cs-sub {
    font-size: clamp(16px, 4vw, 24px); line-height: 1.4; margin: 10px 0 0; opacity: .85;
  }
  #cs-benef-{{ section.id }} .cs-grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px; margin: 28px 0 0; padding: 0; list-style: none;
  }
  #cs-benef-{{ section.id }} .cs-card {
    background: {{ section.settings.color_tarjeta }};
    color: {{ section.settings.color_tarjeta_texto }};
    border-radius: {{ section.settings.radio }}px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 12px; padding: 22px 12px; min-height: 160px; margin: 0;
  }
  #cs-benef-{{ section.id }} .cs-icono { width: 44px; height: 44px; flex-shrink: 0; }
  #cs-benef-{{ section.id }} .cs-icono svg {
    width: 100%; height: 100%; display: block;
    fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
  }
  #cs-benef-{{ section.id }} .cs-icono img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #cs-benef-{{ section.id }} .cs-card p {
    margin: 0; color: inherit; font-family: inherit; font-weight: 600;
    font-size: 15px; line-height: 1.3; text-wrap: balance;
  }
  #cs-benef-{{ section.id }} .cs-pie { font-size: 14px; margin: 24px 0 0; opacity: .85; }
  #cs-benef-{{ section.id }} .cs-pie p { margin: 0; }
  #cs-benef-{{ section.id }} .cs-pie a { color: inherit; text-decoration: underline; }

  @media screen and (min-width: 750px) {
    #cs-benef-{{ section.id }} { padding: {{ section.settings.padding_desktop }}px 24px; }
    #cs-benef-{{ section.id }} .cs-grid {
      grid-template-columns: repeat({{ section.settings.columnas_desktop }}, minmax(0, 1fr));
      gap: 24px; margin-top: 44px;
    }
    #cs-benef-{{ section.id }} .cs-card { min-height: 200px; padding: 28px 24px; gap: 16px; }
    #cs-benef-{{ section.id }} .cs-icono { width: 60px; height: 60px; }
    #cs-benef-{{ section.id }} .cs-card p { font-size: 20px; }
    #cs-benef-{{ section.id }} .cs-pie { font-size: 18px; margin-top: 36px; }
  }
</style>

<div id="cs-benef-{{ section.id }}" class="cs-beneficios">
  <div class="cs-wrap">
    {%- if section.settings.titulo != blank -%}
      <h2 class="cs-titulo">{{ section.settings.titulo | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitulo != blank -%}
      <p class="cs-sub">{{ section.settings.subtitulo | escape }}</p>
    {%- endif -%}

    <ul class="cs-grid" role="list">
      {%- for block in section.blocks -%}
        <li class="cs-card" {{ block.shopify_attributes }}>
          <div class="cs-icono">
            {%- if block.settings.icono_imagen != blank -%}
              {{ block.settings.icono_imagen | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- case block.settings.icono -%}
                {%- when 'dedos' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M8 8h48M8 8l4-3.5M8 8l4 3.5M56 8l-4-3.5M56 8l-4 3.5"/><path d="M26 60c-6 0-8.5-7-8-14.5.4-7 2.5-10.5 2.5-15 0-3.5 2.5-5.5 6-5.5h11c4.5 0 7 2.5 7 7 0 5 2 9.5 2 16.5 0 7.5-4 11.5-10 11.5z"/><circle cx="41" cy="19" r="4.6"/><circle cx="31" cy="17.5" r="3.3"/><circle cx="23.5" cy="19.5" r="2.9"/><circle cx="17" cy="23.5" r="2.5"/><circle cx="12" cy="29" r="2.1"/></svg>
                {%- when 'ampollas' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><g transform="rotate(45 32 32)"><rect x="11" y="25" width="42" height="14" rx="7"/><path d="M25 25v14M39 25v14"/><circle cx="30" cy="30" r=".6" fill="currentColor"/><circle cx="34" cy="34" r=".6" fill="currentColor"/><circle cx="34" cy="30" r=".6" fill="currentColor"/><circle cx="30" cy="34" r=".6" fill="currentColor"/></g><circle cx="32" cy="32" r="27"/><path d="M13 51L51 13"/></svg>
                {%- when 'secos' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M24 10s-13 16-13 26a13 13 0 0 0 26 0c0-10-13-26-13-26z"/><path d="M18 37a6 6 0 0 0 6 6"/><path d="M42 22h11a4 4 0 1 0-4-4M42 32h16M42 42h11a4 4 0 1 1-4 4"/></svg>
                {%- when 'olor' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M23 47c-4-4 4-8 0-12s4-8 0-12"/><path d="M32 47c-4-4 4-8 0-12s4-8 0-12"/><path d="M41 47c-4-4 4-8 0-12s4-8 0-12"/><circle cx="32" cy="32" r="27"/><path d="M13 13l38 38"/></svg>
                {%- when 'nube' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M19 47h27a10 10 0 0 0 1-20 14 14 0 0 0-27-3 11.5 11.5 0 0 0-1 23z"/></svg>
                {%- when 'reforzadas' -%}
                  <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M32 7l18 7v15c0 13-8 22-18 27-10-5-18-14-18-27V14z"/><path d="M24 31l6 6 11-12"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <p>{{ block.settings.texto | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.pie != blank -%}
      <div class="cs-pie">{{ section.settings.pie }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cloud · ¿Son para vos?",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "¿Son para vos?" },
    { "type": "text", "id": "subtitulo", "label": "Subtítulo", "default": "Cloud Socks son ideales si querés:" },
    { "type": "richtext", "id": "pie", "label": "Texto de abajo", "default": "<p>¿Tenés dudas? Escribinos y te ayudamos.</p>" },
    { "type": "header", "content": "Colores" },
    { "type": "checkbox", "id": "fondo_transparente", "label": "Fondo transparente", "default": true },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo (si no es transparente)", "default": "#F5F1E8" },
    { "type": "color", "id": "color_texto", "label": "Color de títulos", "default": "#1B2A4A" },
    { "type": "color", "id": "color_tarjeta", "label": "Color de tarjetas", "default": "#1B2A4A" },
    { "type": "color", "id": "color_tarjeta_texto", "label": "Color de texto e íconos de las tarjetas", "default": "#F5F1E8" },
    { "type": "header", "content": "Diseño" },
    { "type": "checkbox", "id": "usar_poppins", "label": "Usar fuente Poppins", "info": "Desactivalo para usar la fuente de tu tema.", "default": true },
    {
      "type": "select", "id": "columnas_desktop", "label": "Columnas en computadora",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "range", "id": "radio", "label": "Redondeo de tarjetas", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_desktop", "label": "Espacio arriba y abajo (computadora)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_mobile", "label": "Espacio arriba y abajo (celular)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select", "id": "icono", "label": "Ícono",
          "options": [
            { "value": "dedos", "label": "Dedos libres" },
            { "value": "ampollas", "label": "Sin ampollas" },
            { "value": "secos", "label": "Secos y frescos" },
            { "value": "olor", "label": "Sin olor" },
            { "value": "nube", "label": "Nube / suavidad" },
            { "value": "reforzadas", "label": "Reforzadas / escudo" }
          ],
          "default": "dedos"
        },
        { "type": "image_picker", "id": "icono_imagen", "label": "Ícono personalizado (opcional)", "info": "Si subís una imagen, reemplaza al ícono elegido arriba." },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Beneficio" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Cloud · ¿Son para vos?",
      "blocks": [
        { "type": "beneficio", "settings": { "icono": "dedos", "texto": "Que tus dedos no se aprieten más" } },
        { "type": "beneficio", "settings": { "icono": "ampollas", "texto": "Chau ampollas y dolor de pies" } },
        { "type": "beneficio", "settings": { "icono": "secos", "texto": "Pies secos y frescos todo el día" } },
        { "type": "beneficio", "settings": { "icono": "olor", "texto": "Olvidarte del mal olor" } },
        { "type": "beneficio", "settings": { "icono": "nube", "texto": "Sentir tus pies en una nube" } },
        { "type": "beneficio", "settings": { "icono": "reforzadas", "texto": "Talón y punta reforzados, para que duren" } }
      ]
    }
  ]
}
{% endschema %}
