<style>
  .bz-hero{background:linear-gradient(180deg,var(--bz-p1) 0%,var(--bz-p2) 100%);padding:32px 0 48px;position:relative;overflow:hidden}
  .bz-hero::before{content:"";position:absolute;width:620px;height:620px;right:-220px;top:-180px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.7) 0,rgba(255,255,255,0) 65%);pointer-events:none}
  .bz-hero-grid{position:relative;display:grid;gap:30px}
  .bz-hero .bz-lead{margin-bottom:22px}
  .bz-byline{display:flex;align-items:center;gap:12px;font-size:14px;color:var(--bz-muted);line-height:1.4}
  .bz-avatar{flex:0 0 44px;height:44px;border-radius:50%;background:var(--bz-brown);color:#FBE9DF;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;letter-spacing:.12em}
  .bz-byline b{display:block;color:var(--bz-brown);font-size:14px}
  .bz-hero-proof{display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;margin:0 0 22px;font-size:14px;color:var(--bz-brown)}
  .bz-hero-proof>span{display:inline-flex;align-items:center;gap:8px}
  .bz-chip-tt{background:#111;color:#fff;border-radius:999px;padding:3px 10px;font-weight:700;font-size:12px}
  .bz-chip-ml{background:#FFE600;color:#2D3277;border-radius:999px;padding:3px 10px;font-weight:800;font-size:12px}
  .bz-hero-visual{position:relative;max-width:520px;width:100%;margin:0 auto}
  .bz-hero-visual .bz-media{border-radius:28px;box-shadow:0 30px 60px -30px rgba(58,35,23,.45)}
  .bz-float{position:absolute;display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.96);backdrop-filter:blur(6px);border-radius:18px;padding:12px 16px 12px 12px;box-shadow:0 16px 36px -14px rgba(58,35,23,.35);font-size:13px;line-height:1.3;color:var(--bz-text)}
  .bz-float b{display:block;color:var(--bz-brown);font-size:15px}
  .bz-float .bz-ic{width:42px;height:42px}.bz-float .bz-ic svg{width:20px;height:20px}
  .bz-float-a{left:12px;bottom:14px}
  .bz-hero-cta{display:none}
  @media(min-width:990px){
    .bz-hero{padding:72px 0 88px}
    .bz-hero-grid{grid-template-columns:1.12fr .88fr;gap:64px;align-items:center}
    .bz-hero-cta{display:flex;align-items:center;gap:22px;margin:0 0 30px}
    .bz-float-a{left:-36px;bottom:48px}
  }

  /* Índice de la nota */
  .bz-toc{position:relative;margin-top:36px;background:var(--bz-white);border-radius:22px;padding:18px 18px 8px;box-shadow:0 20px 40px -28px rgba(58,35,23,.4)}
  .bz-toc-t{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--bz-muted);margin-bottom:6px}
  .bz-toc ol{list-style:none;margin:0;padding:0;display:grid}
  .bz-toc a{display:flex;align-items:center;gap:14px;padding:11px 0;border-top:1px solid var(--bz-line);text-decoration:none;color:var(--bz-brown);font-size:15px;font-weight:600;line-height:1.3}
  .bz-toc li:first-child a{border-top:0}
  .bz-toc a span{font-family:var(--bz-head);color:var(--bz-coral);font-size:18px;min-width:26px}
  @media(min-width:990px){
    .bz-toc{margin-top:64px;padding:22px 28px}
    .bz-toc ol{grid-template-columns:repeat(5,1fr);gap:20px}
    .bz-toc a{flex-direction:column;align-items:flex-start;gap:6px;border-top:0;padding:4px 0 10px}
    .bz-toc a span{font-size:28px}
  }

  /* Intro */
  .bz-intro{padding:52px 0 8px}
  .bz-intro p:first-child{font-size:19px;color:var(--bz-brown)}
  @media(min-width:990px){.bz-intro{padding:88px 0 8px}.bz-intro p{font-size:20px}.bz-intro p:first-child{font-size:22px}}
</style>

<div class="bz">
