<style>
  .bz-cmp{border-radius:14px;overflow:hidden;border:1px solid var(--bz-peach-light);background:#fff;margin-top:24px;font-size:14px;line-height:1.35}
  .bz-cmp-row{display:grid;grid-template-columns:1.2fr 1fr 1fr}
  .bz-cmp-row>div{padding:12px 10px;border-top:1px solid var(--bz-peach-light);display:flex;align-items:center}
  .bz-cmp-row>div:nth-child(2),.bz-cmp-row>div:nth-child(3){justify-content:center;text-align:center}
  .bz-cmp-row>div:nth-child(3){background:var(--bz-peach-light);color:var(--bz-brown);font-weight:600}
  .bz-cmp-head>div{background:var(--bz-brown) !important;color:var(--bz-cream) !important;font-weight:700;border-top:0}
  .bz-cmp-head>div:nth-child(3){background:var(--bz-cta) !important}
  .bz-no{color:#A9A09A}
  .bz-yes{color:var(--bz-cta);font-weight:700}
