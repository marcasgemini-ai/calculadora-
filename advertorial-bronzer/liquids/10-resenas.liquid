{% comment %}
  10 de 12 · RESEÑAS + CAPTURAS
  Usá SOLO reseñas reales (Mercado Libre, TikTok, WhatsApp, DMs), con permiso y tapando datos personales.
  Fotos de reseñas en Contenido > Archivos: bronzer-review-1.jpg … bronzer-review-4.jpg (1200x1500, vertical)
  Capturas: bronzer-captura-1.jpg … bronzer-captura-6.jpg (verticales, como salen del celular)
  Para sumar o sacar tarjetas, copiá o borrá un bloque <article> o <figure> completo.
{% endcomment %}
<style>
  .bz-rv-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:28px}
  .bz-rv-head h2{margin:0;max-width:560px}
  .bz-rv-score{display:flex;align-items:center;gap:14px;background:var(--bz-white);border:1px solid var(--bz-line);border-radius:18px;padding:12px 18px}
  .bz-rv-score b{font-family:var(--bz-head);font-size:38px;line-height:1;color:var(--bz-brown)}
  .bz-rv-score span{display:block;font-size:13px;color:var(--bz-muted)}
  .bz-rvs{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 20px 18px;margin:0 -20px;scrollbar-width:none}
  .bz-rvs::-webkit-scrollbar{display:none}
  .bz-rv{flex:0 0 80%;scroll-snap-align:center;background:var(--bz-white);border-radius:22px;overflow:hidden;border:1px solid var(--bz-line);display:flex;flex-direction:column;box-shadow:0 18px 40px -30px rgba(58,35,23,.45)}
  @media(min-width:750px){.bz-rvs{margin:0 -32px;padding:4px 32px 18px}.bz-rv{flex-basis:44%}}
  @media(min-width:990px){.bz-rvs{display:grid;grid-template-columns:repeat(4,1fr);overflow:visible;margin:0;padding:4px 0 18px}}
  .bz-rv .bz-media{border-radius:0}
  .bz-rv-b{padding:16px 18px 18px;font-size:14.5px;line-height:1.5;display:flex;flex-direction:column;flex:1}
  .bz-rv-n{display:flex;flex-direction:column;gap:2px;margin-bottom:6px}
  .bz-rv-n b{color:var(--bz-brown);font-size:15px}
  .bz-ver{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:#2E7D55;white-space:nowrap}
  .bz-rv p{margin:8px 0 14px;flex:1}
  .bz-rv small{align-self:flex-start;background:var(--bz-p1);color:var(--bz-coral-d);font-weight:700;font-size:12px;padding:5px 11px;border-radius:999px}
  .bz-swipe{text-align:center;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--bz-muted);margin:0 0 44px}
  @media(min-width:990px){.bz-swipe{display:none}}
  .bz-caps-h{text-align:center;margin:52px 0 22px}
  .bz-caps-h h3{font-size:22px;text-transform:uppercase;letter-spacing:.06em;margin:0}
  .bz-caps{columns:2;column-gap:12px;margin-bottom:34px}
  @media(min-width:750px){.bz-caps{columns:3;column-gap:16px}}
  .bz-caps figure{margin:0 0 12px;break-inside:avoid;border-radius:16px;overflow:hidden;box-shadow:0 10px 26px -18px rgba(58,35,23,.5);background:var(--bz-white)}
  .bz-caps figure.is-empty{aspect-ratio:9/14}
  .bz-caps figure img{width:100%}
  .bz-rv-cta{text-align:center}
</style>

<div class="bz">
  <section class="bz-sec" id="resenas">
    <div class="bz-wrap">
      <div class="bz-rv-head">
        <div><span class="bz-eyebrow">Opiniones reales</span><h2>Lo que dicen las que <em>ya lo probaron</em></h2></div>
        <div class="bz-rv-score"><b>[4,8]</b><div><span class="bz-stars">★★★★★</span><span>[+2.300] opiniones</span></div></div>
      </div>

      <div class="bz-rvs">
        <article class="bz-rv">
          <div class="bz-media bz-ar-45"><img src="{{ 'bronzer-review-1.jpg' | file_url }}" alt="Foto de clienta" width="1200" height="1500" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">bronzer-review-1.jpg</span></div>
          <div class="bz-rv-b">
            <div class="bz-rv-n"><b>[Nombre], [Ciudad]</b><span class="bz-ver">✓ Compra verificada</span></div>
            <span class="bz-stars">★★★★★</span>
            <p>[Pegá acá una reseña real de Mercado Libre o TikTok]</p>
            <small>Usa Bronzer hace [X] semanas</small>
          </div>
        </article>
        <article class="bz-rv">
          <div class="bz-media bz-ar-45"><img src="{{ 'bronzer-review-2.jpg' | file_url }}" alt="Foto de clienta" width="1200" height="1500" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">bronzer-review-2.jpg</span></div>
          <div class="bz-rv-b">
            <div class="bz-rv-n"><b>[Nombre], [Ciudad]</b><span class="bz-ver">✓ Compra verificada</span></div>
            <span class="bz-stars">★★★★★</span>
            <p>[Pegá acá una reseña real de Mercado Libre o TikTok]</p>
            <small>Usa Bronzer hace [X] semanas</small>
          </div>
        </article>
        <article class="bz-rv">
          <div class="bz-media bz-ar-45"><img src="{{ 'bronzer-review-3.jpg' | file_url }}" alt="Foto de clienta" width="1200" height="1500" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">bronzer-review-3.jpg</span></div>
          <div class="bz-rv-b">
            <div class="bz-rv-n"><b>[Nombre], [Ciudad]</b><span class="bz-ver">✓ Compra verificada</span></div>
            <span class="bz-stars">★★★★★</span>
            <p>[Pegá acá una reseña real de Mercado Libre o TikTok]</p>
            <small>Usa Bronzer hace [X] semanas</small>
          </div>
        </article>
        <article class="bz-rv">
          <div class="bz-media bz-ar-45"><img src="{{ 'bronzer-review-4.jpg' | file_url }}" alt="Foto de clienta" width="1200" height="1500" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">bronzer-review-4.jpg</span></div>
          <div class="bz-rv-b">
            <div class="bz-rv-n"><b>[Nombre], [Ciudad]</b><span class="bz-ver">✓ Compra verificada</span></div>
            <span class="bz-stars">★★★★★</span>
            <p>[Pegá acá una reseña real de Mercado Libre o TikTok]</p>
            <small>Usa Bronzer hace [X] semanas</small>
          </div>
        </article>
      </div>
      <p class="bz-swipe">Deslizá para ver más →</p>

      <div class="bz-caps-h"><span class="bz-eyebrow">Mensajes de clientas</span><h3>Lo que nos escriben</h3></div>
      <div class="bz-caps">
        <figure class="bz-media"><img src="{{ 'bronzer-captura-1.jpg' | file_url }}" alt="Mensaje de clienta" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">captura 1</span></figure>
        <figure class="bz-media"><img src="{{ 'bronzer-captura-2.jpg' | file_url }}" alt="Mensaje de clienta" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">captura 2</span></figure>
        <figure class="bz-media"><img src="{{ 'bronzer-captura-3.jpg' | file_url }}" alt="Mensaje de clienta" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">captura 3</span></figure>
        <figure class="bz-media"><img src="{{ 'bronzer-captura-4.jpg' | file_url }}" alt="Mensaje de clienta" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">captura 4</span></figure>
        <figure class="bz-media"><img src="{{ 'bronzer-captura-5.jpg' | file_url }}" alt="Mensaje de clienta" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">captura 5</span></figure>
        <figure class="bz-media"><img src="{{ 'bronzer-captura-6.jpg' | file_url }}" alt="Mensaje de clienta" loading="lazy" onerror="this.parentNode.classList.add('is-empty');this.remove()"><span class="bz-media-ph">captura 6</span></figure>
      </div>

      <div class="bz-rv-cta"><a class="bz-btn" href="#oferta">Quiero probarlo <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
    </div>
  </section>
</div>
