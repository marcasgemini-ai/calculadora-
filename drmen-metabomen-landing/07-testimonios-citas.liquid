{%- comment -%}
  LANDING METABOMEN +40 · LIQUID 07 · TESTIMONIOS EN CITA (texto largo)
  Necesita el 01 arriba. Clientes reales, con permiso. Separá con | (mismo orden).
{%- endcomment -%}

{%- assign eyebrow = 'Lo que dicen de Metabomen' -%}
{%- assign titulo = 'Lo que cuentan los hombres de <em>+40</em>' -%}

{%- assign c_titulo = '[Título corto de la reseña]|[Título corto de la reseña]|[Título corto de la reseña]' | split: '|' -%}
{%- assign c_texto = '[Reseña real larga: cómo se sentía (cansado, "viejo"), qué probó antes, qué notó con Metabomen.]|[Reseña real larga]|[Reseña real larga]' | split: '|' -%}
{%- assign c_nombre = '[Nombre], 48 · [Ciudad]|[Nombre], 51 · [Ciudad]|[Nombre], 45 · [Ciudad]' | split: '|' -%}

<style>
  .dt-cita { background: var(--dt-cream); border: 1px solid var(--dt-line); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; height: 100%; }
  .dt-cita small { font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--dt-red); }
  .dt-cita p { font-size: 15.5px; line-height: 1.55; margin: 10px 0 16px !important; flex: 1; }
  .dt-cita span { font-size: 12.5px; color: var(--dt-muted); font-weight: 700; }
</style>

<div class="dt-band">
  <div class="dt dt-sec">
    <div class="dt-head">
      <span class="dt-eyebrow">{{ eyebrow }}</span>
      <h2 class="dt-h2">{{ titulo }}</h2>
    </div>
    <div class="dt-scroll">
      {%- for t in c_titulo -%}
        {%- assign k = forloop.index0 -%}
        <div class="dt-cita">
          <small>{{ t }}</small>
          <p>"{{ c_texto[k] }}"</p>
          <span><span class="dt-stars">★★★★★</span> — {{ c_nombre[k] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
