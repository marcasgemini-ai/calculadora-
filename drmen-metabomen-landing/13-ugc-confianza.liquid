{%- comment -%}
  LANDING METABOMEN +40 · LIQUID 13 · FOTOS DE CLIENTES (UGC) + PUNTOS DE CONFIANZA
  Necesita el 01 arriba.
  u_img: fotos reales que mandan los clientes con el frasco (separadas por |). Vacías = recuadros punteados.
  confianza: verificá cada punto antes de publicar.
{%- endcomment -%}

{%- assign eyebrow = 'Así llega Metabomen' -%}
{%- assign titulo = 'Las fotos que nos <em>mandan</em>' -%}
{%- assign u_img = '||||||' | split: '|' -%}
{%- assign u_user = '[@cliente]|[@cliente]|[@cliente]|[@cliente]|[@cliente]|[@cliente]' | split: '|' -%}

{%- assign confianza_icono = 'badge|truck|card|shield' | split: '|' -%}
{%- assign confianza = 'Producto registrado: RNPA [número]|Envío gratis con seguimiento a todo el país|Pagás con Mercado Pago, tarjeta o transferencia|60 días de garantía de satisfacción' | split: '|' -%}
{%- assign nota = 'Metabomen es un suplemento dietario. No es un medicamento ni reemplaza una alimentación variada y equilibrada. Consultá a tu médico, sobre todo si tomás medicación o tenés presión alta o problemas cardíacos.' -%}

<style>
  .dt-ugc { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; }
  .dt-ugc > div { position: relative; }
  .dt-ugc img, .dt-ugc .dt-ph { aspect-ratio: 4 / 5; object-fit: cover; border-radius: 12px; font-size: 11px; padding: 8px; }
  .dt-ugc span { position: absolute; left: 8px; bottom: 8px; background: rgba(14,15,17,.75); color: #fff; font-size: 10.5px; font-weight: 700; padding: 3px 8px; border-radius: 999px; }
  .dt-conf { max-width: 760px; margin: 30px auto 0; display: grid; gap: 10px; }
  .dt-conf div { display: flex; gap: 12px; align-items: center; font-size: 15px; font-weight: 600; }
  .dt-conf div span { width: 40px; height: 40px; border-radius: 50%; background: var(--dt-ink, #141517); color: #fff; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .dt-conf div span .dt-ic { width: 20px; height: 20px; }
  .dt-conf__nota { max-width: 760px; margin: 18px auto 0 !important; background: #fff; border: 1px solid var(--dt-line); border-radius: 12px; padding: 14px 16px; font-size: 13px; color: var(--dt-muted); }
  @media (max-width: 749px) { .dt-ugc { grid-template-columns: repeat(3, 1fr); gap: 6px; } }
</style>

<div class="dt-band is-sand">
  <div class="dt dt-sec">
    <div class="dt-head">
      <span class="dt-eyebrow">{{ eyebrow }}</span>
      <h2 class="dt-h2">{{ titulo }}</h2>
    </div>
    <div class="dt-ugc">
      {%- for u in u_user -%}
        {%- assign k = forloop.index0 -%}
        <div>{%- if u_img[k] != blank -%}<img src="{{ u_img[k] }}" alt="Foto de cliente con Metabomen" loading="lazy" width="400" height="500">{%- else -%}<div class="dt-ph">FOTO DE CLIENTE con el frasco</div>{%- endif -%}<span>{{ u }}</span></div>
      {%- endfor -%}
    </div>
    <div class="dt-conf">
      {%- for c in confianza -%}<div><span><svg class="dt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{%- case confianza_icono[forloop.index0] -%}{%- when 'bolt' -%}<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>{%- when 'leaf' -%}<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>{%- when 'grape' -%}<circle cx="9" cy="9.5" r="2.5"/><circle cx="15" cy="9.5" r="2.5"/><circle cx="12" cy="14" r="2.5"/><circle cx="9" cy="18.5" r="2.5"/><circle cx="15" cy="18.5" r="2.5"/><path d="M12 7V3.5l3-1.5"/>{%- when 'pulse' -%}<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>{%- when 'pin' -%}<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>{%- when 'shield' -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>{%- when 'trophy' -%}<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>{%- when 'camera' -%}<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>{%- when 'flame' -%}<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>{%- when 'book' -%}<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>{%- when 'utensils' -%}<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>{%- when 'plane' -%}<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>{%- when 'gift' -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/>{%- when 'lock' -%}<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>{%- when 'truck' -%}<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62L18.3 9.38a1 1 0 0 0-.78-.38H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>{%- when 'card' -%}<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/>{%- when 'chat' -%}<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>{%- when 'badge' -%}<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>{%- when 'clock' -%}<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>{%- when 'hourglass' -%}<path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.17a2 2 0 0 0-.59-1.42L12 12l-4.41 4.41A2 2 0 0 0 7 17.83V22"/><path d="M7 2v4.17a2 2 0 0 0 .59 1.42L12 12l4.41-4.41A2 2 0 0 0 17 6.17V2"/>{%- when 'flask' -%}<path d="M9 3h6"/><path d="M10 3v6L4.5 18.5A2 2 0 0 0 6.2 21.5h11.6a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7 15h10"/>{%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>{%- when 'heart' -%}<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>{%- when 'calendar' -%}<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>{%- when 'bulb' -%}<path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>{%- when 'dumbbell' -%}<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>{%- when 'citrus' -%}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><path d="M12 6.5v11M6.5 12h11M8.1 8.1l7.8 7.8M15.9 8.1l-7.8 7.8"/>{%- when 'hex' -%}<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M9 9.5h6l-6 5h6"/>{%- when 'drop' -%}<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>{%- when 'berry' -%}<circle cx="12" cy="14" r="7"/><path d="M12 7V3M9 4.5 12 7l3-2.5"/><path d="M9.5 12h.01M14.5 12h.01M12 15h.01M9.5 17h.01M14.5 17h.01"/>{%- when 'arrowdown' -%}<path d="M12 5v14M19 12l-7 7-7-7"/>{%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>{%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>{%- endcase -%}</svg></span>{{ c }}</div>{%- endfor -%}
    </div>
    <p class="dt-conf__nota">{{ nota }}</p>
  </div>
</div>
