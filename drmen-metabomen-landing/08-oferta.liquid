 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/>{%- when 'dumbbell' -%}<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>{%- when 'citrus' -%}<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><path d="M12 6.5v11M6.5 12h11M8.1 8.1l7.8 7.8M15.9 8.1l-7.8 7.8"/>{%- when 'hex' -%}<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M9 9.5h6l-6 5h6"/>{%- when 'drop' -%}<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>{%- when 'berry' -%}<circle cx="12" cy="14" r="7"/><path d="M12 7V3M9 4.5 12 7l3-2.5"/><path d="M9.5 12h.01M14.5 12h.01M12 15h.01M9.5 17h.01M14.5 17h.01"/>{%- when 'arrowdown' -%}<path d="M12 5v14M19 12l-7 7-7-7"/>{%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>{%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>{%- endcase -%}</svg>{{ badge_3 }}</span>{%- endif -%}
</div>

<div class="dmo" data-bump-handle="{{ bump_handle }}">
  {%- if request.design_mode -%}<p class="dmo-adm" id="dmBumpAdm" style="display:none;background:#FDECEC;color:#9B1C1C;border:1px solid #F5B5B5;border-radius:8px;padding:8px 10px;font-size:12px;margin:0 0 8px;">Atención, solo lo ves vos en el editor: no se encontró el upsell <b>{{ bump_handle }}</b>. Revisá que el producto esté Activo y publicado en Tienda online.</p>{%- endif -%}
  <div class="dmo__ttl">{{ separador }}</div>
  <form id="dmBuyForm" data-checkout="{% if ir_a_checkout %}1{% else %}0{% endif %}" onsubmit="return false;">

    {%- for i in (1..4) -%}
      {%- case i -%}
        {%- when 1 -%}{%- assign t = p1_titulo -%}{%- assign s = p1_sub -%}{%- assign q = p1_cantidad -%}{%- assign vid = p1_variante -%}{%- assign pr = p1_precio -%}{%- assign tc = p1_tachado -%}{%- assign ah = p1_ahorro -%}{%- assign pd = p1_por_dia -%}{%- assign ci = p1_cinta -%}{%- assign bd = p1_badges -%}{%- assign bj = p1_bajada -%}{%- assign bu = p1_bump -%}{%- assign bp = p1_bump_precio -%}{%- assign bt = p1_bump_tachado -%}
        {%- when 2 -%}{%- assign t = p2_titulo -%}{%- assign s = p2_sub -%}{%- assign q = p2_cantidad -%}{%- assign vid = p2_variante -%}{%- assign pr = p2_precio -%}{%- assign tc = p2_tachado -%}{%- assign ah = p2_ahorro -%}{%- assign pd = p2_por_dia -%}{%- assign ci = p2_cinta -%}{%- assign bd = p2_badges -%}{%- assign bj = p2_bajada -%}{%- assign bu = p2_bump -%}{%- assign bp = p2_bump_precio -%}{%- assign bt = p2_bump_tachado -%}
        {%- when 3 -%}{%- assign t = p3_titulo -%}{%- assign s = p3_sub -%}{%- assign q = p3_cantidad -%}{%- assign vid = p3_variante -%}{%- assign pr = p3_precio -%}{%- assign tc = p3_tachado -%}{%- assign ah = p3_ahorro -%}{%- assign pd = p3_por_dia -%}{%- assign ci = p3_cinta -%}{%- assign bd = p3_badges -%}{%- assign bj = p3_bajada -%}{%- assign bu = p3_bump -%}{%- assign bp = p3_bump_precio -%}{%- assign bt = p3_bump_tachado -%}
        {%- when 4 -%}{%- assign t = p4_titulo -%}{%- assign s = p4_sub -%}{%- assign q = p4_cantidad -%}{%- assign vid = p4_variante -%}{%- assign pr = p4_precio -%}{%- assign tc = p4_tachado -%}{%- assign ah = p4_ahorro -%}{%- assign pd = p4_por_dia -%}{%- assign ci = p4_cinta -%}{%- assign bd = p4_badges -%}{%- assign bj = p4_bajada -%}{%- assign bu = p4_bump -%}{%- assign bp = p4_bump_precio -%}{%- assign bt = p4_bump_tachado -%}
      {%- endcase -%}
      {%- if vid == blank -%}
        {%- for v in prod.variants -%}
          {%- assign vt = v.title | downcase -%}
          {%- assign sd = s | split: ' (' | first | downcase -%}
          {%- if vt contains sd -%}{%- assign vid = v.id -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if vid != blank -%}{%- assign q = 1 -%}{%- endif -%}
      {%- else -%}
        {%- assign q = 1 -%}
      {%- endif -%}
      {%- if vid == blank -%}{%- assign vid = v0.id -%}{%- endif -%}
      {%- assign frascos = s | split: ' ' | first | plus: 0 -%}
      {%- if frascos == 0 -%}{%- assign frascos = q -%}{%- endif -%}

      {%- assign bpu = bp | upcase -%}
      {%- if bpu contains 'GRATIS' -%}{%- assign bid = bump_id_gratis -%}{%- assign btype = 'gratis' -%}{%- else -%}{%- assign bid = bump_id_50 -%}{%- assign btype = 'off' -%}{%- endif -%}

      <div data-bump="{{ bid }}" data-bump-type="{{ btype }}" class="dmo-card{% if i == pack_elegido %} is-on{% endif %}{% if ci != blank %} is-top{% endif %}" data-variant="{{ vid }}" data-qty="{{ q }}" data-price="{{ pr }}" data-name="{{ t | escape }}">
        {%- if ci != blank -%}<span class="dmo-rib">★ {{ ci }}</span>{%- endif -%}
        <label class="dmo-head">
          <input type="radio" name="dmPack" value="{{ i }}" {% if i == pack_elegido %}checked{% endif %}>
          <span class="dmo-dot"></span>
          <span class="dmo-t"><b>{{ t }}</b><small>{{ s }}{% if pd != blank %} · <i>{{ pd }}</i>{% endif %}</small></span>
          <span class="dmo-p"><b>{{ pr }}</b>{%- if tc != blank -%}<s>{{ tc }}</s>{%- endif -%}{%- if ah != blank -%}<em>{{ ah }}</em>{%- endif -%}</span>
        </label>
        {%- if bd != blank -%}
          <div class="dmo-chips">{%- assign bl = bd | split: '|' -%}{%- for b in bl -%}<span>{{ b }}</span>{%- endfor -%}</div>
        {%- endif -%}

        <div class="dmo-body">
          {%- if bj != blank -%}<p class="dmo-baj">{{ bj }}</p>{%- endif -%}

          {%- if bu != blank -%}
          <label class="dmo-bump">
            <input type="checkbox" class="dmo-bump__cb" {% if bid == blank %}disabled{% endif %}>
            {%- if bump_img != blank -%}<img src="{{ bump_img }}" alt="{{ bump_nombre | escape }}" loading="lazy">{%- else -%}<span class="dmo-bump__ph"></span>{%- endif -%}
            <span class="dmo-bump__t">{{ bu }}</span>
            <span class="dmo-bump__p">{{ bp }}{%- if bt != blank -%}<s>{{ bt }}</s>{%- endif -%}</span>
          </label>
          {%- endif -%}

          {%- assign abiertos = 0 -%}
          {%- for d in regalos_desde -%}{%- assign dn = d | plus: 0 | minus: 1 -%}{%- if frascos > dn -%}{%- assign abiertos = abiertos | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- assign hay_sorteo = false -%}
          <div class="dmo-gifts__h"><span class="dmo-gh"><svg class="dt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg> {% if abiertos > 0 %}{{ abiertos }}/{{ regalos_corto.size }} regalos incluidos{% else %}Regalos desde {{ regalos_desde | first }} frascos{% endif %}</span><span>{% if abiertos < regalos_corto.size %}Desbloqueá más con 3 frascos{% endif %}</span></div>
          <div class="dmo-gifts">
            {%- for nombre in regalos_corto -%}
              {%- assign k = forloop.index0 -%}
              {%- assign dn = regalos_desde[k] | plus: 0 -%}
              {%- assign dn_menos = dn | minus: 1 -%}
              {%- if frascos > dn_menos -%}
                {%- if regalos_etiqueta[k] == 'Sorteo' -%}{%- assign hay_sorteo = true -%}{%- endif -%}
