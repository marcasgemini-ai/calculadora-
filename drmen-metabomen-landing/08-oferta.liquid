<script>
  (function () {
    var main = document.getElementById('dmxMain');
    document.querySelectorAll('.dmx-gal__th button').forEach(function (b) {
      b.addEventListener('click', function () {
        if (main) main.src = b.dataset.src;
        document.querySelectorAll('.dmx-gal__th button').forEach(function (x) { x.classList.remove('is-on'); });
        b.classList.add('is-on');
      });
    });
  })();
  (function () {
    var form = document.getElementById('dmBuyForm');
    if (!form) return;
    var cards = form.querySelectorAll('.dmo-card');
    var priceEl = document.getElementById('dmOfferPrice');
    var btn = document.getElementById('dmOfferBtn');
    var err = document.getElementById('dmOfferErr');
    function current() { return form.querySelector('.dmo-card.is-on') || cards[0]; }
    function sync() {
      var c = current();
      if (priceEl && c) priceEl.textContent = c.dataset.price;
      /* avisa a la barra fija del bloque 10 qué pack está elegido */
      document.dispatchEvent(new CustomEvent('dm:pack', { detail: { name: c.dataset.name, price: c.dataset.price } }));
    }
    cards.forEach(function (card) {
      card.querySelector('input[type=radio]').addEventListener('change', function () {
        cards.forEach(function (c) { c.classList.remove('is-on'); });
        card.classList.add('is-on');
        sync();
      });
    });
    var want = new URLSearchParams(window.location.search).get('variant');
    if (want) cards.forEach(function (c) { if (c.dataset.variant === want) { var r = c.querySelector('input[type=radio]'); if (r) { r.checked = true; r.dispatchEvent(new Event('change')); } } });
    sync();

    /* Upsell: si Liquid no lo encontró, lo busca directo en la tienda (/products/handle.js) */
    var root = form.closest('.dmo');
    var handle = root && root.dataset.bumpHandle;
    var missing = Array.prototype.some.call(cards, function (c) { return !c.dataset.bump; });
    if (handle && missing) {
      fetch('/products/' + handle + '.js', { headers: { 'Accept': 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error('bump'); return r.json(); })
        .then(function (p) {
          var gratis = null, off = null;
          (p.variants || []).forEach(function (v) {
            var t = (v.title || '').toLowerCase();
            if (!gratis && (v.price === 0 || t.indexOf('gratis') > -1)) gratis = v; else if (!off) off = v;
          });
          var img = p.featured_image ? (p.featured_image.indexOf('//') === 0 ? 'https:' + p.featured_image : p.featured_image) : '';
          cards.forEach(function (c) {
            if (c.dataset.bump) return;
            var v = c.dataset.bumpType === 'gratis' ? gratis : off;
            if (!v) return;
            c.dataset.bump = v.id;
            var cb = c.querySelector('.dmo-bump__cb'); if (cb) cb.disabled = false;
            var ph = c.querySelector('.dmo-bump__ph');
            if (ph && img) { var im = document.createElement('img'); im.src = img; im.alt = p.title || ''; ph.replaceWith(im); }
          });
        })
        .catch(function () { var a = document.getElementById('dmBumpAdm'); if (a) a.style.display = 'block'; });
    }

    form.addEventListener('submit', function () {
      var c = current();
      var items = [{ id: Number(c.dataset.variant), quantity: Number(c.dataset.qty), properties: { _Pack: c.dataset.name, _Origen: 'Landing +40' } }];
      var bumpId = c.dataset.bump;
      var cb = c.querySelector('.dmo-bump__cb');
      if (bumpId && cb && cb.checked) items.push({ id: Number(bumpId), quantity: 1 });
      if (btn) btn.disabled = true;
      if (err) err.style.display = 'none';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: items }) })
        .then(function (r) { if (!r.ok) throw new Error('cart'); return r.json(); })
        .then(function () { window.location.href = form.dataset.checkout === '1' ? '/checkout' : '/cart'; })
        .catch(function () { if (btn) btn.disabled = false; if (err) err.style.display = 'block'; });
    });
  })();
</script>
