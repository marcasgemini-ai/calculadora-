<style>
  :root {
    --dm-black: #0E0F11;
    --dm-ink: #15171A;
    --dm-steel: #6F8CA1;
    --dm-soft: #F3F5F7;
    --dm-line: #E2E6EA;
    --dm-muted: #6B7178;
    --dm-good: #2F8A5B;
    --dm-bad: #C23B3B;
    --dm-red: #E1261C;
  }

  /* ===== contenedor del bloque de compra ===== */
  .dmx { background: #F4F1EC; color: var(--dm-ink); scroll-margin-top: 20px; }
  .dmx__in { max-width: 1120px; margin: 0 auto; padding: 56px 16px; display: grid; grid-template-columns: 1fr 470px; gap: 44px; align-items: start; font-family: 'Inter', var(--font-body-family, inherit); letter-spacing: 0; }
  .dmx-gal__main img, .dmx-gal__main .dmx__ph { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 18px; background: #fff; }
  .dmx-gal__th { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 10px; }
  .dmx-gal__th button { padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; background: #fff; cursor: pointer; aspect-ratio: 1 / 1; }
  .dmx-gal__th button.is-on { border-color: var(--dm-ink); }
  .dmx-gal__th img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dmx-ttl { font-family: 'Oswald', var(--font-heading-family, inherit); font-size: clamp(26px, 3.6vw, 36px); line-height: 1.05; font-weight: 700; text-transform: uppercase; margin: 0 0 6px; letter-spacing: .01em; }
  .dmx-rate { font-size: 13px; color: var(--dm-muted); margin: 0 0 14px; }
  .dmx-rate b { color: #E9A23B; letter-spacing: 2px; }
  .dmx-rev { display: flex; gap: 12px; align-items: flex-start; background: #fff; border: 1px solid var(--dm-line); border-radius: 12px; padding: 12px; margin-top: 12px; font-size: 13.5px; line-height: 1.45; }
  .dmx-rev img, .dmx-rev i { width: 40px; height: 40px; border-radius: 50%; flex: 0 0 auto; object-fit: cover; background: #E3DED5; display: flex; align-items: center; justify-content: center; font-style: normal; font-weight: 800; }
  .dmx-rev small { display: block; color: var(--dm-muted); margin-top: 4px; }
  .dmx__in *, .dmx__in *::before, .dmx__in *::after { box-sizing: border-box; }
  .dmx__k { display: inline-block; background: var(--dm-red); color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; margin-bottom: 12px; }
  .dmx__t { font-family: var(--font-heading-family, inherit); font-size: clamp(28px, 4.6vw, 44px); line-height: 1.08; font-weight: 900; text-transform: uppercase; color: #fff; margin: 0 0 18px; letter-spacing: 0; }
  .dmx__t span { color: var(--dm-red); }
  .dmx__img img, .dmx__img .dmx__ph { display: block; width: 100%; max-width: 420px; height: auto; border-radius: 14px; }
  .dmx__ph { aspect-ratio: 1 / 1; border: 2px dashed #C8C1B5; background: #EAE4DA; color: #5B554D; display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; font-size: 13px; font-weight: 600; }
  .dmx__ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 8px; }
  .dmx__ul li { display: flex; gap: 10px; font-size: 15px; color: #D5DADF; line-height: 1.4; margin: 0; }

  .dmx__panel { color: var(--dm-ink); }

  /* ===== estilos de la oferta (iguales a la página de producto) ===== */
  .dm-tbadges { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; font-family: var(--font-body-family, inherit); }
  .dm-tbadges .dt-ic { width: 14px; height: 14px; }
  .dm-tbadges span { display: inline-flex; align-items: center; gap: 6px; background: var(--dm-black, #0E0F11); color: #fff; font-size: 12px; font-weight: 700; padding: 6px 11px; border-radius: 999px; line-height: 1; }
  .dm-tbadges span:first-child { background: #FFE600; color: #2D3277; }

  .dm-below { font-family: var(--font-body-family, inherit); color: var(--dm-ink, #15171A); margin: 12px 0 0; display: grid; gap: 8px; }
  .dm-below__row { display: flex; align-items: flex-start; gap: 10px; border: 1px solid var(--dm-line, #E2E6EA); border-radius: 10px; padding: 10px 12px; font-size: 13.5px; line-height: 1.4; background: #fff; }
  .dm-below__row > span:first-child { flex: 0 0 auto; line-height: 1; color: var(--dm-ink); }
  .dm-below__row > span:first-child .dt-ic { width: 20px; height: 20px; }
  .dm-below__row b { display: block; font-size: 14px; }
  .dm-below__row.is-ml { background: #FFFBD6; border-color: #F2E27A; }

  .dmo { font-family: var(--font-body-family, inherit); color: var(--dm-ink); margin: 4px 0; letter-spacing: 0; }
  .dmo * { box-sizing: border-box; letter-spacing: 0; }
  .dmo__ttl { display: flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 800; letter-spacing: .14em !important; text-transform: uppercase; color: var(--dm-muted); margin: 0 0 10px; }
  .dmo__ttl::before, .dmo__ttl::after { content: ''; flex: 1; height: 1px; background: var(--dm-line); }

  .dmo-card { position: relative; border: 1.5px solid var(--dm-line); border-radius: 12px; background: #fff; margin-bottom: 8px; transition: border-color .15s ease, box-shadow .2s ease, background .2s ease; }
  .dmo-card.is-on { border-color: var(--dm-ink); background: linear-gradient(180deg, #FFFFFF 0%, #F6F7F9 100%); box-shadow: 0 8px 24px rgba(14,15,17,.10); }
  .dmo-card.is-top { margin-top: 12px; }
  .dmo-rib { position: absolute; top: -9px; right: 12px; background: linear-gradient(90deg, #B8924A, #E2C17C); color: #1A1407; font-size: 9.5px; font-weight: 800; letter-spacing: .1em !important; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; box-shadow: 0 2px 6px rgba(184,146,74,.35); }

  .dmo-head { display: grid; grid-template-columns: 18px 1fr auto; align-items: center; gap: 10px; padding: 11px 12px; cursor: pointer; margin: 0; }
  .dmo-head input { position: absolute; opacity: 0; pointer-events: none; }
  .dmo-dot { width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid #B5BCC3; display: block; position: relative; background: #fff; }
  .dmo-card.is-on .dmo-dot { border-color: var(--dm-ink); }
  .dmo-card.is-on .dmo-dot::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--dm-ink); }
  .dmo-t { min-width: 0; line-height: 1.2; }
  .dmo-t b { display: block; font-size: 14.5px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dmo-t small { display: block; font-size: 11.5px; color: var(--dm-muted); margin-top: 2px; }
  .dmo-t small i { font-style: normal; color: var(--dm-ink); font-weight: 700; }
  .dmo-p { text-align: right; line-height: 1.1; white-space: nowrap; }
  .dmo-p b { display: block; font-size: 16px; font-weight: 800; }
  .dmo-p s { font-size: 11px; color: #9AA1A8; }
  .dmo-p em { display: block; font-style: normal; font-size: 10.5px; font-weight: 800; color: var(--dm-good); margin-top: 2px; }

  .dmo-chips { display: flex; flex-wrap: wrap; gap: 4px; padding: 0 12px 10px 40px; margin-top: -4px; }
  .dmo-chips span { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 999px; background: #EEF1F4; color: #3B434B; }
  .dmo-chips span:last-child { background: var(--dm-ink); color: #fff; }

  .dmo-body { display: none; padding: 0 12px 12px; }
  .dmo-card.is-on .dmo-body { display: block; }
  .dmo-baj { font-size: 12px; font-style: italic; color: var(--dm-muted); margin: 0 0 8px 28px; line-height: 1.4; }

  .dmo-bump { display: flex; align-items: center; gap: 8px; border: 1px dashed #D4B574; background: #FFFBF1; border-radius: 9px; padding: 7px 9px; cursor: pointer; margin: 0 0 8px; }
  .dmo-bump input { width: 16px; height: 16px; accent-color: var(--dm-ink); margin: 0; flex: 0 0 auto; }
  .dmo-bump img, .dmo-bump__ph { width: 30px; height: 30px; border-radius: 6px; object-fit: cover; flex: 0 0 auto; background: #fff; border: 1px solid #EEDFBF; }
  .dmo-bump__t { flex: 1; font-size: 12px; line-height: 1.25; min-width: 0; }
  .dmo-bump__t b { font-weight: 800; }
  .dmo-bump__p { text-align: right; white-space: nowrap; line-height: 1.1; font-size: 12.5px; font-weight: 800; color: var(--dm-good); }
  .dmo-bump__p s { display: block; font-size: 10.5px; font-weight: 400; color: #9AA1A8; }

  .dmo-gifts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .dmo-gift { position: relative; border: 1px solid var(--dm-line); border-radius: 9px; background: #fff; padding: 7px 6px 6px; text-align: center; line-height: 1.15; min-width: 0; }
  .dmo-gift__i { display: block; margin-bottom: 4px; color: var(--dm-ink); }
  .dmo-gift__i .dt-ic { width: 22px; height: 22px; }
  .dmo-gift__img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; margin: 0 0 5px; background: var(--dm-soft); }
  .dmo-gift.is-lock .dmo-gift__img { opacity: .4; filter: grayscale(1); }
  .dmo-gift__n { display: block; font-size: 10.5px; font-weight: 700; color: var(--dm-ink); }
  .dmo-gift__v { display: block; font-size: 9.5px; font-weight: 800; color: var(--dm-good); margin-top: 3px; text-transform: uppercase; }
  .dmo-gift__v s { color: #9AA1A8; font-weight: 400; margin-left: 3px; text-transform: none; }
  .dmo-gift.is-lock { background: #F6F7F9; border-style: dashed; }
  .dmo-gift.is-lock .dmo-gift__i, .dmo-gift.is-lock .dmo-gift__n { opacity: .45; }
  .dmo-gift__lock { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); color: var(--dm-ink); }
  .dmo-gift__lock .dt-ic { width: 20px; height: 20px; }
  .dmo-gift__v .dt-ic { width: 10px; height: 10px; }
  .dmo-gh { display: inline-flex; align-items: center; gap: 6px; }
  .dmo-gh .dt-ic { width: 14px; height: 14px; }
  .dmx-rev .dt-ic { width: 12px; height: 12px; color: #2F8A5B; }
  .dmo-gift.is-lock .dmo-gift__v { color: #8A9199; }
  .dmo-gifts__h { display: flex; justify-content: space-between; align-items: center; font-size: 11px; font-weight: 800; margin: 0 0 6px; }
  .dmo-gifts__h span { color: var(--dm-muted); font-weight: 600; }
  .dmo-legal { font-size: 9.5px; color: #9AA1A8; margin: 6px 0 0; }
  .dmo-legal a { color: inherit; }

  .dmo-btn { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; background: var(--dm-red); color: #fff; border: 0; border-radius: 10px; padding: 16px; font-size: 15px; font-weight: 800; letter-spacing: .06em !important; text-transform: uppercase; cursor: pointer; font-family: var(--font-body-family, inherit); margin-top: 6px; box-shadow: 0 5px 0 #A9170F; transition: transform .1s ease, opacity .15s ease; }
  .dmo-btn:hover { opacity: .92; transform: translateY(1px); }
  .dmo-btn span { opacity: .75; font-weight: 700; }
  .dmo-btn[disabled] { opacity: .55; cursor: default; }
  .dmo-err { display: none; color: var(--dm-bad); font-size: 12px; margin-top: 6px; text-align: center; }

  @media (max-width: 899px) {
    .dmx__in { grid-template-columns: 1fr; gap: 22px; padding: 40px 16px; }
    .dmx-gal__th { grid-template-columns: repeat(6, 1fr); gap: 6px; }
  }
</style>

{%- if product and product.id -%}
  {%- assign prod = product -%}
{%- else -%}
  {%- assign prod = all_products[producto_handle] -%}
{%- endif -%}

<section class="dmx" id="oferta">
  <div class="dmx__in">
    <div class="dmx-gal">
      {%- assign gal = '' -%}
      {%- if galeria_urls != blank -%}
        {%- assign gal = galeria_urls -%}
      {%- elsif prod and prod.images.size > 0 -%}
        {%- for im in prod.images limit: 6 -%}{%- assign u = im | image_url: width: 900 -%}{%- assign gal = gal | append: u | append: '|' -%}{%- endfor -%}
      {%- endif -%}
      {%- assign gl = gal | split: '|' -%}
      <div class="dmx-gal__main">
        {%- if gl.size > 0 -%}<img id="dmxMain" src="{{ gl[0] }}" alt="Metabomen de DR.MEN" width="900" height="900" loading="lazy">{%- else -%}<div class="dmx__ph">FOTOS DEL PRODUCTO · se toman solas de Shopify (frasco, placa de 14 activos, cápsulas, pack x3, regalos)</div>{%- endif -%}
      </div>
      {%- if gl.size > 1 -%}
        <div class="dmx-gal__th">{%- for u in gl -%}<button type="button" class="{% if forloop.first %}is-on{% endif %}" data-src="{{ u }}"><img src="{{ u }}" alt="" loading="lazy" width="120" height="120"></button>{%- endfor -%}</div>
      {%- endif -%}
    </div>

    <div class="dmx__panel">
    <h2 class="dmx-ttl">{{ titulo_producto }}</h2>
    <p class="dmx-rate"><b>★★★★★</b> {{ rating }} · {{ cant_resenas }}</p>
    {%- unless prod and prod.id -%}
      {%- if request.design_mode -%}<p style="background:#FDECEC;color:#9B1C1C;border:1px solid #F5B5B5;border-radius:8px;padding:10px;font-size:13px;margin:0;">Atención, solo lo ves vos en el editor: no se encontró el producto <b>{{ producto_handle }}</b>. Revisá el handle en "producto_handle" y que el producto esté publicado en Tienda online.</p>{%- endif -%}
    {%- else -%}

{%- assign v0 = prod.selected_or_first_available_variant -%}
{%- if bump_handle != blank -%}
  {%- assign bp_prod = all_products[bump_handle] -%}
  {%- if bp_prod and bp_prod.id -%}
    {%- for bv in bp_prod.variants -%}
      {%- assign bvt = bv.title | downcase -%}
      {%- if bump_id_gratis == blank and bv.price == 0 -%}{%- assign bump_id_gratis = bv.id -%}
      {%- elsif bump_id_gratis == blank and bvt contains 'gratis' -%}{%- assign bump_id_gratis = bv.id -%}
      {%- elsif bump_id_50 == blank -%}{%- assign bump_id_50 = bv.id -%}{%- endif -%}
    {%- endfor -%}
