{%- comment -%}
  LANDING METABOMEN +40 · LIQUID 12 · COMENTARIOS EN REDES
  Necesita el 01 arriba. Copiá comentarios REALES de Instagram/Facebook/TikTok (con permiso del autor o
  con el nombre tapado). Separá con | (mismo orden). Avatar vacío = inicial del nombre.
{%- endcomment -%}

{%- assign eyebrow = 'Lo que dicen en redes' -%}
{%- assign titulo = 'Comentarios <em>reales</em>' -%}

{%- assign s_nombre = '[@usuario]|[@usuario]|[@usuario]|[@usuario]' | split: '|' -%}
{%- assign s_red = 'Instagram|Facebook|TikTok|Instagram' | split: '|' -%}
{%- assign s_texto = '[Comentario real]|[Comentario real]|[Comentario real]|[Comentario real]' | split: '|' -%}
{%- assign s_likes = '[X]|[X]|[X]|[X]' | split: '|' -%}
{%- assign s_avatar = '' | split: '|' -%}

<style>
  .dt-soc { background: #fff; border: 1px solid var(--dt-line); border-radius: 16px; padding: 16px; height: 100%; display: flex; flex-direction: column; }
  .dt-soc__h { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .dt-soc__h img, .dt-soc__h i { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; background: var(--dt-sand); display: flex; align-items: center; justify-content: center; font-style: normal; font-weight: 800; flex: 0 0 auto; }
  .dt-soc__h b { display: block; font-size: 14px; }
  .dt-soc__h small { font-size: 12px; color: var(--dt-muted); }
  .dt-soc p { font-size: 14.5px; flex: 1; }
  .dt-soc__f { display: flex; gap: 16px; font-size: 12.5px; color: var(--dt-muted); border-top: 1px solid var(--dt-line); padding-top: 10px; }
</style>

<div class="dt-band is-cream">
  <div class="dt dt-sec">
    <div class="dt-head">
      <span class="dt-eyebrow">{{ eyebrow }}</span>
      <h2 class="dt-h2">{{ titulo }}</h2>
    </div>
    <div class="dt-scroll">
      {%- for n in s_nombre -%}
        {%- assign k = forloop.index0 -%}
        <div class="dt-soc">
          <div class="dt-soc__h">
            {%- if s_avatar[k] != blank -%}<img src="{{ s_avatar[k] }}" alt="" width="38" height="38" loading="lazy">{%- else -%}<i>{{ n | remove: '@' | remove: '[' | slice: 0 | upcase }}</i>{%- endif -%}
            <div><b>{{ n }}</b><small>{{ s_red[k] }}</small></div>
          </div>
          <p>{{ s_texto[k] }}</p>
          <div class="dt-soc__f"><span><svg class="dt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg> {{ s_likes[k] }}</span><span><svg class="dt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg> Responder</span></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
