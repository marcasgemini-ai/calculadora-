          "label": "Ícono",
          "default": "check",
          "options": [
            {
              "value": "moon",
              "label": "Luna (sueño)"
            },
            {
              "value": "belly",
              "label": "Panza"
            },
            {
              "value": "bolt",
              "label": "Rayo (energía)"
            },
            {
              "value": "heart",
              "label": "Corazón (ganas)"
            },
            {
              "value": "hourglass",
              "label": "Reloj de arena (edad)"
            },
            {
              "value": "brain",
              "label": "Cerebro (cabeza)"
            },
            {
              "value": "check",
              "label": "Tilde"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Beneficio"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto"
        }
