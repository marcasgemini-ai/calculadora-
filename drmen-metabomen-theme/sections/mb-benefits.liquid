            },
            {
              "value": "leaf",
              "label": "Hoja (natural)"
            },
            {
              "value": "flame",
              "label": "Llama"
            },
            {
              "value": "dumbbell",
              "label": "Pesa"
            },
            {
              "value": "drop",
              "label": "Gota"
            },
            {
              "value": "sun",
              "label": "Sol"
            },
            {
