{{ 'mb-metabomen.css' | asset_url | stylesheet_tag }}

<style>
  #mb-{{ section.id }} { --mb-pt: {{ section.settings.pt }}px; --mb-pb: {{ section.settings.pb }}px; }
  #mb-{{ section.id }} .mb-sc { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, 1fr); gap: 16px; }
  #mb-{{ section.id }} .mb-sc__c { padding: 26px 22px; text-align: center; }
  #mb-{{ section.id }} .mb-sc__c b { display: block; font-family: var(--mb-head); font-size: clamp(46px, 6vw, 68px); line-height: 1; color: var(--mb-red); }
  #mb-{{ section.id }} .mb-sc__c h3 { font-size: 18px; margin: 10px 0 6px; }
  #mb-{{ section.id }} .mb-sc__c p { font-size: 14.5px; color: var(--mb-sub); margin: 0; }
  #mb-{{ section.id }} .mb-sc__c small { display: block; font-size: 11.5px; color: var(--mb-sub); opacity: .8; margin-top: 10px; }
  #mb-{{ section.id }} .mb-sc__end { text-align: center; margin-top: 28px; }
  @media (max-width: 899px) { #mb-{{ section.id }} .mb-sc { grid-template-columns: 1fr; } }
</style>

<section id="mb-{{ section.id }}" class="mb mb--{{ section.settings.scheme }}">
  <div class="mb-wrap mb-pad">
    <div class="mb-head">
      {%- if section.settings.eyebrow != blank -%}<span class="mb-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="mb-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="mb-lead">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="mb-sc">
      {%- for block in section.blocks -%}
        <div class="mb-sc__c mb-card" {{ block.shopify_attributes }}>
          <b>{{ block.settings.number }}</b>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          {%- if block.settings.source != blank -%}<small>Fuente: {{ block.settings.source }}</small>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="mb-sc__end"><a class="mb-btn" href="{{ section.settings.button_link | default: '#mb-comprar' }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "MB · Datos con fuente",
  "tag": "div",
  "class": "mb-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto chico", "default": "Lo que dice la ciencia" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Por qué a los 40 <em>todo viene junto</em>" },
    { "type": "richtext", "id": "text", "label": "Bajada", "default": "<p>Dormís mal, sube el cortisol, crece la panza y baja la testosterona. Un problema alimenta al otro.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Cortar el círculo" },
    { "type": "text", "id": "button_link", "label": "Link del botón", "default": "#mb-comprar" },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "dark", "options": [ { "value": "light", "label": "Blanco" }, { "value": "cream", "label": "Crema" }, { "value": "sand", "label": "Arena" }, { "value": "dark", "label": "Negro" }, { "value": "red", "label": "Rojo" } ] },
    { "type": "range", "id": "pt", "label": "Espacio arriba", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pb", "label": "Espacio abajo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Dato",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Número", "default": "-80%" },
        { "type": "text", "id": "title", "label": "Título", "default": "Sueño profundo" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "text", "id": "source", "label": "Fuente", "info": "Solo datos con fuente real." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MB · Datos con fuente",
      "blocks": [
        { "type": "stat", "settings": { "number": "-80%", "title": "Sueño profundo", "text": "Entre los 36 y los 50 años, el sueño profundo cae casi un 80%. Es cuando el cuerpo se repara.", "source": "Van Cauter, JAMA 2000" } },
        { "type": "stat", "settings": { "number": "+45%", "title": "Cortisol", "text": "Después de una mala noche, la hormona del estrés queda hasta un 45% más alta. Y se asocia a la grasa abdominal.", "source": "Leproult, Sleep 1997" } },
        { "type": "stat", "settings": { "number": "-15%", "title": "Testosterona", "text": "Una semana durmiendo 5 horas la bajó entre un 10 y un 15%: lo que se pierde en una década.", "source": "Leproult & Van Cauter, JAMA 2011" } }
      ]
    }
  ]
}
{% endschema %}
