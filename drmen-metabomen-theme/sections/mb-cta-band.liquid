{{ 'mb-metabomen.css' | asset_url | stylesheet_tag }}

<style>
  #mb-{{ section.id }} { --mb-pt: {{ section.settings.pt }}px; --mb-pb: {{ section.settings.pb }}px; }
  #mb-{{ section.id }} .mb-cta { text-align: center; max-width: 820px; margin: 0 auto; }
  #mb-{{ section.id }} .mb-cta h2 { font-size: clamp(32px, 5vw, 56px); }
  #mb-{{ section.id }} .mb-cta .mb-lead { color: inherit; opacity: .9; }
  #mb-{{ section.id }} .mb-cta .mb-btn { margin-top: 24px; }
  #mb-{{ section.id }} .mb-cta .mb-under { color: inherit; opacity: .85; }
</style>

<section id="mb-{{ section.id }}" class="mb mb--{{ section.settings.scheme }}">
  <div class="mb-wrap mb-pad">
    <div class="mb-cta">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="mb-lead">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="mb-btn{% if section.settings.scheme == 'red' %} mb-btn--light{% endif %}" href="{{ section.settings.button_link | default: '#mb-comprar' }}">{{ section.settings.button_label }}</a>{%- endif -%}
      {%- if section.settings.under != blank -%}<div class="mb-under">{{ section.settings.under }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MB · Banda con botón",
  "tag": "div",
  "class": "mb-section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Volvé a sentirte <em>vos</em>" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Un tratamiento integral para el sueño, la panza, la energía y las ganas. 90 días. 60 de garantía.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Empezar hoy" },
    { "type": "text", "id": "button_link", "label": "Link del botón", "default": "#mb-comprar" },
    { "type": "text", "id": "under", "label": "Texto bajo el botón", "default": "Envío gratis · 3 cuotas sin interés" },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "red", "options": [ { "value": "light", "label": "Blanco" }, { "value": "cream", "label": "Crema" }, { "value": "dark", "label": "Negro" }, { "value": "red", "label": "Rojo" } ] },
    { "type": "range", "id": "pt", "label": "Espacio arriba", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pb", "label": "Espacio abajo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [ { "name": "MB · Banda con botón" } ]
}
{% endschema %}
