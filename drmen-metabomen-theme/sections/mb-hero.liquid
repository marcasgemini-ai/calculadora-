        },
        {
          "type": "bullet",
          "settings": {
            "text": "<b>Energía</b> para llegar entero a la noche"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Zinc para una <b>testosterona en niveles normales</b>*"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Vitamina C para <b>el colágeno de tu piel</b>*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
