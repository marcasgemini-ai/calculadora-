    {
      "name": "MB · Reseñas (lista)",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "tag": "sueno",
            "title": "[Título]",
            "text": "[Reseña real sobre el sueño]"
          }
        },
        {
          "type": "review",
          "settings": {
            "tag": "panza",
            "title": "[Título]",
            "text": "[Reseña real sobre la panza]"
          }
        },
        {
          "type": "review",
          "settings": {
            "tag": "energia",
            "title": "[Título]",
            "text": "[Reseña real sobre la energía]"
          }
        },
        {
          "type": "review",
          "settings": {
            "tag": "juventud",
            "title": "[Título]",
            "text": "[Reseña real sobre cómo se ve]"
          }
        }
      ]
    }
  ]
}
{% endschema %}
