{{ 'mb-metabomen.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign prod = section.settings.product
  if prod == blank and product
    assign prod = product
  endif
  assign up = section.settings.upsell_product
  assign up_off = ''
  assign up_free = ''
  if up != blank
    for v in up.variants
      assign vt = v.title | downcase
      if up_free == blank and v.price == 0
        assign up_free = v.id
      elsif up_free == blank and vt contains 'gratis'
        assign up_free = v.id
      elsif up_off == blank
        assign up_off = v.id
      endif
    endfor
  endif
  assign packs = section.blocks | where: 'type', 'pack'
  assign gifts = section.blocks | where: 'type', 'gift'
  assign default_i = 0
  for b in packs
    if b.settings.default
      assign default_i = forloop.index0
    endif
  endfor
-%}

<style>
  #mb-{{ section.id }} { --mb-pt: {{ section.settings.pt }}px; --mb-pb: {{ section.settings.pb }}px; scroll-margin-top: 20px; }
  #mb-{{ section.id }} .mb-bb__kicker { text-align: center; margin-bottom: 26px; }
  #mb-{{ section.id }} .mb-bb__kicker h2 { font-size: clamp(28px, 4.4vw, 46px); }
  #mb-{{ section.id }} .mb-bb { display: grid; grid-template-columns: 1fr 480px; gap: 44px; align-items: start; }
  #mb-{{ section.id }} .mb-bb__main img, #mb-{{ section.id }} .mb-bb__main .mb-ph { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 20px; background: #fff; }
  #mb-{{ section.id }} .mb-bb__th { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 10px; }
  #mb-{{ section.id }} .mb-bb__th button { padding: 0; border: 2px solid transparent; border-radius: 10px; overflow: hidden; background: #fff; cursor: pointer; aspect-ratio: 1 / 1; }
  #mb-{{ section.id }} .mb-bb__th button.is-on { border-color: var(--mb-red); }
  #mb-{{ section.id }} .mb-bb__th img { width: 100%; height: 100%; object-fit: cover; }
  #mb-{{ section.id }} .mb-bb__title { font-size: clamp(26px, 3.4vw, 36px); margin: 6px 0 8px; }
  #mb-{{ section.id }} .mb-bb__bul { margin: 14px 0 18px; font-size: 15px; }
  #mb-{{ section.id }} .mb-bb__bul ul { margin: 0; padding-left: 18px; }
  #mb-{{ section.id }} .mb-pk { position: relative; border: 2px solid var(--mb-line); border-radius: 14px; background: #fff; color: var(--mb-ink); margin-bottom: 10px; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
  #mb-{{ section.id }} .mb-pk.is-on { border-color: var(--mb-red); box-shadow: 0 8px 24px rgba(225,38,28,.14); }
  #mb-{{ section.id }} .mb-pk.has-rib { margin-top: 16px; }
  #mb-{{ section.id }} .mb-pk__rib { position: absolute; top: -11px; left: 14px; background: var(--mb-red); color: #fff; font-size: 10.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
  #mb-{{ section.id }} .mb-pk__h { display: grid; grid-template-columns: 20px 1fr auto; gap: 12px; align-items: center; padding: 14px; }
  #mb-{{ section.id }} .mb-pk__dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #B5BCC3; position: relative; }
  #mb-{{ section.id }} .mb-pk.is-on .mb-pk__dot { border-color: var(--mb-red); }
  #mb-{{ section.id }} .mb-pk.is-on .mb-pk__dot::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--mb-red); }
  #mb-{{ section.id }} .mb-pk__t b { display: block; font-size: 15.5px; font-weight: 800; }
  #mb-{{ section.id }} .mb-pk__t small { display: block; font-size: 12.5px; color: var(--mb-muted); }
  #mb-{{ section.id }} .mb-pk__p { text-align: right; line-height: 1.15; }
  #mb-{{ section.id }} .mb-pk__p b { display: block; font-size: 18px; font-weight: 800; }
  #mb-{{ section.id }} .mb-pk__p s { font-size: 12px; color: #9AA1A8; }
  #mb-{{ section.id }} .mb-pk__p em { display: block; font-style: normal; font-size: 11.5px; font-weight: 800; color: var(--mb-good); }
  #mb-{{ section.id }} .mb-pk__chips { display: flex; flex-wrap: wrap; gap: 5px; padding: 0 14px 12px 46px; margin-top: -4px; }
  #mb-{{ section.id }} .mb-pk__chips span { font-size: 11px; font-weight: 700; background: #F1EEE8; padding: 3px 8px; border-radius: 999px; }
  #mb-{{ section.id }} .mb-pk__body { display: none; padding: 0 14px 14px; }
  #mb-{{ section.id }} .mb-pk.is-on .mb-pk__body { display: block; }
  #mb-{{ section.id }} .mb-pk__baj { font-size: 13px; color: var(--mb-muted); font-style: italic; margin: 0 0 10px 32px; }
  #mb-{{ section.id }} .mb-bump { display: flex; align-items: center; gap: 10px; border: 1.5px dashed var(--mb-red); background: #FFF6F5; border-radius: 10px; padding: 9px 10px; margin-bottom: 10px; cursor: pointer; }
  #mb-{{ section.id }} .mb-bump input { width: 18px; height: 18px; accent-color: var(--mb-red); margin: 0; }
  #mb-{{ section.id }} .mb-bump img, #mb-{{ section.id }} .mb-bump__ph { width: 36px; height: 36px; border-radius: 8px; object-fit: cover; background: #fff; flex: 0 0 auto; }
  #mb-{{ section.id }} .mb-bump__t { flex: 1; font-size: 13px; line-height: 1.3; }
  #mb-{{ section.id }} .mb-bump__p { font-size: 13px; font-weight: 800; color: var(--mb-good); text-align: right; }
  #mb-{{ section.id }} .mb-bump__p s { display: block; font-weight: 400; color: #9AA1A8; font-size: 11px; }
  #mb-{{ section.id }} .mb-gifts__h { font-size: 12.5px; font-weight: 800; margin: 4px 0 8px; }
  #mb-{{ section.id }} .mb-gifts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  #mb-{{ section.id }} .mb-gift { position: relative; border: 1px solid var(--mb-line); border-radius: 10px; padding: 8px; text-align: center; background: #fff; }
  #mb-{{ section.id }} .mb-gift img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; margin-bottom: 6px; }
  #mb-{{ section.id }} .mb-gift__e { font-size: 22px; display: block; margin-bottom: 4px; }
  #mb-{{ section.id }} .mb-gift b { display: block; font-size: 11.5px; line-height: 1.2; }
  #mb-{{ section.id }} .mb-gift span { display: block; font-size: 10.5px; font-weight: 800; color: var(--mb-good); text-transform: uppercase; margin-top: 3px; }
  #mb-{{ section.id }} .mb-gift span s { color: #9AA1A8; font-weight: 400; text-transform: none; margin-left: 3px; }
  #mb-{{ section.id }} .mb-gift.is-lock { background: #F6F4F0; border-style: dashed; }
  #mb-{{ section.id }} .mb-gift.is-lock > * { opacity: .45; }
  #mb-{{ section.id }} .mb-gift.is-lock span { opacity: 1; color: #8A9199; }
  #mb-{{ section.id }} .mb-bb__btn { flex-wrap: wrap; gap: 0 8px; width: 100%; margin-top: 8px; padding: 19px; font-size: 16px; }
  #mb-{{ section.id }} .mb-bb__err { display: none; color: #C23B3B; font-size: 13px; text-align: center; margin-top: 8px; }
  #mb-{{ section.id }} .mb-bb__err small { display: block; color: var(--mb-muted); }
  #mb-{{ section.id }} .mb-bb__trust { display: grid; gap: 8px; margin-top: 14px; }
  #mb-{{ section.id }} .mb-bb__trust div { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; background: #fff; color: var(--mb-ink); border: 1px solid var(--mb-line); border-radius: 10px; padding: 10px 12px; }
  #mb-{{ section.id }} .mb-bb__trust .mb-ic { width: 20px; height: 20px; color: var(--mb-red); margin-top: 1px; }
  #mb-{{ section.id }} .mb-bb__trust b { display: block; }
  #mb-{{ section.id }} .mb-bb__trust p { margin: 0; }
  @media (max-width: 989px) { #mb-{{ section.id }} .mb-bb { grid-template-columns: 1fr; gap: 22px; } }
</style>

<section id="mb-comprar" class="mb mb--{{ section.settings.scheme }}">
<div id="mb-{{ section.id }}">
  <div class="mb-wrap mb-pad">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="mb-bb__kicker">
        {%- if section.settings.kicker != blank -%}<span class="mb-eyebrow">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if prod == blank -%}
      {%- if request.design_mode -%}<p class="mb-ph" style="aspect-ratio:auto">Elegí el producto en los ajustes de esta sección (o usala en la plantilla de producto).</p>{%- endif -%}
    {%- else -%}
    {%- assign v0 = prod.selected_or_first_available_variant -%}
    <div class="mb-bb">
      <div class="mb-bb__gal">
        <div class="mb-bb__main">
          {%- if prod.featured_media -%}
            <img data-main src="{{ prod.featured_media | image_url: width: 1100 }}" alt="{{ prod.title | escape }}" width="1100" height="1100" loading="lazy">
          {%- else -%}<div class="mb-ph">FOTOS DEL PRODUCTO</div>{%- endif -%}
        </div>
        {%- if prod.media.size > 1 -%}
          <div class="mb-bb__th">
            {%- for m in prod.media limit: 6 -%}
              {%- if m.media_type == 'image' -%}
                <button type="button" class="{% if forloop.first %}is-on{% endif %}" data-src="{{ m | image_url: width: 1100 }}"><img src="{{ m | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="160"></button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="mb-bb__panel">
        {%- if section.settings.rating_text != blank -%}<div class="mb-rating"><span class="mb-stars">★★★★★</span> {{ section.settings.rating_text }}</div>{%- endif -%}
        <h3 class="mb-bb__title">{{ section.settings.title | default: prod.title }}</h3>
        {%- if section.settings.bullets != blank -%}<div class="mb-bb__bul">{{ section.settings.bullets }}</div>{%- endif -%}

        <form data-form onsubmit="return false;">
          {%- for b in packs -%}
            {%- liquid
              assign vid = ''
              assign q = b.settings.quantity
              if b.settings.variant_match != blank
                assign want = b.settings.variant_match | downcase
                for v in prod.variants
                  assign vt = v.title | downcase
                  if vt contains want
                    assign vid = v.id
                    assign q = 1
                    break
                  endif
                endfor
              endif
              if vid == blank
                assign vid = v0.id
              endif
              case b.settings.bump
                when 'free'
                  assign bid = up_free
                when 'off'
                  assign bid = up_off
                else
                  assign bid = ''
              endcase
            -%}
            <div class="mb-pk{% if forloop.index0 == default_i %} is-on{% endif %}{% if b.settings.ribbon != blank %} has-rib{% endif %}" data-pack data-variant="{{ vid }}" data-qty="{{ q }}" data-units="{{ b.settings.quantity }}" data-code="{{ b.settings.discount_code | escape }}" data-price="{{ b.settings.price | escape }}" data-name="{{ b.settings.title | escape }}" data-bump="{{ bid }}" {{ b.shopify_attributes }}>
              {%- if b.settings.ribbon != blank -%}<span class="mb-pk__rib">{{ b.settings.ribbon }}</span>{%- endif -%}
              <div class="mb-pk__h">
                <span class="mb-pk__dot"></span>
                <span class="mb-pk__t"><b>{{ b.settings.title }}</b><small>{{ b.settings.subtitle }}{% if b.settings.per_day != blank %} · {{ b.settings.per_day }}{% endif %}</small></span>
                <span class="mb-pk__p"><b>{{ b.settings.price }}</b>{%- if b.settings.compare != blank -%}<s>{{ b.settings.compare }}</s>{%- endif -%}{%- if b.settings.savings != blank -%}<em>{{ b.settings.savings }}</em>{%- endif -%}</span>
              </div>
              {%- if b.settings.chips != blank -%}
                <div class="mb-pk__chips">{%- assign cl = b.settings.chips | split: ',' -%}{%- for c in cl -%}<span>{{ c | strip }}</span>{%- endfor -%}</div>
              {%- endif -%}
              <div class="mb-pk__body">
                {%- if b.settings.note != blank -%}<p class="mb-pk__baj">{{ b.settings.note }}</p>{%- endif -%}
                {%- if b.settings.bump != 'none' and up != blank -%}
                  <label class="mb-bump">
                    <input type="checkbox" data-bump-cb {% if bid == blank %}disabled{% endif %}>
                    {%- if up.featured_image -%}<img src="{{ up.featured_image | image_url: width: 100 }}" alt="" width="36" height="36" loading="lazy">{%- else -%}<span class="mb-bump__ph"></span>{%- endif -%}
                    <span class="mb-bump__t">{{ b.settings.bump_text }}</span>
                    <span class="mb-bump__p">{{ b.settings.bump_price }}{%- if b.settings.bump_compare != blank -%}<s>{{ b.settings.bump_compare }}</s>{%- endif -%}</span>
                  </label>
                {%- endif -%}
                {%- if gifts.size > 0 -%}
                  {%- assign open = 0 -%}{%- for g in gifts -%}{%- if b.settings.quantity >= g.settings.min_qty -%}{%- assign open = open | plus: 1 -%}{%- endif -%}{%- endfor -%}
                  <div class="mb-gifts__h">🎁 {{ open }}/{{ gifts.size }} {{ section.settings.gifts_label }}</div>
                  <div class="mb-gifts">
                    {%- for g in gifts -%}
                      <div class="mb-gift{% if b.settings.quantity < g.settings.min_qty %} is-lock{% endif %}" {{ g.shopify_attributes }}>
                        {%- if g.settings.image != blank -%}{{ g.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: g.settings.title }}{%- else -%}<span class="mb-gift__e">{{ g.settings.emoji }}</span>{%- endif -%}
                        <b>{{ g.settings.title }}</b>
                        {%- if b.settings.quantity >= g.settings.min_qty -%}
                          <span>{{ g.settings.label }}{%- if g.settings.compare != blank -%}<s>{{ g.settings.compare }}</s>{%- endif -%}</span>
                        {%- else -%}
                          <span>🔒 desde {{ g.settings.min_qty }} frascos</span>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}

          {%- if v0.available -%}
            <button type="submit" class="mb-btn mb-bb__btn" data-btn><span>{{ section.settings.button_label }}</span> <span data-btn-price></span></button>
          {%- else -%}
            <button type="button" class="mb-btn mb-bb__btn" disabled>Sin stock</button>
          {%- endif -%}
          <div class="mb-bb__err" data-err>{{ section.settings.error_text }}<small data-err-msg></small></div>
        </form>

        <div class="mb-bb__trust">
          {%- if section.settings.trust_1 != blank -%}<div><svg class="mb-ic" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg><span>{{ section.settings.trust_1 }}</span></div>{%- endif -%}
          {%- if section.settings.trust_2 != blank -%}<div><svg class="mb-ic" viewBox="0 0 24 24"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62L18.3 9.38a1 1 0 0 0-.78-.38H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg><span>{{ section.settings.trust_2 }}</span></div>{%- endif -%}
        </div>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>
</section>

<script>
  (function () {
    var root = document.getElementById('mb-{{ section.id }}');
    if (!root) return;
    var main = root.querySelector('[data-main]');
    root.querySelectorAll('.mb-bb__th button').forEach(function (b) {
      b.addEventListener('click', function () {
        if (main) main.src = b.getAttribute('data-src');
        root.querySelectorAll('.mb-bb__th button').forEach(function (x) { x.classList.remove('is-on'); });
        b.classList.add('is-on');
      });
    });
    var form = root.querySelector('[data-form]');
    if (!form) return;
    var packs = form.querySelectorAll('[data-pack]');
    var priceEl = form.querySelector('[data-btn-price]');
    var btn = form.querySelector('[data-btn]');
    var err = form.querySelector('[data-err]');
    var errMsg = form.querySelector('[data-err-msg]');
    function cur() { return form.querySelector('[data-pack].is-on') || packs[0]; }
    function sync() {
      var c = cur(); if (!c) return;
      if (priceEl) priceEl.textContent = '· ' + c.getAttribute('data-price');
      document.dispatchEvent(new CustomEvent('mb:pack', { detail: { name: c.getAttribute('data-name'), price: c.getAttribute('data-price') } }));
    }
    packs.forEach(function (p) {
      p.addEventListener('click', function (e) {
        if (e.target.closest('.mb-bump')) return;
        packs.forEach(function (x) { x.classList.remove('is-on'); });
        p.classList.add('is-on'); sync();
      });
    });
    sync();
    function post(url, body) {
      return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body || {}) })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok) throw new Error(j.description || j.message || ('Error ' + r.status)); return j; }); });
    }
    form.addEventListener('submit', function () {
      var c = cur(); if (!c) return;
      var bump = c.getAttribute('data-bump');
      var cb = c.querySelector('[data-bump-cb]');
      var code = (c.getAttribute('data-code') || '').trim();
      var dest = {{ section.settings.go_checkout | json }} ? '/checkout' : '/cart';
      if (btn) btn.disabled = true;
      if (err) err.style.display = 'none';
      ({{ section.settings.clear_cart | json }} ? post('/cart/clear.js') : Promise.resolve())
        .then(function () { return post('/cart/add.js', { items: [{ id: Number(c.getAttribute('data-variant')), quantity: Number(c.getAttribute('data-qty')), properties: { _Pack: c.getAttribute('data-name') } }] }); })
        .then(function () { if (bump && cb && cb.checked) return post('/cart/add.js', { items: [{ id: Number(bump), quantity: 1 }] }).catch(function () {}); })
        .then(function () { window.location.href = code ? '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(dest) : dest; })
        .catch(function (e) { if (btn) btn.disabled = false; if (err) err.style.display = 'block'; if (errMsg) errMsg.textContent = e && e.message ? e.message : ''; });
    });
  })();
</script>

{% schema %}
{
  "name": "MB · Compra (packs)",
  "tag": "div",
  "class": "mb-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto", "info": "En la plantilla de producto se usa solo. Elegilo si ponés esta sección en otra página." },
    { "type": "text", "id": "kicker", "label": "Texto chico", "default": "Oferta por tiempo limitado" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Ahorrá hasta <em>40%</em> en tu tratamiento" },
    { "type": "text", "id": "title", "label": "Nombre del producto (vacío = el de Shopify)", "default": "Metabomen · Tratamiento integral +40" },
    { "type": "text", "id": "rating_text", "label": "Calificación", "default": "4,8 · Hombres de +40" },
    { "type": "richtext", "id": "bullets", "label": "Puntos debajo del nombre", "default": "<ul><li>Fórmula de 14 activos, 1 cápsula por día</li><li>Protocolo de sueño y plan de alimentación de regalo</li><li>60 días de garantía</li></ul>" },
    { "type": "header", "content": "Upsell" },
    { "type": "product", "id": "upsell_product", "label": "Producto upsell", "info": "Variante con precio $0 o con 'Gratis' en el nombre = gratis. La otra = con descuento." },
    { "type": "header", "content": "Regalos" },
    { "type": "text", "id": "gifts_label", "label": "Texto de regalos", "default": "regalos incluidos" },
    { "type": "header", "content": "Botón y carrito" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Empezar mi tratamiento" },
    { "type": "checkbox", "id": "go_checkout", "label": "Ir directo al checkout", "default": true },
    { "type": "checkbox", "id": "clear_cart", "label": "Vaciar el carrito antes de agregar el pack", "default": true },
    { "type": "text", "id": "error_text", "label": "Mensaje de error", "default": "No pudimos agregarlo al carrito. Probá de nuevo en unos segundos." },
    { "type": "richtext", "id": "trust_1", "label": "Garantía", "default": "<p><b>60 días para probarlo.</b> Si no quedás conforme, te devolvemos el dinero.</p>" },
    { "type": "richtext", "id": "trust_2", "label": "Envío", "default": "<p><b>Envío gratis</b> con seguimiento a todo el país.</p>" },
    { "type": "header", "content": "Diseño" },
    { "type": "select", "id": "scheme", "label": "Fondo", "default": "cream", "options": [ { "value": "light", "label": "Blanco" }, { "value": "cream", "label": "Crema" }, { "value": "sand", "label": "Arena" }, { "value": "dark", "label": "Negro" } ] },
    { "type": "range", "id": "pt", "label": "Espacio arriba", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pb", "label": "Espacio abajo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Tratamiento integral 90 días" },
        { "type": "text", "id": "subtitle", "label": "Detalle", "default": "3 frascos" },
        { "type": "range", "id": "quantity", "label": "Frascos (unidades al carrito)", "min": 1, "max": 12, "step": 1, "default": 3 },
        { "type": "text", "id": "variant_match", "label": "Variante (opcional)", "info": "Si el producto tiene variantes por pack, escribí parte del nombre (ej: 3 frascos). Se agrega 1 unidad de esa variante." },
        { "type": "text", "id": "discount_code", "label": "Código de descuento (opcional)", "info": "Vacío si usás descuentos automáticos." },
        { "type": "text", "id": "price", "label": "Precio que se muestra", "default": "$101.900" },
        { "type": "text", "id": "compare", "label": "Precio tachado", "default": "$176.970" },
        { "type": "text", "id": "savings", "label": "Ahorro", "default": "Ahorrás $75.070" },
