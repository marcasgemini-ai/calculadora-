      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Número",
          "default": "14"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texto",
          "default": "activos en una cápsula"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video de cliente",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video (subido a Shopify)"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Imagen si no hay video"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Frase"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre"
        }
