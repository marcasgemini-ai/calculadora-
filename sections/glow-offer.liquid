{%- comment -%}
  Glow Offer · selector de packs para reemplazar Kaching Bundles.
  Cada pack = una variante del producto (precio y precio comparativo reales),
  así lo que ve la clienta es exactamente lo que cobra el checkout.
  Bump (CELUFIT) y regalos se agregan al carrito junto con el pack.
{%- endcomment -%}

{%- liquid
  if section.settings.product != blank
    assign offer_product = section.settings.product
  else
    assign offer_product = product
  endif
  assign bump_product = section.settings.bump_product
  assign bump_variant = bump_product.selected_or_first_available_variant
  assign preselected_index = 0
  for block in section.blocks
    if block.settings.preselected
      assign preselected_index = forloop.index0
    endif
  endfor
  assign gift_count = 0
  if section.settings.gift_1_title != blank
    assign gift_count = gift_count | plus: 1
  endif
  if section.settings.gift_2_title != blank
    assign gift_count = gift_count | plus: 1
  endif
  if section.settings.gift_3_title != blank
    assign gift_count = gift_count | plus: 1
  endif
-%}

{%- if offer_product != blank -%}
<div
  id="glow-{{ section.id }}"
  class="glow"
  data-redirect="{{ section.settings.redirect }}"
  data-bump-id="{{ bump_variant.id }}"
  data-bump-free-min="{{ section.settings.bump_free_min }}"
  data-bump-price="{{ section.settings.bump_price | times: 100 }}"
  data-bump-compare="{{ bump_variant.price }}"
  style="
    --glow-accent: {{ section.settings.color_accent }};
    --glow-soft: {{ section.settings.color_soft }};
    --glow-ink: {{ section.settings.color_ink }};
    --glow-card: {{ section.settings.color_card }};
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="glow__heading">
      <span class="glow__line"></span>
      <p>{{ section.settings.heading }}</p>
      <span class="glow__line"></span>
    </div>
  {%- endif -%}

  <div class="glow__tiers" role="radiogroup" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign v_index = block.settings.variant_position | minus: 1
        assign variant = offer_product.variants[v_index]
        assign bottles = block.settings.bottles
        assign compare = variant.compare_at_price | default: variant.price
        assign savings = compare | minus: variant.price
        assign per_unit = variant.price | divided_by: bottles
        assign unlocked = 0
        if section.settings.gift_1_title != blank and bottles >= section.settings.gift_1_min
          assign unlocked = unlocked | plus: 1
        endif
        if section.settings.gift_2_title != blank and bottles >= section.settings.gift_2_min
          assign unlocked = unlocked | plus: 1
        endif
        if section.settings.gift_3_title != blank and bottles >= section.settings.gift_3_min
          assign unlocked = unlocked | plus: 1
        endif
        assign bump_free = false
        if bottles >= section.settings.bump_free_min
          assign bump_free = true
        endif
      -%}
      {%- if variant != blank -%}
      <div
        class="glow-tier{% if forloop.index0 == preselected_index %} is-active{% endif %}{% if block.settings.ribbon != blank %} has-ribbon{% endif %}"
        data-variant-id="{{ variant.id }}"
        data-bottles="{{ bottles }}"
        data-price="{{ variant.price }}"
        data-compare="{{ compare }}"
        data-name="{{ block.settings.title | escape }}"
        {{ block.shopify_attributes }}
      >
        <input
          type="radio"
          class="glow-tier__radio"
          aria-label="{{ block.settings.title | escape }} · {{ variant.price | money_without_trailing_zeros }}"
          name="glow-tier-{{ section.id }}"
          value="{{ variant.id }}"
          {% if forloop.index0 == preselected_index %}checked{% endif %}
          {% unless variant.available %}disabled{% endunless %}
        >

        {%- if block.settings.ribbon != blank -%}
          <span class="glow-tier__ribbon">{{ block.settings.ribbon }}</span>
        {%- endif -%}

        <div class="glow-tier__head">
          <span class="glow-tier__check" aria-hidden="true"></span>
          <div class="glow-tier__title">
            <strong>{{ block.settings.title }}</strong>
            {%- if block.settings.meta != blank -%}<span>{{ block.settings.meta }}</span>{%- endif -%}
          </div>
          <div class="glow-tier__price">
            <strong>{{ variant.price | money_without_trailing_zeros }}</strong>
            {%- if savings > 0 -%}<s>{{ compare | money_without_trailing_zeros }}</s>{%- endif -%}
            {%- if bottles > 1 -%}<span>{{ per_unit | money_without_trailing_zeros }} c/u</span>{%- endif -%}
          </div>
        </div>

        {%- if block.settings.badges != blank -%}
          <div class="glow-tier__badges">
            {%- assign badges = block.settings.badges | split: ',' -%}
            {%- for badge in badges -%}
              <span class="glow-badge{% if forloop.first %} glow-badge--strong{% endif %}">{{ badge | strip }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="glow-tier__body">
          {%- if block.settings.subtitle != blank -%}
            <p class="glow-tier__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}

          {%- if bump_variant != blank and block.settings.show_bump -%}
            <div class="glow-bump" role="group">
              <input type="checkbox" class="glow-bump__input" id="glow-bump-{{ block.id }}" {% if bump_free %}checked{% endif %}>
              <label class="glow-bump__row" for="glow-bump-{{ block.id }}">
                <span class="glow-bump__box" aria-hidden="true"></span>
                {%- if bump_product.featured_image -%}
                  {{ bump_product.featured_image | image_url: width: 120 | image_tag: class: 'glow-bump__img', loading: 'lazy', alt: bump_product.title }}
                {%- endif -%}
                <span class="glow-bump__text">
                  {%- if bump_free -%}{{ block.settings.bump_text_free }}{%- else -%}{{ block.settings.bump_text }}{%- endif -%}
                </span>
                <span class="glow-bump__price">
                  {%- if bump_free -%}
                    <strong>GRATIS</strong>
                  {%- else -%}
                    <strong>{{ section.settings.bump_price | times: 100 | money_without_trailing_zeros }}</strong>
                  {%- endif -%}
                  <s>{{ bump_variant.price | money_without_trailing_zeros }}</s>
                </span>
              </label>
            </div>
          {%- endif -%}

          {%- if gift_count > 0 -%}
            <div class="glow-gifts">
              <p class="glow-gifts__title">
                {%- if unlocked > 0 -%}
                  🎁 {{ unlocked }}/{{ gift_count }} regalos incluidos
                {%- else -%}
                  🎁 Regalos desde {{ section.settings.gift_1_min }} frascos
                {%- endif -%}
              </p>
              <ul>
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign k_title = 'gift_' | append: i | append: '_title'
                    assign k_value = 'gift_' | append: i | append: '_value'
                    assign k_min = 'gift_' | append: i | append: '_min'
                    assign k_tag = 'gift_' | append: i | append: '_tag'
                    assign g_title = section.settings[k_title]
                    assign g_min = section.settings[k_min]
                  -%}
                  {%- if g_title != blank -%}
                    {%- if bottles >= g_min -%}
                      <li class="is-unlocked">
                        <span class="glow-gifts__icon" aria-hidden="true">✓</span>
                        <span class="glow-gifts__name">{{ g_title }}</span>
                        <span class="glow-gifts__value">
                          <strong>{{ section.settings[k_tag] }}</strong>
                          {%- if section.settings[k_value] != blank -%}<s>{{ section.settings[k_value] }}</s>{%- endif -%}
                        </span>
                      </li>
                    {%- else -%}
                      <li class="is-locked">
                        <span class="glow-gifts__icon" aria-hidden="true">🔒</span>
                        <span class="glow-gifts__name">{{ g_title }}</span>
                        <span class="glow-gifts__value"><em>con {{ g_min }} frascos</em></span>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="glow__summary">
    <div class="glow__total">
      <span>Total</span>
      <strong data-glow-total></strong>
      <s data-glow-compare></s>
    </div>
    <p class="glow__savings" data-glow-savings></p>
  </div>

  <button type="button" class="glow__cta" data-glow-cta>
    <span data-glow-cta-label>{{ section.settings.cta_label }}</span>
  </button>
  <p class="glow__error" data-glow-error hidden></p>

  {%- if section.settings.trust != blank -%}
    <ul class="glow__trust">
      {%- assign trust_items = section.settings.trust | split: ',' -%}
      {%- for item in trust_items -%}<li>{{ item | strip }}</li>{%- endfor -%}
    </ul>
  {%- endif -%}

  <script type="application/json" data-glow-gifts>
    [
      {%- for i in (1..3) -%}
        {%- liquid
          assign k_title = 'gift_' | append: i | append: '_title'
          assign k_min = 'gift_' | append: i | append: '_min'
          assign k_product = 'gift_' | append: i | append: '_product'
          assign g_product = section.settings[k_product]
        -%}
        {
          "title": {{ section.settings[k_title] | json }},
          "min": {{ section.settings[k_min] | default: 99 }},
          "variantId": {% if g_product != blank %}{{ g_product.selected_or_first_available_variant.id }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

<style>
  #glow-{{ section.id }} { --glow-radius: 14px; color: var(--glow-ink); font-size: 15px; line-height: 1.35; margin: 12px 0 20px; }
  #glow-{{ section.id }} * { box-sizing: border-box; }
  #glow-{{ section.id }} s { opacity: .55; font-weight: 400; }
  .glow__heading { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .glow__heading p { margin: 0; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .glow__line { flex: 1; height: 1px; background: currentColor; opacity: .2; }
  .glow__tiers { display: grid; gap: 12px; }

  .glow-tier { position: relative; display: block; padding: 14px 14px 12px; border: 1.5px solid rgba(0,0,0,.12); border-radius: var(--glow-radius); background: var(--glow-card); cursor: pointer; transition: border-color .2s, box-shadow .2s, background .2s; }
  .glow-tier.has-ribbon { margin-top: 10px; }
  .glow-tier:hover { border-color: var(--glow-accent); }
  .glow-tier.is-active { border-color: var(--glow-accent); background: var(--glow-soft); box-shadow: 0 6px 22px -10px var(--glow-accent); }
  .glow-tier__radio { position: absolute; opacity: 0; pointer-events: none; }
  .glow-tier__radio:focus-visible ~ .glow-tier__head .glow-tier__check { outline: 2px solid var(--glow-accent); outline-offset: 2px; }
  .glow-tier__ribbon { position: absolute; top: -11px; left: 14px; padding: 3px 10px; border-radius: 999px; background: var(--glow-ink); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }

  .glow-tier__head { display: grid; grid-template-columns: auto 1fr auto; gap: 10px; align-items: center; }
  .glow-tier__check { width: 20px; height: 20px; border-radius: 50%; border: 2px solid rgba(0,0,0,.3); display: grid; place-items: center; }
  .is-active .glow-tier__check { border-color: var(--glow-accent); }
  .is-active .glow-tier__check::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--glow-accent); }
  .glow-tier__title strong { display: block; font-size: 16px; }
  .glow-tier__title span { display: block; font-size: 13px; opacity: .7; }
  .glow-tier__price { text-align: right; display: flex; flex-direction: column; align-items: flex-end; }
  .glow-tier__price strong { font-size: 18px; }
  .glow-tier__price s { font-size: 13px; }
  .glow-tier__price span { font-size: 12px; opacity: .7; }

  .glow-tier__badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; padding-left: 30px; }
  .glow-badge { padding: 3px 9px; border-radius: 999px; border: 1px solid rgba(0,0,0,.15); background: #fff; font-size: 11.5px; font-weight: 600; }
  .glow-badge--strong { background: var(--glow-accent); border-color: var(--glow-accent); color: #fff; }

  .glow-tier__body { display: none; padding-left: 30px; }
  .glow-tier.is-active .glow-tier__body { display: block; }
  .glow-tier__subtitle { margin: 10px 0 0; font-size: 14px; font-style: italic; }

  .glow-bump { margin-top: 12px; }
  .glow-bump__input { position: absolute; opacity: 0; pointer-events: none; }
  .glow-bump__row { display: grid; grid-template-columns: auto auto 1fr auto; gap: 10px; align-items: center; padding: 10px; border: 1.5px dashed var(--glow-accent); border-radius: 10px; background: #fff; cursor: pointer; }
  .glow-bump__box { width: 18px; height: 18px; border-radius: 4px; border: 2px solid var(--glow-accent); display: grid; place-items: center; }
  .glow-bump__input:checked + .glow-bump__row .glow-bump__box { background: var(--glow-accent); }
  .glow-bump__input:checked + .glow-bump__row .glow-bump__box::after { content: "✓"; color: #fff; font-size: 12px; font-weight: 700; }
  .glow-bump__input:focus-visible + .glow-bump__row { outline: 2px solid var(--glow-accent); outline-offset: 2px; }
  .glow-bump__img { width: 40px; height: 40px; object-fit: cover; border-radius: 6px; }
  .glow-bump__text { font-size: 13px; font-weight: 600; }
  .glow-bump__price { display: flex; flex-direction: column; align-items: flex-end; font-size: 13px; }
  .glow-bump__price strong { color: var(--glow-accent); }

  .glow-gifts { margin-top: 12px; padding: 10px 12px; border-radius: 10px; background: rgba(255,255,255,.7); }
  .glow-gifts__title { margin: 0 0 6px; font-size: 13px; font-weight: 700; }
  .glow-gifts ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .glow-gifts li { display: grid; grid-template-columns: 18px 1fr auto; gap: 8px; align-items: center; font-size: 13px; }
  .glow-gifts li.is-locked { opacity: .5; }
  .glow-gifts__icon { color: var(--glow-accent); font-weight: 700; text-align: center; }
  .glow-gifts__value { display: flex; gap: 6px; align-items: baseline; white-space: nowrap; }
  .glow-gifts__value strong { color: var(--glow-accent); font-size: 12px; }
  .glow-gifts__value em { font-style: normal; font-size: 12px; }

  .glow__summary { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; margin: 16px 2px 10px; }
  .glow__total { display: flex; align-items: baseline; gap: 8px; }
  .glow__total span { font-size: 14px; opacity: .7; }
  .glow__total strong { font-size: 22px; }
  .glow__savings { margin: 0; font-size: 13px; font-weight: 700; color: var(--glow-accent); }

  .glow__cta { width: 100%; min-height: 56px; border: 0; border-radius: 999px; background: var(--glow-ink); color: #fff; font-size: 16px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; cursor: pointer; transition: transform .15s, opacity .2s; }
  .glow__cta:hover { transform: translateY(-1px); }
  .glow__cta[aria-busy="true"] { opacity: .6; pointer-events: none; }
  .glow__error { margin: 8px 0 0; color: #b42318; font-size: 13px; text-align: center; }
  .glow__trust { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; margin: 12px 0 0; padding: 0; font-size: 12.5px; opacity: .8; }
  .glow__trust li::before { content: "✓ "; color: var(--glow-accent); font-weight: 700; }

  @media (max-width: 480px) {
    .glow-tier__badges, .glow-tier__body { padding-left: 0; }
    .glow-bump__row { grid-template-columns: auto 1fr auto; }
    .glow-bump__img { display: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('glow-{{ section.id }}');
    if (!root) return;
    var tiers = Array.prototype.slice.call(root.querySelectorAll('.glow-tier'));
    var gifts = JSON.parse(root.querySelector('[data-glow-gifts]').textContent);
    var bumpId = Number(root.dataset.bumpId) || null;
    var bumpFreeMin = Number(root.dataset.bumpFreeMin);
    var bumpPrice = Number(root.dataset.bumpPrice);
    var bumpCompare = Number(root.dataset.bumpCompare);
    var cta = root.querySelector('[data-glow-cta]');
    var errorEl = root.querySelector('[data-glow-error]');

    function money(cents) {
      return '$' + Math.round(cents / 100).toLocaleString('es-AR');
    }
    function active() {
      return root.querySelector('.glow-tier.is-active') || tiers[0];
    }
    function bumpChecked(tier) {
      var box = tier.querySelector('.glow-bump__input');
      return !!(box && box.checked && bumpId);
    }
    function render() {
      var tier = active();
      var bottles = Number(tier.dataset.bottles);
      var price = Number(tier.dataset.price);
      var compare = Number(tier.dataset.compare);
      if (bumpChecked(tier)) {
        price += bottles >= bumpFreeMin ? 0 : bumpPrice;
        compare += bumpCompare;
      }
      root.querySelector('[data-glow-total]').textContent = money(price);
      root.querySelector('[data-glow-compare]').textContent = compare > price ? money(compare) : '';
      root.querySelector('[data-glow-savings]').textContent = compare > price ? 'Ahorrás ' + money(compare - price) : '';
    }
    function select(tier) {
      tiers.forEach(function (t) {
        var on = t === tier;
        t.classList.toggle('is-active', on);
        t.querySelector('.glow-tier__radio').checked = on;
      });
      render();
    }

    tiers.forEach(function (tier) {
      var radio = tier.querySelector('.glow-tier__radio');
      radio.addEventListener('change', function () { select(tier); });
      tier.addEventListener('click', function () { if (!radio.disabled && !tier.classList.contains('is-active')) select(tier); });
      var box = tier.querySelector('.glow-bump__input');
      if (box) box.addEventListener('change', render);
    });

    cta.addEventListener('click', function () {
      var tier = active();
      var bottles = Number(tier.dataset.bottles);
      var offer = tier.dataset.name;
      var items = [{ id: Number(tier.dataset.variantId), quantity: 1, properties: { _oferta: offer } }];
      if (bumpChecked(tier)) items.push({ id: bumpId, quantity: 1, properties: { _oferta: offer + ' · bump' } });
      gifts.forEach(function (g) {
        if (g.variantId && bottles >= g.min) items.push({ id: g.variantId, quantity: 1, properties: { _regalo: offer } });
      });

      cta.setAttribute('aria-busy', 'true');
      errorEl.hidden = true;
      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) { return res.json().then(function (data) { if (!res.ok) throw data; return data; }); })
        .then(function () {
          window.location.href = root.dataset.redirect === 'checkout' ? '/checkout' : '{{ routes.cart_url }}';
        })
        .catch(function (err) {
          cta.removeAttribute('aria-busy');
          errorEl.textContent = (err && (err.description || err.message)) || 'No pudimos agregar el pack. Probá de nuevo.';
          errorEl.hidden = false;
        });
    });

    select(active());
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Oferta Glow (packs)",
  "tag": "section",
  "class": "section-glow-offer",
  "settings": [
    { "type": "header", "content": "Producto" },
    { "type": "product", "id": "product", "label": "Producto de la oferta", "info": "Vacío = usa el producto de la página. Cada pack es una variante de este producto." },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elegí tu protocolo" },
    { "type": "select", "id": "redirect", "label": "Después de agregar", "default": "cart", "options": [ { "value": "cart", "label": "Ir al carrito" }, { "value": "checkout", "label": "Ir directo al checkout" } ] },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Quiero mi tono dorado" },
    { "type": "text", "id": "trust", "label": "Garantías (separadas por coma)", "default": "Envío gratis, 3 cuotas sin interés, Compra 100% segura" },

    { "type": "header", "content": "Order bump (CELUFIT)" },
    { "type": "product", "id": "bump_product", "label": "Producto bump" },
    { "type": "number", "id": "bump_price", "label": "Precio promo del bump (ARS)", "default": 23990 },
    { "type": "number", "id": "bump_free_min", "label": "Bump GRATIS desde (frascos)", "default": 6 },

    { "type": "header", "content": "Regalo 1" },
    { "type": "text", "id": "gift_1_title", "label": "Nombre", "default": "Guía \"Rutina Glow\"" },
    { "type": "text", "id": "gift_1_value", "label": "Valor tachado", "default": "$25.000" },
    { "type": "text", "id": "gift_1_tag", "label": "Etiqueta", "default": "GRATIS" },
    { "type": "number", "id": "gift_1_min", "label": "Desde (frascos)", "default": 2 },
    { "type": "product", "id": "gift_1_product", "label": "Producto regalo ($0) a agregar al carrito", "info": "Opcional. Se agrega solo cuando el pack califica." },

    { "type": "header", "content": "Regalo 2" },
    { "type": "text", "id": "gift_2_title", "label": "Nombre", "default": "Guía \"Alimentación para un tono dorado\"" },
    { "type": "text", "id": "gift_2_value", "label": "Valor tachado", "default": "$20.000" },
    { "type": "text", "id": "gift_2_tag", "label": "Etiqueta", "default": "GRATIS" },
    { "type": "number", "id": "gift_2_min", "label": "Desde (frascos)", "default": 3 },
    { "type": "product", "id": "gift_2_product", "label": "Producto regalo ($0) a agregar al carrito" },

    { "type": "header", "content": "Regalo 3" },
    { "type": "text", "id": "gift_3_title", "label": "Nombre", "default": "Viaje al Caribe para Enero" },
    { "type": "text", "id": "gift_3_value", "label": "Valor tachado" },
    { "type": "text", "id": "gift_3_tag", "label": "Etiqueta", "default": "SORTEO" },
    { "type": "number", "id": "gift_3_min", "label": "Desde (frascos)", "default": 3 },
    { "type": "product", "id": "gift_3_product", "label": "Producto regalo ($0) a agregar al carrito" },

